"""Canonical logical-brain facade for bounded resident shard admission."""
import config;

open cache;

open config;

open manifest;

"""Failures returned before a logical-brain mutation is published."""
open enum LogicalBrainError {
    InvalidProfile,
    NotInitialized,
    InvalidGeneration,
    InvalidDescriptor,
    InvalidShardCapacity,
    NonSequentialShard,
    LogicalCapacityExceeded,
    ResidentCapacityExceeded,
    FlushRequired,
    ShardNotFound,
}

"""Bounded resident state for one logical brain.

The directory and cache are inline bounded state. This facade owns metadata
only; shard payload encoding, filesystem I/O, and publication remain in the
explicit persistence operations.
"""
open struct LogicalBrain {
    erg initialized: Bool,
    erg shard_count: u32,
    erg total_column_count: u32,
    erg shard_transitions: u32,
    erg generation: u64,
    erg cache: ShardCache,
}

"""Return a zeroed logical brain value without filesystem access."""
open verb logical_brain_empty() -> LogicalBrain {
    return LogicalBrain {initialized: false, shard_count: 0u32, total_column_count: 0u32, shard_transitions: 0u32, generation: 0u64, cache: ShardCache {entries: Array[ShardCacheEntry, 4](
    ), clock: 0u64}};
}

"""Initialize or reset bounded logical-brain metadata.

No payload is loaded and no filesystem operation occurs. The caller receives
an error before mutation when the production routing profile is invalid.
"""
open verb logical_brain_init(ins brain: LogicalBrain) -> Result[Int, LogicalBrainError] {
    if !logical_shard_profile_is_valid() {
        return Result[Int, LogicalBrainError].Err(LogicalBrainError.InvalidProfile);
    }
    brain.initialized = true;
    brain.shard_count = 0u32;
    brain.total_column_count = 0u32;
    brain.shard_transitions = 0u32;
    brain.generation = 0u64;
    shard_cache_init(cache: ins brain.cache);
    return Result[Int, LogicalBrainError].Ok(0);
}

"""Admit the next deterministic full-capacity shard into resident metadata.

The operation does not write to disk. It rejects non-sequential or oversized
shards before mutation and reports `FlushRequired` when the caller must flush
the cache at its configured dirty high-watermark.
"""
verb logical_brain_record_shard(ins brain: LogicalBrain) -> Result[Int, LogicalBrainError] {
    if brain.shard_count >= BRAIN_LOGICAL_MAX_SHARDS {
        return Result[Int, LogicalBrainError].Err(LogicalBrainError.LogicalCapacityExceeded);
    }
    brain.shard_count += 1u32;
    brain.total_column_count += BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    if brain.shard_count > 1u32 {
        brain.shard_transitions += 1u32;
    }
    return Result[Int, LogicalBrainError].Ok(0);
}

verb logical_brain_insert_resident(
    ins brain: LogicalBrain,
    erg shard_id: u32,
    erg generation: u64,
    erg checksum: u64
) -> Result[u8, ShardCacheError] {
    return shard_cache_insert(
        cache: ins brain.cache,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
}

verb logical_brain_finish_admission(
    ins brain: LogicalBrain,
    dat inserted: Result[u8, ShardCacheError]
) -> Result[u8, LogicalBrainError] {
    return case dat inserted {
        Result.Err(_) => Result[u8, LogicalBrainError].Err(LogicalBrainError.ResidentCapacityExceeded),
        Result.Ok(slot) => {
            erg recorded = logical_brain_record_shard(brain: ins brain);
            return case dat recorded {
                Result.Err(error) => Result[u8, LogicalBrainError].Err(error),
                Result.Ok(_) => Result[u8, LogicalBrainError].Ok(slot),
            };
        },
    };
}

"""Admit the next deterministic full-capacity shard into resident metadata.

The operation does not write to disk. It rejects non-sequential or oversized
shards before mutation and reports `FlushRequired` when the caller must flush
the cache at its configured dirty high-watermark.
"""
open verb logical_brain_admit_shard(
    ins brain: LogicalBrain,
    erg shard_id: u32,
    erg column_count: u32
) -> Result[u8, LogicalBrainError] {
    if !brain.initialized {
        return Result[u8, LogicalBrainError].Err(LogicalBrainError.NotInitialized);
    }
    if column_count != BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        return Result[u8, LogicalBrainError].Err(LogicalBrainError.InvalidShardCapacity);
    }
    if shard_id != brain.shard_count {
        return Result[u8, LogicalBrainError].Err(LogicalBrainError.NonSequentialShard);
    }
    if shard_id >= BRAIN_LOGICAL_MAX_SHARDS {
        return Result[u8, LogicalBrainError].Err(LogicalBrainError.LogicalCapacityExceeded);
    }
    if shard_cache_flush_requested(cache: abs brain.cache) {
        return Result[u8, LogicalBrainError].Err(LogicalBrainError.FlushRequired);
    }
    erg generation: u64 = brain.generation;
    erg checksum: u64 = 0u64;
    erg inserted = logical_brain_insert_resident(
        brain: ins brain,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
    return logical_brain_finish_admission(brain: ins brain, inserted: dat inserted);
}

"""Look up one admitted shard through the public logical-brain facade.

The operation is read-only, returns the position-independent manifest
descriptor, and never exposes the resident cache or shard payload internals.
Uninitialized brains and unknown shard IDs return typed errors.
"""
open verb logical_brain_lookup_shard(abs brain: LogicalBrain, erg shard_id: u32) -> Result[ManifestDescriptor, LogicalBrainError] {
    if !brain.initialized {
        return Result[ManifestDescriptor, LogicalBrainError].Err(LogicalBrainError.NotInitialized);
    }
    if shard_id >= brain.shard_count {
        return Result[ManifestDescriptor, LogicalBrainError].Err(LogicalBrainError.ShardNotFound);
    }
    erg first_column_index: u32 = shard_id * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    return Result[ManifestDescriptor, LogicalBrainError].Ok(ManifestDescriptor {shard_id: shard_id, first_column_index: first_column_index, column_count: BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY, payload_offset: BRAIN_SHARD_HEADER_BYTES as u32, payload_bytes: BRAIN_LOGICAL_SHARD_COLUMNS_BYTES, binding_offset: BRAIN_SHARD_HEADER_BYTES as u32 + BRAIN_LOGICAL_SHARD_COLUMNS_BYTES, binding_bytes: BRAIN_LOGICAL_SHARD_BINDINGS_BYTES, auxiliary_offset: BRAIN_SHARD_HEADER_BYTES as u32 + BRAIN_LOGICAL_SHARD_COLUMNS_BYTES + BRAIN_LOGICAL_SHARD_BINDINGS_BYTES, auxiliary_bytes: BRAIN_AUXILIARY_PAYLOAD_BYTES, checksum: 0u64, state: 1u32});
}

"""Return the bounded resident slot for a logical shard, if it is cached."""
open verb logical_brain_resident_slot(abs brain: LogicalBrain, erg shard_id: u32) -> Option[u8] {
    return shard_cache_find(cache: abs brain.cache, shard_id: erg shard_id);
}

"""Restore a validated multi-shard generation into a fresh logical facade.

The caller supplies descriptors only after the manifest and every referenced
shard have passed persistence validation. This operation restores bounded
logical metadata and resident-cache state without filesystem I/O; shard
payload restoration belongs to the teaching-state persistence boundary.
"""
open verb logical_brain_restore_generation(
    ins brain: LogicalBrain,
    erg generation: u64,
    erg total_column_count: u32,
    abs shard_count: u32
) -> Result[Int, LogicalBrainError] {
    if !logical_shard_profile_is_valid() || shard_count == 0u32 || shard_count > BRAIN_LOGICAL_MAX_SHARDS || shard_count > BRAIN_LOGICAL_MAX_MANIFEST_DESCRIPTORS {
        return Result[Int, LogicalBrainError].Err(LogicalBrainError.InvalidGeneration);
    }
    if total_column_count != shard_count * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        return Result[Int, LogicalBrainError].Err(LogicalBrainError.InvalidGeneration);
    }
    brain.initialized = true;
    brain.shard_count = shard_count;
    brain.total_column_count = total_column_count;
    brain.shard_transitions = shard_count - 1u32;
    brain.generation = generation;
    shard_cache_init(cache: ins brain.cache);
    return Result[Int, LogicalBrainError].Ok(0);
}

"""Close a logical brain and release its bounded resident metadata.

Closing is an in-memory lifecycle operation. It clears the logical directory
and cache; it does not publish or delete files. A caller must perform any
explicit persistence operation before closing.
"""
open verb logical_brain_close(ins brain: LogicalBrain) -> Result[Int, LogicalBrainError] {
    if !brain.initialized {
        return Result[Int, LogicalBrainError].Err(LogicalBrainError.NotInitialized);
    }
    brain.initialized = false;
    brain.shard_count = 0u32;
    brain.total_column_count = 0u32;
    brain.shard_transitions = 0u32;
    brain.generation = 0u64;
    shard_cache_init(cache: ins brain.cache);
    return Result[Int, LogicalBrainError].Ok(0);
}

"""Report whether one admitted logical shard still needs persistence."""
open verb logical_brain_shard_is_dirty(abs brain: LogicalBrain, erg shard_id: u32) -> Bool {
    if shard_id >= brain.shard_count {
        return false;
    }
    erg found = shard_cache_find(cache: abs brain.cache, shard_id: erg shard_id);
    return case dat found {
        Option.None => false,
        Option.Some(slot) => cache_entry_is_dirty(entry: abs brain.cache.entries[slot as Usize]),
    };
}

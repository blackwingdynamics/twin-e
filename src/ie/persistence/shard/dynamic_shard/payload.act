"""Public writer for dynamic shards containing columns only."""
open writer_core;

verb dynamic_payload_inputs_are_valid(
    erg first_column_index: u32,
    erg column_count: u32,
    erg payload_length: Int,
    erg expected_payload_bytes: u32
) -> Bool {
    erg no_binding_bytes: u32 = 0u32;
    erg no_binding_length: Int = 0;
    return dynamic_shard_write_inputs_are_valid(
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload_length: erg payload_length,
        expected_payload_bytes: erg expected_payload_bytes,
        observed_binding_length: erg no_binding_length,
        expected_binding_bytes: erg no_binding_bytes,
        expected_auxiliary_bytes: erg no_binding_bytes
    );
}

"""Write a dynamic shard containing column payload bytes only."""
open verb write_dynamic_shard(
    abs path: Path,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    abs payload: Buffer
) -> Result[Int, IoError] {
    erg payload_length: Int = buffer_length_or_negative(input: abs payload);
    erg expected_payload_bytes: u32 = column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    if !dynamic_payload_inputs_are_valid(
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload_length: erg payload_length,
        expected_payload_bytes: erg expected_payload_bytes
    ) {
        return Err(IoError.InvalidInput);
    }
    return persist_dynamic_shard_payload(
        path: abs path,
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload: abs payload,
        expected_payload_bytes: erg expected_payload_bytes
    );
}

verb persist_dynamic_shard_payload(
    abs path: Path,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    abs payload: Buffer,
    erg expected_payload_bytes: u32
) -> Result[Int, IoError] {
    erg file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + expected_payload_bytes;
    erg no_binding_bytes: u32 = 0u32;
    erg output = initialize_dynamic_shard_output(
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        expected_payload_bytes: erg expected_payload_bytes,
        expected_binding_bytes: erg no_binding_bytes,
        expected_auxiliary_bytes: erg no_binding_bytes,
        file_length: erg file_length
    );
    append_dynamic_shard_bytes(
        output: ins output,
        input: abs payload,
        length: erg expected_payload_bytes
    );
    return finalize_dynamic_shard(
        output: dat output,
        path: abs path,
        file_length: erg file_length
    );
}

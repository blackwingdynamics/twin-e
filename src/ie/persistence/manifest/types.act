"""Position-independent index for a bounded set of brain shards."""
import config;

import std::fs;

import std::io;

"""Versioned header describing the complete shard manifest."""
open struct ManifestHeader {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg manifest_bytes: u32,
    erg generation: u64,
    erg total_column_count: u32,
    erg active_column_count: u32,
    erg shard_count: u32,
    erg column_stride_bytes: u16,
    erg binding_stride_bytes: u16,
    erg tokenizer_version: u16,
    erg context_version: u16,
    erg code_version: u16,
    erg reserved: u16,
    erg checksum: u64,
}

"""Position-independent location and checksum metadata for one shard."""
open struct ManifestDescriptor {
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg payload_offset: u32,
    erg payload_bytes: u32,
    erg binding_offset: u32,
    erg binding_bytes: u32,
    erg auxiliary_offset: u32,
    erg auxiliary_bytes: u32,
    erg checksum: u64,
    erg state: u32,
}

"""Resolved mapping from one global column index to a shard-local index."""
open struct ColumnLocation {
    erg global_index: u32,
    erg shard_id: u32,
    erg local_index: u32,
}

"""Deterministic allocation result, including whether a shard is created."""
open struct AllocationPlan {
    erg global_index: u32,
    erg shard_id: u32,
    erg local_index: u32,
    erg creates_shard: Bool,
}

"""Bounded plan for loading one dynamic shard and selecting its local column."""
open struct DynamicLoadPlan {
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg local_index: u32,
}

"""Selected manifest slot and generation for recovery or publication."""
open struct ManifestSelection {
    erg slot: u8,
    erg generation: u64,
}

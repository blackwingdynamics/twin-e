"""Public wavefront step orchestration."""
import config;

open slots;

"""Result of one gated step with fixed inline and auxiliary destinations."""
open struct ExtendedImpulseStepResult {
    erg base: ImpulseStepResult,
    erg auxiliary: Array[u32, 8],
    erg auxiliary_count: u8,
}

"""Submit one wavefront to an active source and propagate one bounded impulse.

The caller keeps ownership of `fabric` through the exclusive `ins` loan. The
wavefront is read through `abs`. An out-of-range or inactive source returns
`valid_source == false` and leaves the fabric unchanged. A firing source
evaluates each of its eight configured destinations once. The result contains
the source payload and destination indexes that fired; unconnected or
sub-threshold destinations contain `NULL_INDEX`.
"""
open verb step_wavefront[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    if source_idx >= (N as u32) {
        return result;
    }
    if (fabric.columns[source_idx].flags & FLAG_ACTIVE) == 0u8 {
        return result;
    }
    return evaluate_active_source(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
}

verb empty_step_result() -> ImpulseStepResult {
    return ImpulseStepResult {valid_source: false, source_fired: false, payload: 0u8, destination_0: null_index(
    ), destination_1: null_index(), destination_2: null_index(), destination_3: null_index(), destination_4: null_index(
    ), destination_5: null_index(), destination_6: null_index(), destination_7: null_index()};
}

meta limitless("verb")
verb evaluate_active_source[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    result.valid_source = true;
    erg evaluation: Option[u8] = evaluate_minicolumn_core(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: erg source_idx
    );
    case dat evaluation {
        Option.Some(payload) => {
            result.source_fired = true;
            result.payload = payload;
            erg fired: Array[u32,8] = forward_step_destinations(
                fabric: ins fabric,
                wave: abs wave,
                source_idx: erg source_idx
            );
            result.destination_0 = fired[0];
            result.destination_1 = fired[1];
            result.destination_2 = fired[2];
            result.destination_3 = fired[3];
            result.destination_4 = fired[4];
            result.destination_5 = fired[5];
            result.destination_6 = fired[6];
            result.destination_7 = fired[7];
        },
        Option.None => {},
    };
    return result;
}

meta limitless("verb")
verb forward_step_destinations[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    for erg index: u32 in 0u32 .. 8u32 {
        erg target: u32 = fabric.columns[source_idx].axons[index];
        store_destination(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            index: erg index,
            target: erg target
        );
    }
    return fired;
}

verb empty_auxiliary_destinations() -> Array[u32, 8] {
    erg fired: Array[u32,8] = Array[u32, 8]();
    for erg index: u32 in 0u32 .. 8u32 {
        fired[index] = NULL_INDEX;
    }
    return fired;
}

verb forward_auxiliary_destinations[N: Usize](
    ins fabric: CorticalFabric[N],
    abs table: AuxAxonTable[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_auxiliary_destinations();
    erg record_index: u32 = table.source_to_record[source_idx] as u32;
    erg used_count: u8 = table.records[record_index].used_count;
    for erg index: u32 in 0u32 .. 8u32 {
        if index >= used_count as u32 {
            break;
        }
        erg target: u32 = table.records[record_index].targets[index];
        fired[index] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target
        );
    }
    return fired;
}

"""Run the existing inline step and gate sidecar forwarding by `FLAG_HAS_AUX`."""
open verb step_wavefront_with_aux[N: Usize](
    ins fabric: CorticalFabric[N],
    abs table: AuxAxonTable[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ExtendedImpulseStepResult {
    erg base: ImpulseStepResult = step_wavefront(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
    erg auxiliary: Array[u32,8] = empty_auxiliary_destinations();
    erg auxiliary_count: u8 = 0u8;
    if base.source_fired && (fabric.columns[source_idx].flags & FLAG_HAS_AUX) != 0u8 {
        auxiliary = forward_auxiliary_destinations(
            fabric: ins fabric,
            table: abs table,
            wave: abs wave,
            source_idx: erg source_idx
        );
        erg record_index: u32 = table.source_to_record[source_idx] as u32;
        auxiliary_count = table.records[record_index].used_count;
    }
    return ExtendedImpulseStepResult {base: base, auxiliary: auxiliary, auxiliary_count: auxiliary_count};
}

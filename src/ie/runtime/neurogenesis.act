import config;

"""Allocate and connect a minicolumn for a novel wavefront.

The caller retains ownership of `fabric` through the exclusive `ins` loan and
provides the wavefront through `abs`. On success, `Some(index)` identifies the
seeded and linked column. `None` is returned when the free list is exhausted,
the source index is invalid or inactive, or all eight source axon slots are
occupied; an unsuccessful allocation is reclaimed before returning.
"""
open verb neurogenesis[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    return neurogenesis_core(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: source_idx
    );
}

"""Allocate a novel column and bind its token/context identity atomically."""
open verb neurogenesis_with_binding[N: Usize](
    ins fabric: CorticalFabric[N],
    ins bindings: Array[TokenBinding, N],
    abs wave: Wavefront,
    erg source_idx: u32,
    erg token_id: u32,
    erg context_key: u64
) -> Option[u32] {
    erg allocated = allocate_binding_slot(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: source_idx
    );
    erg result: Option[u32] = Option[u32].None;
    case dat allocated {
        Option.None => {},
        Option.Some(slot) => {
            bindings[slot].token_id = token_id;
            bindings[slot].context_key = context_key;
            bindings[slot].tokenizer_version = TOKENIZER_VERSION;
            bindings[slot].context_version = CONTEXT_VERSION;
            bindings[slot].binding_flags = BINDING_ACTIVE_FLAG;
            result = Option[u32].Some(slot);
        },
    };
    return result;
}

verb allocate_binding_slot[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    erg available: Bool = slot != null_index();
    if !available || slot >= (N as u32) {
        if available {
            free_column(fabric: ins fabric, slot: erg slot);
        }
        return Option[u32].None;
    }
    erg linked: Bool = seed_and_link_binding(
        fabric: ins fabric,
        wave: abs wave,
        source: source_idx,
        slot: slot
    );
    if !linked {
        free_column(fabric: ins fabric, slot: erg slot);
        return Option[u32].None;
    }
    return Option[u32].Some(slot);
}

verb seed_and_link_binding[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source: u32,
    erg slot: u32
) -> Bool {
    erg available: Bool = true;
    seed_column(
        fabric: ins fabric,
        slot: erg slot,
        wave: abs wave
    );
    return link_allocated(
        fabric: ins fabric,
        source: erg source,
        slot: erg slot,
        available: erg available
    );
}

"""Allocate, seed, link, or reclaim one novel minicolumn."""
open verb neurogenesis_core[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    erg has_allocation: Bool = slot != null_index();
    if has_allocation {
        seed_column(
            fabric: ins fabric,
            slot: slot,
            wave: abs wave
        );
    }
    erg linked: Bool = link_allocated(
        fabric: ins fabric,
        source: source_idx,
        slot: slot,
        available: has_allocation
    );
    if has_allocation && !linked {
        free_column(fabric: ins fabric, slot: erg slot);
    }
    erg success: Bool = has_allocation && linked;
    erg result: Option[u32] = Option[u32].None;
    if success {
        result = Option[u32].Some(slot);
    }
    return result;
}

verb seed_column[N: Usize](
    ins fabric: CorticalFabric[N],
    erg slot: u32,
    abs wave: Wavefront
) {
    fabric.columns[slot].threshold = NEUROGENESIS_THRESHOLD;
    fabric.columns[slot].myelination = 1u8;
    fabric.columns[slot].idle_ticks = 0u8;
    fabric.columns[slot].coincidence_low = wave.mask_low;
    fabric.columns[slot].coincidence_high = wave.mask_high;
}

"""Dispatch the first available axon slot to a newly seeded column."""
meta limitless("verb")
verb link_allocated[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg available: Bool
) -> Bool {
    erg link_choice: u32 = choose_link(
        fabric: abs fabric,
        source: source,
        available: available
    );
    if link_choice >= 8u32 {
        return false;
    }
    link_axon(
        fabric: ins fabric,
        source: source,
        slot: link_choice,
        target: slot
    );
    return true;
}

meta limitless("verb")
verb choose_link[N: Usize](
    abs fabric: CorticalFabric[N],
    erg source: u32,
    erg available: Bool
) -> u32 {
    if !available || source >= (N as u32) {
        return 8u32;
    }
    erg index: u32 = 0u32;
    loop {
        if index >= 8u32 {
            break;
        }
        if fabric.columns[source].axons[index] == null_index() {
            return index;
        }
        index += 1u32;
    }
    return 8u32;
}

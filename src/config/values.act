"""Token identity for the bounded follow action."""
open const ACTION_TOKEN_FOLLOW: u32 = 4u32;


"""Token identity for the bounded signal action."""
open const ACTION_TOKEN_SIGNAL: u32 = 5u32;


"""Generation stop reason code for an invalid prompt."""
open const GENERATION_STOP_INVALID_PROMPT: u8 = 5u8;


"""Generation stop reason code for missing context binding."""
open const GENERATION_STOP_MISSING_CONTEXT: u8 = 6u8;



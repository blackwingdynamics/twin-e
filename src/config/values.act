"""Package-wide typed constants for AIE policy and binary formats."""
"""Arena index sentinel used for an unconnected axon, link, or free-list entry."""
open const NULL_INDEX: u32 = 4294967295u32;


"""Bit flag marking a minicolumn as allocated and active in the arena."""
open const FLAG_ACTIVE: u8 = 1u8;


"""Bit flag marking a minicolumn as temporarily inhibited by lateral competition."""
open const FLAG_INHIBITED: u8 = 2u8;


"""Bit flag marking a minicolumn as temporarily unavailable after firing."""
open const FLAG_REFRACTORY: u8 = 4u8;


"""Bit flag protecting a minicolumn from homeostatic decay."""
open const FLAG_CONSOLIDATED: u8 = 8u8;


"""Bit flag marking a minicolumn with one attached auxiliary axon record."""
open const FLAG_HAS_AUX: u8 = 128u8;


"""Empty value in the compact auxiliary source-to-record index."""
open const AUX_AXON_INVALID_ID: u16 = 65535u16;


"""Maximum number of fixed auxiliary records in the first sidecar profile."""
open const AUX_AXON_CAPACITY: u32 = 8u32;


"""Number of extra successor targets in one auxiliary record."""
open const AUX_AXON_TARGET_CAPACITY: u32 = 8u32;


"""Initial coincidence threshold assigned to a newly initialized minicolumn."""
open const DEFAULT_THRESHOLD: u8 = 30u8;


"""Coincidence threshold assigned to a minicolumn created by neurogenesis."""
open const NEUROGENESIS_THRESHOLD: u8 = 20u8;


"""Maximum idle tick count before an eligible weak minicolumn is reclaimed."""
open const DECAY_IDLE_LIMIT: u8 = 240u8;


"""Myelination ceiling below which an idle minicolumn may be reclaimed."""
open const DECAY_MYELINATION_LIMIT: u8 = 100u8;


"""Maximum representable value used for saturating u8 state updates."""
open const MAX_U8: u8 = 255u8;


"""Magic value identifying the fixed `.brain` snapshot format."""
open const BRAIN_MAGIC: u32 = 1095322161u32;


"""Version of the fixed `.brain` snapshot format."""
open const BRAIN_VERSION: u16 = 1u16;


"""Serialized byte length of the fixed `.brain` header."""
open const BRAIN_HEADER_BYTES: u16 = 12u16;


"""Serialized byte length reserved for the fixed fabric payload."""
open const BRAIN_PAYLOAD_BYTES: u32 = 4096u32;


"""Version of the fixed token-binding snapshot section."""
open const BRAIN_BINDING_VERSION: u16 = 1u16;


"""Serialized byte stride of one fixed token binding."""
open const BRAIN_BINDING_STRIDE_BYTES: u16 = 24u16;


"""Number of token-binding slots in the fixed snapshot."""
open const BRAIN_BINDING_COUNT: u32 = 64u32;


"""Serialized byte length of the fixed token-binding section."""
open const BRAIN_BINDING_PAYLOAD_BYTES: u32 = 1536u32;


"""Version of the fixed auxiliary fan-out snapshot section."""
open const BRAIN_AUXILIARY_VERSION: u16 = 1u16;


"""Serialized byte length of the auxiliary source directory."""
open const BRAIN_AUXILIARY_SOURCE_MAP_BYTES: u32 = 128u32;


"""Serialized byte stride of one auxiliary fan-out record."""
open const BRAIN_AUXILIARY_RECORD_STRIDE_BYTES: u16 = 40u16;


"""Serialized count of auxiliary fan-out records."""
open const BRAIN_AUXILIARY_RECORD_COUNT: u32 = 8u32;


"""Serialized byte length of all auxiliary fan-out records."""
open const BRAIN_AUXILIARY_RECORD_PAYLOAD_BYTES: u32 = 320u32;


"""Serialized byte length of auxiliary directory, records, and metadata."""
open const BRAIN_AUXILIARY_PAYLOAD_BYTES: u32 = 456u32;


"""Magic value identifying the combined fabric and binding `.brain` file."""
open const BRAIN_TEXT_MAGIC: u32 = 1414482256u32;


"""Version of the combined fabric and binding `.brain` file."""
open const BRAIN_TEXT_VERSION: u16 = 1u16;


"""Serialized byte length of the combined `.brain` file header."""
open const BRAIN_TEXT_HEADER_BYTES: u32 = 32u32;


"""Serialized byte length of one complete fixed fabric section."""
open const BRAIN_TEXT_FABRIC_BYTES: u32 = 4116u32;


"""Serialized byte length of one complete binding section."""
open const BRAIN_TEXT_BINDING_BYTES: u32 = 1554u32;


"""Serialized byte length of the combined `.brain` file."""
open const BRAIN_TEXT_TOTAL_BYTES: u32 = BRAIN_TEXT_HEADER_BYTES + BRAIN_TEXT_FABRIC_BYTES + BRAIN_TEXT_BINDING_BYTES;


"""Serialized byte length of the fixed vocabulary artifact section."""
open const BRAIN_TEXT_VOCABULARY_BYTES: u32 = 5404u32;


"""Version of the combined `.brain` format that includes vocabulary data."""
open const BRAIN_TEXT_VOCABULARY_VERSION: u16 = 2u16;


"""Serialized byte length of a combined `.brain` file with vocabulary."""
open const BRAIN_TEXT_VOCABULARY_TOTAL_BYTES: u32 = BRAIN_TEXT_TOTAL_BYTES + BRAIN_TEXT_VOCABULARY_BYTES;


"""Binding flag indicating that a token-binding slot contains live metadata."""
open const BINDING_ACTIVE_FLAG: u8 = 1u8;


"""Version marker required for compatible tokenizer metadata."""
open const TOKENIZER_VERSION: u16 = 1u16;


"""Maximum input byte capacity for bounded tokenization."""
open const TOKENIZER_MAX_BYTES: u32 = 256u32;


"""Maximum number of merge rules in a bounded BPE vocabulary."""
open const BPE_MAX_RULES: u32 = 128u32;


"""Maximum number of tokens in a bounded token sequence."""
open const BPE_MAX_TOKENS: u32 = 256u32;


"""Maximum byte width of one vocabulary token."""
open const BPE_MAX_TOKEN_BYTES: u32 = 8u32;


"""Magic value identifying the serialized BPE vocabulary format."""
open const BPE_VOCAB_MAGIC: u32 = 1111577410u32;


"""Version of the serialized BPE vocabulary format."""
open const BPE_VOCAB_VERSION: u16 = 1u16;


"""Reserved token identifier for beginning-of-sequence output."""
open const BPE_BOS_TOKEN_ID: u32 = 4294967280u32;


"""Reserved token identifier for end-of-sequence output."""
open const BPE_EOS_TOKEN_ID: u32 = 4294967281u32;


"""Reserved token identifier for unknown vocabulary entries."""
open const BPE_UNKNOWN_TOKEN_ID: u32 = 4294967282u32;


"""Version marker for sparse token-code generation."""
open const TOKEN_CODE_VERSION: u16 = 1u16;


"""Required number of active bits in each sparse token code."""
open const TOKEN_CODE_ACTIVE_BITS: u8 = 12u8;


"""Integer seed used by deterministic sparse token-code generation."""
open const TOKEN_CODE_SEED: u64 = 11400714819323198485u64;


"""Version marker for previous-token context binding."""
open const CONTEXT_VERSION: u16 = 1u16;


"""Number of token positions retained by the bounded context encoder."""
open const CONTEXT_WINDOW: u8 = 2u8;


"""Initial integer seed for deterministic context hashing."""
open const CONTEXT_SEED: u64 = 1099511628211u64;


"""Integer multiplier used by deterministic context hashing."""
open const CONTEXT_MULTIPLIER: u64 = 1099511628211u64;


"""Version marker for the bounded teaching request contract."""
open const TEACHING_CONTRACT_VERSION: u16 = 1u16;


"""Maximum replay passes accepted by one teaching request."""
open const TEACHING_MAX_REPLAY_PASSES: u16 = 16u16;


open const TEACHING_MAX_BATCH_ITEMS: u16 = 8u16;


"""Byte length of the bounded teaching file magic and version header."""
open const TEACHING_FILE_HEADER_BYTES: u32 = 5u32;


"""Maximum UTF-8 payload bytes in one offline teaching file record."""
open const TEACHING_FILE_MAX_RECORD_BYTES: u32 = 256u32;


"""Maximum length-delimited records accepted in one teaching file."""
open const TEACHING_FILE_MAX_RECORDS: u16 = 8u16;


"""Maximum complete byte length accepted for one offline teaching file."""
open const TEACHING_FILE_MAX_BYTES: u32 = 2069u32;


"""Version marker for the bounded modality-neutral observation contract."""
open const OBSERVATION_VERSION: u16 = 1u16;


"""Maximum integer magnitude accepted in one observation value field."""
open const OBSERVATION_MAX_VALUE: u16 = 4095u16;


"""Initial integer seed for deterministic observation encoding."""
open const OBSERVATION_SEED: u64 = 1469598103934665603u64;


"""Mask used to project an observation hash into the bounded token ID domain."""
open const OBSERVATION_TOKEN_MASK: u64 = 4294967295u64;


"""Magic value identifying one serialized observation event."""
open const OBSERVATION_SNAPSHOT_MAGIC: u32 = 1330595153u32;


"""Version of the fixed serialized observation event format."""
open const OBSERVATION_SNAPSHOT_VERSION: u16 = 1u16;


"""Total byte length of one serialized observation event."""
open const OBSERVATION_SNAPSHOT_BYTES: u16 = 20u16;


"""Version marker for the common modality adapter envelope contract."""
open const ADAPTER_CONTRACT_VERSION: u16 = 1u16;


"""Maximum number of normalized events in one adapter envelope."""
open const ADAPTER_MAX_EVENTS: u32 = 256u32;


"""Maximum combined events admitted by one cross-modality teaching pair."""
open const TEACHING_MAX_ASSOCIATION_EVENTS: u16 = 16u16;


"""Feature discriminator for one byte-token text event."""
open const ADAPTER_TEXT_BYTE_FEATURE: u16 = 1u16;


"""Feature discriminator for one merged BPE text event."""
open const ADAPTER_TEXT_BPE_FEATURE: u16 = 2u16;


"""Feature discriminator for one structured integer field event."""
open const ADAPTER_STRUCTURED_FIELD_FEATURE: u16 = 3u16;


"""Feature discriminator for one opaque binary byte event."""
open const ADAPTER_BINARY_BYTE_FEATURE: u16 = 4u16;


"""Maximum number of fields in one structured adapter record."""
open const ADAPTER_STRUCTURED_MAX_FIELDS: u32 = 32u32;


"""Maximum image width admitted by the future patch-event envelope."""
open const ADAPTER_IMAGE_MAX_WIDTH: u16 = 64u16;


"""Maximum image height admitted by the future patch-event envelope."""
open const ADAPTER_IMAGE_MAX_HEIGHT: u16 = 64u16;


"""Maximum image channel count admitted by the future envelope."""
open const ADAPTER_IMAGE_MAX_CHANNELS: u8 = 4u8;


"""Maximum quantized image value represented by one integer feature."""
open const ADAPTER_IMAGE_MAX_QUANTIZED_VALUE: u16 = 255u16;


"""Maximum audio samples in one future integer feature window."""
open const ADAPTER_AUDIO_MAX_WINDOW_SAMPLES: u32 = 4096u32;


"""Maximum audio channel count admitted by the future envelope."""
open const ADAPTER_AUDIO_MAX_CHANNELS: u8 = 2u8;


"""Maximum normalized audio feature value in the future envelope."""
open const ADAPTER_AUDIO_MAX_FEATURE_VALUE: u16 = 4095u16;


"""Maximum video frames in one future bounded temporal envelope."""
open const ADAPTER_VIDEO_MAX_FRAMES: u16 = 16u16;


"""Maximum video width admitted by the future frame envelope."""
open const ADAPTER_VIDEO_MAX_WIDTH: u16 = 64u16;


"""Maximum video height admitted by the future frame envelope."""
open const ADAPTER_VIDEO_MAX_HEIGHT: u16 = 64u16;


"""Maximum video channel count admitted by the future frame envelope."""
open const ADAPTER_VIDEO_MAX_CHANNELS: u8 = 4u8;


"""Feature discriminator for one quantized image event."""
open const ADAPTER_IMAGE_FEATURE: u16 = 5u16;


"""Feature discriminator for one integer audio event."""
open const ADAPTER_AUDIO_FEATURE: u16 = 6u16;


"""Feature discriminator for one sparse video event."""
open const ADAPTER_VIDEO_FEATURE: u16 = 7u16;


"""Maximum number of generated token ids retained for loop guards."""
open const GENERATION_HISTORY_LIMIT: u32 = 8u32;


"""Generation stop reason code for an end-of-sequence token."""
open const GENERATION_STOP_EOS: u8 = 1u8;


"""Generation stop reason code for reaching the output limit."""

open const BRAIN_MANIFEST_VERSION: u16 = 1u16;


"""Serialized byte length of a manifest header."""
open const BRAIN_MANIFEST_HEADER_BYTES: u16 = 64u16;


"""Serialized byte length of one manifest shard descriptor."""
open const BRAIN_MANIFEST_DESCRIPTOR_BYTES: u16 = 48u16;


"""Number of descriptors in the fixed two-shard manifest."""
open const BRAIN_MANIFEST_SHARD_COUNT: u32 = 2u32;



"""Generation stop reason code for repetition protection."""
open const GENERATION_STOP_LOOP_GUARD: u8 = 4u8;


"""Token identity for the bounded stop action."""
open const ACTION_TOKEN_STOP: u32 = 1u32;


"""Token identity for the bounded move action."""
open const ACTION_TOKEN_MOVE: u32 = 2u32;


"""Token identity for the bounded turn action."""

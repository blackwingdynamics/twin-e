import config;

"""Versioned 128-bit sparse code assigned to one tokenizer token.

The two masks form a fixed integer SDR, `active_bits` records the selected
population, and `version` identifies the codebook profile. The value is inline
and position-independent.
"""
open struct TokenCode {
    erg mask_low: u64,
    erg mask_high: u64,
    erg active_bits: u8,
    erg version: u16,
}

verb mix_token_state(erg state: u64) -> u64 {
    state ^= state << 13u8;
    state ^= state >> 7u8;
    state ^= state << 17u8;
    return state;
}

"""Encode one token ID into a deterministic 128-bit sparse code.

This is the initial integer-only codebook profile. Its collision behavior must
be measured before it is used as the final subword profile.
"""
verb encode_state(erg state: u64) -> TokenCode {
    erg mask_low: u64 = 0u64;
    erg mask_high: u64 = 0u64;
    erg selected_bits: u8 = 0u8;
    loop {
        if selected_bits >= TOKEN_CODE_ACTIVE_BITS {
            break;
        }
        state = mix_token_state(erg state);
        erg slot: u8 = (state & 127u64) as u8;
        if slot < 64u8 {
            erg low_bit_mask: u64 = 1u64 << slot;
            if (mask_low & low_bit_mask) == 0u64 {
                mask_low |= low_bit_mask;
                selected_bits += 1u8;
            }
        } else {
            erg high_bit_mask: u64 = 1u64 << (slot - 64u8);
            if (mask_high & high_bit_mask) == 0u64 {
                mask_high |= high_bit_mask;
                selected_bits += 1u8;
            }
        }
    }
    return TokenCode {mask_low: mask_low, mask_high: mask_high, active_bits: TOKEN_CODE_ACTIVE_BITS, version: TOKEN_CODE_VERSION};
}

"""Encode one token ID into the versioned sparse codebook.

The token ID is read through its fixed-width `erg` binding and deterministically
mapped to a 128-bit integer mask with the configured active-bit count. The
operation allocates no memory and performs no floating-point work.
"""
open verb encode_token_id(erg token_id: u32) -> TokenCode {
    erg state: u64 = (token_id as u64) ^ TOKEN_CODE_SEED;
    return encode_state(erg state);
}

"""Encode a context key using the same versioned sparse profile.

The key is mixed as an integer and returned as a fixed `TokenCode`. The output
keeps the configured active-bit count and codebook version, with no allocation,
pointer, or floating-point dependency.
"""
open verb encode_context_key(erg context_key: u64) -> TokenCode {
    erg state: u64 = context_key ^ TOKEN_CODE_SEED;
    return encode_state(erg state);
}

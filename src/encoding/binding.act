"""Position-independent token and context identity stored beside an arena slot.

The inline 24-byte little-endian layout contains token identity, context key,
version markers, and binding state. It contains no pointer or dynamic storage,
so it can be serialized beside the owning shard.
"""
open pack TokenBinding {
    erg storage: Array[u8, 24];
    layout little;
    fields {
        erg token_id: u32 at 0;
        erg alignment_reserved: u32 at 32;
        erg context_key: u64 at 64;
        erg tokenizer_version: u16 at 128;
        erg context_version: u16 at 144;
        erg binding_flags: u8 at 160;
        erg trailing_reserved_0: u8 at 168;
        erg trailing_reserved_1: u8 at 176;
        erg trailing_reserved_2: u8 at 184;
    }
}

"""Return the fixed serialized width of one token binding.

The result is the byte stride used by binding snapshots and shard-local
binding sections. The operation has no mutation, allocation, or failure path.
"""
open verb token_binding_size_bytes() -> u32 {
    return 24u32;
}

"""Attach one token and context identity to a bounded arena slot.

The binding array receives an exclusive `ins` loan. The slot must be within
the configured binding count; invalid slots return `false` without mutation.
Valid bindings receive current tokenizer/context versions and the active flag.
"""
open verb bind_token_context(
    ins bindings: Array[TokenBinding, 64],
    erg slot: u32,
    erg token_id: u32,
    erg context_key: u64
) -> Bool {
    if slot >= BRAIN_BINDING_COUNT {
        return false;
    }
    bindings[slot].token_id = token_id;
    bindings[slot].context_key = context_key;
    bindings[slot].tokenizer_version = TOKENIZER_VERSION;
    bindings[slot].context_version = CONTEXT_VERSION;
    bindings[slot].binding_flags = BINDING_ACTIVE_FLAG;
    return true;
}

"""Find an active slot matching one token and context identity.

The binding array is read through `abs`. Version markers and the active flag
must match the current configuration; a miss returns `Option.None` without
mutating the binding array.
"""
open verb lookup_token_context(
    abs bindings: Array[TokenBinding, 64],
    erg token_id: u32,
    erg context_key: u64
) -> Option[u32] {
    for erg slot: u32 in 0u32 .. BRAIN_BINDING_COUNT {
        if bindings[slot].binding_flags == BINDING_ACTIVE_FLAG && bindings[slot].token_id == token_id && bindings[slot].context_key == context_key && bindings[slot].tokenizer_version == TOKENIZER_VERSION && bindings[slot].context_version == CONTEXT_VERSION {
            return Option[u32].Some(slot);
        }
    }
    return Option[u32].None;
}

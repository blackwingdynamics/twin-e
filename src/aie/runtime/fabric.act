"""Bounded ownership and free-list management for cortical minicolumns."""
verb fabric_none_u32() -> Option[u32] {
    erg value: Option[u32] = Option[u32].None;
    return value;
}

verb fabric_some_u32(abs value: u32) -> Option[u32] {
    erg result: Option[u32] = Option[u32].Some(value);
    return result;
}

open verb link_axon_0[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg target: u32
) -> u32 {
    fabric.columns[source].axon_0 = target;
    return 0u32;
}

open verb link_axon_1[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg target: u32

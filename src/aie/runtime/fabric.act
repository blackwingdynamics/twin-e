open verb empty_fired_destinations() -> Array[u32, 8] {
    erg fired: Array[u32,8] = Array[u32, 8]();
    erg i: u32 = 0u32;
    loop {
        if i >= 8u32 {
            break;
        }
        fired[i] = null_index();
        i += 1u32;
    }
    return fired;
}

open verb fabric_init[N: Usize](ins fabric: CorticalFabric[N]) -> Void {
    fabric_init_core(fabric: ins fabric);
}

meta limitless("verb")
verb fabric_init_core[N: Usize](ins fabric: CorticalFabric[N]) {
    erg i: u32 = 0u32;
    loop {
        if i >= (N as u32) {
            break;
        }
        fabric.columns[i].charge = 0u8;
        fabric.columns[i].threshold = 30u8;
        fabric.columns[i].myelination = 0u8;
        fabric.columns[i].idle_ticks = 0u8;
        fabric.columns[i].flags = 0u8;
        fabric.columns[i].payload = 0u8;
        fabric.columns[i].layer_depth = 0u16;
        fabric.columns[i].coincidence_low = 0u64;
        fabric.columns[i].coincidence_high = 0u64;
        fabric.columns[i].axon_0 = null_index();
        fabric.columns[i].axon_1 = null_index();
        fabric.columns[i].axon_2 = null_index();
        fabric.columns[i].axon_3 = null_index();
        fabric.columns[i].axon_4 = null_index();
        fabric.columns[i].axon_5 = null_index();
        fabric.columns[i].axon_6 = null_index();
        fabric.columns[i].axon_7 = null_index();
        fabric.columns[i].inhibitory_link = null_index();
        if i + 1u32 < (N as u32) {
            fabric.columns[i].free_list_link = (i as u32) + 1u32;
        } else {
            fabric.columns[i].free_list_link = null_index();
        }
        i += 1u32;
    }
    fabric.free_list_head = 0u32;
    fabric.active_count = 0u32;
}

open verb allocate_column[N: Usize](ins fabric: CorticalFabric[N]) -> Option[u32] {
    erg slot: u32 = 0u32;
    erg available: Bool = fabric.free_list_head != null_index();
    if available {
        slot = fabric.free_list_head;
        fabric.free_list_head = fabric.columns[slot].free_list_link;
        fabric.columns[slot].free_list_link = null_index();
        fabric.columns[slot].flags = 1u8;
        fabric.active_count += 1u32;
    }
    erg result: Option[u32] = Option[u32].None;
    if available {
        result = Option[u32].Some(slot);
    }
    return result;
}

open verb allocate_column_index[N: Usize](ins fabric: CorticalFabric[N]) -> u32 {
    erg slot: u32 = null_index();
    erg available: Bool = fabric.free_list_head != null_index();
    if available {
        slot = fabric.free_list_head;
        fabric.free_list_head = fabric.columns[slot].free_list_link;
        fabric.columns[slot].free_list_link = null_index();
        fabric.columns[slot].flags = 1u8;
        fabric.active_count += 1u32;
    }
    return slot;
}

open verb free_column[N: Usize](ins fabric: CorticalFabric[N], erg slot: u32) -> Void {
    if slot >= (N as u32) {
        return;
    }
    fabric.columns[slot].flags = 0u8;
    fabric.columns[slot].charge = 0u8;
    fabric.columns[slot].threshold = 0u8;
    fabric.columns[slot].myelination = 0u8;
    fabric.columns[slot].idle_ticks = 0u8;
    fabric.columns[slot].payload = 0u8;
    fabric.columns[slot].layer_depth = 0u16;
    fabric.columns[slot].coincidence_low = 0u64;
    fabric.columns[slot].coincidence_high = 0u64;
    fabric.columns[slot].axon_0 = null_index();
    fabric.columns[slot].axon_1 = null_index();
    fabric.columns[slot].axon_2 = null_index();
    fabric.columns[slot].axon_3 = null_index();
    fabric.columns[slot].axon_4 = null_index();
    fabric.columns[slot].axon_5 = null_index();
    fabric.columns[slot].axon_6 = null_index();
    fabric.columns[slot].axon_7 = null_index();
    fabric.columns[slot].inhibitory_link = null_index();
    fabric.columns[slot].free_list_link = fabric.free_list_head;
    fabric.free_list_head = slot;
    if fabric.active_count > 0u32 {
        fabric.active_count -= 1u32;
    }
}

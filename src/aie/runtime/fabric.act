import config;

"""Bounded ownership and free-list management for cortical minicolumns."""
verb fabric_none_u32() -> Option[u32] {
    erg value: Option[u32] = Option[u32].None;
    return value;
}

verb fabric_some_u32(abs value: u32) -> Option[u32] {
    erg result: Option[u32] = Option[u32].Some(value);
    return result;
}

"""Write one destination into the packed indexed axon array.

Inputs use an exclusive `ins` loan for `fabric`; `source` selects a column,
`slot` must be in `0..8`, and `target` is a column index or `null_index()`.
Invalid source or slot indexes are ignored and return `0u32`. The operation
does not allocate memory or perform I/O.
"""
open verb link_axon[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg target: u32
) -> u32 {
    if source >= (N as u32) || slot >= 8u32 {
        return 0u32;
    }
    fabric.columns[source].axons[slot] = target;
    return 0u32;
}

"""Create an empty result for one eight-slot forwarding operation.

Every returned element is initialized to `null_index()`, which distinguishes
an unconnected or non-firing destination from a valid arena index. The helper
allocates only the fixed inline array value and cannot fail.
"""
open verb empty_fired_destinations() -> Array[u32, 8] {
    erg fired: Array[u32,8] = Array[u32, 8]();
    for erg i: u32 in 0u32 .. 8u32 {
        fired[i] = null_index();
    }
    return fired;
}

"""Initialize the complete arena and rebuild its contiguous free-list.

The exclusive `ins` loan is mutated in place. Every column receives default
threshold and empty state, all indexed axons and links become null, and the
free-list is chained in ascending index order. Existing arena contents are
discarded by design; the operation performs no disk I/O.
"""
open verb fabric_init[N: Usize](ins fabric: CorticalFabric[N]) -> Void {
    fabric_init_core(fabric: ins fabric);
}

meta limitless("verb")
verb fabric_init_core[N: Usize](ins fabric: CorticalFabric[N]) {
    erg i: u32 = 0u32;
    loop {
        if i >= (N as u32) {
            break;
        }
        fabric.columns[i].charge = 0u8;
        fabric.columns[i].threshold = DEFAULT_THRESHOLD;
        fabric.columns[i].myelination = 0u8;
        fabric.columns[i].idle_ticks = 0u8;
        fabric.columns[i].flags = 0u8;
        fabric.columns[i].payload = 0u8;
        fabric.columns[i].layer_depth = 0u16;
        fabric.columns[i].coincidence_low = 0u64;
        fabric.columns[i].coincidence_high = 0u64;
        erg axon_index: u32 = 0u32;
        loop {
            if axon_index >= 8u32 {
                break;
            }
            fabric.columns[i].axons[axon_index] = null_index();
            axon_index += 1u32;
        }
        fabric.columns[i].inhibitory_link = null_index();
        if i + 1u32 < (N as u32) {
            fabric.columns[i].free_list_link = (i as u32) + 1u32;
        } else {
            fabric.columns[i].free_list_link = null_index();
        }
        i += 1u32;
    }
    fabric.free_list_head = 0u32;
    fabric.active_count = 0u32;
}

"""Allocate the free-list head and return it as an optional index.

The exclusive `ins` loan advances the free-list, clears the returned link,
marks the column active, and increments `active_count`. Exhaustion returns
`Option.None` without changing the arena.
"""
open verb allocate_column[N: Usize](ins fabric: CorticalFabric[N]) -> Option[u32] {
    erg slot: u32 = 0u32;
    erg available: Bool = fabric.free_list_head != null_index();
    if available {
        slot = fabric.free_list_head;
        fabric.free_list_head = fabric.columns[slot].free_list_link;
        fabric.columns[slot].free_list_link = null_index();
        fabric.columns[slot].flags = FLAG_ACTIVE;
        fabric.active_count += 1u32;
    }
    erg result: Option[u32] = Option[u32].None;
    if available {
        result = Option[u32].Some(slot);
    }
    return result;
}

"""Allocate one slot and return a raw index for low-level runtime paths.

The exclusive `ins` loan performs the same free-list transition as
`allocate_column`. When no slot exists, the function returns `null_index()`
and leaves the arena unchanged.
"""
open verb allocate_column_index[N: Usize](ins fabric: CorticalFabric[N]) -> u32 {
    erg slot: u32 = null_index();
    erg available: Bool = fabric.free_list_head != null_index();
    if available {
        slot = fabric.free_list_head;
        fabric.free_list_head = fabric.columns[slot].free_list_link;
        fabric.columns[slot].free_list_link = null_index();
        fabric.columns[slot].flags = FLAG_ACTIVE;
        fabric.active_count += 1u32;
    }
    return slot;
}

"""Decommission one column and return its slot to the free-list.

The exclusive `ins` loan clears scalar state, all eight indexed axons, and
links before pushing the slot at the free-list head. An out-of-range slot is
ignored. `active_count` is decremented only when it is nonzero, preventing
underflow during recovery or repeated cleanup.
"""
open verb free_column[N: Usize](ins fabric: CorticalFabric[N], erg slot: u32) -> Void {
    if slot >= (N as u32) {
        return;
    }
    fabric.columns[slot].flags = 0u8;
    fabric.columns[slot].charge = 0u8;
    fabric.columns[slot].threshold = 0u8;
    fabric.columns[slot].myelination = 0u8;
    fabric.columns[slot].idle_ticks = 0u8;
    fabric.columns[slot].payload = 0u8;
    fabric.columns[slot].layer_depth = 0u16;
    fabric.columns[slot].coincidence_low = 0u64;
    fabric.columns[slot].coincidence_high = 0u64;
    erg axon_index: u32 = 0u32;
    loop {
        if axon_index >= 8u32 {
            break;
        }
        fabric.columns[slot].axons[axon_index] = null_index();
        axon_index += 1u32;
    }
    fabric.columns[slot].inhibitory_link = null_index();
    fabric.columns[slot].free_list_link = fabric.free_list_head;
    fabric.free_list_head = slot;
    if fabric.active_count > 0u32 {
        fabric.active_count -= 1u32;
    }
}

import config;

"""Allocate and connect a minicolumn for a novel wavefront.

The caller retains ownership of `fabric` through the exclusive `ins` loan and
provides the wavefront through `abs`. On success, `Some(index)` identifies the
seeded and linked column. `None` is returned when the free list is exhausted,
the source index is invalid or inactive, or all eight source axon slots are
occupied; an unsuccessful allocation is reclaimed before returning.
"""
open verb neurogenesis[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    return neurogenesis_core(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: source_idx
    );
}

"""Allocate a novel column and bind its token/context identity atomically."""
open verb neurogenesis_with_binding[N: Usize](
    ins fabric: CorticalFabric[N],
    ins bindings: Array[TokenBinding, 64],
    abs wave: Wavefront,
    erg source_idx: u32,
    erg token_id: u32,
    erg context_key: u64
) -> Option[u32] {
    erg allocated = allocate_binding_slot(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: source_idx
    );
    erg result: Option[u32] = Option[u32].None;
    case dat allocated {
        Option.None => {},
        Option.Some(slot) => {
            bind_token_context(
                bindings: ins bindings,
                slot: slot,
                token_id: token_id,
                context_key: context_key
            );
            result = Option[u32].Some(slot);
        },
    };
    return result;
}

verb allocate_binding_slot[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    erg available: Bool = slot != null_index();
    if !available || slot >= BRAIN_BINDING_COUNT {
        if available {
            free_column(fabric: ins fabric, slot: erg slot);
        }
        return Option[u32].None;
    }
    seed_column(fabric: ins fabric, slot: erg slot, wave: abs wave);
    erg link_available: Bool = true;
    erg linked: Bool = link_allocated(
        fabric: ins fabric,
        source: source_idx,
        slot: slot,
        available: erg link_available
    );
    if !linked {
        free_column(fabric: ins fabric, slot: erg slot);
        return Option[u32].None;
    }
    return Option[u32].Some(slot);
}

"""Allocate, seed, link, or reclaim one novel minicolumn."""
open verb neurogenesis_core[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    erg has_allocation: Bool = slot != null_index();
    if has_allocation {
        seed_column(
            fabric: ins fabric,
            slot: slot,
            wave: abs wave
        );
    }
    erg linked: Bool = link_allocated(
        fabric: ins fabric,
        source: source_idx,
        slot: slot,
        available: has_allocation
    );
    if has_allocation && !linked {
        free_column(fabric: ins fabric, slot: erg slot);
    }
    erg success: Bool = has_allocation && linked;
    erg result: Option[u32] = Option[u32].None;
    if success {
        result = Option[u32].Some(slot);
    }
    return result;
}

verb seed_column[N: Usize](
    ins fabric: CorticalFabric[N],
    erg slot: u32,
    abs wave: Wavefront
) {
    fabric.columns[slot].threshold = NEUROGENESIS_THRESHOLD;
    fabric.columns[slot].myelination = 1u8;
    fabric.columns[slot].idle_ticks = 0u8;
    fabric.columns[slot].coincidence_low = wave.mask_low;
    fabric.columns[slot].coincidence_high = wave.mask_high;
}

"""Dispatch the first available axon slot to a newly seeded column."""
meta limitless("verb")
verb link_allocated[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg available: Bool
) -> Bool {
    erg link_choice: u32 = choose_link(
        fabric: abs fabric,
        source: source,
        available: available
    );
    if link_choice < 4u32 {
        return link_first_four(
            fabric: ins fabric,
            source: source,
            slot: slot,
            link_choice: link_choice
        );
    } else {
        return link_last_four(
            fabric: ins fabric,
            source: source,
            slot: slot,
            link_choice: link_choice
        );
    }
    return false;
}

meta limitless("verb")
verb link_first_four[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg link_choice: u32
) -> Bool {
    erg dispatched_low: u32 = case true {
        true if link_choice == 0u32 => link_axon_0(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 1u32 => link_axon_1(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 2u32 => link_axon_2(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 3u32 => link_axon_3(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        _ => 0u32,
    };
    return link_choice < 4u32;
}

meta limitless("verb")
verb link_last_four[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg link_choice: u32
) -> Bool {
    erg dispatched_high: u32 = case true {
        true if link_choice == 4u32 => link_axon_4(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 5u32 => link_axon_5(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 6u32 => link_axon_6(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 7u32 => link_axon_7(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        _ => 0u32,
    };
    return link_choice < 8u32;
}

meta limitless("verb")
verb choose_link[N: Usize](
    abs fabric: CorticalFabric[N],
    erg source: u32,
    erg available: Bool
) -> u32 {
    erg zero: u32 = 0u32;
    erg one: u32 = 1u32;
    erg two: u32 = 2u32;
    erg three: u32 = 3u32;
    erg four: u32 = 4u32;
    erg five: u32 = 5u32;
    erg six: u32 = 6u32;
    erg seven: u32 = 7u32;
    erg eight: u32 = 8u32;
    erg empty: u32 = null_index();
    return case true {
        true if available && source < (N as u32) && fabric.columns[source].axon_0 == empty => zero,
        true if available && source < (N as u32) && fabric.columns[source].axon_1 == empty => one,
        true if available && source < (N as u32) && fabric.columns[source].axon_2 == empty => two,
        true if available && source < (N as u32) && fabric.columns[source].axon_3 == empty => three,
        true if available && source < (N as u32) && fabric.columns[source].axon_4 == empty => four,
        true if available && source < (N as u32) && fabric.columns[source].axon_5 == empty => five,
        true if available && source < (N as u32) && fabric.columns[source].axon_6 == empty => six,
        true if available && source < (N as u32) && fabric.columns[source].axon_7 == empty => seven,
        _ => eight,
    };
}

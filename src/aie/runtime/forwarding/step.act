"""Public wavefront step orchestration."""
import config;

open slots;

"""Submit one wavefront to an active source and propagate one bounded impulse.

The caller keeps ownership of `fabric` through the exclusive `ins` loan. The
wavefront is read through `abs`. An out-of-range or inactive source returns
`valid_source == false` and leaves the fabric unchanged. A firing source
evaluates each of its eight configured destinations once. The result contains
the source payload and destination indexes that fired; unconnected or
sub-threshold destinations contain `NULL_INDEX`.
"""
open verb step_wavefront[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    if source_idx >= (N as u32) {
        return result;
    }
    if (fabric.columns[source_idx].flags & FLAG_ACTIVE) == 0u8 {
        return result;
    }
    return evaluate_active_source(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
}

verb empty_step_result() -> ImpulseStepResult {
    return ImpulseStepResult {valid_source: false, source_fired: false, payload: 0u8, destination_0: null_index(
    ), destination_1: null_index(), destination_2: null_index(), destination_3: null_index(), destination_4: null_index(
    ), destination_5: null_index(), destination_6: null_index(), destination_7: null_index()};
}

meta limitless("verb")
verb evaluate_active_source[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    result.valid_source = true;
    erg evaluation: Option[u8] = evaluate_minicolumn_core(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: erg source_idx
    );
    case dat evaluation {
        Option.Some(payload) => {
            result.source_fired = true;
            result.payload = payload;
            erg fired: Array[u32,8] = forward_step_destinations(
                fabric: ins fabric,
                wave: abs wave,
                source_idx: erg source_idx
            );
            result.destination_0 = fired[0];
            result.destination_1 = fired[1];
            result.destination_2 = fired[2];
            result.destination_3 = fired[3];
            result.destination_4 = fired[4];
            result.destination_5 = fired[5];
            result.destination_6 = fired[6];
            result.destination_7 = fired[7];
        },
        Option.None => {},
    };
    return result;
}

meta limitless("verb")
verb forward_step_destinations[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    erg index: u32 = 0u32;
    loop {
        if index >= 8u32 {
            break;
        }
        erg target: u32 = fabric.columns[source_idx].axons[index];
        store_destination(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            index: erg index,
            target: erg target
        );
        index += 1u32;
    }
    return fired;
}

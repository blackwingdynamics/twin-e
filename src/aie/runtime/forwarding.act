meta limitless("file")


"""Forwarding retains the eight-slot implementation and public step boundary."""
import config;

"""Propagate fired impulses across the eight fixed axon slots."""
"""Deterministic result returned by one public engine step."""
open struct ImpulseStepResult {
    erg valid_source: Bool,
    erg source_fired: Bool,
    erg payload: u8,
    erg destination_0: u32,
    erg destination_1: u32,
    erg destination_2: u32,
    erg destination_3: u32,
    erg destination_4: u32,
    erg destination_5: u32,
    erg destination_6: u32,
    erg destination_7: u32,
}

open verb store_destination[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg index: u32,
    erg target: u32
) -> u32 {
    if target == null_index() {
        fired[index] = null_index();
        return 0u32;
    }
    erg evaluation: Option[u8] = evaluate_minicolumn_core(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: target
    );
    fired[index] = case dat evaluation {
        Option.Some(_) => target,
        Option.None => null_index(),
    };
    return 0u32;
}

"""Evaluate all eight fixed axon destinations from one source column."""
verb forward_one[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg target: u32
) -> u32 {
    erg evaluation: Option[u8] = evaluate_minicolumn(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: erg target
    );
    return case dat evaluation {
        Option.Some(_) => target,
        Option.None => null_index(),
    };
}

verb forward_slot_0[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_0;
    fired[0] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_1[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_1;
    fired[1] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_2[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_2;
    fired[2] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_3[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_3;
    fired[3] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_4[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_4;
    fired[4] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_5[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_5;
    fired[5] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_6[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_6;
    fired[6] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

verb forward_slot_7[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    erg target: u32 = fabric.columns[source_idx].axon_7;
    fired[7] = forward_one(
        fabric: ins fabric,
        wave: abs wave,
        target: erg target
    );
}

meta limitless("verb")
verb forward_group_a[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    forward_slot_0(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_1(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_2(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_3(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
}

meta limitless("verb")
verb forward_group_b[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    forward_slot_4(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_5(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_6(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_7(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
}

open verb forward_impulse[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    if source_idx < (N as u32) {
        forward_group_a(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            source_idx: erg source_idx
        );
        forward_group_b(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            source_idx: erg source_idx
        );
    }
    return fired;
}

"""Submit one wavefront to an active source and propagate one bounded impulse.

The caller keeps ownership of `fabric` through the exclusive `ins` loan. The
wavefront is read through `abs`. An out-of-range or inactive source returns
`valid_source == false` and leaves the fabric unchanged. A firing source
evaluates each of its eight configured destinations once. The result contains
the source payload and destination indexes that fired; unconnected or
sub-threshold destinations contain `NULL_INDEX`.
"""
open verb step_wavefront[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    if source_idx >= (N as u32) {
        return result;
    }
    if (fabric.columns[source_idx].flags & FLAG_ACTIVE) == 0u8 {
        return result;
    }
    return evaluate_active_source(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
}

verb empty_step_result() -> ImpulseStepResult {
    return ImpulseStepResult {valid_source: false, source_fired: false, payload: 0u8, destination_0: null_index(
    ), destination_1: null_index(), destination_2: null_index(), destination_3: null_index(), destination_4: null_index(
    ), destination_5: null_index(), destination_6: null_index(), destination_7: null_index()};
}

meta limitless("verb")
verb evaluate_active_source[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> ImpulseStepResult {
    erg result: ImpulseStepResult = empty_step_result();
    result.valid_source = true;
    erg evaluation: Option[u8] = evaluate_minicolumn_core(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: erg source_idx
    );
    case dat evaluation {
        Option.Some(payload) => {
            result.source_fired = true;
            result.payload = payload;
            erg fired: Array[u32,8] = forward_step_destinations(
                fabric: ins fabric,
                wave: abs wave,
                source_idx: erg source_idx
            );
            result.destination_0 = fired[0];
            result.destination_1 = fired[1];
            result.destination_2 = fired[2];
            result.destination_3 = fired[3];
            result.destination_4 = fired[4];
            result.destination_5 = fired[5];
            result.destination_6 = fired[6];
            result.destination_7 = fired[7];
        },
        Option.None => {},
    };
    return result;
}

meta limitless("verb")
verb forward_step_destinations[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    erg index: u32 = 0u32;
    erg target: u32 = fabric.columns[source_idx].axon_0;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 1u32;
    target = fabric.columns[source_idx].axon_1;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 2u32;
    target = fabric.columns[source_idx].axon_2;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 3u32;
    target = fabric.columns[source_idx].axon_3;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 4u32;
    target = fabric.columns[source_idx].axon_4;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 5u32;
    target = fabric.columns[source_idx].axon_5;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 6u32;
    target = fabric.columns[source_idx].axon_6;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    index = 7u32;
    target = fabric.columns[source_idx].axon_7;
    store_destination(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        index: erg index,
        target: erg target
    );
    return fired;
}

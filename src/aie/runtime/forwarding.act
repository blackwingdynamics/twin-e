meta limitless("verb")
verb forward_group_a[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    forward_slot_0(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_1(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_2(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_3(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
}

meta limitless("verb")
verb forward_group_b[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg source_idx: u32
) {
    forward_slot_4(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_5(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_6(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
    forward_slot_7(
        fabric: ins fabric,
        wave: abs wave,
        fired: ins fired,
        source_idx: erg source_idx
    );
}

open verb forward_impulse[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    if source_idx < (N as u32) {
        forward_group_a(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            source_idx: erg source_idx
        );
        forward_group_b(
            fabric: ins fabric,
            wave: abs wave,
            fired: ins fired,
            source_idx: erg source_idx
        );
    }
    return fired;
}

meta limitless("file")


"""Coincidence evaluation, software population count, neurogenesis, and decay."""
open verb popcount_u64(erg value: u64) -> u32 {
    erg working: u64 = value;
    erg count: u32 = 0u32;
    loop {
        if working == 0u64 {
            break;
        }
        working &= working - 1u64;
        count += 1u32;
    }
    return count;
}

verb none_u8() -> Option[u8] {
    erg value: Option[u8] = Option[u8].None;
    return value;
}

verb some_u8(abs value: u8) -> Option[u8] {
    erg result: Option[u8] = Option[u8].Some(value);
    return result;
}

verb none_u32() -> Option[u32] {
    erg value: Option[u32] = Option[u32].None;
    return value;
}

verb some_u32(abs value: u32) -> Option[u32] {
    erg result: Option[u32] = Option[u32].Some(value);
    return result;
}

open verb evaluate_minicolumn[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg target_idx: u32
) -> Option[u8] {
    return evaluate_minicolumn_core(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: target_idx
    );
}

"""Evaluate one packed column, update plastic state, and apply inhibition."""
meta limitless("verb")
verb evaluate_minicolumn_core[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg target_idx: u32
) -> Option[u8] {
    erg valid: Bool = target_idx < (N as u32);
    erg eligible: Bool = valid && (fabric.columns[target_idx].flags & (4u8 | 2u8)) == 0u8;
    erg overlap: u32 = 0u32;
    if valid {
        erg low: u64 = wave.mask_low & fabric.columns[target_idx].coincidence_low;
        erg high: u64 = wave.mask_high & fabric.columns[target_idx].coincidence_high;
        overlap = (popcount_u64(value: low) as u32) + (popcount_u64(value: high) as u32);
    }
    erg fires: Bool = eligible && overlap >= (fabric.columns[target_idx].threshold as u32);
    if fires {
        fabric.columns[target_idx].charge = 0u8;
        fabric.columns[target_idx].idle_ticks = 0u8;
        if fabric.columns[target_idx].myelination < 255u8 {
            fabric.columns[target_idx].myelination += 1u8;
        }
        if fabric.columns[target_idx].inhibitory_link != 4294967295u32 && fabric.columns[target_idx].inhibitory_link < (N as u32) {
            erg inhibitory_idx: u32 = fabric.columns[target_idx].inhibitory_link;
            fabric.columns[inhibitory_idx].flags |= 2u8;
        }
    } else if eligible {
        erg accumulated: u32 = (fabric.columns[target_idx].charge as u32) + overlap;
        if accumulated > 255u32 {
            fabric.columns[target_idx].charge = 255u8;
        } else {
            fabric.columns[target_idx].charge = accumulated as u8;
        };
    }
    erg result: Option[u8] = Option[u8].None;
    if fires {
        result = Option[u8].Some(fabric.columns[target_idx].payload);
    }
    return result;
}

open verb store_destination[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    ins fired: Array[u32, 8],
    erg index: u32,
    erg target: u32
) -> u32 {
    erg evaluation: Option[u8] = evaluate_minicolumn(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: target
    );
    fired[index] = case dat evaluation {
        Option.Some(_) => target,
        Option.None => 4294967295u32,
    };
    return 0u32;
}

"""Evaluate all eight fixed axon destinations from one source column."""
verb forward_one[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg target: u32
) -> u32 {
    erg evaluation: Option[u8] = evaluate_minicolumn(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: erg target
    );
    return case dat evaluation {
        Option.Some(_) => target,
        Option.None => 4294967295u32,
    };
}

open verb forward_impulse[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Array[u32, 8] {
    erg fired: Array[u32,8] = empty_fired_destinations();
    erg target_0: u32 = 4294967295u32;
    erg target_1: u32 = 4294967295u32;
    erg target_2: u32 = 4294967295u32;
    erg target_3: u32 = 4294967295u32;
    erg target_4: u32 = 4294967295u32;
    erg target_5: u32 = 4294967295u32;
    erg target_6: u32 = 4294967295u32;
    erg target_7: u32 = 4294967295u32;
    if source_idx < (N as u32) {
        target_0 = fabric.columns[source_idx].axon_0;
        target_1 = fabric.columns[source_idx].axon_1;
        target_2 = fabric.columns[source_idx].axon_2;
        target_3 = fabric.columns[source_idx].axon_3;
        target_4 = fabric.columns[source_idx].axon_4;
        target_5 = fabric.columns[source_idx].axon_5;
        target_6 = fabric.columns[source_idx].axon_6;
        target_7 = fabric.columns[source_idx].axon_7;
        fired[0] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_0
        );
        fired[1] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_1
        );
        fired[2] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_2
        );
        fired[3] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_3
        );
        fired[4] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_4
        );
        fired[5] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_5
        );
        fired[6] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_6
        );
        fired[7] = forward_one(
            fabric: ins fabric,
            wave: abs wave,
            target: erg target_7
        );
    }
    return fired;
}

open verb neurogenesis[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    return neurogenesis_core(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: source_idx
    );
}

"""Allocate, seed, link, or reclaim one novel minicolumn."""
meta limitless("verb")
verb neurogenesis_core[N: Usize](
    ins fabric: CorticalFabric[N],
    abs wave: Wavefront,
    erg source_idx: u32
) -> Option[u32] {
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    erg has_allocation: Bool = slot != 4294967295u32;
    if has_allocation {
        seed_column(
            fabric: ins fabric,
            slot: slot,
            wave: abs wave
        );
    }
    erg linked: Bool = link_allocated(
        fabric: ins fabric,
        source: source_idx,
        slot: slot,
        available: has_allocation
    );
    if has_allocation && !linked {
        free_column(fabric: ins fabric, slot: erg slot);
    }
    erg success: Bool = has_allocation && linked;
    erg result: Option[u32] = Option[u32].None;
    if success {
        result = Option[u32].Some(slot);
    }
    return result;
}

verb seed_column[N: Usize](
    ins fabric: CorticalFabric[N],
    erg slot: u32,
    abs wave: Wavefront
) {
    fabric.columns[slot].threshold = 20u8;
    fabric.columns[slot].myelination = 1u8;
    fabric.columns[slot].idle_ticks = 0u8;
    fabric.columns[slot].coincidence_low = wave.mask_low;
    fabric.columns[slot].coincidence_high = wave.mask_high;
}

"""Dispatch the first available axon slot to a newly seeded column."""
meta limitless("verb")
verb link_allocated[N: Usize](
    ins fabric: CorticalFabric[N],
    erg source: u32,
    erg slot: u32,
    erg available: Bool
) -> Bool {
    erg link_choice: u32 = choose_link(
        fabric: abs fabric,
        source: source,
        available: available
    );
    case true {
        true if link_choice == 0u32 => link_axon_0(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 1u32 => link_axon_1(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 2u32 => link_axon_2(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 3u32 => link_axon_3(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 4u32 => link_axon_4(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 5u32 => link_axon_5(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 6u32 => link_axon_6(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        true if link_choice == 7u32 => link_axon_7(
            fabric: ins fabric,
            source: source,
            target: slot
        ),
        _ => 0u32,
    };
    return link_choice < 8u32;
}

verb choose_link[N: Usize](
    abs fabric: CorticalFabric[N],
    erg source: u32,
    erg available: Bool
) -> u32 {
    erg zero: u32 = 0u32;
    erg one: u32 = 1u32;
    erg two: u32 = 2u32;
    erg three: u32 = 3u32;
    erg four: u32 = 4u32;
    erg five: u32 = 5u32;
    erg six: u32 = 6u32;
    erg seven: u32 = 7u32;
    erg eight: u32 = 8u32;
    return case true {
        true if available && source < (N as u32) && fabric.columns[source].axon_0 == 4294967295u32 => zero,
        true if available && source < (N as u32) && fabric.columns[source].axon_1 == 4294967295u32 => one,
        true if available && source < (N as u32) && fabric.columns[source].axon_2 == 4294967295u32 => two,
        true if available && source < (N as u32) && fabric.columns[source].axon_3 == 4294967295u32 => three,
        true if available && source < (N as u32) && fabric.columns[source].axon_4 == 4294967295u32 => four,
        true if available && source < (N as u32) && fabric.columns[source].axon_5 == 4294967295u32 => five,
        true if available && source < (N as u32) && fabric.columns[source].axon_6 == 4294967295u32 => six,
        true if available && source < (N as u32) && fabric.columns[source].axon_7 == 4294967295u32 => seven,
        _ => eight,
    };
}

open verb global_homeostatic_sweep[N: Usize](ins fabric: CorticalFabric[N]) -> Void {
    erg i: u32 = 0u32;
    loop {
        if i >= (N as u32) {
            break;
        }
        if (fabric.columns[i].flags & 1u8) != 0u8 {
            fabric.columns[i].flags &= ~(4u8 | 2u8);
            if fabric.columns[i].idle_ticks < 255u8 {
                fabric.columns[i].idle_ticks += 1u8;
            }
            if fabric.columns[i].idle_ticks >= 240u8 && fabric.columns[i].myelination < 100u8 {
                erg reclaim_idx: u32 = i as u32;
                free_column(fabric: ins fabric, slot: erg reclaim_idx);
            }
        }
        i += 1u32;
    }
}

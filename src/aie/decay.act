"""Advance homeostasis and reclaim idle, weak minicolumns."""
open verb global_homeostatic_sweep[N: Usize](ins fabric: CorticalFabric[N]) -> Void {
    erg i: u32 = 0u32;
    loop {
        if i >= (N as u32) {
            break;
        }
        if (fabric.columns[i].flags & 1u8) != 0u8 {
            fabric.columns[i].flags &= ~(4u8 | 2u8);
            if fabric.columns[i].idle_ticks < 255u8 {
                fabric.columns[i].idle_ticks += 1u8;
            }
            if fabric.columns[i].idle_ticks >= 240u8 && fabric.columns[i].myelination < 100u8 {
                erg reclaim_idx: u32 = i as u32;
                free_column(fabric: ins fabric, slot: erg reclaim_idx);
            }
        }
        i += 1u32;
    }
}

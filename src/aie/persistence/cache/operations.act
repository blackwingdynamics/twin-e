"""Bounded metadata cache for disk-backed shard working sets."""
import config;

open lifecycle;

"""Failure categories for bounded shard-cache state transitions."""
open enum ShardCacheError {
    Missing,
    Dirty,
    Pinned,
    NoEvictable,
}

"""Metadata for one cached shard slot, without owning shard payload bytes."""
open struct ShardCacheEntry {
    erg shard_id: u32,
    erg generation: u64,
    erg last_use: u64,
    erg checksum: u64,
    erg pin_count: u16,
    erg lifecycle: ShardLifecycle,
}

"""Fixed-capacity metadata cache for shard working-set management.

The cache owns four inline entries and a monotonic logical clock. It tracks
the explicit resident lifecycle and pinning so eviction never discards
protected or unsaved work.
"""
open struct ShardCache {
    erg entries: Array[ShardCacheEntry, 4],
    erg clock: u64,
}

verb empty_entry() -> ShardCacheEntry {
    return ShardCacheEntry {shard_id: 0u32, generation: 0u64, last_use: 0u64, checksum: 0u64, pin_count: 0u16, lifecycle: ShardLifecycle.Absent};
}

"""Reset every cache entry and restart the logical usage clock.

The cache is mutated through an exclusive `ins` loan. Existing metadata is
discarded and no filesystem operation is performed.
"""
open verb shard_cache_init(ins cache: ShardCache) -> Void {
    erg index: u8 = 0u8;
    loop {
        if index >= BRAIN_CACHE_CAPACITY {
            break;
        }
        cache.entries[index as Usize] = empty_entry();
        index += 1u8;
    }
    cache.clock = 0u64;
}

"""Find a managed shard by ID without changing cache state.

The cache is read through `abs`; success returns the bounded slot index and a
miss returns `Option.None`.
"""
open verb shard_cache_find(abs cache: ShardCache, erg shard_id: u32) -> Option[u8] {
    erg index: u8 = 0u8;
    loop {
        if index >= BRAIN_CACHE_CAPACITY {
            break;
        }
        erg entry: ShardCacheEntry = cache.entries[index as Usize];
        if cache_entry_is_present(entry: abs entry) && entry.shard_id == shard_id {
            return Option[u8].Some(index);
        }
        index += 1u8;
    }
    return Option[u8].None;
}

verb cache_next_clock(ins cache: ShardCache) -> u64 {
    cache.clock += 1u64;
    return cache.clock;
}

verb select_cache_slot(erg free_slot: u8, erg victim: u8) -> u8 {
    if free_slot < BRAIN_CACHE_CAPACITY {
        return free_slot;
    }
    return victim;
}

verb find_free_cache_slot(abs cache: ShardCache) -> u8 {
    erg index: u8 = 0u8;
    loop {
        if index >= BRAIN_CACHE_CAPACITY {
            break;
        }
        erg entry: ShardCacheEntry = cache.entries[index as Usize];
        if cache_entry_is_empty(entry: abs entry) {
            return index;
        }
        index += 1u8;
    }
    return BRAIN_CACHE_CAPACITY;
}

verb find_cache_victim(abs cache: ShardCache) -> u8 {
    erg victim: u8 = BRAIN_CACHE_CAPACITY;
    erg oldest: u64 = 0u64;
    erg has_victim: Bool = false;
    erg index: u8 = 0u8;
    loop {
        if index >= BRAIN_CACHE_CAPACITY {
            break;
        }
        erg entry: ShardCacheEntry = cache.entries[index as Usize];
        if !cache_entry_is_dirty(entry: abs entry) && cache_entry_is_clean_resident(entry: abs entry) && entry.pin_count == 0u16 && (!has_victim || entry.last_use < oldest) {
            oldest = cache.entries[index as Usize].last_use;
            victim = index;
            has_victim = true;
        }
        index += 1u8;
    }
    return victim;
}

verb refresh_cache_entry(
    ins cache: ShardCache,
    abs slot: u8,
    erg generation: u64,
    erg checksum: u64
) -> Result[u8, ShardCacheError] {
    cache.entries[slot as Usize].generation = generation;
    cache.entries[slot as Usize].checksum = checksum;
    erg touched = shard_cache_touch(cache: ins cache, slot: abs slot);
    return case dat touched {
        Result.Err(error) => Err(error),
        Result.Ok(_) => Ok(slot),
    };
}

"""Update one resident entry's logical last-use timestamp.

The cache uses an exclusive `ins` loan. Invalid or unloaded slots return
`Missing`; valid slots return `Ok(0)` and become newer eviction candidates.
"""
open verb shard_cache_touch(ins cache: ShardCache, abs slot: u8) -> Result[Int, ShardCacheError] {
    if slot >= BRAIN_CACHE_CAPACITY {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg entry: ShardCacheEntry = cache.entries[slot as Usize];
    if !cache_entry_is_present(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg stamp: u64 = cache_next_clock(cache: ins cache);
    cache.entries[slot as Usize].last_use = stamp;
    return Result[Int, ShardCacheError].Ok(0);
}

"""Pin one resident entry against eviction.

The cache is mutated through `ins`. Missing slots return `Missing`; successful
calls increment the bounded pin count and return `Ok(0)`.
"""
open verb shard_cache_pin(ins cache: ShardCache, erg slot: u8) -> Result[Int, ShardCacheError] {
    if slot >= BRAIN_CACHE_CAPACITY {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg entry: ShardCacheEntry = cache.entries[slot as Usize];
    if !cache_entry_is_present(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    cache.entries[slot as Usize].pin_count += 1u16;
    return Result[Int, ShardCacheError].Ok(0);
}

"""Release one pin from a resident cache entry.

Missing slots return `Missing`; an already unpinned entry returns `Pinned` so
underflow cannot occur. Successful calls decrement the pin count.
"""
open verb shard_cache_unpin(ins cache: ShardCache, erg slot: u8) -> Result[Int, ShardCacheError] {
    if slot >= BRAIN_CACHE_CAPACITY {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg entry: ShardCacheEntry = cache.entries[slot as Usize];
    if !cache_entry_is_present(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    if cache.entries[slot as Usize].pin_count == 0u16 {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Pinned);
    }
    cache.entries[slot as Usize].pin_count -= 1u16;
    return Result[Int, ShardCacheError].Ok(0);
}

"""Mark one resident entry as requiring persistence before eviction.

The exclusive `ins` loan changes the lifecycle to `Dirty`. Missing slots
return `Missing`; successful calls return `Ok(0)`.
"""
open verb shard_cache_mark_dirty(ins cache: ShardCache, erg slot: u8) -> Result[Int, ShardCacheError] {
    if slot >= BRAIN_CACHE_CAPACITY {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg entry: ShardCacheEntry = cache.entries[slot as Usize];
    if !cache_entry_is_present(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    cache.entries[slot as Usize].lifecycle = ShardLifecycle.Dirty;
    return Result[Int, ShardCacheError].Ok(0);
}

"""Evict one safe cache entry and clear all of its metadata.

Dirty, pinned, missing, or out-of-range slots are rejected with the matching
error. Only a clean resident or persisted entry is cleared and returns
`Ok(0)`.
"""
open verb shard_cache_evict(ins cache: ShardCache, erg slot: u8) -> Result[Int, ShardCacheError] {
    if slot >= BRAIN_CACHE_CAPACITY {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    erg entry: ShardCacheEntry = cache.entries[slot as Usize];
    if !cache_entry_is_present(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Missing);
    }
    if cache_entry_is_dirty(entry: abs entry) {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Dirty);
    }
    if cache.entries[slot as Usize].pin_count > 0u16 {
        return Result[Int, ShardCacheError].Err(ShardCacheError.Pinned);
    }
    cache.entries[slot as Usize].shard_id = 0u32;
    cache.entries[slot as Usize].generation = 0u64;
    cache.entries[slot as Usize].last_use = 0u64;
    cache.entries[slot as Usize].checksum = 0u64;
    cache.entries[slot as Usize].pin_count = 0u16;
    cache.entries[slot as Usize].lifecycle = ShardLifecycle.Absent;
    return Result[Int, ShardCacheError].Ok(0);
}

verb find_insert_slot(abs cache: ShardCache) -> Option[u8] {
    erg free_slot: u8 = find_free_cache_slot(cache: abs cache);
    erg victim: u8 = find_cache_victim(cache: abs cache);
    if free_slot >= BRAIN_CACHE_CAPACITY && victim >= BRAIN_CACHE_CAPACITY {
        return Option[u8].None;
    }
    return Option[u8].Some(select_cache_slot(free_slot: erg free_slot, victim: erg victim));
}

"""Insert or refresh one shard using bounded deterministic eviction.

The exclusive `ins` cache loan refreshes an existing shard, uses a free slot,
or selects the oldest clean unpinned victim. `NoEvictable` is returned when
all four slots are dirty or pinned.
"""
verb populate_cache_slot(
    ins cache: ShardCache,
    abs slot: u8,
    erg shard_id: u32,
    erg generation: u64,
    erg checksum: u64
) -> Result[u8, ShardCacheError] {
    erg stamp: u64 = cache_next_clock(cache: ins cache);
    cache.entries[slot as Usize].shard_id = shard_id;
    cache.entries[slot as Usize].generation = generation;
    cache.entries[slot as Usize].last_use = stamp;
    cache.entries[slot as Usize].checksum = checksum;
    cache.entries[slot as Usize].pin_count = 0u16;
    cache.entries[slot as Usize].lifecycle = ShardLifecycle.Resident;
    return Result[u8, ShardCacheError].Ok(slot);
}

"""Insert or refresh one shard using bounded deterministic eviction.

The exclusive `ins` cache loan refreshes an existing shard, uses a free slot,
or selects the oldest clean unpinned victim. `NoEvictable` is returned when
all four slots are dirty or pinned.
"""
open verb shard_cache_insert(
    ins cache: ShardCache,
    erg shard_id: u32,
    erg generation: u64,
    erg checksum: u64
) -> Result[u8, ShardCacheError] {
    erg existing = shard_cache_find(cache: abs cache, shard_id: erg shard_id);
    case existing {
        Option.Some(slot) => {
            return refresh_cache_entry(
                cache: ins cache,
                slot: abs slot,
                generation: erg generation,
                checksum: erg checksum
            );
        },
        Option.None => {},
    };
    erg selected = find_insert_slot(cache: abs cache);
    return case selected {
        Option.Some(slot) => populate_cache_slot(
            cache: ins cache,
            slot: abs slot,
            shard_id: erg shard_id,
            generation: erg generation,
            checksum: erg checksum
        ),
        Option.None => Result[u8, ShardCacheError].Err(ShardCacheError.NoEvictable),
    };
}

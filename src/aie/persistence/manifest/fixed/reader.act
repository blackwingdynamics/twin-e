import std::io;

open io;

struct FixedManifestHeaderCore {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg manifest_bytes: u32,
    erg generation: u64,
    erg total_column_count: u32,
    erg active_column_count: u32,
    erg shard_count: u32,
}

struct FixedManifestHeaderLayout {
    erg column_stride_bytes: u16,
    erg binding_stride_bytes: u16,
    erg tokenizer_version: u16,
    erg context_version: u16,
    erg code_version: u16,
    erg reserved: u16,
    erg checksum: u64,
}

"""Decode the identity and count fields of a fixed manifest header."""
verb read_fixed_manifest_header_core(abs bytes: Buffer) -> FixedManifestHeaderCore {
    erg o0: u32 = 0u32;
    erg o4: u32 = 4u32;
    erg o6: u32 = 6u32;
    erg o8: u32 = 8u32;
    erg o12: u32 = 12u32;
    erg o20: u32 = 20u32;
    erg o24: u32 = 24u32;
    erg o28: u32 = 28u32;
    return FixedManifestHeaderCore {magic: read_manifest_u32(input: abs bytes, offset: abs o0), version: read_manifest_u16(
        input: abs bytes,
        offset: abs o4
    ), header_bytes: read_manifest_u16(input: abs bytes, offset: abs o6), manifest_bytes: read_manifest_u32(
        input: abs bytes,
        offset: abs o8
    ), generation: read_manifest_u64(input: abs bytes, offset: abs o12), total_column_count: read_manifest_u32(
        input: abs bytes,
        offset: abs o20
    ), active_column_count: read_manifest_u32(input: abs bytes, offset: abs o24), shard_count: read_manifest_u32(
        input: abs bytes,
        offset: abs o28
    )};
}

"""Decode fixed manifest layout versions and checksum fields."""
verb read_fixed_manifest_header_layout(abs bytes: Buffer) -> FixedManifestHeaderLayout {
    erg o32: u32 = 32u32;
    erg o34: u32 = 34u32;
    erg o36: u32 = 36u32;
    erg o38: u32 = 38u32;
    erg o40: u32 = 40u32;
    erg o42: u32 = 42u32;
    erg o44: u32 = 44u32;
    return FixedManifestHeaderLayout {column_stride_bytes: read_manifest_u16(input: abs bytes, offset: abs o32), binding_stride_bytes: read_manifest_u16(
        input: abs bytes,
        offset: abs o34
    ), tokenizer_version: read_manifest_u16(input: abs bytes, offset: abs o36), context_version: read_manifest_u16(
        input: abs bytes,
        offset: abs o38
    ), code_version: read_manifest_u16(input: abs bytes, offset: abs o40), reserved: read_manifest_u16(
        input: abs bytes,
        offset: abs o42
    ), checksum: read_manifest_u64(input: abs bytes, offset: abs o44)};
}

"""Decode the fixed manifest header from canonical little-endian bytes.

The input buffer is an immutable view and is never consumed or modified. Field
offsets are fixed by the manifest format, including generation, layout strides,
version fields, and checksum. Structural validation is performed by the
caller after decoding.
"""
verb read_fixed_manifest_header(abs bytes: Buffer) -> ManifestHeader {
    erg core: FixedManifestHeaderCore = read_fixed_manifest_header_core(bytes: abs bytes);
    erg layout: FixedManifestHeaderLayout = read_fixed_manifest_header_layout(bytes: abs bytes);
    return ManifestHeader {magic: core.magic, version: core.version, header_bytes: core.header_bytes, manifest_bytes: core.manifest_bytes, generation: core.generation, total_column_count: core.total_column_count, active_column_count: core.active_column_count, shard_count: core.shard_count, column_stride_bytes: layout.column_stride_bytes, binding_stride_bytes: layout.binding_stride_bytes, tokenizer_version: layout.tokenizer_version, context_version: layout.context_version, code_version: layout.code_version, reserved: layout.reserved, checksum: layout.checksum};
}

"""Decode one fixed shard descriptor at a manifest byte offset.

The manifest buffer is read-only. The offset selects the descriptor's shard id,
column range, payload range, binding range, checksum, and state fields using
the position-independent on-disk layout. Range and schema validation remain the
responsibility of the descriptor predicate.
"""
verb read_fixed_manifest_descriptor(abs bytes: Buffer, erg offset: u32) -> ManifestDescriptor {
    erg offset_4: u32 = offset + 4u32;
    erg offset_8: u32 = offset + 8u32;
    erg offset_12: u32 = offset + 12u32;
    erg offset_16: u32 = offset + 16u32;
    erg offset_20: u32 = offset + 20u32;
    erg offset_24: u32 = offset + 24u32;
    erg offset_28: u32 = offset + 28u32;
    erg offset_36: u32 = offset + 36u32;
    return ManifestDescriptor {shard_id: read_manifest_u32(input: abs bytes, offset: abs offset), first_column_index: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_4
    ), column_count: read_manifest_u32(input: abs bytes, offset: abs offset_8), payload_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_12
    ), payload_bytes: read_manifest_u32(input: abs bytes, offset: abs offset_16), binding_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_20
    ), binding_bytes: read_manifest_u32(input: abs bytes, offset: abs offset_24), checksum: read_manifest_u64(
        input: abs bytes,
        offset: abs offset_28
    ), state: read_manifest_u32(input: abs bytes, offset: abs offset_36)};
}

"""
Purpose: Validate both fixed shard descriptors against the fixed layout contract.
Inputs: The manifest, descriptor, shard, or header values declared by the signature.
Outputs: Returns Bool for predicates or a typed Result when validation also reports an I/O condition.
Invariants: Validation is side-effect free and enforces magic, version, bounds, checksum, and layout rules.
Failure behavior: Returns false or InvalidData/InvalidInput according to the public contract; it never accepts partial state.
"""
verb fixed_manifest_descriptors_are_valid(abs bytes: Buffer) -> Bool {
    erg descriptor_zero_offset: u32 = 64u32;
    erg descriptor_one_offset: u32 = 104u32;
    erg expected_zero: u32 = 0u32;
    erg expected_one: u32 = 1u32;
    erg zero: ManifestDescriptor = read_fixed_manifest_descriptor(bytes: abs bytes, offset: erg descriptor_zero_offset);
    erg one: ManifestDescriptor = read_fixed_manifest_descriptor(bytes: abs bytes, offset: erg descriptor_one_offset);
    return manifest_descriptor_is_valid(descriptor: abs zero, expected_id: erg expected_zero) && manifest_descriptor_is_valid(
        descriptor: abs one,
        expected_id: erg expected_one
    );
}

"""Validate and consume a complete fixed manifest buffer.

Ownership arrives through `dat` and is released on every branch. The function
checks exact file size, header fields, the manifest checksum, and both fixed
shard descriptors before returning the byte length. Any mismatch returns
`InvalidData`; no partially validated manifest is exposed to callers.
"""
open verb read_manifest_bytes(dat bytes: Buffer) -> Result[Int, IoError] {
    erg length_result = buffer_size(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != BRAIN_MANIFEST_FILE_BYTES as Int {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg header: ManifestHeader = read_fixed_manifest_header(bytes: abs bytes);
    erg actual_checksum: u64 = manifest_checksum(input: abs bytes);
    if !manifest_header_is_valid(header: abs header) || header.total_column_count != 64u32 || header.checksum != actual_checksum || !fixed_manifest_descriptors_are_valid(
        bytes: abs bytes
    ) {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    drop(bytes);
    return Ok(length);
}

"""Read and validate a fixed manifest file from disk.

The path is an immutable view. The filesystem read result is forwarded to the
in-memory validator, which owns and consumes the returned buffer. I/O failures
retain their mapped error; malformed size, header, descriptor, or checksum data
returns `InvalidData`.
"""
open verb read_manifest(abs path: Path) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => manifest_io_error(error: dat error),
        Result.Ok(bytes) => read_manifest_bytes(bytes: dat bytes),
    };
}

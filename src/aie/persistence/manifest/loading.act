"""Select and load the fixed shard identified by a validated column location.

The fabric is borrowed mutably for the duration of the shard read. The two
fixed shard paths are read-only inputs, and the location decides which path is
allowed to satisfy the request. Invalid shard identifiers return `InvalidInput`.
The delegated shard loader validates the bytes before writing the destination.
"""
verb load_selected_shard(
    ins fabric: CorticalFabric[64],
    abs location: ColumnLocation,
    abs shard_zero_path: Path,
    abs shard_one_path: Path
) -> Result[Int, IoError] {
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    if location.shard_id == zero_id {
        return read_shard(
            fabric: ins fabric,
            path: abs shard_zero_path,
            shard_id: erg zero_id
        );
    }
    if location.shard_id == one_id {
        return read_shard(
            fabric: ins fabric,
            path: abs shard_one_path,
            shard_id: erg one_id
        );
    }
    return Err(IoError.InvalidInput);
}

"""Resolve a global column index through the fixed manifest and load its shard.

The manifest buffer and shard paths are immutable views. The fabric receives an
exclusive `ins` loan only while the selected shard is decoded. Resolution and
payload validation happen before the shard loader mutates the destination;
malformed metadata, missing files, checksum failures, and range errors are
returned through `IoError`.
"""
verb load_selected_shard_from_manifest(
    ins fabric: CorticalFabric[64],
    abs manifest_bytes: Buffer,
    abs shard_zero_path: Path,
    abs shard_one_path: Path,
    erg global_index: u32
) -> Result[Int, IoError] {
    erg location_result = manifest_locate_column(bytes: abs manifest_bytes, global_index: erg global_index);
    return case dat location_result {
        Result.Err(error) => Err(error),
        Result.Ok(location) => load_selected_shard(
            fabric: ins fabric,
            location: abs location,
            shard_zero_path: abs shard_zero_path,
            shard_one_path: abs shard_one_path
        ),
    };
}

"""Load one column from the fixed manifest and its selected shard file.

The manifest path and both shard paths are read-only views. The global index is
resolved from the manifest before any column bytes are copied into the mutable
fabric. Filesystem errors, invalid descriptors, checksum mismatches, and an
out-of-range column are propagated as `IoError`.
"""
open verb load_column_from_shards(
    ins fabric: CorticalFabric[64],
    abs manifest_path: Path,
    abs shard_zero_path: Path,
    abs shard_one_path: Path,
    erg global_index: u32
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs manifest_path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => load_selected_shard_from_manifest(
            fabric: ins fabric,
            manifest_bytes: abs bytes,
            shard_zero_path: abs shard_zero_path,
            shard_one_path: abs shard_one_path,
            global_index: erg global_index
        ),
    };
}

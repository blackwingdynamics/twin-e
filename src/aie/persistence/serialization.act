import config;

"""Position-independent binary snapshots backed by the packed storage array."""
open struct FabricSnapshot {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg payload_bytes: u32,
    erg columns: Array[u8, 4096],
    erg free_list_head: u32,
    erg active_count: u32,
}

open verb snapshot_is_valid(abs snapshot: FabricSnapshot) -> Bool {
    return snapshot.magic == BRAIN_MAGIC && snapshot.version == BRAIN_VERSION && snapshot.header_bytes == BRAIN_HEADER_BYTES && snapshot.payload_bytes == BRAIN_PAYLOAD_BYTES;
}

open verb serialize_minicolumn(abs column: Minicolumn) -> Array[u8, 64] {
    erg snapshot: Array[u8,64] = Array[u8, 64]();
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        snapshot[i] = column.storage[i];
        i += 1u32;
    }
    return snapshot;
}

open verb deserialize_minicolumn(
    ins column: Minicolumn,
    abs snapshot: Array[u8, 64]
) -> Void {
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        column.storage[i] = snapshot[i];
        i += 1u32;
    }
}

open verb serialize_fabric(abs fabric: CorticalFabric[64]) -> FabricSnapshot {
    erg snapshot: FabricSnapshot = FabricSnapshot {magic: BRAIN_MAGIC, version: BRAIN_VERSION, header_bytes: BRAIN_HEADER_BYTES, payload_bytes: BRAIN_PAYLOAD_BYTES, columns: Array[u8, 4096](
    ), free_list_head: fabric.free_list_head, active_count: fabric.active_count};
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        erg column: Array[u8,64] = serialize_minicolumn(column: abs fabric.columns[i]);
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            snapshot.columns[(i * 64u32) + byte] = column[byte];
            byte += 1u32;
        }
        i += 1u32;
    }
    return snapshot;
}

open verb deserialize_fabric(
    ins fabric: CorticalFabric[64],
    abs snapshot: FabricSnapshot
) -> Bool {
    if !snapshot_is_valid(snapshot: abs snapshot) {
        return false;
    }
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            fabric.columns[i].storage[byte] = snapshot.columns[(i * 64u32) + byte];
            byte += 1u32;
        }
        i += 1u32;
    }
    fabric.free_list_head = snapshot.free_list_head;
    fabric.active_count = snapshot.active_count;
    return true;
}

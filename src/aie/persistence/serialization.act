import config;

import encoding;

"""Position-independent binary snapshots backed by the packed storage array."""
open struct FabricSnapshot {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg payload_bytes: u32,
    erg columns: Array[u8, 4096],
    erg free_list_head: u32,
    erg active_count: u32,
}

"""Position-independent serialized sidecar for token/context bindings."""
open struct BindingSnapshot {
    erg magic: u32,
    erg version: u16,
    erg stride_bytes: u16,
    erg payload_bytes: u32,
    erg tokenizer_version: u16,
    erg context_version: u16,
    erg code_version: u16,
    erg entries: Array[u8, 1536],
}

"""Fabric and text sidecar snapshot with explicit compatibility versions."""
open struct TextSnapshot {
    erg fabric: FabricSnapshot,
    erg bindings: BindingSnapshot,
}

"""Validate binding snapshot identity and all compatibility versions.

The snapshot is read through `abs` and is never mutated. `false` means the
magic, layout, tokenizer, context, or code version is incompatible with the
current process.
"""
open verb binding_snapshot_is_valid(abs snapshot: BindingSnapshot) -> Bool {
    return snapshot.magic == BRAIN_MAGIC && snapshot.version == BRAIN_BINDING_VERSION && snapshot.stride_bytes == BRAIN_BINDING_STRIDE_BYTES && snapshot.payload_bytes == BRAIN_BINDING_PAYLOAD_BYTES && snapshot.tokenizer_version == TOKENIZER_VERSION && snapshot.context_version == CONTEXT_VERSION && snapshot.code_version == TOKEN_CODE_VERSION;
}

"""Validate the fixed fabric snapshot header and payload contract.

The snapshot is read through `abs`. The operation rejects incompatible magic,
version, header size, or payload size without touching any arena state.
"""
open verb snapshot_is_valid(abs snapshot: FabricSnapshot) -> Bool {
    return snapshot.magic == BRAIN_MAGIC && snapshot.version == BRAIN_VERSION && snapshot.header_bytes == BRAIN_HEADER_BYTES && snapshot.payload_bytes == BRAIN_PAYLOAD_BYTES;
}

"""Copy one packed 64-byte column into a position-independent byte array.

The column is read through `abs`; the returned inline array preserves every
byte, including indexed axons and arena links, without pointers or I/O.
"""
open verb serialize_minicolumn(abs column: Minicolumn) -> Array[u8, 64] {
    erg snapshot: Array[u8,64] = Array[u8, 64]();
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        snapshot[i] = column.storage[i];
        i += 1u32;
    }
    return snapshot;
}

"""Restore one packed column from a validated-size inline byte array.

The column receives an exclusive `ins` mutation loan and the source snapshot
is read through `abs`. All 64 bytes are copied in order; validation belongs to
the caller because the array type already fixes the size.
"""
open verb deserialize_minicolumn(
    ins column: Minicolumn,
    abs snapshot: Array[u8, 64]
) -> Void {
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        column.storage[i] = snapshot[i];
        i += 1u32;
    }
}

"""Serialize the complete fixed arena and free-list metadata.

The fabric is read through `abs`; the returned snapshot contains the 4,096
column bytes plus free-list and active-count state. No disk I/O or allocation
outside the fixed inline snapshot occurs.
"""
open verb serialize_fabric(abs fabric: CorticalFabric[64]) -> FabricSnapshot {
    erg snapshot: FabricSnapshot = FabricSnapshot {magic: BRAIN_MAGIC, version: BRAIN_VERSION, header_bytes: BRAIN_HEADER_BYTES, payload_bytes: BRAIN_PAYLOAD_BYTES, columns: Array[u8, 4096](
    ), free_list_head: fabric.free_list_head, active_count: fabric.active_count};
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        erg column: Array[u8,64] = serialize_minicolumn(column: abs fabric.columns[i]);
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            snapshot.columns[(i * 64u32) + byte] = column[byte];
            byte += 1u32;
        }
        i += 1u32;
    }
    return snapshot;
}

"""Restore the arena from a compatible fixed fabric snapshot.

The fabric receives an exclusive `ins` loan and the snapshot is read through
`abs`. Invalid headers return `false` before mutation; valid snapshots restore
all column bytes and free-list metadata and return `true`.
"""
open verb deserialize_fabric(
    ins fabric: CorticalFabric[64],
    abs snapshot: FabricSnapshot
) -> Bool {
    if !snapshot_is_valid(snapshot: abs snapshot) {
        return false;
    }
    erg i: u32 = 0u32;
    loop {
        if i >= 64u32 {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            fabric.columns[i].storage[byte] = snapshot.columns[(i * 64u32) + byte];
            byte += 1u32;
        }
        i += 1u32;
    }
    fabric.free_list_head = snapshot.free_list_head;
    fabric.active_count = snapshot.active_count;
    return true;
}

"""Serialize all fixed token/context binding records into a sidecar snapshot.

Bindings are read through `abs`. The returned inline payload preserves the
configured stride and compatibility versions and performs no file I/O.
"""
open verb serialize_bindings(abs bindings: Array[TokenBinding, 64]) -> BindingSnapshot {
    erg snapshot: BindingSnapshot = BindingSnapshot {magic: BRAIN_MAGIC, version: BRAIN_BINDING_VERSION, stride_bytes: BRAIN_BINDING_STRIDE_BYTES, payload_bytes: BRAIN_BINDING_PAYLOAD_BYTES, tokenizer_version: TOKENIZER_VERSION, context_version: CONTEXT_VERSION, code_version: TOKEN_CODE_VERSION, entries: Array[u8, 1536](
    )};
    erg index: u32 = 0u32;
    loop {
        if index >= BRAIN_BINDING_COUNT {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= BRAIN_BINDING_STRIDE_BYTES as u32 {
                break;
            }
            snapshot.entries[(index * BRAIN_BINDING_STRIDE_BYTES as u32) + byte] = bindings[index].storage[byte];
            byte += 1u32;
        }
        index += 1u32;
    }
    return snapshot;
}

"""Restore binding records from a compatible sidecar snapshot.

The binding array receives an exclusive `ins` loan. Invalid metadata returns
`false` without mutation; a valid snapshot copies every fixed-width record and
returns `true`.
"""
open verb deserialize_bindings(
    ins bindings: Array[TokenBinding, 64],
    abs snapshot: BindingSnapshot
) -> Bool {
    if !binding_snapshot_is_valid(snapshot: abs snapshot) {
        return false;
    }
    erg index: u32 = 0u32;
    loop {
        if index >= BRAIN_BINDING_COUNT {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= BRAIN_BINDING_STRIDE_BYTES as u32 {
                break;
            }
            bindings[index].storage[byte] = snapshot.entries[(index * BRAIN_BINDING_STRIDE_BYTES as u32) + byte];
            byte += 1u32;
        }
        index += 1u32;
    }
    return true;
}

"""Create one combined fabric and token/context snapshot.

Both inputs are read through `abs`. The returned value contains independent
fixed-size snapshots and does not perform disk I/O.
"""
open verb serialize_text_snapshot(
    abs fabric: CorticalFabric[64],
    abs bindings: Array[TokenBinding, 64]
) -> TextSnapshot {
    return TextSnapshot {fabric: serialize_fabric(fabric: abs fabric), bindings: serialize_bindings(
        bindings: abs bindings
    )};
}

"""Restore fabric and bindings only after both snapshot headers validate.

The arena and binding arrays receive exclusive `ins` loans. Incompatible
metadata returns `false` before either side is changed; compatible snapshots
restore both components and return `true`.
"""
open verb deserialize_text_snapshot(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs snapshot: TextSnapshot
) -> Bool {
    if !snapshot_is_valid(snapshot: abs snapshot.fabric) {
        return false;
    }
    if !binding_snapshot_is_valid(snapshot: abs snapshot.bindings) {
        return false;
    }
    if !deserialize_fabric(fabric: ins fabric, snapshot: abs snapshot.fabric) {
        return false;
    }
    return deserialize_bindings(bindings: ins bindings, snapshot: abs snapshot.bindings);
}

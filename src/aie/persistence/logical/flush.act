"""Explicit flush boundary for resident logical teaching state."""
import std::io;

import std::path;

open io;

open path;

open teaching;

open verb logical_teaching_complete_flush(
    ins brain: LogicalTeachingBrain,
    erg shard_id: u32,
    abs flushed: Result[Int, IoError]
) -> Result[Int, IoError] {
    if shard_id >= brain.logical.shard_count {
        return Result[Int, IoError].Err(IoError.InvalidInput);
    }
    erg found = logical_brain_resident_slot(brain: abs brain.logical, shard_id: erg shard_id);
    erg slot: u8 = 0u8;
    case dat found {
        Option.None => {
            return Result[Int, IoError].Err(IoError.InvalidInput);
        },
        Option.Some(value) => {
            slot = value;
        },
    };
    return case flushed {
        Result.Err(error) => Result[Int, IoError].Err(error),
        Result.Ok(bytes) => {
            erg saved: Result[Int,IoError] = Result[Int, IoError].Ok(bytes);
            return complete_shard_save(
                cache: ins brain.logical.cache,
                slot: erg slot,
                flushed: dat saved
            );
        },
    };
}

"""Select the first dirty shard for a caller-driven flush boundary.

The bounded scan is deterministic and allocation-free. It returns the logical
shard ID, not a cache slot, so the runner cannot accidentally flush a different
resident payload. No filesystem operation is performed.
"""
open verb logical_teaching_flush_target(abs brain: LogicalTeachingBrain) -> Option[u32] {
    for erg shard_id: u32 in 0u32 .. brain.logical.shard_count {
        if logical_brain_shard_is_dirty(brain: abs brain.logical, shard_id: erg shard_id) {
            return Option[u32].Some(shard_id);
        }
    }
    return Option[u32].None;
}

"""Flush every dirty resident shard through one validated generation.

The operation is explicit persistence work and must only be called by a
dataset or save boundary. A failed publication returns before any resident
entry is marked persisted. A successful generation publication makes all
dirty entries eligible for bounded clean eviction by the next admission.
"""
open verb logical_teaching_flush_dirty_residents(
    ins brain: LogicalTeachingBrain,
    abs brain_dir: Path
) -> Result[Int, IoError] {
    erg target = logical_teaching_flush_target(brain: abs brain);
    return case dat target {
        Option.None => Result[Int, IoError].Ok(0),
        Option.Some(_) => {
            erg generation: u64 = brain.logical.generation + 1u64;
            erg saved = logical_teaching_save_generation(
                brain: abs brain,
                brain_dir: abs brain_dir,
                generation: erg generation
            );
            return case dat saved {
                Result.Err(error) => Result[Int, IoError].Err(dat error),
                Result.Ok(bytes) => {
                    erg published: Result[Int,IoError] = Result[Int, IoError].Ok(bytes);
                    return logical_teaching_finish_dirty_flush(brain: ins brain, flushed: abs published);
                },
            };
        },
    };
}

verb logical_teaching_finish_dirty_flush(
    ins brain: LogicalTeachingBrain,
    abs flushed: Result[Int, IoError]
) -> Result[Int, IoError] {
    erg target = logical_teaching_flush_target(brain: abs brain);
    return case dat target {
        Option.None => Result[Int, IoError].Ok(0),
        Option.Some(shard_id) => {
            erg completed = logical_teaching_complete_flush(
                brain: ins brain,
                shard_id: erg shard_id,
                flushed: abs flushed
            );
            return case dat completed {
                Result.Err(error) => Result[Int, IoError].Err(dat error),
                Result.Ok(_) => logical_teaching_finish_dirty_flush(brain: ins brain, flushed: abs flushed),
            };
        },
    };
}

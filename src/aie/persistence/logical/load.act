"""Preflight and restore complete logical teaching generations."""
import config;

import std::io;

open config;

open io;

open manifest;

open shard;

open core;

open teaching;

open codec;

verb logical_persistence_buffer_length_result(dat length: Result[Int, IoError]) -> Result[Int, IoError] {
    return case dat length {
        Result.Err(_) => Err(IoError.InvalidData),
        Result.Ok(value) => Ok(value),
    };
}

verb logical_persistence_descriptor(abs manifest: Buffer, erg index: u32) -> ManifestDescriptor {
    erg offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32;
    erg first_offset: u32 = offset + 4u32;
    erg count_offset: u32 = offset + 8u32;
    erg payload_offset: u32 = offset + 12u32;
    erg payload_bytes_offset: u32 = offset + 16u32;
    erg binding_offset: u32 = offset + 20u32;
    erg binding_bytes_offset: u32 = offset + 24u32;
    erg auxiliary_offset: u32 = offset + 28u32;
    erg auxiliary_bytes_offset: u32 = offset + 32u32;
    erg checksum_offset: u32 = offset + 36u32;
    erg state_offset: u32 = offset + 44u32;
    return ManifestDescriptor {shard_id: read_manifest_u32(input: abs manifest, offset: abs offset), first_column_index: read_manifest_u32(
        input: abs manifest,
        offset: abs first_offset
    ), column_count: read_manifest_u32(input: abs manifest, offset: abs count_offset), payload_offset: read_manifest_u32(
        input: abs manifest,
        offset: abs payload_offset
    ), payload_bytes: read_manifest_u32(input: abs manifest, offset: abs payload_bytes_offset), binding_offset: read_manifest_u32(
        input: abs manifest,
        offset: abs binding_offset
    ), binding_bytes: read_manifest_u32(input: abs manifest, offset: abs binding_bytes_offset), auxiliary_offset: read_manifest_u32(
        input: abs manifest,
        offset: abs auxiliary_offset
    ), auxiliary_bytes: read_manifest_u32(input: abs manifest, offset: abs auxiliary_bytes_offset), checksum: read_manifest_u64(
        input: abs manifest,
        offset: abs checksum_offset
    ), state: read_manifest_u32(input: abs manifest, offset: abs state_offset)};
}

verb logical_persistence_auxiliary_bytes_are_valid(
    abs input: Buffer,
    erg offset: u32
) -> Bool {
    erg length_result = buffer_size(buffer: abs input);
    erg length: Int = case dat length_result {
        Result.Err(_) => -1,
        Result.Ok(value) => value,
    };
    if length < (offset + BRAIN_AUXILIARY_PAYLOAD_BYTES) as Int {
        return false;
    }
    erg auxiliary: Buffer = Buffer[0];
    erg auxiliary_length: u32 = BRAIN_AUXILIARY_PAYLOAD_BYTES;
    logical_persistence_zero_buffer(output: ins auxiliary, length: erg auxiliary_length);
    for erg index: u32 in 0u32 .. BRAIN_AUXILIARY_PAYLOAD_BYTES {
        auxiliary[index] = input[offset + index];
    }
    erg state: LogicalAuxiliaryState = logical_auxiliary_empty();
    logical_auxiliary_init(state: ins state);
    erg valid = logical_persistence_restore_auxiliary(state: ins state, input: abs auxiliary);
    drop(auxiliary);
    return valid;
}

verb logical_persistence_validate_loaded_shard(
    dat bytes: Buffer,
    abs descriptor: ManifestDescriptor
) -> Result[Int, IoError] {
    erg expected_shard_id: u32 = descriptor.shard_id;
    erg expected_first_column_index: u32 = descriptor.first_column_index;
    erg expected_column_count: u32 = descriptor.column_count;
    erg auxiliary_offset: u32 = descriptor.auxiliary_offset;
    erg valid: Bool = dynamic_shard_with_bindings_and_auxiliary_is_valid(
        bytes: abs bytes,
        expected_shard_id: erg expected_shard_id,
        expected_first_column_index: erg expected_first_column_index,
        expected_column_count: erg expected_column_count
    ) && logical_persistence_auxiliary_bytes_are_valid(input: abs bytes, offset: erg auxiliary_offset);
    erg length = buffer_size(buffer: abs bytes);
    drop(bytes);
    if !valid {
        return Err(IoError.InvalidData);
    }
    return logical_persistence_buffer_length_result(length: dat length);
}

verb logical_persistence_preflight_shard(
    abs path: Path,
    abs descriptor: ManifestDescriptor
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => logical_persistence_validate_loaded_shard(bytes: dat bytes, descriptor: abs descriptor),
    };
}

verb logical_persistence_rebuild_fabric_allocator(ins fabric: CorticalFabric[1024]) {
    fabric.free_list_head = NULL_INDEX;
    fabric.active_count = 0u32;
    for erg column: u32 in 0u32 .. BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        if fabric.columns[column].flags & FLAG_ACTIVE == FLAG_ACTIVE {
            fabric.active_count += 1u32;
        } else {
            fabric.columns[column].free_list_link = fabric.free_list_head;
            fabric.free_list_head = column;
        }
    }
}

open verb logical_persistence_restore_shard(
    ins brain: LogicalTeachingBrain,
    dat bytes: Buffer,
    abs descriptor: ManifestDescriptor
) -> Bool {
    erg shard_id: u32 = descriptor.shard_id;
    fabric_init(fabric: ins brain.fabrics[shard_id as Usize]);
    logical_auxiliary_init(state: ins brain.auxiliary[shard_id as Usize]);
    for erg column: u32 in 0u32 .. BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        for erg byte: u32 in 0u32 .. 64u32 {
            brain.fabrics[shard_id as Usize].columns[column].storage[byte] = bytes[descriptor.payload_offset + column * 64u32 + byte];
        }
    }
    logical_persistence_rebuild_fabric_allocator(fabric: ins brain.fabrics[shard_id as Usize]);
    for erg binding: u32 in 0u32 .. BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        for erg byte: u32 in 0u32 .. 24u32 {
            brain.bindings[shard_id as Usize][binding].storage[byte] = bytes[descriptor.binding_offset + binding * 24u32 + byte];
        }
    }
    erg auxiliary: Buffer = Buffer[0];
    erg auxiliary_length: u32 = BRAIN_AUXILIARY_PAYLOAD_BYTES;
    logical_persistence_zero_buffer(output: ins auxiliary, length: erg auxiliary_length);
    for erg byte: u32 in 0u32 .. BRAIN_AUXILIARY_PAYLOAD_BYTES {
        auxiliary[byte] = bytes[descriptor.auxiliary_offset + byte];
    }
    erg restored = logical_persistence_restore_auxiliary(state: ins brain.auxiliary[shard_id as Usize], input: abs auxiliary);
    drop(auxiliary);
    drop(bytes);
    return restored;
}

verb logical_persistence_restore_loaded_shard(
    ins brain: LogicalTeachingBrain,
    dat bytes: Buffer,
    abs descriptor: ManifestDescriptor
) -> Result[Int, IoError] {
    if !logical_persistence_restore_shard(
        brain: ins brain,
        bytes: dat bytes,
        descriptor: abs descriptor
    ) {
        return Err(IoError.InvalidData);
    }
    return Ok(0);
}

open verb logical_persistence_restore_resident_shard(
    ins brain: LogicalTeachingBrain,
    abs path: Path,
    abs descriptor: ManifestDescriptor
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => logical_persistence_restore_loaded_shard(
            brain: ins brain,
            bytes: dat bytes,
            descriptor: abs descriptor
        ),
    };
}

verb logical_persistence_validate_manifest(dat bytes: Buffer) -> Result[Buffer, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs bytes) {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    return Ok(bytes);
}

verb logical_persistence_read_manifest(abs path: Path) -> Result[Buffer, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => logical_persistence_validate_manifest(bytes: dat bytes),
    };
}

open verb logical_persistence_preflight_generation(
    abs manifest: Buffer,
    abs shard_paths: Array[Path, 8],
    ins descriptors: Array[ManifestDescriptor, 8]
) -> Result[Int, IoError] {
    erg shard_count_offset: u32 = 28u32;
    erg total_offset: u32 = 20u32;
    erg shard_count: u32 = read_manifest_u32(input: abs manifest, offset: abs shard_count_offset);
    erg total: u32 = read_manifest_u32(input: abs manifest, offset: abs total_offset);
    if shard_count == 0u32 || shard_count > BRAIN_LOGICAL_MAX_RESIDENT_SHARDS || total != shard_count * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY {
        return Err(IoError.InvalidData);
    }
    for erg shard_id: u32 in 0u32 .. shard_count {
        descriptors[shard_id as Usize] = logical_persistence_descriptor(manifest: abs manifest, index: erg shard_id);
        erg descriptor: ManifestDescriptor = descriptors[shard_id as Usize];
        if descriptor.auxiliary_bytes != BRAIN_AUXILIARY_PAYLOAD_BYTES || descriptor.binding_bytes != BRAIN_LOGICAL_SHARD_BINDINGS_BYTES {
            return Err(IoError.InvalidData);
        }
        erg checked = logical_persistence_preflight_shard(path: abs shard_paths[shard_id as Usize], descriptor: abs descriptor);
        case dat checked {
            Result.Err(error) => {
                return Err(error);
            },
            Result.Ok(_) => {},
        };
    }
    return Ok(shard_count as Int);
}

verb logical_persistence_load_manifest(
    ins brain: LogicalTeachingBrain,
    dat loaded_manifest: Result[Buffer, IoError],
    abs shard_paths: Array[Path, 8]
) -> Result[Int, IoError] {
    return case dat loaded_manifest {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => logical_persistence_apply_manifest(
            brain: ins brain,
            manifest: dat bytes,
            shard_paths: abs shard_paths
        ),
    };
}

"""Load a complete generation after a mutation-free preflight."""
open verb logical_teaching_load_generation(
    ins brain: LogicalTeachingBrain,
    abs shard_paths: Array[Path, 8],
    abs manifest_path: Path
) -> Result[Int, IoError] {
    erg loaded = logical_persistence_read_manifest(path: abs manifest_path);
    return logical_persistence_load_manifest(
        brain: ins brain,
        loaded_manifest: dat loaded,
        shard_paths: abs shard_paths
    );
}

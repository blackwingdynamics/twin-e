"""Restore validated shard payloads into a logical teaching resident set."""
import std::io;

open io;

open core;

open teaching;

open codec;

open path;

verb logical_persistence_restore_resident_one(
    ins brain: LogicalTeachingBrain,
    abs path: Path,
    abs descriptor: ManifestDescriptor,
    erg shard_id: u32
) -> Result[Int, IoError] {
    erg slot_result = logical_persistence_cache_resident(
        brain: ins brain,
        descriptor: abs descriptor,
        shard_id: erg shard_id
    );
    return case dat slot_result {
        Result.Err(error) => Err(dat error),
        Result.Ok(slot) => logical_persistence_restore_resident_shard(
            brain: ins brain,
            path: abs path,
            descriptor: abs descriptor,
            destination_slot: erg slot
        ),
    };
}

verb logical_persistence_cache_resident(
    ins brain: LogicalTeachingBrain,
    abs descriptor: ManifestDescriptor,
    erg shard_id: u32
) -> Result[u8, IoError] {
    erg generation: u64 = brain.logical.generation;
    erg checksum: u64 = descriptor.checksum;
    erg slot = logical_brain_insert_resident(
        brain: ins brain.logical,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
    return case dat slot {
        Result.Err(_) => Err(IoError.InvalidData),
        Result.Ok(value) => Ok(value),
    };
}

verb logical_persistence_restore_resident_index(
    ins brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    abs manifest: Buffer,
    erg shard_id: u32
) -> Result[Int, IoError] {
    erg shard_path = format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
    erg descriptor = logical_persistence_descriptor(manifest: abs manifest, index: erg shard_id);
    return case dat shard_path {
        Result.Err(_) => Err(IoError.InvalidInput),
        Result.Ok(path) => logical_persistence_restore_resident_one(
            brain: ins brain,
            path: abs path,
            descriptor: abs descriptor,
            shard_id: erg shard_id
        ),
    };
}

open verb logical_persistence_restore_resident(
    ins brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    abs manifest: Buffer
) -> Result[Int, IoError] {
    brain.initialized = true;
    erg resident_count: u32 = brain.logical.shard_count;
    if resident_count > BRAIN_LOGICAL_MAX_RESIDENT_SHARDS {
        resident_count = BRAIN_LOGICAL_MAX_RESIDENT_SHARDS;
    }
    for erg shard_id: u32 in 0u32 .. resident_count {
        erg restored = logical_persistence_restore_resident_index(
            brain: ins brain,
            brain_dir: abs brain_dir,
            manifest: abs manifest,
            shard_id: erg shard_id
        );
        case dat restored {
            Result.Err(error) => {
                return Err(error);
            },
            Result.Ok(_) => {},
        };
    }
    return Ok(resident_count as Int);
}

"""Load one manifest-admitted shard into a bounded resident cache slot."""
open verb logical_persistence_restore_one_shard(
    ins brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    abs manifest: Buffer,
    erg shard_id: u32
) -> Result[Int, IoError] {
    if shard_id >= brain.logical.shard_count {
        return Err(IoError.InvalidInput);
    }
    erg descriptor: ManifestDescriptor = logical_persistence_descriptor(manifest: abs manifest, index: erg shard_id);
    erg shard_path = format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
    return case dat shard_path {
        Result.Err(_) => Err(IoError.InvalidInput),
        Result.Ok(path) => logical_persistence_restore_resident_one(
            brain: ins brain,
            path: abs path,
            descriptor: abs descriptor,
            shard_id: erg shard_id
        ),
    };
}

verb logical_persistence_restore_metadata(
    ins brain: LogicalTeachingBrain,
    abs manifest: Buffer,
    erg shard_count: u32
) -> Bool {
    erg generation_offset: u32 = 12u32;
    erg generation: u64 = read_manifest_u64(input: abs manifest, offset: abs generation_offset);
    erg total_column_offset: u32 = 20u32;
    erg total_column_count: u32 = read_manifest_u32(input: abs manifest, offset: abs total_column_offset);
    erg restored = logical_brain_restore_generation(
        brain: ins brain.logical,
        generation: erg generation,
        total_column_count: erg total_column_count,
        shard_count: abs shard_count
    );
    return case dat restored {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb logical_persistence_prepare_manifest(
    abs manifest: Buffer,
    abs brain_dir: Path
) -> Result[Int, IoError] {
    return logical_persistence_preflight_generation(manifest: abs manifest, brain_dir: abs brain_dir);
}

verb logical_persistence_finish_manifest(
    ins brain: LogicalTeachingBrain,
    dat manifest: Buffer,
    abs brain_dir: Path,
    erg shard_count: u32
) -> Result[Int, IoError] {
    if !logical_persistence_restore_metadata(
        brain: ins brain,
        manifest: abs manifest,
        shard_count: erg shard_count
    ) {
        drop(manifest);
        return Err(IoError.InvalidData);
    }
    erg resident = logical_persistence_restore_resident(
        brain: ins brain,
        brain_dir: abs brain_dir,
        manifest: abs manifest
    );
    drop(manifest);
    return resident;
}

open verb logical_persistence_apply_manifest(
    ins brain: LogicalTeachingBrain,
    dat manifest: Buffer,
    abs brain_dir: Path
) -> Result[Int, IoError] {
    erg prepared = logical_persistence_prepare_manifest(manifest: abs manifest, brain_dir: abs brain_dir);
    erg shard_count: u32 = 0u32;
    case dat prepared {
        Result.Err(error) => {
            drop(manifest);
            return Err(error);
        },
        Result.Ok(value) => {
            shard_count = value as u32;
        },
    };
    return logical_persistence_finish_manifest(
        brain: ins brain,
        manifest: dat manifest,
        brain_dir: abs brain_dir,
        shard_count: erg shard_count
    );
}

"""Write complete logical teaching generations."""
import config;

import std::io;

open config;

open io;

open manifest;

open shard;

open core;

open teaching;

open codec;

verb logical_persistence_append_descriptor(
    ins output: Buffer,
    erg shard_id: u32,
    erg checksum: u64
) {
    append_manifest_u32(output: ins output, value: abs shard_id);
    append_manifest_u32(output: ins output, value: abs shard_id * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY);
    append_manifest_u32(output: ins output, value: abs BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY);
    append_manifest_u32(output: ins output, value: abs BRAIN_SHARD_HEADER_BYTES as u32);
    append_manifest_u32(output: ins output, value: abs BRAIN_LOGICAL_SHARD_COLUMNS_BYTES);
    append_manifest_u32(output: ins output, value: abs BRAIN_SHARD_HEADER_BYTES as u32 + BRAIN_LOGICAL_SHARD_COLUMNS_BYTES);
    append_manifest_u32(output: ins output, value: abs BRAIN_LOGICAL_SHARD_BINDINGS_BYTES);
    append_manifest_u32(output: ins output, value: abs BRAIN_SHARD_HEADER_BYTES as u32 + BRAIN_LOGICAL_SHARD_COLUMNS_BYTES + BRAIN_LOGICAL_SHARD_BINDINGS_BYTES);
    append_manifest_u32(output: ins output, value: abs BRAIN_AUXILIARY_PAYLOAD_BYTES);
    append_manifest_u64(output: ins output, value: abs checksum);
    append_manifest_u32(output: ins output, value: abs 1u32);
}

verb logical_persistence_write_resident_shard(
    abs brain: LogicalTeachingBrain,
    abs path: Path,
    erg shard_id: u32,
    erg slot: u8
) -> Result[u64, IoError] {
    erg payload = logical_persistence_columns(fabric: abs brain.fabrics[slot as Usize]);
    erg bindings = logical_persistence_bindings(bindings: abs brain.bindings[slot as Usize]);
    erg auxiliary = logical_persistence_auxiliary(state: abs brain.auxiliary[slot as Usize]);
    erg first_column_index: u32 = shard_id * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    erg column_count: u32 = BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    erg written = write_dynamic_shard_with_bindings_and_auxiliary(
        path: abs path,
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload: abs payload,
        bindings: abs bindings,
        auxiliary: abs auxiliary
    );
    drop(payload);
    drop(bindings);
    drop(auxiliary);
    return case dat written {
        Result.Err(error) => Err(error),
        Result.Ok(_) => logical_persistence_checksum_after_write(path: abs path),
    };
}

verb logical_persistence_checksum_after_write(abs path: Path) -> Result[u64, IoError] {
    erg checksum = dynamic_shard_file_checksum(path: abs path);
    return case dat checksum {
        Result.Err(error) => Err(error),
        Result.Ok(value) => Ok(value),
    };
}

verb logical_persistence_save_one_shard(
    abs brain: LogicalTeachingBrain,
    abs path: Path,
    erg shard_id: u32
) -> Result[u64, IoError] {
    erg found = logical_brain_resident_slot(brain: abs brain.logical, shard_id: erg shard_id);
    return case dat found {
        Option.None => dynamic_shard_file_checksum(path: abs path),
        Option.Some(slot) => logical_persistence_write_resident_shard(
            brain: abs brain,
            path: abs path,
            shard_id: erg shard_id,
            slot: erg slot
        ),
    };
}

verb logical_persistence_save_profile_is_valid(abs brain: LogicalTeachingBrain) -> Bool {
    return brain.initialized && brain.logical.shard_count != 0u32 && brain.logical.shard_count <= BRAIN_LOGICAL_MAX_SHARDS;
}

verb logical_persistence_save_shard_and_append(
    abs brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    ins descriptors: Buffer,
    erg shard_id: u32
) -> Result[Int, IoError] {
    erg shard_path = format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
    return case dat shard_path {
        Result.Err(_) => Err(IoError.InvalidInput),
        Result.Ok(path) => {
            erg checksum = logical_persistence_save_one_shard(
                brain: abs brain,
                path: abs path,
                shard_id: erg shard_id
            );
            return case dat checksum {
                Result.Err(error) => Err(dat error),
                Result.Ok(value) => {
                    logical_persistence_append_descriptor(
                        output: ins descriptors,
                        shard_id: erg shard_id,
                        checksum: erg value
                    );
                    Ok(0);
                },
            };
        },
    };
}

verb logical_persistence_save_shards(
    abs brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    ins descriptors: Buffer
) -> Result[Int, IoError] {
    if !logical_persistence_save_profile_is_valid(brain: abs brain) {
        return Err(IoError.InvalidInput);
    }
    for erg shard_id: u32 in 0u32 .. brain.logical.shard_count {
        erg saved = logical_persistence_save_shard_and_append(
            brain: abs brain,
            brain_dir: abs brain_dir,
            descriptors: ins descriptors,
            shard_id: erg shard_id
        );
        case dat saved {
            Result.Err(error) => {
                return Err(error);
            },
            Result.Ok(_) => {},
        };
    }
    return Ok(brain.logical.shard_count as Int);
}

verb logical_persistence_write_manifest(
    abs brain: LogicalTeachingBrain,
    abs manifest_path: Path,
    abs descriptors: Buffer,
    erg generation: u64
) -> Result[Int, IoError] {
    erg active_count: u32 = brain.logical.total_column_count;
    erg free_list_head: u32 = 0u32;
    erg total_column_count: u32 = brain.logical.total_column_count;
    erg shard_count: u32 = brain.logical.shard_count;
    return write_manifest_dynamic(
        path: abs manifest_path,
        generation: erg generation,
        active_count: erg active_count,
        free_list_head: erg free_list_head,
        total_column_count: erg total_column_count,
        shard_count: erg shard_count,
        descriptors: abs descriptors
    );
}

verb logical_persistence_write_generation_manifest(
    abs brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    abs descriptors: Buffer,
    erg generation: u64
) -> Result[Int, IoError] {
    erg manifest_path = logical_manifest_path(brain_dir: abs brain_dir);
    return case dat manifest_path {
        Result.Err(_) => Err(IoError.InvalidInput),
        Result.Ok(path) => logical_persistence_write_manifest(
            brain: abs brain,
            manifest_path: abs path,
            descriptors: abs descriptors,
            generation: erg generation
        ),
    };
}

"""Write all resident logical shards and then their complete manifest."""
open verb logical_teaching_save_generation(
    abs brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    erg generation: u64
) -> Result[Int, IoError] {
    erg descriptors: Buffer = Buffer[0];
    erg descriptor_capacity: Int = (brain.logical.shard_count * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) as Int;
    erg reserved = reserve(buffer: ins descriptors, capacity: erg descriptor_capacity);
    erg saved = logical_persistence_save_shards(
        brain: abs brain,
        brain_dir: abs brain_dir,
        descriptors: ins descriptors
    );
    case dat saved {
        Result.Err(error) => {
            drop(descriptors);
            return Err(error);
        },
        Result.Ok(_) => {},
    };
    erg result = logical_persistence_write_generation_manifest(
        brain: abs brain,
        brain_dir: abs brain_dir,
        descriptors: abs descriptors,
        generation: erg generation
    );
    drop(descriptors);
    return result;
}

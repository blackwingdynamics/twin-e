"""Bounded resident teaching over the canonical logical-brain facade.

Each resident shard owns one fixed 1024-column fabric and one matching
shard-local binding array. Admission is decided before training mutation; a
sequence that cannot fit in the current shard rotates to the next logical
shard, while dirty-cache pressure returns `FlushRequired` to the caller.
"""
import config;

import std::io;

import tokenizer;

open config;

open core;

open auxiliary;

open io;

open runtime;

open tokenizer;

"""Failures returned by the bounded logical teaching boundary."""
open enum LogicalTeachingError {
    NotInitialized,
    FlushRequired,
    LogicalCapacityExceeded,
    ResidentCapacityExceeded,
    TrainingRejected,
}

"""Resident multi-shard teaching state with fixed inline storage."""
open struct LogicalTeachingBrain {
    erg initialized: Bool,
    erg logical: LogicalBrain,
    erg fabrics: Array[CorticalFabric[1024], 8],
    erg bindings: Array[Array[TokenBinding, 1024], 8],
    erg auxiliary: Array[LogicalAuxiliaryState, 8],
    erg cache_slots: Array[u8, 8],
}

open verb logical_teaching_shard_transitions(abs brain: LogicalTeachingBrain) -> u32 {
    return brain.logical.shard_transitions;
}

open verb logical_teaching_empty() -> LogicalTeachingBrain {
    return LogicalTeachingBrain {initialized: false, logical: logical_brain_empty(), fabrics: Array[CorticalFabric[1024], 8](
    ), bindings: Array[Array[TokenBinding, 1024], 8](), auxiliary: Array[LogicalAuxiliaryState, 8](
    ), cache_slots: Array[u8, 8]()};
}

open verb logical_teaching_init(ins brain: LogicalTeachingBrain) -> Result[Int, LogicalTeachingError] {
    erg initialized = logical_brain_init(brain: ins brain.logical);
    return case dat initialized {
        Result.Err(_) => Result[Int, LogicalTeachingError].Err(LogicalTeachingError.ResidentCapacityExceeded),
        Result.Ok(_) => {
            brain.initialized = true;
            Result[Int, LogicalTeachingError].Ok(0);
        },
    };
}

verb logical_teaching_admission_error(erg error: LogicalBrainError) -> LogicalTeachingError {
    return case error {
        LogicalBrainError.FlushRequired => LogicalTeachingError.FlushRequired,
        LogicalBrainError.LogicalCapacityExceeded => LogicalTeachingError.LogicalCapacityExceeded,
        LogicalBrainError.ResidentCapacityExceeded => LogicalTeachingError.ResidentCapacityExceeded,
        _ => LogicalTeachingError.TrainingRejected,
    };
}

verb logical_teaching_admit_next(ins brain: LogicalTeachingBrain) -> Result[u8, LogicalTeachingError] {
    if brain.logical.shard_count >= BRAIN_LOGICAL_MAX_SHARDS {
        return Result[u8, LogicalTeachingError].Err(LogicalTeachingError.LogicalCapacityExceeded);
    }
    erg next_id: u32 = brain.logical.shard_count;
    erg capacity: u32 = BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    erg admitted = logical_brain_admit_shard(
        brain: ins brain.logical,
        shard_id: erg next_id,
        column_count: erg capacity
    );
    return case dat admitted {
        Result.Err(error) => Result[u8, LogicalTeachingError].Err(logical_teaching_admission_error(
            error: erg error
        )),
        Result.Ok(slot) => {
            fabric_init(fabric: ins brain.fabrics[next_id as Usize]);
            logical_auxiliary_init(state: ins brain.auxiliary[next_id as Usize]);
            brain.cache_slots[next_id as Usize] = slot;
            Result[u8, LogicalTeachingError].Ok(slot);
        },
    };
}

verb logical_teaching_required_columns(abs sequence: TokenSequence) -> u32 {
    return sequence.length + 1u32;
}

verb logical_teaching_ensure_capacity(
    ins brain: LogicalTeachingBrain,
    abs sequence: TokenSequence
) -> Result[u8, LogicalTeachingError] {
    erg required: u32 = logical_teaching_required_columns(sequence: abs sequence);
    if brain.logical.shard_count == 0u32 {
        return logical_teaching_admit_next(brain: ins brain);
    }
    erg shard_id: u32 = brain.logical.shard_count - 1u32;
    erg used: u32 = brain.fabrics[shard_id as Usize].active_count;
    if used <= BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY - required {
        return Result[u8, LogicalTeachingError].Ok(brain.cache_slots[shard_id as Usize]);
    }
    return logical_teaching_admit_next(brain: ins brain);
}

verb logical_teaching_run_on_shard(
    ins brain: LogicalTeachingBrain,
    abs sequence: TokenSequence,
    erg shard_id: u32,
    erg cache_slot: u8
) -> Result[TrainingMetrics, LogicalTeachingError] {
    erg local_fabric: CorticalFabric[1024] = brain.fabrics[shard_id as Usize];
    erg local_bindings: Array[TokenBinding,1024] = brain.bindings[shard_id as Usize];
    erg local_auxiliary: LogicalAuxiliaryState = brain.auxiliary[shard_id as Usize];
    erg target_base: u32 = shard_id * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    erg trained = train_token_sequence_with_auxiliary(
        fabric: ins local_fabric,
        bindings: ins local_bindings,
        table: ins local_auxiliary.table,
        sequence: abs sequence,
        target_base: erg target_base
    );
    return case dat trained {
        Result.Err(_) => Result[TrainingMetrics, LogicalTeachingError].Err(LogicalTeachingError.TrainingRejected),
        Result.Ok(metrics) => {
            brain.fabrics[shard_id as Usize] = local_fabric;
            brain.bindings[shard_id as Usize] = local_bindings;
            brain.auxiliary[shard_id as Usize] = local_auxiliary;
            shard_cache_mark_dirty(cache: ins brain.logical.cache, slot: erg cache_slot);
            Result[TrainingMetrics, LogicalTeachingError].Ok(metrics);
        },
    };
}

"""Teach one validated sequence without synchronous persistence I/O."""
open verb logical_teaching_sequence(
    ins brain: LogicalTeachingBrain,
    abs sequence: TokenSequence
) -> Result[TrainingMetrics, LogicalTeachingError] {
    erg admitted = validate_training_sequence(sequence: abs sequence);
    erg admission_status: Int = case dat admitted {
        Result.Err(_) => 1,
        Result.Ok(_) => 0,
    };
    if admission_status != 0 {
        return Result[TrainingMetrics, LogicalTeachingError].Err(LogicalTeachingError.TrainingRejected);
    }
    erg slot = logical_teaching_ensure_capacity(brain: ins brain, sequence: abs sequence);
    erg current_shard_id: u32 = brain.logical.shard_count - 1u32;
    return case dat slot {
        Result.Err(error) => Result[TrainingMetrics, LogicalTeachingError].Err(error),
        Result.Ok(cache_slot) => logical_teaching_run_on_shard(
            brain: ins brain,
            sequence: abs sequence,
            shard_id: erg current_shard_id,
            cache_slot: erg cache_slot
        ),
    };
}

verb logical_teaching_auxiliary_location(
    abs brain: LogicalTeachingBrain,
    erg global_index: u32
) -> Result[LogicalColumnLocation, LogicalAuxiliaryError] {
    erg location_result = logical_column_location(global_index: erg global_index);
    erg location: LogicalColumnLocation = LogicalColumnLocation {global_index: 0u32, shard_id: 0u32, local_index: 0u32};
    erg valid: Bool = true;
    erg failure: LogicalAuxiliaryError = LogicalAuxiliaryError.InvalidIndex;
    case dat location_result {
        Result.Err(_) => {
            valid = false;
        },
        Result.Ok(value) => {
            erg shard_id: u32 = value.shard_id;
            location = value;
            if shard_id >= brain.logical.shard_count {
                valid = false;
                failure = LogicalAuxiliaryError.ShardNotAdmitted;
            }
        },
    };
    if !valid {
        return Result[LogicalColumnLocation, LogicalAuxiliaryError].Err(failure);
    }
    return Result[LogicalColumnLocation, LogicalAuxiliaryError].Ok(location);
}

verb logical_teaching_apply_auxiliary_link(
    ins brain: LogicalTeachingBrain,
    abs source: LogicalColumnLocation,
    abs target: LogicalColumnLocation
) -> Result[Int, LogicalAuxiliaryError] {
    erg source_local: u32 = source.local_index;
    erg target_global: u32 = target.global_index;
    erg linked = logical_auxiliary_link(
        state: ins brain.auxiliary[source.shard_id as Usize],
        source_local: erg source_local,
        target_global: erg target_global
    );
    return case dat linked {
        Result.Err(error) => Result[Int, LogicalAuxiliaryError].Err(error),
        Result.Ok(value) => {
            brain.fabrics[source.shard_id as Usize].columns[source_local].flags |= FLAG_HAS_AUX;
            Result[Int, LogicalAuxiliaryError].Ok(value);
        },
    };
}

struct LogicalAuxiliaryLocations {
    erg source: LogicalColumnLocation,
    erg target: LogicalColumnLocation,
}

verb logical_teaching_resolve_auxiliary_location(
    abs brain: LogicalTeachingBrain,
    erg global_index: u32,
    ins location: LogicalColumnLocation,
    ins failure: LogicalAuxiliaryError
) -> Bool {
    erg resolved = logical_teaching_auxiliary_location(brain: abs brain, global_index: erg global_index);
    return case dat resolved {
        Result.Err(error) => {
            failure = error;
            false;
        },
        Result.Ok(value) => {
            location = value;
            true;
        },
    };
}

verb logical_teaching_auxiliary_locations(
    abs brain: LogicalTeachingBrain,
    erg source_global: u32,
    erg target_global: u32
) -> Result[LogicalAuxiliaryLocations, LogicalAuxiliaryError] {
    erg source: LogicalColumnLocation = LogicalColumnLocation {global_index: 0u32, shard_id: 0u32, local_index: 0u32};
    erg target: LogicalColumnLocation = LogicalColumnLocation {global_index: 0u32, shard_id: 0u32, local_index: 0u32};
    erg failure: LogicalAuxiliaryError = LogicalAuxiliaryError.InvalidIndex;
    if !logical_teaching_resolve_auxiliary_location(
        brain: abs brain,
        global_index: erg source_global,
        location: ins source,
        failure: ins failure
    ) {
        return Result[LogicalAuxiliaryLocations, LogicalAuxiliaryError].Err(failure);
    }
    if !logical_teaching_resolve_auxiliary_location(
        brain: abs brain,
        global_index: erg target_global,
        location: ins target,
        failure: ins failure
    ) {
        return Result[LogicalAuxiliaryLocations, LogicalAuxiliaryError].Err(failure);
    }
    return Result[LogicalAuxiliaryLocations, LogicalAuxiliaryError].Ok(LogicalAuxiliaryLocations {source: source, target: target});
}

"""Link a global cross-shard successor in the source shard's sidecar."""
open verb logical_teaching_auxiliary_link(
    ins brain: LogicalTeachingBrain,
    erg source_global: u32,
    erg target_global: u32
) -> Result[Int, LogicalAuxiliaryError] {
    if !brain.initialized {
        return Result[Int, LogicalAuxiliaryError].Err(LogicalAuxiliaryError.NotInitialized);
    }
    erg locations = logical_teaching_auxiliary_locations(
        brain: abs brain,
        source_global: erg source_global,
        target_global: erg target_global
    );
    return case dat locations {
        Result.Err(error) => Result[Int, LogicalAuxiliaryError].Err(dat error),
        Result.Ok(value) => logical_teaching_apply_auxiliary_link(
            brain: ins brain,
            source: abs value.source,
            target: abs value.target
        ),
    };
}

"""Release one source sidecar and its marker as one bounded operation."""
open verb logical_teaching_auxiliary_release(
    ins brain: LogicalTeachingBrain,
    erg source_global: u32
) -> Bool {
    if !brain.initialized {
        return false;
    }
    erg source: LogicalColumnLocation = LogicalColumnLocation {global_index: 0u32, shard_id: 0u32, local_index: 0u32};
    erg source_result = logical_teaching_auxiliary_location(brain: abs brain, global_index: erg source_global);
    case dat source_result {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(value) => {
            source = value;
        },
    };
    erg local_auxiliary: LogicalAuxiliaryState = brain.auxiliary[source.shard_id as Usize];
    erg source_local: u32 = source.local_index;
    erg released = logical_auxiliary_release(state: ins local_auxiliary, source_local: erg source_local);
    brain.auxiliary[source.shard_id as Usize] = local_auxiliary;
    if released {
        brain.fabrics[source.shard_id as Usize].columns[source_local].flags &= ~FLAG_HAS_AUX;
    }
    return released;
}

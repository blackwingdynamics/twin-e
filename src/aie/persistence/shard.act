meta limitless("file")
"""Position-independent metadata for one bounded brain storage shard."""
import config;
import std::fs;
import std::io;

"""Describes one contiguous logical arena range and its sidecar payload."""
open struct ShardHeader {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg column_stride_bytes: u16,
    erg binding_stride_bytes: u16,
    erg column_payload_bytes: u32,
    erg binding_payload_bytes: u32,
    erg tokenizer_version: u16,
    erg context_version: u16,
    erg code_version: u16,
    erg reserved: u16,
    erg checksum: u64,
}

"""Accept a shard header only when its layout and compatibility profile match."""
open verb shard_header_is_valid(abs header: ShardHeader) -> Bool {
    return header.magic == BRAIN_SHARD_MAGIC && header.version == BRAIN_SHARD_VERSION && header.header_bytes == BRAIN_SHARD_HEADER_BYTES && header.column_stride_bytes == BRAIN_SHARD_COLUMN_STRIDE_BYTES && header.binding_stride_bytes == BRAIN_SHARD_BINDING_STRIDE_BYTES && header.tokenizer_version == TOKENIZER_VERSION && header.context_version == CONTEXT_VERSION && header.code_version == TOKEN_CODE_VERSION;
}

open verb shard_header_matches(abs header: ShardHeader, erg shard_id: u32) -> Bool {
    return shard_header_is_valid(header: abs header) && header.shard_id == shard_id && header.first_column_index == (shard_id * BRAIN_SHARD_COLUMN_COUNT) && header.column_count == BRAIN_SHARD_COLUMN_COUNT && header.column_payload_bytes == BRAIN_SHARD_COLUMN_PAYLOAD_BYTES && header.binding_payload_bytes == BRAIN_SHARD_BINDING_PAYLOAD_BYTES;
}

verb append_shard_u16(ins output: Buffer, abs value: u16) {
    append(output, value as u8);
    append(output, ((value as u32 / 256u32) & 255u32) as u8);
}

verb append_shard_u32(ins output: Buffer, abs value: u32) {
    append(output, (value & 255u32) as u8);
    append(output, ((value / 256u32) & 255u32) as u8);
    append(output, ((value / 65536u32) & 255u32) as u8);
    append(output, ((value / 16777216u32) & 255u32) as u8);
}

verb append_shard_u64(ins output: Buffer, abs value: u64) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    append_shard_u32(output: ins output, value: abs low);
    append_shard_u32(output: ins output, value: abs high);
}

verb read_shard_u16(abs input: Buffer, abs offset: u32) -> u16 {
    return (input[offset] as u16) + (((input[offset + 1u32] as u16) * 256u16));
}

verb read_shard_u32(abs input: Buffer, abs offset: u32) -> u32 {
    return (input[offset] as u32) + ((input[offset + 1u32] as u32 * 256u32)) + ((input[offset + 2u32] as u32 * 65536u32)) + ((input[offset + 3u32] as u32 * 16777216u32));
}

verb read_shard_u64(abs input: Buffer, abs offset: u32) -> u64 {
    erg low: u64 = read_shard_u32(input: abs input, offset: abs offset) as u64;
    erg high_offset: u32 = offset + 4u32;
    erg high: u64 = read_shard_u32(input: abs input, offset: abs high_offset) as u64;
    return low + (high * 4294967296u64);
}

verb shard_payload_checksum(abs input: Buffer) -> u64 {
    erg checksum: u64 = 0u64;
    erg index: u32 = 48u32;
    loop {
        if index >= BRAIN_SHARD_FILE_BYTES {
            break;
        }
        checksum += (input[index] as u64) * ((index - 47u32) as u64);
        index += 1u32;
    }
    return checksum;
}

verb write_shard_u64(ins output: Buffer, abs value: u64, abs offset: u32) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    output[offset] = (low & 255u32) as u8;
    output[offset + 1u32] = ((low / 256u32) & 255u32) as u8;
    output[offset + 2u32] = ((low / 65536u32) & 255u32) as u8;
    output[offset + 3u32] = ((low / 16777216u32) & 255u32) as u8;
    output[offset + 4u32] = (high & 255u32) as u8;
    output[offset + 5u32] = ((high / 256u32) & 255u32) as u8;
    output[offset + 6u32] = ((high / 65536u32) & 255u32) as u8;
    output[offset + 7u32] = ((high / 16777216u32) & 255u32) as u8;
}

verb shard_io_error(dat error: IoError) -> Result[Int, IoError] {
    return case dat error {
        IoError.EndOfStream => Err(IoError.EndOfStream),
        IoError.Failed => Err(IoError.Failed),
        IoError.InvalidInput => Err(IoError.InvalidInput),
        IoError.InvalidData => Err(IoError.InvalidData),
    };
}

open verb write_shard(abs path: Path, abs fabric: CorticalFabric[64], erg shard_id: u32) -> Result[Int, IoError] {
    if shard_id >= 2u32 {
        return Err(IoError.InvalidInput);
    }
    erg output: Buffer = Buffer[0];
    erg capacity: Int = BRAIN_SHARD_FILE_BYTES as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg magic: u32 = BRAIN_SHARD_MAGIC;
    erg version: u16 = BRAIN_SHARD_VERSION;
    erg header_bytes: u16 = BRAIN_SHARD_HEADER_BYTES;
    erg first_column_index: u32 = shard_id * BRAIN_SHARD_COLUMN_COUNT;
    erg column_count: u32 = BRAIN_SHARD_COLUMN_COUNT;
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    erg column_payload: u32 = BRAIN_SHARD_COLUMN_PAYLOAD_BYTES;
    erg binding_payload: u32 = BRAIN_SHARD_BINDING_PAYLOAD_BYTES;
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u16: u16 = 0u16;
    erg zero_u64: u64 = 0u64;
    append_shard_u32(output: ins output, value: abs magic);
    append_shard_u16(output: ins output, value: abs version);
    append_shard_u16(output: ins output, value: abs header_bytes);
    append_shard_u32(output: ins output, value: abs shard_id);
    append_shard_u32(output: ins output, value: abs first_column_index);
    append_shard_u32(output: ins output, value: abs column_count);
    append_shard_u16(output: ins output, value: abs column_stride);
    append_shard_u16(output: ins output, value: abs binding_stride);
    append_shard_u32(output: ins output, value: abs column_payload);
    append_shard_u32(output: ins output, value: abs binding_payload);
    append_shard_u16(output: ins output, value: abs tokenizer_version);
    append_shard_u16(output: ins output, value: abs context_version);
    append_shard_u16(output: ins output, value: abs code_version);
    append_shard_u16(output: ins output, value: abs zero_u16);
    append_shard_u64(output: ins output, value: abs zero_u64);
    erg column: u32 = 0u32;
    erg first: u32 = first_column_index;
    loop {
        if column >= BRAIN_SHARD_COLUMN_COUNT {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            append(output, fabric.columns[first + column].storage[byte]);
            byte += 1u32;
        }
        column += 1u32;
    }
    erg checksum: u64 = shard_payload_checksum(input: abs output);
    erg checksum_offset: u32 = 40u32;
    write_shard_u64(output: ins output, value: abs checksum, offset: abs checksum_offset);
    return write_file(path: abs path, contents: abs output);
}

open verb read_shard_bytes(ins fabric: CorticalFabric[64], dat bytes: Buffer, erg shard_id: u32) -> Result[Int, IoError] {
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != BRAIN_SHARD_FILE_BYTES as Int {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg offset_0: u32 = 0u32;
    erg offset_4: u32 = 4u32;
    erg offset_6: u32 = 6u32;
    erg offset_8: u32 = 8u32;
    erg offset_12: u32 = 12u32;
    erg offset_16: u32 = 16u32;
    erg offset_20: u32 = 20u32;
    erg offset_22: u32 = 22u32;
    erg offset_24: u32 = 24u32;
    erg offset_28: u32 = 28u32;
    erg offset_32: u32 = 32u32;
    erg offset_34: u32 = 34u32;
    erg offset_36: u32 = 36u32;
    erg offset_38: u32 = 38u32;
    erg checksum_offset: u32 = 40u32;
    erg header: ShardHeader = ShardHeader {magic: read_shard_u32(input: abs bytes, offset: abs offset_0), version: read_shard_u16(input: abs bytes, offset: abs offset_4), header_bytes: read_shard_u16(input: abs bytes, offset: abs offset_6), shard_id: read_shard_u32(input: abs bytes, offset: abs offset_8), first_column_index: read_shard_u32(input: abs bytes, offset: abs offset_12), column_count: read_shard_u32(input: abs bytes, offset: abs offset_16), column_stride_bytes: read_shard_u16(input: abs bytes, offset: abs offset_20), binding_stride_bytes: read_shard_u16(input: abs bytes, offset: abs offset_22), column_payload_bytes: read_shard_u32(input: abs bytes, offset: abs offset_24), binding_payload_bytes: read_shard_u32(input: abs bytes, offset: abs offset_28), tokenizer_version: read_shard_u16(input: abs bytes, offset: abs offset_32), context_version: read_shard_u16(input: abs bytes, offset: abs offset_34), code_version: read_shard_u16(input: abs bytes, offset: abs offset_36), reserved: read_shard_u16(input: abs bytes, offset: abs offset_38), checksum: read_shard_u64(input: abs bytes, offset: abs checksum_offset)};
    erg actual_checksum: u64 = shard_payload_checksum(input: abs bytes);
    if !shard_header_matches(header: abs header, shard_id: erg shard_id) || header.checksum != actual_checksum {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg column: u32 = 0u32;
    erg first: u32 = shard_id * BRAIN_SHARD_COLUMN_COUNT;
    loop {
        if column >= BRAIN_SHARD_COLUMN_COUNT {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            fabric.columns[first + column].storage[byte] = bytes[48u32 + (column * 64u32) + byte];
            byte += 1u32;
        }
        column += 1u32;
    }
    drop(bytes);
    return Ok(length);
}

open verb read_shard(ins fabric: CorticalFabric[64], abs path: Path, erg shard_id: u32) -> Result[Int, IoError] {
    if shard_id >= 2u32 {
        return Err(IoError.InvalidInput);
    }
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => shard_io_error(error: dat error),
        Result.Ok(bytes) => read_shard_bytes(fabric: ins fabric, bytes: dat bytes, shard_id: erg shard_id),
    };
}

verb shard_checksum_bytes(dat bytes: Buffer) -> Result[u64, IoError] {
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != BRAIN_SHARD_FILE_BYTES as Int {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg checksum_offset: u32 = 40u32;
    erg checksum: u64 = read_shard_u64(input: abs bytes, offset: abs checksum_offset);
    drop(bytes);
    return Ok(checksum);
}

open verb shard_file_checksum(abs path: Path) -> Result[u64, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => {
            erg mapped_result = shard_io_error(error: dat error);
            return case dat mapped_result {
                Result.Err(mapped) => Err(mapped),
                Result.Ok(_) => Err(IoError.InvalidData),
            };
        },
        Result.Ok(bytes) => shard_checksum_bytes(bytes: dat bytes),
    };
}

verb shard_dynamic_checksum(abs input: Buffer, erg length: u32) -> u64 {
    erg checksum: u64 = 0u64;
    erg index: u32 = BRAIN_SHARD_HEADER_BYTES as u32;
    loop {
        if index >= length {
            break;
        }
        checksum += (input[index] as u64) * ((index - 47u32) as u64);
        index += 1u32;
    }
    return checksum;
}

open verb dynamic_shard_file_checksum(abs path: Path) -> Result[u64, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => {
            erg length_result = buffer_length(buffer: abs bytes);
            return case dat length_result {
                Result.Err(_) => Err(IoError.InvalidData),
                Result.Ok(length) => {
                    if length < BRAIN_SHARD_HEADER_BYTES as Int {
                        drop(bytes);
                        return Err(IoError.InvalidData);
                    } else {
                    }
                    erg length_u32: u32 = length as u32;
                    erg checksum_offset: u32 = 40u32;
                    erg stored_checksum: u64 = read_shard_u64(input: abs bytes, offset: abs checksum_offset);
                    erg actual_checksum: u64 = shard_dynamic_checksum(input: abs bytes, length: erg length_u32);
                    drop(bytes);
                    if stored_checksum != actual_checksum {
                        return Err(IoError.InvalidData);
                    } else {
                    }
                    return Ok(stored_checksum);
                },
            };
        },
    };
}

open verb write_dynamic_shard(
    abs path: Path,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    abs payload: Buffer
) -> Result[Int, IoError] {
    erg payload_length_result = buffer_length(buffer: abs payload);
    erg payload_length: Int = case dat payload_length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    erg expected_payload_bytes: u32 = column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    if column_count == 0u32 || column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS || first_column_index > 4294967295u32 - column_count || payload_length != expected_payload_bytes as Int {
        return Err(IoError.InvalidInput);
    }
    erg file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + expected_payload_bytes;
    if file_length > BRAIN_SHARD_DYNAMIC_MAX_BYTES {
        return Err(IoError.InvalidInput);
    }
    erg output: Buffer = Buffer[0];
    erg capacity: Int = file_length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg magic: u32 = BRAIN_SHARD_MAGIC;
    erg version: u16 = BRAIN_SHARD_VERSION;
    erg header_bytes: u16 = BRAIN_SHARD_HEADER_BYTES;
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    erg binding_payload: u32 = 0u32;
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u16: u16 = 0u16;
    erg zero_u64: u64 = 0u64;
    append_shard_u32(output: ins output, value: abs magic);
    append_shard_u16(output: ins output, value: abs version);
    append_shard_u16(output: ins output, value: abs header_bytes);
    append_shard_u32(output: ins output, value: abs shard_id);
    append_shard_u32(output: ins output, value: abs first_column_index);
    append_shard_u32(output: ins output, value: abs column_count);
    append_shard_u16(output: ins output, value: abs column_stride);
    append_shard_u16(output: ins output, value: abs binding_stride);
    append_shard_u32(output: ins output, value: abs expected_payload_bytes);
    append_shard_u32(output: ins output, value: abs binding_payload);
    append_shard_u16(output: ins output, value: abs tokenizer_version);
    append_shard_u16(output: ins output, value: abs context_version);
    append_shard_u16(output: ins output, value: abs code_version);
    append_shard_u16(output: ins output, value: abs zero_u16);
    append_shard_u64(output: ins output, value: abs zero_u64);
    erg payload_index: u32 = 0u32;
    loop {
        if payload_index >= expected_payload_bytes {
            break;
        }
        append(output, payload[payload_index]);
        payload_index += 1u32;
    }
    erg checksum: u64 = shard_dynamic_checksum(input: abs output, length: erg file_length);
    erg checksum_offset: u32 = 40u32;
    write_shard_u64(output: ins output, value: abs checksum, offset: abs checksum_offset);
    return write_file(path: abs path, contents: abs output);
}

open verb publish_dynamic_shard(
    abs staged: Path,
    abs active: Path,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs staged);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => {
            erg validated = validate_dynamic_shard_bytes(bytes: dat bytes, expected_shard_id: erg expected_shard_id, expected_first_column_index: erg expected_first_column_index, expected_column_count: erg expected_column_count);
            return case dat validated {
                Result.Err(error) => Err(error),
                Result.Ok(_) => rename(from: abs staged, to: abs active),
            };
        },
    };
}

open verb write_dynamic_shard_with_bindings(
    abs path: Path,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    abs payload: Buffer,
    abs bindings: Buffer
) -> Result[Int, IoError] {
    erg payload_length_result = buffer_length(buffer: abs payload);
    erg payload_length: Int = case dat payload_length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    erg bindings_length_result = buffer_length(buffer: abs bindings);
    erg bindings_length: Int = case dat bindings_length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    erg expected_payload_bytes: u32 = column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg expected_binding_bytes: u32 = column_count * BRAIN_SHARD_BINDING_STRIDE_BYTES as u32;
    if column_count == 0u32 || column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS || first_column_index > 4294967295u32 - column_count || payload_length != expected_payload_bytes as Int || bindings_length != expected_binding_bytes as Int {
        return Err(IoError.InvalidInput);
    }
    erg file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + expected_payload_bytes + expected_binding_bytes;
    if file_length > BRAIN_SHARD_DYNAMIC_MAX_BYTES {
        return Err(IoError.InvalidInput);
    }
    erg output: Buffer = Buffer[0];
    erg capacity: Int = file_length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg magic: u32 = BRAIN_SHARD_MAGIC;
    erg version: u16 = BRAIN_SHARD_VERSION;
    erg header_bytes: u16 = BRAIN_SHARD_HEADER_BYTES;
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u16: u16 = 0u16;
    erg zero_u64: u64 = 0u64;
    append_shard_u32(output: ins output, value: abs magic);
    append_shard_u16(output: ins output, value: abs version);
    append_shard_u16(output: ins output, value: abs header_bytes);
    append_shard_u32(output: ins output, value: abs shard_id);
    append_shard_u32(output: ins output, value: abs first_column_index);
    append_shard_u32(output: ins output, value: abs column_count);
    append_shard_u16(output: ins output, value: abs column_stride);
    append_shard_u16(output: ins output, value: abs binding_stride);
    append_shard_u32(output: ins output, value: abs expected_payload_bytes);
    append_shard_u32(output: ins output, value: abs expected_binding_bytes);
    append_shard_u16(output: ins output, value: abs tokenizer_version);
    append_shard_u16(output: ins output, value: abs context_version);
    append_shard_u16(output: ins output, value: abs code_version);
    append_shard_u16(output: ins output, value: abs zero_u16);
    append_shard_u64(output: ins output, value: abs zero_u64);
    erg payload_index: u32 = 0u32;
    loop {
        if payload_index >= expected_payload_bytes {
            break;
        }
        append(output, payload[payload_index]);
        payload_index += 1u32;
    }
    erg binding_index: u32 = 0u32;
    loop {
        if binding_index >= expected_binding_bytes {
            break;
        }
        append(output, bindings[binding_index]);
        binding_index += 1u32;
    }
    erg checksum: u64 = shard_dynamic_checksum(input: abs output, length: erg file_length);
    erg checksum_offset: u32 = 40u32;
    write_shard_u64(output: ins output, value: abs checksum, offset: abs checksum_offset);
    return write_file(path: abs path, contents: abs output);
}

open verb validate_dynamic_shard_bytes(
    dat bytes: Buffer,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Result[Int, IoError] {
    erg valid: Bool = dynamic_shard_bytes_are_valid(bytes: abs bytes, expected_shard_id: erg expected_shard_id, expected_first_column_index: erg expected_first_column_index, expected_column_count: erg expected_column_count);
    if !valid {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    drop(bytes);
    return Ok(length);
}

verb dynamic_shard_with_bindings_is_valid(
    abs bytes: Buffer,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Bool {
    if expected_column_count == 0u32 || expected_column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS || expected_first_column_index > 4294967295u32 - expected_column_count {
        return false;
    }
    erg expected_payload_bytes: u32 = expected_column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg expected_binding_bytes: u32 = expected_column_count * BRAIN_SHARD_BINDING_STRIDE_BYTES as u32;
    erg expected_file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + expected_payload_bytes + expected_binding_bytes;
    if expected_file_length > BRAIN_SHARD_DYNAMIC_MAX_BYTES {
        return false;
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != expected_file_length as Int {
        return false;
    }
    erg offset_magic: u32 = 0u32;
    erg offset_version: u32 = 4u32;
    erg offset_header: u32 = 6u32;
    erg offset_shard: u32 = 8u32;
    erg offset_first: u32 = 12u32;
    erg offset_count: u32 = 16u32;
    erg offset_column_stride: u32 = 20u32;
    erg offset_binding_stride: u32 = 22u32;
    erg offset_payload: u32 = 24u32;
    erg offset_binding_payload: u32 = 28u32;
    erg offset_tokenizer: u32 = 32u32;
    erg offset_context: u32 = 34u32;
    erg offset_code: u32 = 36u32;
    erg offset_checksum: u32 = 40u32;
    erg length_u32: u32 = length as u32;
    erg actual_checksum: u64 = shard_dynamic_checksum(input: abs bytes, length: erg length_u32);
    erg stored_checksum: u64 = read_shard_u64(input: abs bytes, offset: abs offset_checksum);
    return read_shard_u32(input: abs bytes, offset: abs offset_magic) == BRAIN_SHARD_MAGIC && read_shard_u16(input: abs bytes, offset: abs offset_version) == BRAIN_SHARD_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_header) == BRAIN_SHARD_HEADER_BYTES && read_shard_u32(input: abs bytes, offset: abs offset_shard) == expected_shard_id && read_shard_u32(input: abs bytes, offset: abs offset_first) == expected_first_column_index && read_shard_u32(input: abs bytes, offset: abs offset_count) == expected_column_count && read_shard_u16(input: abs bytes, offset: abs offset_column_stride) == BRAIN_SHARD_COLUMN_STRIDE_BYTES && read_shard_u16(input: abs bytes, offset: abs offset_binding_stride) == BRAIN_SHARD_BINDING_STRIDE_BYTES && read_shard_u32(input: abs bytes, offset: abs offset_payload) == expected_payload_bytes && read_shard_u32(input: abs bytes, offset: abs offset_binding_payload) == expected_binding_bytes && read_shard_u16(input: abs bytes, offset: abs offset_tokenizer) == TOKENIZER_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_context) == CONTEXT_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_code) == TOKEN_CODE_VERSION && stored_checksum == actual_checksum;
}

open verb validate_dynamic_shard_with_bindings_bytes(
    dat bytes: Buffer,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Result[Int, IoError] {
    erg valid: Bool = dynamic_shard_with_bindings_is_valid(bytes: abs bytes, expected_shard_id: erg expected_shard_id, expected_first_column_index: erg expected_first_column_index, expected_column_count: erg expected_column_count);
    if !valid {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    drop(bytes);
    return Ok(length);
}

verb dynamic_shard_bytes_are_valid(
    abs bytes: Buffer,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Bool {
    if expected_column_count == 0u32 || expected_column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS || expected_first_column_index > 4294967295u32 - expected_column_count {
        return false;
    }
    erg expected_payload_bytes: u32 = expected_column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg expected_file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + expected_payload_bytes;
    if expected_file_length > BRAIN_SHARD_DYNAMIC_MAX_BYTES {
        return false;
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != expected_file_length as Int {
        return false;
    }
    erg offset_magic: u32 = 0u32;
    erg offset_version: u32 = 4u32;
    erg offset_header: u32 = 6u32;
    erg offset_shard: u32 = 8u32;
    erg offset_first: u32 = 12u32;
    erg offset_count: u32 = 16u32;
    erg offset_column_stride: u32 = 20u32;
    erg offset_binding_stride: u32 = 22u32;
    erg offset_payload: u32 = 24u32;
    erg offset_binding_payload: u32 = 28u32;
    erg offset_tokenizer: u32 = 32u32;
    erg offset_context: u32 = 34u32;
    erg offset_code: u32 = 36u32;
    erg offset_checksum: u32 = 40u32;
    erg length_u32: u32 = length as u32;
    erg actual_checksum: u64 = shard_dynamic_checksum(input: abs bytes, length: erg length_u32);
    erg stored_checksum: u64 = read_shard_u64(input: abs bytes, offset: abs offset_checksum);
    return read_shard_u32(input: abs bytes, offset: abs offset_magic) == BRAIN_SHARD_MAGIC && read_shard_u16(input: abs bytes, offset: abs offset_version) == BRAIN_SHARD_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_header) == BRAIN_SHARD_HEADER_BYTES && read_shard_u32(input: abs bytes, offset: abs offset_shard) == expected_shard_id && read_shard_u32(input: abs bytes, offset: abs offset_first) == expected_first_column_index && read_shard_u32(input: abs bytes, offset: abs offset_count) == expected_column_count && read_shard_u16(input: abs bytes, offset: abs offset_column_stride) == BRAIN_SHARD_COLUMN_STRIDE_BYTES && read_shard_u16(input: abs bytes, offset: abs offset_binding_stride) == BRAIN_SHARD_BINDING_STRIDE_BYTES && read_shard_u32(input: abs bytes, offset: abs offset_payload) == expected_payload_bytes && read_shard_u32(input: abs bytes, offset: abs offset_binding_payload) == 0u32 && read_shard_u16(input: abs bytes, offset: abs offset_tokenizer) == TOKENIZER_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_context) == CONTEXT_VERSION && read_shard_u16(input: abs bytes, offset: abs offset_code) == TOKEN_CODE_VERSION && stored_checksum == actual_checksum;
}

open verb load_dynamic_shard_bytes[N: Usize](
    ins fabric: CorticalFabric[N],
    dat bytes: Buffer,
    erg destination_index: u32,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Result[Int, IoError] {
    if destination_index > (N as u32) || expected_column_count > (N as u32) - destination_index || !dynamic_shard_bytes_are_valid(bytes: abs bytes, expected_shard_id: erg expected_shard_id, expected_first_column_index: erg expected_first_column_index, expected_column_count: erg expected_column_count) {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg column: u32 = 0u32;
    loop {
        if column >= expected_column_count {
            break;
        }
        erg byte: u32 = 0u32;
        loop {
            if byte >= 64u32 {
                break;
            }
            fabric.columns[destination_index + column].storage[byte] = bytes[48u32 + (column * 64u32) + byte];
            byte += 1u32;
        }
        column += 1u32;
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    drop(bytes);
    return Ok(length);
}

open verb dynamic_shard_free_link(
    abs bytes: Buffer,
    erg local_index: u32,
    erg expected_column_count: u32
) -> Result[u32, IoError] {
    if expected_column_count == 0u32 || local_index >= expected_column_count || expected_column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS {
        return Err(IoError.InvalidInput);
    }
    erg payload_bytes: u32 = expected_column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg expected_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + payload_bytes;
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != expected_length as Int {
        return Err(IoError.InvalidData);
    }
    erg link_offset: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + (local_index * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32) + 56u32;
    return Ok(read_shard_u32(input: abs bytes, offset: abs link_offset));
}

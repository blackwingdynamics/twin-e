meta limitless("file")


"""Position-independent index for a bounded set of brain shards."""
import config;

import std::fs;

import std::io;

open struct ManifestHeader {
    erg magic: u32,
    erg version: u16,
    erg header_bytes: u16,
    erg manifest_bytes: u32,
    erg generation: u64,
    erg total_column_count: u32,
    erg active_column_count: u32,
    erg shard_count: u32,
    erg column_stride_bytes: u16,
    erg binding_stride_bytes: u16,
    erg tokenizer_version: u16,
    erg context_version: u16,
    erg code_version: u16,
    erg reserved: u16,
    erg checksum: u64,
}

open struct ManifestDescriptor {
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg payload_offset: u32,
    erg payload_bytes: u32,
    erg binding_offset: u32,
    erg binding_bytes: u32,
    erg checksum: u64,
    erg state: u32,
}

open struct ColumnLocation {
    erg global_index: u32,
    erg shard_id: u32,
    erg local_index: u32,
}

open struct AllocationPlan {
    erg global_index: u32,
    erg shard_id: u32,
    erg local_index: u32,
    erg creates_shard: Bool,
}

open struct DynamicLoadPlan {
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg local_index: u32,
}

verb append_manifest_u16(ins output: Buffer, abs value: u16) {
    append(output, value as u8);
    append(output, ((value as u32 / 256u32) & 255u32) as u8);
}

verb append_manifest_u32(ins output: Buffer, abs value: u32) {
    append(output, (value & 255u32) as u8);
    append(output, ((value / 256u32) & 255u32) as u8);
    append(output, ((value / 65536u32) & 255u32) as u8);
    append(output, ((value / 16777216u32) & 255u32) as u8);
}

verb append_manifest_u64(ins output: Buffer, abs value: u64) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    append_manifest_u32(output: ins output, value: abs low);
    append_manifest_u32(output: ins output, value: abs high);
}

verb read_manifest_u16(abs input: Buffer, abs offset: u32) -> u16 {
    return (input[offset] as u16) + ((input[offset + 1u32] as u16) * 256u16);
}

verb read_manifest_u32(abs input: Buffer, abs offset: u32) -> u32 {
    return (input[offset] as u32) + ((input[offset + 1u32] as u32) * 256u32) + ((input[offset + 2u32] as u32) * 65536u32) + ((input[offset + 3u32] as u32) * 16777216u32);
}

verb read_manifest_u64(abs input: Buffer, abs offset: u32) -> u64 {
    erg low: u64 = read_manifest_u32(input: abs input, offset: abs offset) as u64;
    erg high_offset: u32 = offset + 4u32;
    erg high: u64 = read_manifest_u32(input: abs input, offset: abs high_offset) as u64;
    return low + (high * 4294967296u64);
}

verb manifest_checksum(abs input: Buffer) -> u64 {
    erg checksum: u64 = 0u64;
    erg index: u32 = 0u32;
    loop {
        if index >= BRAIN_MANIFEST_FILE_BYTES {
            break;
        }
        if index < 44u32 || index >= 52u32 {
            checksum += (input[index] as u64) * ((index + 1u32) as u64);
        }
        index += 1u32;
    }
    return checksum;
}

verb write_manifest_u64(ins output: Buffer, abs value: u64, abs offset: u32) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    output[offset] = (low & 255u32) as u8;
    output[offset + 1u32] = ((low / 256u32) & 255u32) as u8;
    output[offset + 2u32] = ((low / 65536u32) & 255u32) as u8;
    output[offset + 3u32] = ((low / 16777216u32) & 255u32) as u8;
    output[offset + 4u32] = (high & 255u32) as u8;
    output[offset + 5u32] = ((high / 256u32) & 255u32) as u8;
    output[offset + 6u32] = ((high / 65536u32) & 255u32) as u8;
    output[offset + 7u32] = ((high / 16777216u32) & 255u32) as u8;
}

open verb manifest_header_is_valid(abs header: ManifestHeader) -> Bool {
    return header.magic == BRAIN_MANIFEST_MAGIC && header.version == BRAIN_MANIFEST_VERSION && header.header_bytes == BRAIN_MANIFEST_HEADER_BYTES && header.manifest_bytes == BRAIN_MANIFEST_FILE_BYTES && header.shard_count == BRAIN_MANIFEST_SHARD_COUNT && header.column_stride_bytes == BRAIN_SHARD_COLUMN_STRIDE_BYTES && header.binding_stride_bytes == BRAIN_SHARD_BINDING_STRIDE_BYTES && header.tokenizer_version == TOKENIZER_VERSION && header.context_version == CONTEXT_VERSION && header.code_version == TOKEN_CODE_VERSION;
}

open verb manifest_descriptor_is_valid(
    abs descriptor: ManifestDescriptor,
    erg expected_id: u32
) -> Bool {
    return descriptor.shard_id == expected_id && descriptor.first_column_index == (expected_id * BRAIN_SHARD_COLUMN_COUNT) && descriptor.column_count == BRAIN_SHARD_COLUMN_COUNT && descriptor.payload_offset == BRAIN_SHARD_HEADER_BYTES && descriptor.payload_bytes == BRAIN_SHARD_COLUMN_PAYLOAD_BYTES && descriptor.binding_offset == 0u32 && descriptor.binding_bytes == BRAIN_SHARD_BINDING_PAYLOAD_BYTES && descriptor.state == 1u32;
}

open verb manifest_locate_column(abs bytes: Buffer, erg global_index: u32) -> Result[ColumnLocation, IoError] {
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != BRAIN_MANIFEST_FILE_BYTES as Int {
        return Err(IoError.InvalidData);
    }
    erg offset_magic: u32 = 0u32;
    erg offset_version: u32 = 4u32;
    erg offset_shard_count: u32 = 28u32;
    erg offset_checksum: u32 = 44u32;
    erg stored_checksum: u64 = read_manifest_u64(input: abs bytes, offset: abs offset_checksum);
    erg actual_checksum: u64 = manifest_checksum(input: abs bytes);
    erg shard_count: u32 = read_manifest_u32(input: abs bytes, offset: abs offset_shard_count);
    if stored_checksum != actual_checksum || read_manifest_u32(input: abs bytes, offset: abs offset_magic) != BRAIN_MANIFEST_MAGIC || read_manifest_u16(input: abs bytes, offset: abs offset_version) != BRAIN_MANIFEST_VERSION || shard_count == 0u32 || shard_count > BRAIN_MANIFEST_MAX_SHARDS {
        return Err(IoError.InvalidData);
    }
    erg shard_index: u32 = 0u32;
    loop {
        if shard_index >= shard_count {
            break;
        }
        erg descriptor_offset: u32 = 64u32 + (shard_index * 40u32);
        erg first_offset: u32 = descriptor_offset + 4u32;
        erg count_offset: u32 = descriptor_offset + 8u32;
        erg first_column: u32 = read_manifest_u32(input: abs bytes, offset: abs first_offset);
        erg column_count: u32 = read_manifest_u32(input: abs bytes, offset: abs count_offset);
        erg query_a: u32 = global_index + 0u32;
        erg query_b: u32 = global_index + 0u32;
        erg query_field: u32 = global_index + 0u32;
        if query_a >= first_column && query_b < first_column + column_count {
            erg local_index: u32 = query_field - first_column;
            return Ok(ColumnLocation {global_index: query_field, shard_id: shard_index, local_index: local_index});
        }
        shard_index += 1u32;
    }
    return Err(IoError.InvalidInput);
}

verb manifest_io_error(dat error: IoError) -> Result[Int, IoError] {
    return case dat error {
        IoError.EndOfStream => Err(IoError.EndOfStream),
        IoError.Failed => Err(IoError.Failed),
        IoError.InvalidInput => Err(IoError.InvalidInput),
        IoError.InvalidData => Err(IoError.InvalidData),
    };
}

open verb write_manifest(
    abs path: Path,
    erg generation: u64,
    erg active_count: u32,
    abs shard_zero_checksum: u64,
    abs shard_one_checksum: u64
) -> Result[Int, IoError] {
    erg output: Buffer = Buffer[0];
    erg capacity: Int = BRAIN_MANIFEST_FILE_BYTES as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg magic: u32 = BRAIN_MANIFEST_MAGIC;
    erg version: u16 = BRAIN_MANIFEST_VERSION;
    erg header_bytes: u16 = BRAIN_MANIFEST_HEADER_BYTES;
    erg manifest_bytes: u32 = BRAIN_MANIFEST_FILE_BYTES;
    erg total_columns: u32 = 64u32;
    erg shard_count: u32 = BRAIN_MANIFEST_SHARD_COUNT;
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u16: u16 = 0u16;
    erg zero_u32: u32 = 0u32;
    erg zero_u64: u64 = 0u64;
    append_manifest_u32(output: ins output, value: abs magic);
    append_manifest_u16(output: ins output, value: abs version);
    append_manifest_u16(output: ins output, value: abs header_bytes);
    append_manifest_u32(output: ins output, value: abs manifest_bytes);
    append_manifest_u64(output: ins output, value: abs generation);
    append_manifest_u32(output: ins output, value: abs total_columns);
    append_manifest_u32(output: ins output, value: abs active_count);
    append_manifest_u32(output: ins output, value: abs shard_count);
    append_manifest_u16(output: ins output, value: abs column_stride);
    append_manifest_u16(output: ins output, value: abs binding_stride);
    append_manifest_u16(output: ins output, value: abs tokenizer_version);
    append_manifest_u16(output: ins output, value: abs context_version);
    append_manifest_u16(output: ins output, value: abs code_version);
    append_manifest_u16(output: ins output, value: abs zero_u16);
    append_manifest_u64(output: ins output, value: abs zero_u64);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    erg descriptor_zero: u32 = 0u32;
    erg descriptor_one: u32 = 1u32;
    erg first_zero: u32 = 0u32;
    erg first_one: u32 = 32u32;
    erg descriptor_columns: u32 = BRAIN_SHARD_COLUMN_COUNT;
    erg payload_offset: u32 = BRAIN_SHARD_HEADER_BYTES as u32;
    erg payload_bytes: u32 = BRAIN_SHARD_COLUMN_PAYLOAD_BYTES;
    erg descriptor_end: u32 = 0u32;
    erg descriptor_state: u32 = 1u32;
    append_manifest_u32(output: ins output, value: abs descriptor_zero);
    append_manifest_u32(output: ins output, value: abs first_zero);
    append_manifest_u32(output: ins output, value: abs descriptor_columns);
    append_manifest_u32(output: ins output, value: abs payload_offset);
    append_manifest_u32(output: ins output, value: abs payload_bytes);
    append_manifest_u32(output: ins output, value: abs descriptor_end);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    append_manifest_u64(output: ins output, value: abs shard_zero_checksum);
    append_manifest_u32(output: ins output, value: abs descriptor_state);
    append_manifest_u32(output: ins output, value: abs descriptor_one);
    append_manifest_u32(output: ins output, value: abs first_one);
    append_manifest_u32(output: ins output, value: abs descriptor_columns);
    append_manifest_u32(output: ins output, value: abs payload_offset);
    append_manifest_u32(output: ins output, value: abs payload_bytes);
    append_manifest_u32(output: ins output, value: abs descriptor_end);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    append_manifest_u64(output: ins output, value: abs shard_one_checksum);
    append_manifest_u32(output: ins output, value: abs descriptor_state);
    erg checksum: u64 = manifest_checksum(input: abs output);
    erg checksum_offset: u32 = 44u32;
    write_manifest_u64(
        output: ins output,
        value: abs checksum,
        offset: abs checksum_offset
    );
    return write_file(path: abs path, contents: abs output);
}

open verb read_manifest_bytes(dat bytes: Buffer) -> Result[Int, IoError] {
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length != BRAIN_MANIFEST_FILE_BYTES as Int {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg offset_0: u32 = 0u32;
    erg offset_4: u32 = 4u32;
    erg offset_6: u32 = 6u32;
    erg offset_8: u32 = 8u32;
    erg offset_12: u32 = 12u32;
    erg offset_20: u32 = 20u32;
    erg offset_24: u32 = 24u32;
    erg offset_28: u32 = 28u32;
    erg offset_32: u32 = 32u32;
    erg offset_34: u32 = 34u32;
    erg offset_36: u32 = 36u32;
    erg offset_38: u32 = 38u32;
    erg offset_40: u32 = 40u32;
    erg offset_42: u32 = 42u32;
    erg offset_44: u32 = 44u32;
    erg header: ManifestHeader = ManifestHeader {magic: read_manifest_u32(input: abs bytes, offset: abs offset_0), version: read_manifest_u16(
        input: abs bytes,
        offset: abs offset_4
    ), header_bytes: read_manifest_u16(input: abs bytes, offset: abs offset_6), manifest_bytes: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_8
    ), generation: read_manifest_u64(input: abs bytes, offset: abs offset_12), total_column_count: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_20
    ), active_column_count: read_manifest_u32(input: abs bytes, offset: abs offset_24), shard_count: read_manifest_u32(
        input: abs bytes,
        offset: abs offset_28
    ), column_stride_bytes: read_manifest_u16(input: abs bytes, offset: abs offset_32), binding_stride_bytes: read_manifest_u16(
        input: abs bytes,
        offset: abs offset_34
    ), tokenizer_version: read_manifest_u16(input: abs bytes, offset: abs offset_36), context_version: read_manifest_u16(
        input: abs bytes,
        offset: abs offset_38
    ), code_version: read_manifest_u16(input: abs bytes, offset: abs offset_40), reserved: read_manifest_u16(
        input: abs bytes,
        offset: abs offset_42
    ), checksum: read_manifest_u64(input: abs bytes, offset: abs offset_44)};
    erg actual_checksum: u64 = manifest_checksum(input: abs bytes);
    if !manifest_header_is_valid(header: abs header) || header.total_column_count != 64u32 || header.checksum != actual_checksum {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg d0: u32 = 64u32;
    erg d4: u32 = 68u32;
    erg d8: u32 = 72u32;
    erg d12: u32 = 76u32;
    erg d16: u32 = 80u32;
    erg d20: u32 = 84u32;
    erg d24: u32 = 88u32;
    erg d28: u32 = 92u32;
    erg d36: u32 = 100u32;
    erg e0: u32 = 104u32;
    erg e4: u32 = 108u32;
    erg e8: u32 = 112u32;
    erg e12: u32 = 116u32;
    erg e16: u32 = 120u32;
    erg e20: u32 = 124u32;
    erg e24: u32 = 128u32;
    erg e28: u32 = 132u32;
    erg e36: u32 = 140u32;
    erg zero: ManifestDescriptor = ManifestDescriptor {shard_id: read_manifest_u32(input: abs bytes, offset: abs d0), first_column_index: read_manifest_u32(
        input: abs bytes,
        offset: abs d4
    ), column_count: read_manifest_u32(input: abs bytes, offset: abs d8), payload_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs d12
    ), payload_bytes: read_manifest_u32(input: abs bytes, offset: abs d16), binding_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs d20
    ), binding_bytes: read_manifest_u32(input: abs bytes, offset: abs d24), checksum: read_manifest_u64(
        input: abs bytes,
        offset: abs d28
    ), state: read_manifest_u32(input: abs bytes, offset: abs d36)};
    erg one: ManifestDescriptor = ManifestDescriptor {shard_id: read_manifest_u32(input: abs bytes, offset: abs e0), first_column_index: read_manifest_u32(
        input: abs bytes,
        offset: abs e4
    ), column_count: read_manifest_u32(input: abs bytes, offset: abs e8), payload_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs e12
    ), payload_bytes: read_manifest_u32(input: abs bytes, offset: abs e16), binding_offset: read_manifest_u32(
        input: abs bytes,
        offset: abs e20
    ), binding_bytes: read_manifest_u32(input: abs bytes, offset: abs e24), checksum: read_manifest_u64(
        input: abs bytes,
        offset: abs e28
    ), state: read_manifest_u32(input: abs bytes, offset: abs e36)};
    erg expected_zero: u32 = 0u32;
    erg expected_one: u32 = 1u32;
    if !manifest_descriptor_is_valid(descriptor: abs zero, expected_id: erg expected_zero) || !manifest_descriptor_is_valid(
        descriptor: abs one,
        expected_id: erg expected_one
    ) {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    drop(bytes);
    return Ok(length);
}

open verb read_manifest(abs path: Path) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => manifest_io_error(error: dat error),
        Result.Ok(bytes) => read_manifest_bytes(bytes: dat bytes),
    };
}

verb load_selected_shard(
    ins fabric: CorticalFabric[64],
    abs location: ColumnLocation,
    abs shard_zero_path: Path,
    abs shard_one_path: Path
) -> Result[Int, IoError] {
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    if location.shard_id == zero_id {
        return read_shard(fabric: ins fabric, path: abs shard_zero_path, shard_id: erg zero_id);
    }
    if location.shard_id == one_id {
        return read_shard(fabric: ins fabric, path: abs shard_one_path, shard_id: erg one_id);
    }
    return Err(IoError.InvalidInput);
}

verb load_selected_shard_from_manifest(
    ins fabric: CorticalFabric[64],
    abs manifest_bytes: Buffer,
    abs shard_zero_path: Path,
    abs shard_one_path: Path,
    erg global_index: u32
) -> Result[Int, IoError] {
    erg location_result = manifest_locate_column(bytes: abs manifest_bytes, global_index: erg global_index);
    return case dat location_result {
        Result.Err(error) => Err(error),
        Result.Ok(location) => load_selected_shard(fabric: ins fabric, location: abs location, shard_zero_path: abs shard_zero_path, shard_one_path: abs shard_one_path),
    };
}

open verb load_column_from_shards(
    ins fabric: CorticalFabric[64],
    abs manifest_path: Path,
    abs shard_zero_path: Path,
    abs shard_one_path: Path,
    erg global_index: u32
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs manifest_path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => load_selected_shard_from_manifest(fabric: ins fabric, manifest_bytes: abs bytes, shard_zero_path: abs shard_zero_path, shard_one_path: abs shard_one_path, global_index: erg global_index),
    };
}

verb manifest_dynamic_checksum(abs input: Buffer, erg length: u32) -> u64 {
    erg checksum: u64 = 0u64;
    erg index: u32 = 0u32;
    loop {
        if index >= length {
            break;
        }
        if index < 44u32 || index >= 52u32 {
            checksum += (input[index] as u64) * ((index + 1u32) as u64);
        }
        index += 1u32;
    }
    return checksum;
}

verb write_manifest_u32_at(ins output: Buffer, abs value: u32, abs offset: u32) {
    output[offset] = (value & 255u32) as u8;
    output[offset + 1u32] = ((value / 256u32) & 255u32) as u8;
    output[offset + 2u32] = ((value / 65536u32) & 255u32) as u8;
    output[offset + 3u32] = ((value / 16777216u32) & 255u32) as u8;
}

verb manifest_dynamic_descriptor_is_safe(
    abs first_column: u32,
    abs column_count: u32,
    abs column_payload: u32,
    abs binding_payload: u32,
    abs state: u32,
    abs expected_first: u32
) -> Bool {
    if first_column != expected_first || column_count == 0u32 || column_count > BRAIN_SHARD_DYNAMIC_MAX_COLUMNS || first_column > BRAIN_MANIFEST_DYNAMIC_MAX_COLUMNS - column_count || column_payload != column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32 || binding_payload != 0u32 || state != 1u32 {
        return false;
    }
    return true;
}

open verb manifest_dynamic_bytes_are_valid(abs bytes: Buffer) -> Bool {
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if length < BRAIN_MANIFEST_HEADER_BYTES as Int || length > BRAIN_MANIFEST_DYNAMIC_MAX_BYTES as Int {
        return false;
    }
    erg length_u32: u32 = length as u32;
    erg offset_0: u32 = 0u32;
    erg offset_4: u32 = 4u32;
    erg offset_6: u32 = 6u32;
    erg offset_8: u32 = 8u32;
    erg offset_20: u32 = 20u32;
    erg offset_28: u32 = 28u32;
    erg offset_32: u32 = 32u32;
    erg offset_34: u32 = 34u32;
    erg offset_36: u32 = 36u32;
    erg offset_38: u32 = 38u32;
    erg offset_40: u32 = 40u32;
    erg offset_44: u32 = 44u32;
    erg offset_52: u32 = 52u32;
    erg stored_length: u32 = read_manifest_u32(input: abs bytes, offset: abs offset_8);
    erg shard_count: u32 = read_manifest_u32(input: abs bytes, offset: abs offset_28);
    erg stored_checksum: u64 = read_manifest_u64(input: abs bytes, offset: abs offset_44);
    erg actual_checksum: u64 = manifest_dynamic_checksum(input: abs bytes, length: erg length_u32);
    if stored_length != length_u32 || stored_length < BRAIN_MANIFEST_HEADER_BYTES as u32 || stored_checksum != actual_checksum || read_manifest_u32(input: abs bytes, offset: abs offset_0) != BRAIN_MANIFEST_MAGIC || read_manifest_u16(input: abs bytes, offset: abs offset_4) != BRAIN_MANIFEST_VERSION || read_manifest_u16(input: abs bytes, offset: abs offset_6) != BRAIN_MANIFEST_HEADER_BYTES || shard_count == 0u32 || shard_count > BRAIN_MANIFEST_DYNAMIC_MAX_SHARDS || read_manifest_u32(input: abs bytes, offset: abs offset_20) > BRAIN_MANIFEST_DYNAMIC_MAX_COLUMNS || read_manifest_u16(input: abs bytes, offset: abs offset_32) != BRAIN_SHARD_COLUMN_STRIDE_BYTES || read_manifest_u16(input: abs bytes, offset: abs offset_34) != BRAIN_SHARD_BINDING_STRIDE_BYTES || read_manifest_u16(input: abs bytes, offset: abs offset_36) != TOKENIZER_VERSION || read_manifest_u16(input: abs bytes, offset: abs offset_38) != CONTEXT_VERSION || read_manifest_u16(input: abs bytes, offset: abs offset_40) != TOKEN_CODE_VERSION {
        return false;
    }
    erg descriptor_bytes: u32 = shard_count * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32;
    if stored_length != BRAIN_MANIFEST_HEADER_BYTES as u32 + descriptor_bytes {
        return false;
    }
    erg total_columns: u32 = read_manifest_u32(input: abs bytes, offset: abs offset_20);
    erg free_list_head: u32 = read_manifest_u32(input: abs bytes, offset: abs offset_52);
    if free_list_head != NULL_INDEX && free_list_head >= total_columns {
        return false;
    }
    erg descriptor_index: u32 = 0u32;
    erg expected_first: u32 = 0u32;
    loop {
        if descriptor_index >= shard_count {
            break;
        }
        erg id_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32);
        erg first_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 4u32;
        erg count_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 8u32;
        erg payload_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 16u32;
        erg binding_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 24u32;
        erg state_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 36u32;
        erg descriptor_id: u32 = read_manifest_u32(input: abs bytes, offset: abs id_offset);
        erg first_column: u32 = read_manifest_u32(input: abs bytes, offset: abs first_offset);
        erg column_count: u32 = read_manifest_u32(input: abs bytes, offset: abs count_offset);
        erg column_payload: u32 = read_manifest_u32(input: abs bytes, offset: abs payload_offset);
        erg binding_payload: u32 = read_manifest_u32(input: abs bytes, offset: abs binding_offset);
        erg state: u32 = read_manifest_u32(input: abs bytes, offset: abs state_offset);
        if descriptor_id != descriptor_index || first_column > total_columns || column_count > total_columns - first_column || !manifest_dynamic_descriptor_is_safe(first_column: abs first_column, column_count: abs column_count, column_payload: abs column_payload, binding_payload: abs binding_payload, state: abs state, expected_first: abs expected_first) {
            return false;
        }
        expected_first = first_column + column_count;
        descriptor_index += 1u32;
    }
    return expected_first == total_columns;
}

open verb dynamic_manifest_free_list_head(abs bytes: Buffer) -> u32 {
    erg offset: u32 = 52u32;
    return read_shard_u32(input: abs bytes, offset: abs offset);
}

open verb dynamic_manifest_active_count(abs bytes: Buffer) -> u32 {
    erg offset: u32 = 24u32;
    return read_shard_u32(input: abs bytes, offset: abs offset);
}

open verb manifest_locate_column_dynamic(abs bytes: Buffer, erg global_index: u32) -> Result[ColumnLocation, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs bytes) {
        return Err(IoError.InvalidData);
    }
    erg shard_count_offset: u32 = 28u32;
    erg shard_count: u32 = read_manifest_u32(input: abs bytes, offset: abs shard_count_offset);
    erg descriptor_index: u32 = 0u32;
    loop {
        if descriptor_index >= shard_count {
            break;
        }
        erg first_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 4u32;
        erg count_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32) + 8u32;
        erg first_column: u32 = read_manifest_u32(input: abs bytes, offset: abs first_offset);
        erg column_count: u32 = read_manifest_u32(input: abs bytes, offset: abs count_offset);
        erg query_a: u32 = global_index + 0u32;
        erg query_b: u32 = global_index + 0u32;
        erg query_field: u32 = global_index + 0u32;
        if query_a >= first_column && query_b < first_column + column_count {
            erg local_index: u32 = query_field - first_column;
            return Ok(ColumnLocation {global_index: query_field, shard_id: descriptor_index, local_index: local_index});
        }
        descriptor_index += 1u32;
    }
    return Err(IoError.InvalidInput);
}

open verb write_manifest_dynamic(
    abs path: Path,
    erg generation: u64,
    erg active_count: u32,
    erg free_list_head: u32,
    erg total_column_count: u32,
    erg shard_count: u32,
    abs descriptors: Buffer
) -> Result[Int, IoError] {
    erg descriptor_length_result = buffer_length(buffer: abs descriptors);
    erg descriptor_length: Int = case dat descriptor_length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    erg expected_descriptor_length: u32 = shard_count * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32;
    if shard_count == 0u32 || shard_count > BRAIN_MANIFEST_DYNAMIC_MAX_SHARDS || descriptor_length != expected_descriptor_length as Int {
        return Err(IoError.InvalidInput);
    }
    erg manifest_length: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + expected_descriptor_length;
    if manifest_length > BRAIN_MANIFEST_DYNAMIC_MAX_BYTES {
        return Err(IoError.InvalidInput);
    }
    erg output: Buffer = Buffer[0];
    erg capacity: Int = manifest_length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg magic: u32 = BRAIN_MANIFEST_MAGIC;
    erg version: u16 = BRAIN_MANIFEST_VERSION;
    erg header_bytes: u16 = BRAIN_MANIFEST_HEADER_BYTES;
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u16: u16 = 0u16;
    erg zero_u32: u32 = 0u32;
    erg zero_u64: u64 = 0u64;
    append_manifest_u32(output: ins output, value: abs magic);
    append_manifest_u16(output: ins output, value: abs version);
    append_manifest_u16(output: ins output, value: abs header_bytes);
    append_manifest_u32(output: ins output, value: abs manifest_length);
    append_manifest_u64(output: ins output, value: abs generation);
    append_manifest_u32(output: ins output, value: abs total_column_count);
    append_manifest_u32(output: ins output, value: abs active_count);
    append_manifest_u32(output: ins output, value: abs shard_count);
    append_manifest_u16(output: ins output, value: abs column_stride);
    append_manifest_u16(output: ins output, value: abs binding_stride);
    append_manifest_u16(output: ins output, value: abs tokenizer_version);
    append_manifest_u16(output: ins output, value: abs context_version);
    append_manifest_u16(output: ins output, value: abs code_version);
    append_manifest_u16(output: ins output, value: abs zero_u16);
    append_manifest_u64(output: ins output, value: abs zero_u64);
    append_manifest_u32(output: ins output, value: abs free_list_head);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    append_manifest_u32(output: ins output, value: abs zero_u32);
    erg descriptor_index: u32 = 0u32;
    loop {
        if descriptor_index >= expected_descriptor_length {
            break;
        }
        append(output, descriptors[descriptor_index]);
        descriptor_index += 1u32;
    }
    erg checksum: u64 = manifest_dynamic_checksum(input: abs output, length: erg manifest_length);
    erg checksum_offset: u32 = 44u32;
    write_manifest_u64(output: ins output, value: abs checksum, offset: abs checksum_offset);
    return write_file(path: abs path, contents: abs output);
}

open verb read_manifest_dynamic_bytes(dat bytes: Buffer) -> Result[Int, IoError] {
    erg valid: Bool = manifest_dynamic_bytes_are_valid(bytes: abs bytes);
    if !valid {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg length_result = buffer_length(buffer: abs bytes);
    erg length: Int = case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    drop(bytes);
    return Ok(length);
}

open verb validate_dynamic_manifest_shard(
    abs manifest: Buffer,
    dat shard: Buffer,
    erg descriptor_index: u32
) -> Result[Int, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs manifest) {
        drop(shard);
        return Err(IoError.InvalidData);
    }
    erg shard_count_offset: u32 = 28u32;
    erg shard_count: u32 = read_shard_u32(input: abs manifest, offset: abs shard_count_offset);
    if descriptor_index >= shard_count {
        drop(shard);
        return Err(IoError.InvalidInput);
    }
    erg descriptor_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (descriptor_index * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32);
    erg descriptor_offset_copy: u32 = descriptor_offset + 0u32;
    erg expected_id: u32 = read_shard_u32(input: abs manifest, offset: abs descriptor_offset_copy);
    erg first_offset: u32 = descriptor_offset + 4u32;
    erg count_offset: u32 = descriptor_offset + 8u32;
    erg checksum_offset: u32 = descriptor_offset + 28u32;
    erg expected_first: u32 = read_shard_u32(input: abs manifest, offset: abs first_offset);
    erg expected_count: u32 = read_shard_u32(input: abs manifest, offset: abs count_offset);
    erg expected_checksum: u64 = read_shard_u64(input: abs manifest, offset: abs checksum_offset);
    erg shard_checksum_offset: u32 = 40u32;
    erg stored_checksum: u64 = read_shard_u64(input: abs shard, offset: abs shard_checksum_offset);
    if stored_checksum != expected_checksum {
        drop(shard);
        return Err(IoError.InvalidData);
    }
    return validate_dynamic_shard_bytes(bytes: dat shard, expected_shard_id: erg expected_id, expected_first_column_index: erg expected_first, expected_column_count: erg expected_count);
}

open verb plan_dynamic_allocation(abs bytes: Buffer, erg global_index: u32) -> Result[AllocationPlan, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs bytes) {
        return Err(IoError.InvalidData);
    }
    erg total_offset: u32 = 20u32;
    erg count_offset: u32 = 28u32;
    erg total_columns: u32 = read_manifest_u32(input: abs bytes, offset: abs total_offset);
    erg shard_count: u32 = read_manifest_u32(input: abs bytes, offset: abs count_offset);
    if global_index > total_columns {
        return Err(IoError.InvalidInput);
    }
    if global_index == total_columns {
        if shard_count >= BRAIN_MANIFEST_DYNAMIC_MAX_SHARDS {
            return Err(IoError.InvalidInput);
        }
        return Ok(AllocationPlan {global_index: global_index, shard_id: shard_count, local_index: 0u32, creates_shard: true});
    }
    erg location_result = manifest_locate_column_dynamic(bytes: abs bytes, global_index: erg global_index);
    return case dat location_result {
        Result.Err(error) => Err(error),
        Result.Ok(location) => Ok(AllocationPlan {global_index: location.global_index, shard_id: location.shard_id, local_index: location.local_index, creates_shard: false}),
    };
}

open verb plan_dynamic_free_list(abs bytes: Buffer) -> Result[AllocationPlan, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs bytes) {
        return Err(IoError.InvalidData);
    }
    erg free_list_offset: u32 = 52u32;
    erg total_offset: u32 = 20u32;
    erg free_list_head: u32 = read_shard_u32(input: abs bytes, offset: abs free_list_offset);
    erg total_columns: u32 = read_shard_u32(input: abs bytes, offset: abs total_offset);
    if free_list_head == NULL_INDEX {
        return plan_dynamic_allocation(bytes: abs bytes, global_index: erg total_columns);
    }
    erg location_result = manifest_locate_column_dynamic(bytes: abs bytes, global_index: erg free_list_head);
    return case dat location_result {
        Result.Err(error) => Err(error),
        Result.Ok(location) => Ok(AllocationPlan {global_index: location.global_index, shard_id: location.shard_id, local_index: location.local_index, creates_shard: false}),
    };
}

open verb plan_dynamic_load(abs manifest: Buffer, erg global_index: u32) -> Result[DynamicLoadPlan, IoError] {
    erg location_result = manifest_locate_column_dynamic(bytes: abs manifest, global_index: erg global_index);
    return case dat location_result {
        Result.Err(error) => Err(error),
        Result.Ok(location) => {
            erg descriptor_offset: u32 = BRAIN_MANIFEST_HEADER_BYTES as u32 + (location.shard_id * BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32);
            erg first_offset: u32 = descriptor_offset + 4u32;
            erg count_offset: u32 = descriptor_offset + 8u32;
            erg expected_first: u32 = read_shard_u32(input: abs manifest, offset: abs first_offset);
            erg expected_count: u32 = read_shard_u32(input: abs manifest, offset: abs count_offset);
            return Ok(DynamicLoadPlan {shard_id: location.shard_id, first_column_index: expected_first, column_count: expected_count, local_index: location.local_index});
        },
    };
}

open verb load_dynamic_from_plan(
    ins fabric: CorticalFabric[64],
    dat shard: Buffer,
    abs plan: DynamicLoadPlan
) -> Result[Int, IoError] {
    erg selected_shard_id: u32 = plan.shard_id + 0u32;
    erg selected_first: u32 = plan.first_column_index + 0u32;
    erg selected_count: u32 = plan.column_count + 0u32;
    erg destination_index: u32 = 0u32;
    erg loaded = load_dynamic_shard_bytes(fabric: ins fabric, bytes: dat shard, destination_index: erg destination_index, expected_shard_id: erg selected_shard_id, expected_first_column_index: erg selected_first, expected_column_count: erg selected_count);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes_loaded) => Ok(bytes_loaded),
    };
}

verb extend_manifest_bytes(
    dat bytes: Buffer,
    abs path: Path,
    erg new_column_count: u32,
    erg new_checksum: u64,
    erg active_count: u32,
    erg free_list_head: u32
) -> Result[Int, IoError] {
    if !manifest_dynamic_bytes_are_valid(bytes: abs bytes) {
        drop(bytes);
        return Err(IoError.InvalidData);
    }
    erg old_length_result = buffer_length(buffer: abs bytes);
    erg old_length: Int = case dat old_length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    erg old_length_u32: u32 = old_length as u32;
    erg total_offset: u32 = 20u32;
    erg count_offset: u32 = 28u32;
    erg generation_offset: u32 = 12u32;
    erg old_total: u32 = read_manifest_u32(input: abs bytes, offset: abs total_offset);
    erg old_count: u32 = read_manifest_u32(input: abs bytes, offset: abs count_offset);
    erg old_generation: u64 = read_manifest_u64(input: abs bytes, offset: abs generation_offset);
    erg old_total_check: u32 = old_total + 0u32;
    erg old_count_check: u32 = old_count + 0u32;
    erg old_total_value: u32 = old_total + 0u32;
    erg old_count_id: u32 = old_count + 0u32;
    erg old_count_count: u32 = old_count + 0u32;
    if new_column_count == 0u32 || old_count_check >= BRAIN_MANIFEST_DYNAMIC_MAX_SHARDS || old_total_check > 4294967295u32 - new_column_count {
        drop(bytes);
        return Err(IoError.InvalidInput);
    }
    erg new_length: u32 = old_length_u32 + BRAIN_MANIFEST_DESCRIPTOR_BYTES as u32;
    if new_length > BRAIN_MANIFEST_DYNAMIC_MAX_BYTES {
        drop(bytes);
        return Err(IoError.InvalidInput);
    }
    erg capacity: Int = new_length as Int;
    erg reserved = reserve(buffer: ins bytes, capacity: erg capacity);
    erg shard_id: u32 = old_count_id;
    erg payload_offset: u32 = BRAIN_SHARD_HEADER_BYTES as u32;
    erg payload_bytes: u32 = new_column_count * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg binding_offset: u32 = 0u32;
    erg binding_bytes: u32 = 0u32;
    erg state: u32 = 1u32;
    erg generation: u64 = old_generation + 1u64;
    erg new_total: u32 = old_total_value + new_column_count;
    erg new_shard_count: u32 = old_count_count + 1u32;
    erg header_length_offset: u32 = 8u32;
    erg header_generation_offset: u32 = 12u32;
    erg header_total_offset: u32 = 20u32;
    erg header_active_offset: u32 = 24u32;
    erg header_count_offset: u32 = 28u32;
    erg header_free_list_offset: u32 = 52u32;
    erg header_checksum_offset: u32 = 44u32;
    append_manifest_u32(output: ins bytes, value: abs shard_id);
    append_manifest_u32(output: ins bytes, value: abs old_total);
    append_manifest_u32(output: ins bytes, value: abs new_column_count);
    append_manifest_u32(output: ins bytes, value: abs payload_offset);
    append_manifest_u32(output: ins bytes, value: abs payload_bytes);
    append_manifest_u32(output: ins bytes, value: abs binding_offset);
    append_manifest_u32(output: ins bytes, value: abs binding_bytes);
    append_manifest_u64(output: ins bytes, value: abs new_checksum);
    append_manifest_u32(output: ins bytes, value: abs state);
    write_manifest_u32_at(output: ins bytes, value: abs new_length, offset: abs header_length_offset);
    write_manifest_u64(output: ins bytes, value: abs generation, offset: abs header_generation_offset);
    write_manifest_u32_at(output: ins bytes, value: abs new_total, offset: abs header_total_offset);
    write_manifest_u32_at(output: ins bytes, value: abs active_count, offset: abs header_active_offset);
    write_manifest_u32_at(output: ins bytes, value: abs new_shard_count, offset: abs header_count_offset);
    write_manifest_u32_at(output: ins bytes, value: abs free_list_head, offset: abs header_free_list_offset);
    erg checksum: u64 = manifest_dynamic_checksum(input: abs bytes, length: erg new_length);
    write_manifest_u64(output: ins bytes, value: abs checksum, offset: abs header_checksum_offset);
    return write_file(path: abs path, contents: abs bytes);
}

open verb append_manifest_shard(
    abs path: Path,
    erg new_column_count: u32,
    erg new_checksum: u64,
    erg active_count: u32,
    erg free_list_head: u32
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => extend_manifest_bytes(bytes: dat bytes, path: abs path, new_column_count: erg new_column_count, new_checksum: erg new_checksum, active_count: erg active_count, free_list_head: erg free_list_head),
    };
}

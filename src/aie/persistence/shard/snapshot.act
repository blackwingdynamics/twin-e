"""Build bounded shard-local payloads from the resident snapshot.

The helpers in this module perform no filesystem I/O and do not mutate the
resident fabric or binding array. They only split the fixed in-memory snapshot
into the two established 32-column shard ranges used by the dynamic shard
writer. Auxiliary bytes are reserved inside the shard because auxiliary data
is shard-local and must never become a side file.
"""
import config;

open config;

verb append_array_range(
    ins output: Buffer,
    abs input: Array[u8, 4096],
    erg start: u32,
    erg length: u32
) {
    erg index: u32 = 0u32;
    loop {
        if index >= length {
            break;
        }
        append(output, input[start + index]);
        index += 1u32;
    }
}

verb append_binding_range(
    ins output: Buffer,
    abs input: Array[u8, 1536],
    erg start: u32,
    erg length: u32
) {
    erg index: u32 = 0u32;
    loop {
        if index >= length {
            break;
        }
        append(output, input[start + index]);
        index += 1u32;
    }
}

"""Return one 32-column payload for a resident fabric snapshot.

`shard_id` must be zero or one. The returned buffer is exactly 2,048 bytes,
preserving the established 64-byte minicolumn layout and global ordering.
"""
open verb fabric_shard_payload(abs columns: Array[u8, 4096], erg shard_id: u32) -> Buffer {
    erg output: Buffer = Buffer[0];
    erg first_column: u32 = shard_id * BRAIN_SHARD_COLUMN_COUNT;
    erg start: u32 = first_column * BRAIN_SHARD_COLUMN_STRIDE_BYTES as u32;
    erg length: u32 = BRAIN_SHARD_COLUMN_PAYLOAD_BYTES;
    erg capacity: Int = length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    append_array_range(
        output: ins output,
        input: abs columns,
        start: erg start,
        length: erg length
    );
    return output;
}

"""Return the shard-local binding payload for one 32-column range."""
open verb binding_shard_payload(abs entries: Array[u8, 1536], erg shard_id: u32) -> Buffer {
    erg output: Buffer = Buffer[0];
    erg start: u32 = shard_id * BRAIN_SHARD_COLUMN_COUNT * BRAIN_SHARD_BINDING_STRIDE_BYTES as u32;
    erg length: u32 = BRAIN_SHARD_COLUMN_COUNT * BRAIN_SHARD_BINDING_STRIDE_BYTES as u32;
    erg capacity: Int = length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    append_binding_range(
        output: ins output,
        input: abs entries,
        start: erg start,
        length: erg length
    );
    return output;
}

"""Return a zeroed, fixed-size auxiliary section for a new shard.

The section is part of the shard file. It is not written as an auxiliary side
file and can later be replaced by the validated resident auxiliary snapshot.
"""
open verb empty_auxiliary_payload() -> Buffer {
    erg output: Buffer = Buffer[0];
    erg capacity: Int = BRAIN_AUXILIARY_PAYLOAD_BYTES as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    erg index: u32 = 0u32;
    loop {
        if index >= BRAIN_AUXILIARY_PAYLOAD_BYTES {
            break;
        }
        append(output, 0u8);
        index += 1u32;
    }
    return output;
}

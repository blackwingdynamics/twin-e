"""Dynamic shard persistence, validation, and loading operations."""
import config;

import std::fs;

import std::io;

import std::path;

open io;

open path;

open publication;

verb buffer_length_or_negative(abs input: Buffer) -> Int {
    erg length_result = buffer_size(buffer: abs input);
    return case dat length_result {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
}

verb dynamic_shard_inputs_are_valid(
    erg first_column_index: u32,
    erg column_count: u32,
    erg payload_length: Int,
    erg expected_payload_bytes: u32,
    erg observed_binding_length: Int,
    erg expected_binding_bytes: u32
) -> Bool {
    return column_count != 0u32 && column_count <= BRAIN_SHARD_DYNAMIC_MAX_COLUMNS && first_column_index <= 4294967295u32 - column_count && payload_length == expected_payload_bytes as Int && observed_binding_length == expected_binding_bytes as Int;
}

verb dynamic_shard_file_length_is_valid(
    erg payload_bytes: u32,
    erg binding_bytes: u32,
    erg auxiliary_bytes: u32
) -> Bool {
    erg file_length: u32 = BRAIN_SHARD_HEADER_BYTES as u32 + payload_bytes + binding_bytes + auxiliary_bytes;
    return auxiliary_bytes <= BRAIN_AUXILIARY_PAYLOAD_BYTES && file_length <= BRAIN_SHARD_DYNAMIC_MAX_BYTES;
}

verb dynamic_shard_write_inputs_are_valid(
    erg first_column_index: u32,
    erg column_count: u32,
    erg payload_length: Int,
    erg expected_payload_bytes: u32,
    erg observed_binding_length: Int,
    erg expected_binding_bytes: u32,
    erg expected_auxiliary_bytes: u32
) -> Bool {
    return dynamic_shard_inputs_are_valid(
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload_length: erg payload_length,
        expected_payload_bytes: erg expected_payload_bytes,
        observed_binding_length: erg observed_binding_length,
        expected_binding_bytes: erg expected_binding_bytes
    ) && dynamic_shard_file_length_is_valid(
        payload_bytes: erg expected_payload_bytes,
        binding_bytes: erg expected_binding_bytes,
        auxiliary_bytes: erg expected_auxiliary_bytes
    );
}

verb append_dynamic_shard_identity(
    ins output: Buffer,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg column_stride: u16,
    erg binding_stride: u16
) {
    erg magic: u32 = BRAIN_SHARD_MAGIC;
    erg version: u16 = BRAIN_SHARD_VERSION;
    erg header_bytes: u16 = BRAIN_SHARD_HEADER_BYTES;
    append_shard_u32(output: ins output, value: abs magic);
    append_shard_u16(output: ins output, value: abs version);
    append_shard_u16(output: ins output, value: abs header_bytes);
    append_shard_u32(output: ins output, value: abs shard_id);
    append_shard_u32(output: ins output, value: abs first_column_index);
    append_shard_u32(output: ins output, value: abs column_count);
    append_shard_u16(output: ins output, value: abs column_stride);
    append_shard_u16(output: ins output, value: abs binding_stride);
}

verb append_dynamic_shard_metadata(
    ins output: Buffer,
    erg expected_payload_bytes: u32,
    erg expected_binding_bytes: u32,
    erg expected_auxiliary_bytes: u32
) {
    erg tokenizer_version: u16 = TOKENIZER_VERSION;
    erg context_version: u16 = CONTEXT_VERSION;
    erg code_version: u16 = TOKEN_CODE_VERSION;
    erg zero_u64: u64 = 0u64;
    append_shard_u32(output: ins output, value: abs expected_payload_bytes);
    append_shard_u32(output: ins output, value: abs expected_binding_bytes);
    append_shard_u16(output: ins output, value: abs tokenizer_version);
    append_shard_u16(output: ins output, value: abs context_version);
    append_shard_u16(output: ins output, value: abs code_version);
    append_shard_u16(output: ins output, value: abs expected_auxiliary_bytes as u16);
    append_shard_u64(output: ins output, value: abs zero_u64);
}

verb append_dynamic_shard_header(
    ins output: Buffer,
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg expected_payload_bytes: u32,
    erg expected_binding_bytes: u32,
    erg expected_auxiliary_bytes: u32
) {
    erg column_stride: u16 = BRAIN_SHARD_COLUMN_STRIDE_BYTES;
    erg binding_stride: u16 = BRAIN_SHARD_BINDING_STRIDE_BYTES;
    append_dynamic_shard_identity(
        output: ins output,
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        column_stride: erg column_stride,
        binding_stride: erg binding_stride
    );
    append_dynamic_shard_metadata(
        output: ins output,
        expected_payload_bytes: erg expected_payload_bytes,
        expected_binding_bytes: erg expected_binding_bytes,
        expected_auxiliary_bytes: erg expected_auxiliary_bytes
    );
}

verb initialize_dynamic_shard_output(
    erg shard_id: u32,
    erg first_column_index: u32,
    erg column_count: u32,
    erg expected_payload_bytes: u32,
    erg expected_binding_bytes: u32,
    erg expected_auxiliary_bytes: u32,
    erg file_length: u32
) -> Buffer {
    erg output: Buffer = Buffer[0];
    erg capacity: Int = file_length as Int;
    erg reserved = reserve(buffer: ins output, capacity: erg capacity);
    append_dynamic_shard_header(
        output: ins output,
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        expected_payload_bytes: erg expected_payload_bytes,
        expected_binding_bytes: erg expected_binding_bytes,
        expected_auxiliary_bytes: erg expected_auxiliary_bytes
    );
    return output;
}

verb append_dynamic_shard_bytes(
    ins output: Buffer,
    abs input: Buffer,
    erg length: u32
) {
    erg index: u32 = 0u32;
    loop {
        if index >= length {
            break;
        }
        append(output, input[index]);
        index += 1u32;
    }
}

verb append_dynamic_shard_segments(
    ins output: Buffer,
    abs payload: Buffer,
    abs bindings: Buffer,
    erg payload_length: u32,
    erg bindings_length: u32,
    abs auxiliary: Buffer,
    erg auxiliary_length: u32
) {
    append_dynamic_shard_bytes(
        output: ins output,
        input: abs payload,
        length: erg payload_length
    );
    append_dynamic_shard_bytes(
        output: ins output,
        input: abs bindings,
        length: erg bindings_length
    );
    append_dynamic_shard_bytes(
        output: ins output,
        input: abs auxiliary,
        length: erg auxiliary_length
    );
}

verb finalize_dynamic_shard(
    dat output: Buffer,
    abs path: Path,
    erg file_length: u32
) -> Result[Int, IoError] {
    erg checksum: u64 = shard_dynamic_checksum(input: abs output, length: erg file_length);
    erg checksum_offset: u32 = 40u32;
    write_shard_u64(
        output: ins output,
        value: abs checksum,
        offset: abs checksum_offset
    );
    erg staged_result = dynamic_shard_staging_path(path: abs path);
    return case dat staged_result {
        Result.Err(error) => {
            drop(output);
            Err(error);
        },
        Result.Ok(staged) => {
            return publish_dynamic_shard_file(
                path: abs path,
                staging: dat staged,
                contents: dat output
            );
        },
    };
}

verb complete_dynamic_shard_with_bindings(
    dat output: Buffer,
    abs path: Path,
    erg file_length: u32,
    abs payload: Buffer,
    abs bindings: Buffer,
    erg expected_payload_bytes: u32,
    erg expected_binding_bytes: u32,
    abs auxiliary: Buffer,
    erg expected_auxiliary_bytes: u32
) -> Result[Int, IoError] {
    append_dynamic_shard_segments(
        output: ins output,
        payload: abs payload,
        bindings: abs bindings,
        payload_length: erg expected_payload_bytes,
        bindings_length: erg expected_binding_bytes,
        auxiliary: abs auxiliary,
        auxiliary_length: erg expected_auxiliary_bytes
    );
    return finalize_dynamic_shard(
        output: dat output,
        path: abs path,
        file_length: erg file_length
    );
}

"""Atomically publish a staged dynamic shard after full validation.

Both paths are read through `abs`. The staged file is loaded and validated for
identity, layout, length, and checksum before rename to the active path. A
failed validation leaves the staged file unpublished and returns an error.
"""
open verb publish_dynamic_shard(
    abs staged: Path,
    abs active: Path,
    erg expected_shard_id: u32,
    erg expected_first_column_index: u32,
    erg expected_column_count: u32
) -> Result[Int, IoError] {
    erg loaded = read_to_bytes(path: abs staged);
    return case dat loaded {
        Result.Err(error) => Err(error),
        Result.Ok(bytes) => {
            erg valid: Bool = dynamic_shard_bytes_are_valid(
                bytes: abs bytes,
                expected_shard_id: erg expected_shard_id,
                expected_first_column_index: erg expected_first_column_index,
                expected_column_count: erg expected_column_count
            );
            drop(bytes);
            if !valid {
                return Err(IoError.InvalidData);
            }
            return rename(from: abs staged, to: abs active);
        },
    };
}

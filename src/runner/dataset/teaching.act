"""Teach one validated dataset index with generation reload boundaries."""
import aie;

import cli;

import std::path;

import teaching;

open aie;

open cli;

open path;

open teaching;

verb dataset_teaching_error(abs brain: LogicalTeachingBrain) -> Int {
    erg message: String = "TWIN_E_ERROR code=4 kind=dataset_teaching_rejected";
    println(text: abs message);
    return 4;
}

verb dataset_teaching_load_next(
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain
) -> Int {
    erg loaded = logical_teaching_load_generation(brain: ins brain, brain_dir: abs command.brain_dir);
    return case dat loaded {
        Result.Err(_) => {
            erg message: String = "TWIN_E_ERROR code=3 kind=brain_checkpoint_load_failed";
            println(text: abs message);
            3;
        },
        Result.Ok(_) => 0,
    };
}

verb dataset_teaching_checkpoint(
    abs command: RunnerConfig,
    abs brain: LogicalTeachingBrain
) -> Int {
    return save_resolved_generation(command: abs command, brain: abs brain);
}

verb dataset_teaching_file(
    abs directory_path: Path,
    dat relative_path: Path,
    ins brain: LogicalTeachingBrain
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg full = runner_entry_path(directory: abs directory_path, entry: abs relative_path);
    return case dat full {
        Result.Err(_) => Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.InvalidRecord),
        Result.Ok(path) => teach_logical_file(brain: ins brain, path: abs path),
    };
}

verb dataset_teaching_entry(
    abs directory_path: Path,
    dat relative_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain,
    ins first_file: Bool,
    ins file_count: u32
) -> Int {
    if !first_file {
        erg loaded = dataset_teaching_load_next(command: abs command, brain: ins brain);
        if loaded != 0 {
            return loaded;
        }
    }
    erg taught = dataset_teaching_file(
        directory_path: abs directory_path,
        relative_path: dat relative_path,
        brain: ins brain
    );
    return case dat taught {
        Result.Err(error) => dataset_teaching_error(brain: abs brain),
        Result.Ok(metrics) => dataset_teaching_finish_entry(
            metrics: abs metrics,
            command: abs command,
            brain: abs brain,
            first_file: ins first_file,
            file_count: ins file_count
        ),
    };
}

verb dataset_teaching_finish_entry(
    abs metrics: TeachingFileMetrics,
    abs command: RunnerConfig,
    abs brain: LogicalTeachingBrain,
    ins first_file: Bool,
    ins file_count: u32
) -> Int {
    print_logical_file_result(metrics: abs metrics, brain: abs brain);
    erg saved = dataset_teaching_checkpoint(command: abs command, brain: abs brain);
    if saved != 0 {
        return saved;
    }
    first_file = false;
    file_count += 1u32;
    return 0;
}

verb dataset_teaching_index_loop(
    ins index: DatasetIndex,
    abs directory_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain,
    ins first_file: Bool,
    ins file_count: u32
) -> Int {
    loop {
        erg next = dataset_index_next(index: ins index);
        erg path_option: Option[Path] = case dat next {
            Result.Err(_) => {
                return dataset_teaching_error(brain: abs brain);
            },
            Result.Ok(option) => option,
        };
        return dataset_teaching_index_option(
            index: ins index,
            directory_path: abs directory_path,
            command: abs command,
            brain: ins brain,
            first_file: ins first_file,
            file_count: ins file_count,
            path_option: dat path_option
        );
    }
}

verb dataset_teaching_index_option(
    ins index: DatasetIndex,
    abs directory_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain,
    ins first_file: Bool,
    ins file_count: u32,
    dat path_option: Option[Path]
) -> Int {
    return case dat path_option {
        Option.None => if file_count == 0u32 {
            4;
        } else {
            0;
        },
        Option.Some(relative_path) => dataset_teaching_index_some(
            index: ins index,
            directory_path: abs directory_path,
            command: abs command,
            brain: ins brain,
            first_file: ins first_file,
            file_count: ins file_count,
            relative_path: dat relative_path
        ),
    };
}

verb dataset_teaching_index_some(
    ins index: DatasetIndex,
    abs directory_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain,
    ins first_file: Bool,
    ins file_count: u32,
    dat relative_path: Path
) -> Int {
    erg status = dataset_teaching_entry(
        directory_path: abs directory_path,
        relative_path: dat relative_path,
        command: abs command,
        brain: ins brain,
        first_file: ins first_file,
        file_count: ins file_count
    );
    if status != 0 {
        return status;
    }
    return dataset_teaching_index_loop(
        index: ins index,
        directory_path: abs directory_path,
        command: abs command,
        brain: ins brain,
        first_file: ins first_file,
        file_count: ins file_count
    );
}

"""Teach the published deterministic index and reload the prior checkpoint before each later file."""
open verb teach_dataset_directory_state(
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain
) -> Int {
    if !prepare_save_directory(command: abs command) {
        return 5;
    }
    erg input_path: Option[Path] = command.input_path;
    return case dat input_path {
        Option.None => 4,
        Option.Some(directory_path) => teach_dataset_directory_index(
            directory_path: abs directory_path,
            command: abs command,
            brain: ins brain
        ),
    };
}

verb teach_dataset_directory_index(
    abs directory_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain
) -> Int {
    erg generated = dataset_index_generate(directory_path: abs directory_path);
    return case dat generated {
        Result.Err(_) => 4,
        Result.Ok(bytes) => teach_dataset_open_index(
            bytes: dat bytes,
            directory_path: abs directory_path,
            command: abs command,
            brain: ins brain
        ),
    };
}

verb teach_dataset_open_index(
    dat bytes: Buffer,
    abs directory_path: Path,
    abs command: RunnerConfig,
    ins brain: LogicalTeachingBrain
) -> Int {
    erg opened = dataset_index_open(bytes: dat bytes);
    return case dat opened {
        Result.Err(_) => 4,
        Result.Ok(index) => {
            erg first_file: Bool = true;
            erg file_count: u32 = 0u32;
            dataset_teaching_index_loop(
                index: ins index,
                directory_path: abs directory_path,
                command: abs command,
                brain: ins brain,
                first_file: ins first_file,
                file_count: ins file_count
            );
        },
    };
}

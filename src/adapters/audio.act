"""Bounded integer audio-feature adapter."""
import config;

open contract;

"""Version marker for the public audio adapter namespace."""
open const ADAPTER_AUDIO_NAMESPACE_VERSION: u16 = 1u16;


"""One caller-provided integer audio feature with temporal metadata."""
open struct AudioFeature {
    erg time_offset: u32,
    erg channel: u8,
    erg kind: u16,
    erg value: u16,
}

verb validate_audio_header(
    abs feature_count: u16,
    abs window_samples: u32,
    abs channels: u8
) -> Result[Int, AdapterError] {
    if window_samples == 0u32 || feature_count == 0u16 {
        return Result[Int, AdapterError].Err(AdapterError.EmptyInput);
    }
    if window_samples > ADAPTER_AUDIO_MAX_WINDOW_SAMPLES || feature_count as u32 > ADAPTER_MAX_EVENTS {
        return Result[Int, AdapterError].Err(AdapterError.EventCountExceeded);
    }
    if channels == 0u8 || channels > ADAPTER_AUDIO_MAX_CHANNELS {
        return Result[Int, AdapterError].Err(AdapterError.MalformedInput);
    }
    return Result[Int, AdapterError].Ok(feature_count as Int);
}

verb validate_audio_features(
    abs features: Array[AudioFeature, 256],
    abs feature_count: u16,
    abs window_samples: u32,
    abs channels: u8
) -> Result[Int, AdapterError] {
    erg previous_offset: u32 = 0u32;
    erg previous_channel: u8 = 0u8;
    for erg index: u32 in 0u32 .. ADAPTER_MAX_EVENTS {
        if index >= feature_count as u32 {
            break;
        }
        erg feature: AudioFeature = features[index as Usize];
        if feature.time_offset >= window_samples || feature.channel >= channels || feature.value > ADAPTER_AUDIO_MAX_FEATURE_VALUE {
            return Result[Int, AdapterError].Err(AdapterError.MalformedInput);
        }
        if index > 0u32 && (feature.time_offset < previous_offset || (feature.time_offset == previous_offset && feature.channel < previous_channel)) {
            return Result[Int, AdapterError].Err(AdapterError.InvalidSourceOrdering);
        }
        previous_offset = feature.time_offset;
        previous_channel = feature.channel;
    }
    return Result[Int, AdapterError].Ok(feature_count as Int);
}

verb audio_to_envelope(
    abs features: Array[AudioFeature, 256],
    abs feature_count: u16,
    abs window_samples: u32
) -> AdapterEnvelope {
    erg event_count_copy: u16 = feature_count + 0u16;
    erg window_copy: u32 = window_samples + 0u32;
    erg loop_limit: u32 = feature_count as u32;
    erg envelope: AdapterEnvelope = AdapterEnvelope {contract_version: ADAPTER_CONTRACT_VERSION, modality: AdapterModality.Audio, event_count: event_count_copy, source_length: window_copy, events: Array[AdapterEvent, 256](
    ), valid: true};
    for erg index: u32 in 0u32 .. ADAPTER_MAX_EVENTS {
        if index >= loop_limit {
            break;
        }
        erg feature: AudioFeature = features[index as Usize];
        envelope.events[index as Usize] = AdapterEvent {source_offset: feature.time_offset, feature_kind: ADAPTER_AUDIO_FEATURE, identity: feature.kind as u32, value_primary: feature.value, value_secondary: feature.channel as u16, payload_length: 1u16, flags: 0u8};
    }
    return envelope;
}

verb finalize_audio_envelope(erg envelope: AdapterEnvelope) -> Result[AdapterEnvelope, AdapterError] {
    erg validation = validate_adapter_envelope(envelope: abs envelope);
    erg accepted: Bool = false;
    erg validation_error: AdapterError = AdapterError.InvalidEnvelope;
    case dat validation {
        Result.Err(error) => {
            validation_error = error;
        },
        Result.Ok(_) => {
            accepted = true;
        },
    };
    if accepted {
        return Result[AdapterEnvelope, AdapterError].Ok(envelope);
    }
    return Result[AdapterEnvelope, AdapterError].Err(validation_error);
}

"""Convert bounded integer audio features into ordered common events.

The caller supplies already-normalized integer features; this adapter does not
decode containers, resample audio, use floating point, or perform external I/O.
"""
verb validate_audio_input(
    abs features: Array[AudioFeature, 256],
    abs feature_count: u16,
    abs window_samples: u32,
    abs channels: u8
) -> Result[Int, AdapterError] {
    erg header = validate_audio_header(
        feature_count: abs feature_count,
        window_samples: abs window_samples,
        channels: abs channels
    );
    case dat header {
        Result.Err(error) => {
            return Result[Int, AdapterError].Err(error);
        },
        Result.Ok(_) => {},
    };
    return validate_audio_features(
        features: abs features,
        feature_count: abs feature_count,
        window_samples: abs window_samples,
        channels: abs channels
    );
}

"""Convert bounded integer audio features into ordered common events.

The caller supplies already-normalized integer features; this adapter does not
decode containers, resample audio, use floating point, or perform external I/O.
"""
open verb adapt_audio(
    abs features: Array[AudioFeature, 256],
    abs feature_count: u16,
    abs window_samples: u32,
    abs channels: u8
) -> Result[AdapterEnvelope, AdapterError] {
    erg admission = validate_audio_input(
        features: abs features,
        feature_count: abs feature_count,
        window_samples: abs window_samples,
        channels: abs channels
    );
    return case dat admission {
        Result.Err(error) => Result[AdapterEnvelope, AdapterError].Err(error),
        Result.Ok(_) => {
            erg envelope: AdapterEnvelope = audio_to_envelope(
                features: abs features,
                feature_count: abs feature_count,
                window_samples: abs window_samples
            );
            finalize_audio_envelope(envelope: erg envelope);
        },
    };
}

meta limitless("file")
import config;
import std::io;

open io;

"""One deterministic pair merge in a bounded subword vocabulary."""
open struct BpeMergeRule {
    erg left_id: u32,
    erg right_id: u32,
    erg merged_id: u32,
    erg rank: u32,
}

open struct BpeTokenRecord {
    erg token_id: u32,
    erg byte_length: u8,
    erg bytes: Array[u8, 8],
}

"""Versioned bounded vocabulary artifact consumed by the BPE encoder."""
open struct BpeVocabulary {
    erg magic: u32,
    erg version: u16,
    erg tokenizer_version: u16,
    erg bos_token_id: u32,
    erg eos_token_id: u32,
    erg unknown_token_id: u32,
    erg rule_count: u32,
    erg rules: Array[BpeMergeRule, 128],
    erg token_count: u32,
    erg tokens: Array[BpeTokenRecord, 256],
}

open enum BpeDecodeError {
    InvalidVocabulary,
    InvalidSequence,
    InvalidToken,
}

open verb bpe_vocabulary_is_valid(abs vocabulary: BpeVocabulary) -> Bool {
    return vocabulary.magic == BPE_VOCAB_MAGIC && vocabulary.version == BPE_VOCAB_VERSION && vocabulary.tokenizer_version == TOKENIZER_VERSION && vocabulary.bos_token_id == BPE_BOS_TOKEN_ID && vocabulary.eos_token_id == BPE_EOS_TOKEN_ID && vocabulary.unknown_token_id == BPE_UNKNOWN_TOKEN_ID && vocabulary.rule_count <= BPE_MAX_RULES && vocabulary.token_count <= BPE_MAX_TOKENS;
}

verb invalid_sequence() -> TokenSequence {
    return TokenSequence {tokens: Array[Token, 256](), length: 0u32, valid: false};
}

struct BpeMatch {
    erg pair_index: u32,
    erg rule_index: u32,
    erg rank: u32,
    erg found: Bool,
}

struct BpeTokenMatch {
    erg index: u32,
    erg found: Bool,
}

verb find_token_record(
    abs vocabulary: BpeVocabulary,
    erg token_id: u32
) -> BpeTokenMatch {
    erg index: u32 = 0u32;
    loop {
        if index >= vocabulary.token_count {
            break;
        }
        if vocabulary.tokens[index].token_id == token_id {
            return BpeTokenMatch {index: index + 0u32, found: true};
        }
        index += 1u32;
    }
    return BpeTokenMatch {index: 0u32, found: false};
}

verb pair_matches(
    abs sequence: TokenSequence,
    ins pair: u32,
    abs rule: BpeMergeRule
) -> Bool {
    return sequence.tokens[pair as Usize].id == rule.left_id && sequence.tokens[(pair + 1u32) as Usize].id == rule.right_id;
}

"""Find the lowest-rank rule matching one adjacent token pair."""
verb find_best_merge(
    abs sequence: TokenSequence,
    abs rules: Array[BpeMergeRule, 128],
    erg rule_count: u32
) -> BpeMatch {
    erg best: BpeMatch = BpeMatch {pair_index: 0u32, rule_index: 0u32, rank: NULL_INDEX, found: false};
    erg pair: u32 = 0u32;
    loop {
        erg next_pair: u32 = pair + 1u32;
        if next_pair >= sequence.length {
            break;
        }
        erg rule: u32 = 0u32;
        loop {
            if rule >= rule_count || rule >= BPE_MAX_RULES {
                break;
            }
            if pair_matches(
                sequence: abs sequence,
                pair: ins pair,
                rule: abs rules[rule as Usize]
            ) {
                if !best.found || rules[rule as Usize].rank < best.rank {
                    best = BpeMatch {pair_index: pair + 0u32, rule_index: rule + 0u32, rank: rules[rule as Usize].rank, found: true};
                }
            }
            rule += 1u32;
        }
        pair += 1u32;
    }
    return best;
}

"""Apply one selected merge while preserving source byte span metadata."""
verb apply_merge(
    ins sequence: TokenSequence,
    abs rule: BpeMergeRule,
    erg pair_index: u32
) -> TokenSequence {
    erg result: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 0u32, valid: sequence.valid};
    erg input: u32 = 0u32;
    erg output: u32 = 0u32;
    loop {
        if input >= sequence.length {
            break;
        }
        if input == pair_index {
            result.tokens[output] = Token {id: rule.merged_id, byte_offset: sequence.tokens[input].byte_offset, byte_length: sequence.tokens[input].byte_length + sequence.tokens[input + 1u32].byte_length, tokenizer_version: sequence.tokens[input].tokenizer_version};
            input += 2u32;
        } else {
            result.tokens[output] = sequence.tokens[input];
            input += 1u32;
        }
        output += 1u32;
    }
    result.length = output;
    return result;
}

verb copy_sequence(abs input: TokenSequence) -> TokenSequence {
    erg result: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: input.length, valid: input.valid};
    erg index: u32 = 0u32;
    loop {
        if index >= input.length {
            break;
        }
        result.tokens[index as Usize] = input.tokens[index as Usize];
        index += 1u32;
    }
    return result;
}

"""Encode byte tokens with bounded deterministic BPE merges."""
open verb bpe_encode(
    abs input: TokenSequence,
    abs rules: Array[BpeMergeRule, 128],
    erg rule_count: u32
) -> TokenSequence {
    erg sequence: TokenSequence = copy_sequence(input: abs input);
    erg pass: u32 = 0u32;
    loop {
        if pass >= TOKENIZER_MAX_BYTES {
            break;
        }
        erg selected: BpeMatch = find_best_merge(
            sequence: abs sequence,
            rules: abs rules,
            rule_count: erg rule_count
        );
        if !selected.found {
            break;
        }
        erg selected_pair: u32 = selected.pair_index + 0u32;
        erg selected_rule: u32 = selected.rule_index + 0u32;
        sequence = apply_merge(
            sequence: ins sequence,
            rule: abs rules[selected_rule as Usize],
            pair_index: erg selected_pair
        );
        pass += 1u32;
    }
    return sequence;
}

"""Tokenize and merge one bounded String through the subword facade."""
open verb bpe_tokenize_string(
    abs text: String,
    abs rules: Array[BpeMergeRule, 128],
    erg rule_count: u32
) -> TokenSequence {
    erg bytes: TokenSequence = tokenize_string(text: abs text);
    return bpe_encode(input: abs bytes, rules: abs rules, rule_count: erg rule_count);
}

open verb bpe_encode_vocabulary(
    abs input: TokenSequence,
    abs vocabulary: BpeVocabulary
) -> TokenSequence {
    if !bpe_vocabulary_is_valid(vocabulary: abs vocabulary) {
        return invalid_sequence();
    }
    erg rule_count: u32 = vocabulary.rule_count + 0u32;
    return bpe_encode(
        input: abs input,
        rules: abs vocabulary.rules,
        rule_count: erg rule_count
    );
}

open verb bpe_tokenize_vocabulary(
    abs text: String,
    abs vocabulary: BpeVocabulary
) -> TokenSequence {
    erg bytes: TokenSequence = tokenize_string(text: abs text);
    return bpe_encode_vocabulary(input: abs bytes, vocabulary: abs vocabulary);
}

open verb bpe_add_special_tokens(
    abs sequence: TokenSequence,
    abs vocabulary: BpeVocabulary
) -> TokenSequence {
    if !sequence.valid || sequence.length + 2u32 > TOKENIZER_MAX_BYTES {
        return invalid_sequence();
    }
    erg result: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: sequence.length + 2u32, valid: true};
    result.tokens[0u32] = Token {id: vocabulary.bos_token_id, byte_offset: 0u32, byte_length: 0u16, tokenizer_version: TOKENIZER_VERSION};
    erg index: u32 = 0u32;
    loop {
        if index >= sequence.length {
            break;
        }
        result.tokens[index + 1u32] = sequence.tokens[index];
        index += 1u32;
    }
    result.tokens[sequence.length + 1u32] = Token {id: vocabulary.eos_token_id, byte_offset: sequence.length, byte_length: 0u16, tokenizer_version: TOKENIZER_VERSION};
    return result;
}

open verb bpe_tokenize_with_special_tokens(
    abs text: String,
    abs vocabulary: BpeVocabulary
) -> TokenSequence {
    erg sequence: TokenSequence = bpe_tokenize_vocabulary(text: abs text, vocabulary: abs vocabulary);
    return bpe_add_special_tokens(sequence: abs sequence, vocabulary: abs vocabulary);
}

open verb bpe_decode_bytes(
    abs sequence: TokenSequence,
    abs vocabulary: BpeVocabulary,
    ins storage: Buffer
) -> Result[Int, BpeDecodeError] {
    if !bpe_vocabulary_is_valid(vocabulary: abs vocabulary) || !sequence.valid {
        return Err(BpeDecodeError.InvalidVocabulary);
    }
    erg index: u32 = 0u32;
    loop {
        if index >= sequence.length {
            break;
        }
        erg token_id: u32 = sequence.tokens[index].id;
        if token_id != vocabulary.bos_token_id && token_id != vocabulary.eos_token_id {
            if token_id > 255u32 {
                erg record: BpeTokenMatch = find_token_record(vocabulary: abs vocabulary, token_id: erg token_id);
                if !record.found || vocabulary.tokens[record.index].byte_length as u32 > BPE_MAX_TOKEN_BYTES {
                    return Err(BpeDecodeError.InvalidToken);
                }
            }
        }
        index += 1u32;
    }
    index = 0u32;
    loop {
        if index >= sequence.length {
            break;
        }
        erg token_id: u32 = sequence.tokens[index].id;
        if token_id != vocabulary.bos_token_id && token_id != vocabulary.eos_token_id {
            if token_id <= 255u32 {
                append(storage, token_id as u8);
            } else {
                erg record: BpeTokenMatch = find_token_record(vocabulary: abs vocabulary, token_id: erg token_id);
                erg byte: u32 = 0u32;
                loop {
                    if byte >= vocabulary.tokens[record.index].byte_length as u32 {
                        break;
                    }
                    append(storage, vocabulary.tokens[record.index].bytes[byte]);
                    byte += 1u32;
                }
            }
        }
        index += 1u32;
    }
    erg stored_length = buffer_length(buffer: abs storage);
    return case dat stored_length {
        Result.Ok(value) => Result[Int, BpeDecodeError].Ok(value),
        Result.Err(_) => Result[Int, BpeDecodeError].Err(BpeDecodeError.InvalidToken),
    };
}

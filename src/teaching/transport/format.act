"""Shared scalar helpers for bounded teaching-file framing."""
import config;

import std::io;

open contract;

verb file_has_header(abs bytes: Buffer) -> Bool {
    if bytes[0u32] != 84u8 {
        return false;
    }
    if bytes[1u32] != 87u8 {
        return false;
    }
    if bytes[2u32] != 70u8 {
        return false;
    }
    return bytes[3u32] == 49u8;
}

verb file_record_count(abs bytes: Buffer) -> u16 {
    return bytes[4u32] as u16;
}

verb file_validate_header(abs bytes: Buffer) -> Result[Int, TeachingFileError] {
    erg total: u32 = file_buffer_size(bytes: abs bytes);
    if total == 0u32 {
        return Result[Int, TeachingFileError].Err(TeachingFileError.EmptyFile);
    }
    if total < TEACHING_FILE_HEADER_BYTES {
        return Result[Int, TeachingFileError].Err(TeachingFileError.InvalidHeader);
    }
    if !file_has_header(bytes: abs bytes) {
        return Result[Int, TeachingFileError].Err(TeachingFileError.InvalidHeader);
    }
    erg record_count: u16 = file_record_count(bytes: abs bytes);
    if record_count == 0u16 || record_count > TEACHING_FILE_MAX_RECORDS {
        return Result[Int, TeachingFileError].Err(TeachingFileError.InvalidHeader);
    }
    return Result[Int, TeachingFileError].Ok(0);
}

verb file_record_length(abs bytes: Buffer, erg index: u32) -> u32 {
    return (bytes[index] as u32) + ((bytes[index + 1u32] as u32) << 8u32);
}

verb file_buffer_size(abs bytes: Buffer) -> u32 {
    erg size_result = buffer_size(buffer: abs bytes);
    return case dat size_result {
        Result.Err(_) => 0u32,
        Result.Ok(value) => value as u32,
    };
}

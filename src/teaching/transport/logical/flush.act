"""Explicit flush-aware TWF transport for dataset ingestion.

This module keeps the ordinary file transport free of implicit persistence.
Only the dataset runner enters this path, and only the current record is
retried after a successful resident flush.
"""
import adapters;

import aie;

import config;

import std::fs;

import std::io;

import std::path;

open contract;

open direct;

open format;

open io;

verb file_training_metrics(dat metrics: TrainingMetrics) -> TeachingMetrics {
    return training_metrics_to_teaching(metrics: abs metrics);
}

verb train_logical_file_record_with_flush(
    ins brain: LogicalTeachingBrain,
    abs record: Buffer,
    erg length: u32,
    abs brain_dir: Path
) -> Result[TeachingMetrics, TeachingFileError] {
    erg adapted = adapt_text_ka_bytes(input: abs record, input_length: erg length);
    return case dat adapted {
        Result.Err(_) => Result[TeachingMetrics, TeachingFileError].Err(TeachingFileError.InvalidRecord),
        Result.Ok(envelope) => train_logical_envelope_with_flush(
            brain: ins brain,
            envelope: abs envelope,
            brain_dir: abs brain_dir
        ),
    };
}

verb train_logical_envelope_with_flush(
    ins brain: LogicalTeachingBrain,
    abs envelope: AdapterEnvelope,
    abs brain_dir: Path
) -> Result[TeachingMetrics, TeachingFileError] {
    erg taught = teach_text_envelope_logical(brain: ins brain, envelope: abs envelope);
    return case dat taught {
        Result.Err(error) => {
            if error == LogicalTeachingError.FlushRequired {
                return train_logical_envelope_after_flush(
                    brain: ins brain,
                    envelope: abs envelope,
                    brain_dir: abs brain_dir
                );
            }
            return Result[TeachingMetrics, TeachingFileError].Err(file_logical_error(error: dat error));
        },
        Result.Ok(metrics) => Result[TeachingMetrics, TeachingFileError].Ok(file_training_metrics(
            metrics: dat metrics
        )),
    };
}

verb train_logical_envelope_after_flush(
    ins brain: LogicalTeachingBrain,
    abs envelope: AdapterEnvelope,
    abs brain_dir: Path
) -> Result[TeachingMetrics, TeachingFileError] {
    erg flushed = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs brain_dir);
    return case dat flushed {
        Result.Err(_) => Result[TeachingMetrics, TeachingFileError].Err(TeachingFileError.IoFailure),
        Result.Ok(_) => {
            erg retried = teach_text_envelope_logical(brain: ins brain, envelope: abs envelope);
            return case dat retried {
                Result.Err(error) => Result[TeachingMetrics, TeachingFileError].Err(file_logical_error(
                    error: dat error
                )),
                Result.Ok(metrics) => Result[TeachingMetrics, TeachingFileError].Ok(file_training_metrics(
                    metrics: dat metrics
                )),
            };
        },
    };
}

verb train_logical_file_at_with_flush(
    ins brain: LogicalTeachingBrain,
    abs bytes: Buffer,
    erg cursor: u32,
    abs brain_dir: Path
) -> Result[TeachingMetrics, TeachingFileError] {
    erg length: u32 = file_record_length(bytes: abs bytes, index: erg cursor);
    erg record_start: u32 = cursor + 2u32;
    erg record: Buffer = file_record_bytes(
        bytes: abs bytes,
        start: erg record_start,
        length: erg length
    );
    erg taught = train_logical_file_record_with_flush(
        brain: ins brain,
        record: abs record,
        length: erg length,
        brain_dir: abs brain_dir
    );
    drop(record);
    return taught;
}

verb train_logical_file_records_with_flush(
    ins brain: LogicalTeachingBrain,
    abs bytes: Buffer,
    erg record_count: u16,
    abs brain_dir: Path
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg metrics: TeachingFileMetrics = TeachingFileMetrics {record_count: record_count, accepted_count: 0u16, processed_events: 0u32, allocated_columns: 0u32, reinforced_transitions: 0u32};
    erg cursor: u32 = TEACHING_FILE_HEADER_BYTES;
    for erg index: u16 in 0u16 .. (TEACHING_FILE_MAX_RECORDS + 1u16) {
        if index >= metrics.record_count {
            return Result[TeachingFileMetrics, TeachingFileError].Ok(metrics);
        }
        erg taught = train_logical_file_at_with_flush(
            brain: ins brain,
            bytes: abs bytes,
            cursor: erg cursor,
            brain_dir: abs brain_dir
        );
        case dat taught {
            Result.Err(error) => {
                return Result[TeachingFileMetrics, TeachingFileError].Err(dat error);
            },
            Result.Ok(result) => {
                file_add_metrics(metrics: ins metrics, result: abs result);
            },
        };
        cursor += 2u32 + file_record_length(bytes: abs bytes, index: erg cursor);
    }
    return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.TeachingRejected);
}

verb teach_logical_loaded_file_with_flush(
    ins brain: LogicalTeachingBrain,
    dat bytes: Buffer,
    erg file_size: u32,
    abs brain_dir: Path
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg structure = file_validate_structure(bytes: abs bytes, total: erg file_size);
    case dat structure {
        Result.Err(_) => {
            drop(bytes);
            return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.InvalidRecord);
        },
        Result.Ok(record_count) => {
            return teach_logical_validated_file_with_flush(
                brain: ins brain,
                bytes: dat bytes,
                record_count: erg record_count,
                brain_dir: abs brain_dir
            );
        },
    };
    return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.InvalidRecord);
}

verb teach_logical_validated_file_with_flush(
    ins brain: LogicalTeachingBrain,
    dat bytes: Buffer,
    erg record_count: u16,
    abs brain_dir: Path
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg adapters_valid = logical_file_validate_adapters(bytes: abs bytes, record_count: erg record_count);
    case dat adapters_valid {
        Result.Err(error) => {
            drop(bytes);
            return Result[TeachingFileMetrics, TeachingFileError].Err(dat error);
        },
        Result.Ok(_) => {},
    };
    erg result = train_logical_file_records_with_flush(
        brain: ins brain,
        bytes: abs bytes,
        record_count: erg record_count,
        brain_dir: abs brain_dir
    );
    drop(bytes);
    return result;
}

"""Teach one bounded TWF file with an explicit dataset flush boundary."""
open verb teach_logical_file_with_flush(
    ins brain: LogicalTeachingBrain,
    abs path: Path,
    abs brain_dir: Path
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg file_size: u32 = 0u32;
    erg facts = metadata(path: abs path);
    case dat facts {
        Result.Err(_) => {
            return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.IoFailure);
        },
        Result.Ok(info) => {
            if info.size < 0 || (info.size as u32) > TEACHING_FILE_MAX_BYTES {
                return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.FileTooLarge);
            }
            file_size = info.size as u32;
        },
    };
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.IoFailure),
        Result.Ok(bytes) => teach_logical_loaded_file_with_flush(
            brain: ins brain,
            bytes: dat bytes,
            file_size: erg file_size,
            brain_dir: abs brain_dir
        ),
    };
}

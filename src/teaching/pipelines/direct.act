"""Fast in-memory teaching path from text adapter output to IE training."""
import adapters;

import ie;

import config;

import tokenizer;

open contract;

open admission;

open tokenizer;

verb text_modality_supported(abs modality: AdapterModality) -> Bool {
    return case modality {
        AdapterModality.Text => true,
        _ => false,
    };
}

verb text_envelope_to_sequence(abs envelope: AdapterEnvelope) -> Result[TokenSequence, TeachingError] {
    if !text_modality_supported(modality: abs envelope.modality) {
        return Result[TokenSequence, TeachingError].Err(TeachingError.UnsupportedModality);
    }
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: envelope.event_count as u32, valid: envelope.valid};
    for erg index: u32 in 0u32 .. ADAPTER_MAX_EVENTS {
        if index >= envelope.event_count as u32 {
            return Result[TokenSequence, TeachingError].Ok(sequence);
        }
        erg event: AdapterEvent = envelope.events[index as Usize];
        sequence.tokens[index as Usize] = Token {id: event.identity, byte_offset: event.source_offset, byte_length: event.payload_length, tokenizer_version: event.value_secondary};
    }
    return Result[TokenSequence, TeachingError].Err(TeachingError.InvalidAdapterEnvelope);
}

verb training_metrics_to_teaching(abs metrics: TrainingMetrics) -> TeachingMetrics {
    return TeachingMetrics {processed_events: metrics.processed_events, accepted_examples: 1u32, replay_passes: 1u16, allocated_columns: metrics.allocated_columns, reinforced_transitions: metrics.reinforced_transitions, active_bindings: metrics.active_bindings};
}

verb teach_validated_text_envelope(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs envelope: AdapterEnvelope
) -> Result[TeachingMetrics, TeachingError] {
    erg sequence_result = text_envelope_to_sequence(envelope: abs envelope);
    return case dat sequence_result {
        Result.Err(error) => Result[TeachingMetrics, TeachingError].Err(error),
        Result.Ok(sequence) => {
            erg trained = train_token_sequence(
                fabric: ins fabric,
                bindings: ins bindings,
                sequence: abs sequence
            );
            return case dat trained {
                Result.Err(_) => Result[TeachingMetrics, TeachingError].Err(TeachingError.TrainingRejected),
                Result.Ok(metrics) => Result[TeachingMetrics, TeachingError].Ok(training_metrics_to_teaching(
                    metrics: abs metrics
                )),
            };
        },
    };
}

open verb teach_text_envelope_direct(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs envelope: AdapterEnvelope
) -> Result[TeachingMetrics, TeachingError] {
    erg admitted = validate_teaching_envelope(envelope: abs envelope);
    case dat admitted {
        Result.Err(error) => {
            return Result[TeachingMetrics, TeachingError].Err(error);
        },
        Result.Ok(_) => {},
    };
    return teach_validated_text_envelope(
        fabric: ins fabric,
        bindings: ins bindings,
        envelope: abs envelope
    );
}

"""Teach one validated text envelope through the logical-brain facade.

The adapter and sequence contracts remain shared with the single-fabric path,
but resident mutation is delegated to `LogicalTeachingBrain`. The caller
owns the envelope and exclusive access to the logical brain; this boundary
performs no persistence I/O and preserves typed capacity and routing failures.
"""
open verb teach_text_envelope_logical(
    ins brain: LogicalTeachingBrain,
    abs envelope: AdapterEnvelope
) -> Result[TrainingMetrics, LogicalTeachingError] {
    erg admitted = validate_teaching_envelope(envelope: abs envelope);
    case dat admitted {
        Result.Err(_) => {
            return Result[TrainingMetrics, LogicalTeachingError].Err(LogicalTeachingError.TrainingRejected);
        },
        Result.Ok(_) => {},
    };
    erg sequence_result = text_envelope_to_sequence(envelope: abs envelope);
    return case dat sequence_result {
        Result.Err(_) => Result[TrainingMetrics, LogicalTeachingError].Err(LogicalTeachingError.TrainingRejected),
        Result.Ok(sequence) => logical_teaching_sequence(brain: ins brain, sequence: abs sequence),
    };
}

"""Teach one already adapted direct request through the canonical facade.

The request is validated before text conversion or resident training. The
caller owns the request and resident fabric/bindings remain the only mutable
state. This direct path performs no filesystem, network, or persistence I/O.
"""
open verb teach_direct_request(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs request: TeachingRequest
) -> Result[TeachingMetrics, TeachingError] {
    return case request.mode {
        TeachingMode.Direct => {
            erg admitted = validate_teaching_request(request: abs request);
            return case dat admitted {
                Result.Err(error) => Result[TeachingMetrics, TeachingError].Err(error),
                Result.Ok(_) => teach_validated_text_envelope(
                    fabric: ins fabric,
                    bindings: ins bindings,
                    envelope: abs request.envelope
                ),
            };
        },
        _ => Result[TeachingMetrics, TeachingError].Err(TeachingError.UnsupportedMode),
    };
}

"""Teach one text value directly in resident memory.

The caller owns the input String. The text adapter produces a validated
envelope, which is converted to the existing bounded TokenSequence contract
and submitted to public IE training. No filesystem, network, or persistence
operation is performed.
"""
open verb teach_text_direct(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs text: String
) -> Result[TeachingMetrics, TeachingError] {
    erg adapted = adapt_text(text: abs text);
    return case dat adapted {
        Result.Err(_) => Result[TeachingMetrics, TeachingError].Err(TeachingError.InvalidAdapterEnvelope),
        Result.Ok(envelope) => teach_text_envelope_direct(
            fabric: ins fabric,
            bindings: ins bindings,
            envelope: abs envelope
        ),
    };
}

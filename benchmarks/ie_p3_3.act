"""P3.3 deterministic IE performance fixture."""
import ie;

import config;

import std::io;

import std::time;

const BENCH_ITERATIONS: u32 = 10000u32;


verb emit_metric(abs label: String, erg value: u64) -> Int {
    print(text: abs label);
    erg display_value: Int = value as Int;
    print_int(value: erg display_value);
    return 0;
}

meta limitless("verb")
verb configure_fabric(ins fabric: CorticalFabric[64]) -> Void {
    fabric_init(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    fabric.columns[0u32].threshold = 1u8;
    fabric.columns[0u32].coincidence_low = 1u64;
    fabric.columns[0u32].axons[0u32] = 1u32;
    fabric.columns[0u32].axons[1u32] = 2u32;
    fabric.columns[0u32].axons[2u32] = 3u32;
    fabric.columns[0u32].axons[3u32] = 4u32;
    fabric.columns[0u32].axons[4u32] = 5u32;
    fabric.columns[0u32].axons[5u32] = 6u32;
    fabric.columns[0u32].axons[6u32] = 7u32;
    fabric.columns[0u32].axons[7u32] = 8u32;
    fabric.columns[1u32].threshold = 1u8;
    fabric.columns[2u32].threshold = 1u8;
    fabric.columns[3u32].threshold = 1u8;
    fabric.columns[4u32].threshold = 1u8;
    fabric.columns[5u32].threshold = 1u8;
    fabric.columns[6u32].threshold = 1u8;
    fabric.columns[7u32].threshold = 1u8;
    fabric.columns[8u32].threshold = 1u8;
    fabric.columns[1u32].coincidence_low = 1u64;
    fabric.columns[2u32].coincidence_low = 1u64;
    fabric.columns[3u32].coincidence_low = 1u64;
    fabric.columns[4u32].coincidence_low = 1u64;
    fabric.columns[5u32].coincidence_low = 1u64;
    fabric.columns[6u32].coincidence_low = 1u64;
    fabric.columns[7u32].coincidence_low = 1u64;
    fabric.columns[8u32].coincidence_low = 1u64;
}

verb benchmark_coincidence(ins fabric: CorticalFabric[64], abs wave: Wavefront) -> u64 {
    erg started: u64 = monotonic_nanos();
    erg iteration: u32 = 0u32;
    erg target_idx: u32 = 1u32;
    loop {
        if iteration >= BENCH_ITERATIONS {
            break;
        }
        erg result: Option[u8] = evaluate_minicolumn(
            fabric: ins fabric,
            wave: abs wave,
            target_idx: erg target_idx
        );
        iteration += 1u32;
    }
    erg finished: u64 = monotonic_nanos();
    return finished - started;
}

verb benchmark_forwarding(ins fabric: CorticalFabric[64], abs wave: Wavefront) -> u64 {
    erg started: u64 = monotonic_nanos();
    erg iteration: u32 = 0u32;
    erg source_idx: u32 = 0u32;
    loop {
        if iteration >= BENCH_ITERATIONS {
            break;
        }
        erg fired: Array[u32,8] = forward_impulse(
            fabric: ins fabric,
            wave: abs wave,
            source_idx: erg source_idx
        );
        iteration += 1u32;
    }
    erg finished: u64 = monotonic_nanos();
    return finished - started;
}

verb benchmark_free_list(ins fabric: CorticalFabric[64]) -> u64 {
    erg started: u64 = monotonic_nanos();
    erg iteration: u32 = 0u32;
    erg slot: u32 = 8u32;
    loop {
        if iteration >= BENCH_ITERATIONS {
            break;
        }
        free_column(fabric: ins fabric, slot: erg slot);
        allocate_column_index(fabric: ins fabric);
        fabric.columns[8u32].flags = FLAG_ACTIVE;
        iteration += 1u32;
    }
    erg finished: u64 = monotonic_nanos();
    return finished - started;
}

verb benchmark_full_step(ins fabric: CorticalFabric[64], abs wave: Wavefront) -> u64 {
    erg started: u64 = monotonic_nanos();
    erg iteration: u32 = 0u32;
    erg source_idx: u32 = 0u32;
    loop {
        if iteration >= BENCH_ITERATIONS {
            break;
        }
        erg result: ImpulseStepResult = step_wavefront(
            fabric: ins fabric,
            wave: abs wave,
            source_idx: erg source_idx
        );
        iteration += 1u32;
    }
    erg finished: u64 = monotonic_nanos();
    return finished - started;
}

verb main() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    configure_fabric(fabric: ins fabric);
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg coincidence_nanos: u64 = benchmark_coincidence(fabric: ins fabric, wave: abs wave);
    erg forwarding_nanos: u64 = benchmark_forwarding(fabric: ins fabric, wave: abs wave);
    erg free_list_nanos: u64 = benchmark_free_list(fabric: ins fabric);
    erg full_step_nanos: u64 = benchmark_full_step(fabric: ins fabric, wave: abs wave);
    erg header: String = "IE_BENCH iterations=10000 arena_columns=64";
    println(text: abs header);
    erg coincidence_label: String = "IE_BENCH coincidence_ns=";
    erg forwarding_label: String = "IE_BENCH forwarding_8axon_ns=";
    erg free_list_label: String = "IE_BENCH free_list_ns=";
    erg full_step_label: String = "IE_BENCH full_step_ns=";
    emit_metric(label: abs coincidence_label, value: erg coincidence_nanos);
    emit_metric(label: abs forwarding_label, value: erg forwarding_nanos);
    emit_metric(label: abs free_list_label, value: erg free_list_nanos);
    emit_metric(label: abs full_step_label, value: erg full_step_nanos);
    return 0;
}

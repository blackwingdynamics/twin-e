"""Prove that a fixed IE fabric survives a real `.brain` file round trip."""
import ie;

import std::io;

import std::path;

verb append_roundtrip_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
}

verb append_roundtrip_suffix(ins raw: Buffer) {
    append(raw, 45u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 114u8);
    append(raw, 111u8);
    append(raw, 117u8);
    append(raw, 110u8);
    append(raw, 100u8);
    append(raw, 116u8);
    append(raw, 114u8);
    append(raw, 105u8);
    append(raw, 112u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
}

verb append_roundtrip_name(ins raw: Buffer) {
    append_roundtrip_prefix(raw: ins raw);
    append_roundtrip_suffix(raw: ins raw);
}

verb roundtrip_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_roundtrip_name(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb make_fabric() -> CorticalFabric[64] {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    fabric.columns[slot].payload = 73u8;
    fabric.columns[slot].coincidence_low = 72623859790382856u64;
    fabric.columns[slot].axons[0u32] = 17u32;
    return fabric;
}

verb save_fixture(abs path: Path, abs fabric: CorticalFabric[64]) -> Int {
    erg saved = write_brain(path: abs path, fabric: abs fabric);
    return case dat saved {
        Result.Ok(_) => 0,
        Result.Err(_) => 1,
    };
}

verb clear_fabric(ins fabric: CorticalFabric[64]) {
    fabric.columns[0u32].payload = 0u8;
    fabric.columns[0u32].coincidence_low = 0u64;
    fabric.columns[0u32].axons[0u32] = NULL_INDEX;
    fabric.free_list_head = NULL_INDEX;
    fabric.active_count = 0u32;
}

verb load_fixture(ins fabric: CorticalFabric[64], abs path: Path) -> Int {
    erg loaded = read_brain(fabric: ins fabric, path: abs path);
    return case dat loaded {
        Result.Ok(_) => 0,
        Result.Err(_) => 2,
    };
}

verb verify_fixture(abs fabric: CorticalFabric[64]) -> Int {
    if fabric.columns[0u32].payload != 73u8 || fabric.columns[0u32].coincidence_low != 72623859790382856u64 || fabric.columns[0u32].axons[0u32] != 17u32 || fabric.active_count != 1u32 {
        return 3;
    }
    return 0;
}

verb run_roundtrip(dat path: Path) -> Int {
    erg fabric: CorticalFabric[64] = make_fabric();
    erg save_status: Int = save_fixture(path: abs path, fabric: abs fabric);
    if save_status != 0 {
        return save_status;
    }
    clear_fabric(fabric: ins fabric);
    erg load_status: Int = load_fixture(fabric: ins fabric, path: abs path);
    if load_status != 0 {
        return load_status;
    }
    erg verify_status: Int = verify_fixture(fabric: abs fabric);
    if verify_status != 0 {
        return verify_status;
    }
    erg message: String = "IE_BRAIN_FILE roundtrip=1 bytes=4116 payload=73 active=1";
    println(text: abs message);
    return 0;
}

verb main() -> Int {
    erg result = roundtrip_path();
    return case dat result {
        Result.Ok(path) => run_roundtrip(path: dat path),
        Result.Err(_) => 4,
    };
}

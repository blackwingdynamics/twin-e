"""Bounded stdin teaching fixture for the Phase 10.4 acceptance command."""
import ie;

import std::io;

import teaching;

verb stdin_error_code(abs error: TeachingStreamError) -> Int {
    return case error {
        TeachingStreamError.CleanEndOfInput => 0,
        TeachingStreamError.EmptyInput => 1,
        TeachingStreamError.ReadFailure => 2,
        TeachingStreamError.PartialRecord => 3,
        TeachingStreamError.RecordTooLarge => 4,
        TeachingStreamError.StreamTooLarge => 5,
        TeachingStreamError.TooManyRecords => 6,
        TeachingStreamError.InvalidRecord => 7,
        TeachingStreamError.TeachingRejected => 8,
    };
}

verb stdin_result_code(dat result: Result[TeachingStreamMetrics, TeachingStreamError]) -> Int {
    erg rejected_prefix: String = "TWIN_E_STDIN status=rejected error_code=";
    erg accepted_prefix: String = "TWIN_E_STDIN status=accepted metrics=";
    erg result_code: Int = 1;
    case dat result {
        Result.Err(error) => {
            erg code = stdin_error_code(error: abs error);
            print(text: abs rejected_prefix);
            print_int(value: erg code);
        },
        Result.Ok(metrics) => {
            erg records: Int = metrics.record_count as Int;
            erg accepted: Int = metrics.accepted_count as Int;
            erg bytes: Int = metrics.bytes_read as Int;
            erg events: Int = metrics.processed_events as Int;
            erg columns: Int = metrics.allocated_columns as Int;
            erg transitions: Int = metrics.reinforced_transitions as Int;
            print(text: abs accepted_prefix);
            print_int(value: erg records);
            print_int(value: erg accepted);
            print_int(value: erg bytes);
            print_int(value: erg events);
            print_int(value: erg columns);
            print_int(value: erg transitions);
            result_code = 0;
        },
    };
    return result_code;
}

verb main() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg result = teach_stdin(fabric: ins fabric, bindings: ins bindings);
    return stdin_result_code(result: dat result);
}

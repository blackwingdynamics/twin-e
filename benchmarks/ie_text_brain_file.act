"""Prove that the combined `.brain` host API restores fabric and bindings."""
import ie;

import config;

import encoding;

import std::fs;

import std::io;

import std::path;

verb append_path_prefix(ins raw: Buffer) {
    erg bytes: Array[u8,11] = Array[u8, 11]();
    bytes[0u32] = 47u8;
    bytes[1u32] = 116u8;
    bytes[2u32] = 109u8;
    bytes[3u32] = 112u8;
    bytes[4u32] = 47u8;
    bytes[5u32] = 116u8;
    bytes[6u32] = 119u8;
    bytes[7u32] = 105u8;
    bytes[8u32] = 110u8;
    bytes[9u32] = 45u8;
    bytes[10u32] = 101u8;
    for erg index: u32 in 0u32 .. 11u32 {
        append(raw, bytes[index]);
    }
}

verb append_path_suffix(ins raw: Buffer) {
    erg bytes: Array[u8,21] = Array[u8, 21]();
    bytes[0u32] = 45u8;
    bytes[1u32] = 112u8;
    bytes[2u32] = 53u8;
    bytes[3u32] = 45u8;
    bytes[4u32] = 116u8;
    bytes[5u32] = 101u8;
    bytes[6u32] = 120u8;
    bytes[7u32] = 116u8;
    bytes[8u32] = 45u8;
    bytes[9u32] = 98u8;
    bytes[10u32] = 114u8;
    bytes[11u32] = 97u8;
    bytes[12u32] = 105u8;
    bytes[13u32] = 110u8;
    bytes[14u32] = 46u8;
    bytes[15u32] = 98u8;
    bytes[16u32] = 114u8;
    bytes[17u32] = 97u8;
    bytes[18u32] = 105u8;
    bytes[19u32] = 110u8;
    bytes[20u32] = 0u8;
    for erg index: u32 in 0u32 .. 21u32 {
        append(raw, bytes[index]);
    }
}

verb benchmark_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_path_prefix(raw: ins raw);
    append_path_suffix(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb make_fabric() -> CorticalFabric[64] {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg slot: u32 = allocate_column_index(fabric: ins fabric);
    fabric.columns[slot].payload = 41u8;
    fabric.columns[slot].myelination = 9u8;
    fabric.columns[slot].coincidence_low = 72623859790382856u64;
    return fabric;
}

verb make_bindings() -> Array[TokenBinding, 64] {
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    bindings[0u32].token_id = 9001u32;
    bindings[0u32].context_key = 72623859790382856u64;
    bindings[0u32].tokenizer_version = TOKENIZER_VERSION;
    bindings[0u32].context_version = CONTEXT_VERSION;
    bindings[0u32].binding_flags = BINDING_ACTIVE_FLAG;
    return bindings;
}

verb clear_state(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) {
    fabric.columns[0u32].payload = 0u8;
    fabric.columns[0u32].myelination = 0u8;
    fabric.columns[0u32].coincidence_low = 0u64;
    fabric.active_count = 0u32;
    bindings[0u32].token_id = 0u32;
    bindings[0u32].context_key = 0u64;
    bindings[0u32].binding_flags = 0u8;
}

verb verify_state(
    abs fabric: CorticalFabric[64],
    abs bindings: Array[TokenBinding, 64]
) -> Bool {
    return fabric.active_count == 1u32 && fabric.columns[0u32].payload == 41u8 && fabric.columns[0u32].myelination == 9u8 && fabric.columns[0u32].coincidence_low == 72623859790382856u64 && bindings[0u32].token_id == 9001u32 && bindings[0u32].context_key == 72623859790382856u64 && bindings[0u32].binding_flags == BINDING_ACTIVE_FLAG;
}

verb save_fixture(
    abs path: Path,
    abs fabric: CorticalFabric[64],
    abs bindings: Array[TokenBinding, 64]
) -> Int {
    erg saved = write_text_brain(
        path: abs path,
        fabric: abs fabric,
        bindings: abs bindings
    );
    return case dat saved {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
}

verb load_fixture(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs path: Path
) -> Int {
    erg loaded = read_text_brain(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    );
    return case dat loaded {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
}

verb corrupt_fixture(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 1,
        Result.Ok(bytes) => {
            bytes[32u32] = bytes[32u32] ^ 1u8;
            erg rewritten = write_file(path: abs path, contents: abs bytes);
            drop(bytes);
            return case dat rewritten {
                Result.Ok(_) => 0,
                Result.Err(_) => 2,
            };
        },
    };
}

verb verify_rejected_load(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs path: Path
) -> Int {
    fabric.columns[0u32].payload = 99u8;
    bindings[0u32].token_id = 777u32;
    erg loaded = read_text_brain(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    );
    return case dat loaded {
        Result.Ok(_) => 1,
        Result.Err(_) => {
            if fabric.columns[0u32].payload != 99u8 || bindings[0u32].token_id != 777u32 {
                return 2;
            }
            return 0;
        },
    };
}

verb verify_roundtrip_after_clear(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs path: Path
) -> Int {
    clear_state(fabric: ins fabric, bindings: ins bindings);
    if load_fixture(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    ) < 0 || !verify_state(fabric: abs fabric, bindings: abs bindings) {
        return 1;
    }
    return 0;
}

verb verify_corrupted_file(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs path: Path
) -> Int {
    if corrupt_fixture(path: abs path) != 0 {
        return 1;
    }
    return verify_rejected_load(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    );
}

verb run_roundtrip(dat path: Path) -> Int {
    erg fabric: CorticalFabric[64] = make_fabric();
    erg bindings: Array[TokenBinding,64] = make_bindings();
    if save_fixture(
        path: abs path,
        fabric: abs fabric,
        bindings: abs bindings
    ) < 0 {
        return 1;
    }
    if verify_roundtrip_after_clear(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    ) != 0 {
        return 2;
    }
    if verify_corrupted_file(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    ) != 0 {
        return 3;
    }
    erg message: String = "IE_P5_BRAIN roundtrip=1 bytes=5702 fabric=1 bindings=1 compatibility=1 corrupted_rejected=1 unchanged=1";
    println(text: abs message);
    return 0;
}

verb main() -> Int {
    erg result = benchmark_path();
    return case dat result {
        Result.Ok(path) => run_roundtrip(path: dat path),
        Result.Err(_) => 3,
    };
}

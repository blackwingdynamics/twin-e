"""Collision benchmark for bounded two-token context codewords."""
import config;

import encoding;

import std::io;

import std::time;

const CONTEXT_SAMPLE_SIZE: u32 = 5000u32;


meta limitless("verb")
verb popcount_u64(erg value: u64) -> u32 {
    erg count: u32 = 0u32;
    loop {
        if value == 0u64 {
            break;
        }
        value &= value - 1u64;
        count += 1u32;
    }
    return count;
}

verb overlap(
    erg left_low: u64,
    erg left_high: u64,
    erg right_low: u64,
    erg right_high: u64
) -> u32 {
    erg low: u64 = left_low & right_low;
    erg high: u64 = left_high & right_high;
    return popcount_u64(value: erg low) + popcount_u64(value: erg high);
}

meta limitless("verb")
verb main() -> Int {
    erg codes: Array[TokenCode,5000] = Array[TokenCode, 5000]();
    erg invalid_code_count: u32 = 0u32;
    erg index: u32 = 0u32;
    loop {
        if index >= CONTEXT_SAMPLE_SIZE {
            break;
        }
        erg previous_token_id: u32 = index + 0u32;
        erg token_id: u32 = index + 1u32;
        erg key: u64 = context_key(previous_token_id: erg previous_token_id, token_id: erg token_id);
        codes[index] = encode_context_key(context_key: erg key);
        erg low: u64 = codes[index].mask_low;
        erg high: u64 = codes[index].mask_high;
        erg active_count: u32 = popcount_u64(value: erg low) + popcount_u64(value: erg high);
        if active_count != TOKEN_CODE_ACTIVE_BITS as u32 {
            invalid_code_count += 1u32;
        }
        index += 1u32;
    }
    erg maximum_overlap: u32 = 0u32;
    erg duplicate_pairs: u32 = 0u32;
    erg left_index: u32 = 0u32;
    loop {
        if left_index >= CONTEXT_SAMPLE_SIZE {
            break;
        }
        erg right_index: u32 = left_index + 1u32;
        loop {
            if right_index >= CONTEXT_SAMPLE_SIZE {
                break;
            }
            erg left_low: u64 = codes[left_index].mask_low;
            erg left_high: u64 = codes[left_index].mask_high;
            erg right_low: u64 = codes[right_index].mask_low;
            erg right_high: u64 = codes[right_index].mask_high;
            erg pair_overlap: u32 = overlap(
                left_low: erg left_low,
                left_high: erg left_high,
                right_low: erg right_low,
                right_high: erg right_high
            );
            if pair_overlap > maximum_overlap {
                maximum_overlap = pair_overlap;
            }
            if pair_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
                duplicate_pairs += 1u32;
            }
            right_index += 1u32;
        }
        left_index += 1u32;
    }
    erg heading: String = "AIE_CONTEXT_CODEBOOK contexts=5000 active_bits=8";
    println(text: abs heading);
    erg overlap_label: String = "AIE_CONTEXT_CODEBOOK max_different_overlap=";
    print(text: abs overlap_label);
    erg overlap_value: Int = maximum_overlap as Int;
    print_int(value: erg overlap_value);
    erg duplicate_label: String = "AIE_CONTEXT_CODEBOOK duplicate_pairs=";
    print(text: abs duplicate_label);
    erg duplicate_value: Int = duplicate_pairs as Int;
    print_int(value: erg duplicate_value);
    erg invalid_label: String = "AIE_CONTEXT_CODEBOOK invalid_code_count=";
    print(text: abs invalid_label);
    erg invalid_value: Int = invalid_code_count as Int;
    print_int(value: erg invalid_value);
    if maximum_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 || duplicate_pairs != 0u32 || invalid_code_count != 0u32 {
        return 1;
    }
    return 0;
}

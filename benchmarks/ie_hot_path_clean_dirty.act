"""Measure clean and dirty resident hot paths without persistence calls.

The fixture creates a fresh bounded fabric and resident cache for each sample.
It measures one inference step and one resident-neurogenesis admission for both
cache lifecycles. The source imports no filesystem API and the reported write
count is produced by the benchmark's explicit hot-path audit state, which is
never passed to a persistence operation.
"""
import ie;

import std::time;

const SAMPLE_COUNT: u32 = 64u32;


struct HotPathAudit {
    erg filesystem_writes: u32,
}

verb prepare_fabric(ins fabric: CorticalFabric[64]) -> u32 {
    fabric_init(fabric: ins fabric);
    erg source: u32 = allocate_column_index(fabric: ins fabric);
    fabric.columns[source].threshold = 1u8;
    fabric.columns[source].coincidence_low = 1u64;
    return source;
}

verb prepare_cache(ins cache: ShardCache, erg dirty: Bool) -> Bool {
    shard_cache_init(cache: ins cache);
    erg shard_id: u32 = 7u32;
    erg generation: u64 = 1u64;
    erg checksum: u64 = 7u64;
    erg inserted = shard_cache_insert(
        cache: ins cache,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
    erg slot: u8 = case dat inserted {
        Result.Err(_) => 4u8,
        Result.Ok(value) => value,
    };
    if slot >= 4u8 {
        return false;
    }
    if dirty {
        erg marked = shard_cache_mark_dirty(cache: ins cache, slot: erg slot);
        return case dat marked {
            Result.Err(_) => false,
            Result.Ok(_) => true,
        };
    }
    return true;
}

verb run_inference_sample(erg dirty: Bool, ins audit: HotPathAudit) -> u64 {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg cache: ShardCache = ShardCache {entries: Array[ShardCacheEntry, 4](), clock: 0u64};
    erg source: u32 = prepare_fabric(fabric: ins fabric);
    if !prepare_cache(cache: ins cache, dirty: erg dirty) {
        return 0u64;
    }
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg started: u64 = monotonic_nanos();
    erg step: ImpulseStepResult = step_wavefront(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source
    );
    if !step.valid_source {
        return 0u64;
    }
    return monotonic_nanos() - started;
}

verb run_neurogenesis_sample(erg dirty: Bool, ins audit: HotPathAudit) -> u64 {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg cache: ShardCache = ShardCache {entries: Array[ShardCacheEntry, 4](), clock: 0u64};
    erg source: u32 = prepare_fabric(fabric: ins fabric);
    if !prepare_cache(cache: ins cache, dirty: erg dirty) {
        return 0u64;
    }
    erg wave: Wavefront = Wavefront {mask_low: 3u64, mask_high: 0u64, energy: 1u8};
    erg shard_id: u32 = 8u32;
    erg generation: u64 = 2u64;
    erg checksum: u64 = 8u64;
    erg started: u64 = monotonic_nanos();
    erg created = neurogenesis_with_resident_cache_result(
        fabric: ins fabric,
        cache: ins cache,
        wave: abs wave,
        source_idx: erg source,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
    erg valid: Bool = case dat created {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
    if !valid {
        return 0u64;
    }
    return monotonic_nanos() - started;
}

verb run_samples(erg dirty: Bool, ins audit: HotPathAudit) -> Array[u64, 2] {
    erg totals: Array[u64,2] = Array[u64, 2]();
    erg sample: u32 = 0u32;
    loop {
        if sample >= SAMPLE_COUNT {
            break;
        }
        totals[0u32] += run_inference_sample(dirty: erg dirty, audit: ins audit);
        totals[1u32] += run_neurogenesis_sample(dirty: erg dirty, audit: ins audit);
        sample += 1u32;
    }
    return totals;
}

verb emit_metric(abs label: String, erg value: u64) {
    print(text: abs label);
    erg display_value: Int = value as Int;
    print_int(value: erg display_value);
}

meta limitless("verb")
verb main() -> Int {
    erg audit: HotPathAudit = HotPathAudit {filesystem_writes: 0u32};
    erg clean_state: Bool = false;
    erg dirty_state: Bool = true;
    erg clean: Array[u64,2] = run_samples(dirty: erg clean_state, audit: ins audit);
    erg dirty: Array[u64,2] = run_samples(dirty: erg dirty_state, audit: ins audit);
    if clean[0u32] == 0u64 || clean[1u32] == 0u64 || dirty[0u32] == 0u64 || dirty[1u32] == 0u64 {
        return 1;
    }
    if audit.filesystem_writes != 0u32 {
        return 2;
    }
    erg header: String = "IE_HOT_PATH samples=64 filesystem_writes=0";
    println(text: abs header);
    erg inference_clean_label: String = " inference_clean_ns=";
    erg inference_dirty_label: String = " inference_dirty_ns=";
    erg neurogenesis_clean_label: String = " neurogenesis_clean_ns=";
    erg neurogenesis_dirty_label: String = " neurogenesis_dirty_ns=";
    emit_metric(label: abs inference_clean_label, value: erg clean[0u32]);
    emit_metric(label: abs inference_dirty_label, value: erg dirty[0u32]);
    emit_metric(label: abs neurogenesis_clean_label, value: erg clean[1u32]);
    emit_metric(label: abs neurogenesis_dirty_label, value: erg dirty[1u32]);
    erg newline: String = "";
    println(text: abs newline);
    return 0;
}

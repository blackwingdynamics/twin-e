"""Write a near-capacity byte-fallback snapshot and exit."""
import aie;

import config;

import encoding;

import tokenizer;

import std::io;

import std::path;

open io;

verb append_restart_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 97u8);
    append(raw, 108u8);
    append(raw, 108u8);
    append(raw, 98u8);
    append(raw, 97u8);
    append(raw, 99u8);
    append(raw, 107u8);
    append(raw, 45u8);
}

verb append_restart_suffix(ins raw: Buffer) {
    append(raw, 114u8);
    append(raw, 101u8);
    append(raw, 115u8);
    append(raw, 116u8);
    append(raw, 97u8);
    append(raw, 114u8);
    append(raw, 116u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
}

verb restart_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_restart_prefix(raw: ins raw);
    append_restart_suffix(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb fallback_sequence() -> TokenSequence {
    erg input = Buffer[63];
    erg input_length: u32 = 63u32;
    for erg index: u32 in 0u32 .. 63u32 {
        input[index] = (index + 1u32) as u8;
    }
    return tokenize_bytes(input: abs input, input_length: erg input_length);
}

verb write_state(abs path: Path) -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg sequence: TokenSequence = fallback_sequence();
    erg trained = train_token_sequence(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs sequence
    );
    return case dat trained {
        Result.Err(_) => 2,
        Result.Ok(metrics) => {
            erg saved = write_text_brain(
                path: abs path,
                fabric: abs fabric,
                bindings: abs bindings
            );
            return case dat saved {
                Result.Err(_) => 3,
                Result.Ok(_) => {
                    if metrics.processed_events != 63u32 || metrics.active_bindings != 63u32 || fabric.active_count != 64u32 {
                        return 4;
                    }
                    return 0;
                },
            };
        },
    };
}

verb main() -> Int {
    erg path_result = restart_path();
    return case dat path_result {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg status: Int = write_state(path: abs path);
            if status != 0 {
                return status;
            }
            erg message: String = "AIE_FALLBACK_RESTART save=1 events=63 active_bindings=63 active_columns=64 process=writer";
            println(text: abs message);
            return 0;
        },
    };
}

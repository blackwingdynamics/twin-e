"""Legacy P3.2 smoke demonstration kept outside the production entry point."""
import ie;

import std::io;

open ie;

open io;

verb demo_line(erg text: String) -> Int {
    println(text: abs text);
    return 0;
}

verb demo_firing(ins fabric: CorticalFabric[64]) -> Bool {
    fabric.columns[0u32].threshold = 1u8;
    fabric.columns[0u32].coincidence_low = 1u64;
    fabric.columns[0u32].payload = 41u8;
    fabric.columns[0u32].axons[0u32] = 2u32;
    fabric.columns[0u32].inhibitory_link = 1u32;
    fabric.columns[2u32].threshold = 1u8;
    fabric.columns[2u32].coincidence_low = 1u64;
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg source_idx: u32 = 0u32;
    erg step: ImpulseStepResult = step_wavefront(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
    erg fired: Bool = step.valid_source && step.source_fired && step.payload == 41u8 && step.destination_0 == 2u32;
    erg inhibited: Bool = (fabric.columns[1u32].flags & FLAG_INHIBITED) != 0u8;
    if !fired || !inhibited {
        erg failure_message: String = "IE_DEMO FAILURE firing_or_inhibition";
        demo_line(text: erg failure_message);
        return false;
    }
    erg firing_message: String = "IE_DEMO firing payload=41 destination=2 inhibition=1";
    demo_line(text: erg firing_message);
    return true;
}

verb demo_linked_result(ins fabric: CorticalFabric[64], erg index: u32) -> Option[u32] {
    erg result: Option[u32] = Option[u32].None;
    if fabric.columns[0u32].axons[1u32] == index {
        erg linking_message: String = "IE_DEMO neurogenesis linked=1";
        demo_line(text: erg linking_message);
        result = Option[u32].Some(index);
    } else {
        erg failure_message: String = "IE_DEMO FAILURE axon_link";
        demo_line(text: erg failure_message);
    }
    return result;
}

verb demo_neurogenesis(ins fabric: CorticalFabric[64]) -> Option[u32] {
    erg novel: Wavefront = Wavefront {mask_low: 8u64, mask_high: 16u64, energy: 1u8};
    erg source_idx: u32 = 0u32;
    erg created: Option[u32] = neurogenesis(
        fabric: ins fabric,
        wave: abs novel,
        source_idx: erg source_idx
    );
    return case dat created {
        Option.Some(index) => demo_linked_result(fabric: ins fabric, index: erg index),
        Option.None => Option[u32].None,
    };
}

verb demo_decay(ins fabric: CorticalFabric[64], erg created_idx: u32) -> Bool {
    fabric.columns[created_idx].idle_ticks = 239u8;
    fabric.columns[created_idx].myelination = 0u8;
    engine_clock_step(fabric: ins fabric);
    if fabric.columns[created_idx].flags != 0u8 || fabric.active_count != 3u32 {
        erg failure_message: String = "IE_DEMO FAILURE decay_reclaim";
        demo_line(text: erg failure_message);
        return false;
    }
    erg decay_message: String = "IE_DEMO decay reclaimed=1";
    demo_line(text: erg decay_message);
    erg success_message: String = "IE_DEMO complete";
    demo_line(text: erg success_message);
    return true;
}

verb demo_decay_status(ins fabric: CorticalFabric[64], erg index: u32) -> Int {
    erg decay_ok: Bool = demo_decay(fabric: ins fabric, created_idx: erg index);
    return case decay_ok {
        true => 0,
        _ => 3,
    };
}

verb demo_after_firing(ins fabric: CorticalFabric[64]) -> Int {
    erg created: Option[u32] = demo_neurogenesis(fabric: ins fabric);
    return case dat created {
        Option.Some(index) => demo_decay_status(fabric: ins fabric, index: erg index),
        Option.None => 2,
    };
}

verb main() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    return case demo_firing(fabric: ins fabric) {
        true => demo_after_firing(fabric: ins fabric),
        _ => 1,
    };
}

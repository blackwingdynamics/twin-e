"""Load the Phase 5 restart fixture from a fresh process state."""
import aie;

import config;

import encoding;

import std::io;

import std::path;

verb append_restart_prefix(ins raw: Buffer) {
    erg bytes: Array[u8,11] = Array[u8, 11]();
    bytes[0u32] = 47u8;
    bytes[1u32] = 116u8;
    bytes[2u32] = 109u8;
    bytes[3u32] = 112u8;
    bytes[4u32] = 47u8;
    bytes[5u32] = 116u8;
    bytes[6u32] = 119u8;
    bytes[7u32] = 105u8;
    bytes[8u32] = 110u8;
    bytes[9u32] = 45u8;
    bytes[10u32] = 101u8;
    for erg index: u32 in 0u32 .. 11u32 {
        append(raw, bytes[index]);
    }
}

verb append_restart_suffix(ins raw: Buffer) {
    erg bytes: Array[u8,18] = Array[u8, 18]();
    bytes[0u32] = 45u8;
    bytes[1u32] = 112u8;
    bytes[2u32] = 53u8;
    bytes[3u32] = 45u8;
    bytes[4u32] = 114u8;
    bytes[5u32] = 101u8;
    bytes[6u32] = 115u8;
    bytes[7u32] = 116u8;
    bytes[8u32] = 97u8;
    bytes[9u32] = 114u8;
    bytes[10u32] = 116u8;
    bytes[11u32] = 46u8;
    bytes[12u32] = 98u8;
    bytes[13u32] = 114u8;
    bytes[14u32] = 97u8;
    bytes[15u32] = 105u8;
    bytes[16u32] = 110u8;
    bytes[17u32] = 0u8;
    for erg index: u32 in 0u32 .. 18u32 {
        append(raw, bytes[index]);
    }
}

verb restart_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_restart_prefix(raw: ins raw);
    append_restart_suffix(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb read_fixture(abs path: Path) -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg loaded = read_text_brain(
        fabric: ins fabric,
        bindings: ins bindings,
        path: abs path
    );
    return case dat loaded {
        Result.Err(_) => 2,
        Result.Ok(_) => {
            if fabric.active_count != 1u32 || fabric.columns[0u32].payload != 88u8 || fabric.columns[0u32].myelination != 12u8 || bindings[0u32].token_id != 12345u32 || bindings[0u32].context_key != 72623859790382856u64 || bindings[0u32].binding_flags != BINDING_ACTIVE_FLAG {
                return 3;
            }
            return 0;
        },
    };
}

verb main() -> Int {
    erg result = restart_path();
    return case dat result {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg status: Int = read_fixture(path: abs path);
            if status != 0 {
                return status;
            }
            erg message: String = "AIE_P5_RESTART reload=1 recalled=1 process=reader";
            println(text: abs message);
            return 0;
        },
    };
}

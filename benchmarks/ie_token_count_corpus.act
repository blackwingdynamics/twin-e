"""Measure bounded BPE token-count reduction on a larger repeated text."""
import tokenizer;

import std::io;

meta limitless("verb")
verb main() -> Int {
    erg rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    rules[0u32] = BpeMergeRule {left_id: 72u32, right_id: 101u32, merged_id: 1000u32, rank: 0u32};
    rules[1u32] = BpeMergeRule {left_id: 108u32, right_id: 108u32, merged_id: 1001u32, rank: 1u32};
    rules[2u32] = BpeMergeRule {left_id: 1000u32, right_id: 108u32, merged_id: 1002u32, rank: 2u32};
    rules[3u32] = BpeMergeRule {left_id: 1002u32, right_id: 111u32, merged_id: 1003u32, rank: 3u32};
    rules[4u32] = BpeMergeRule {left_id: 71u32, right_id: 105u32, merged_id: 1004u32, rank: 4u32};
    rules[5u32] = BpeMergeRule {left_id: 1004u32, right_id: 111u32, merged_id: 1005u32, rank: 5u32};
    rules[6u32] = BpeMergeRule {left_id: 1005u32, right_id: 114u32, merged_id: 1006u32, rank: 6u32};
    rules[7u32] = BpeMergeRule {left_id: 1006u32, right_id: 103u32, merged_id: 1007u32, rank: 7u32};
    rules[8u32] = BpeMergeRule {left_id: 1007u32, right_id: 105u32, merged_id: 1008u32, rank: 8u32};
    erg rule_count: u32 = 9u32;
    erg text: String = "Hello Giorgi. Hello Giorgi. Hello Giorgi. Hello Giorgi.";
    erg byte_sequence: TokenSequence = tokenize_string(text: abs text);
    erg bpe_sequence: TokenSequence = bpe_tokenize_string(
        text: abs text,
        rules: abs rules,
        rule_count: erg rule_count
    );
    if !byte_sequence.valid || !bpe_sequence.valid || bpe_sequence.length >= byte_sequence.length {
        return 1;
    }
    erg byte_count: Int = byte_sequence.length as Int;
    erg bpe_count: Int = bpe_sequence.length as Int;
    erg reduction: Int = byte_count - bpe_count;
    erg prefix: String = "IE_TOKEN_CORPUS byte_tokens=";
    erg bpe_label: String = " bpe_tokens=";
    erg reduction_label: String = " reduction=";
    erg newline: String = "";
    print(text: abs prefix);
    print_int(value: erg byte_count);
    print(text: abs bpe_label);
    print_int(value: erg bpe_count);
    print(text: abs reduction_label);
    print_int(value: erg reduction);
    println(text: abs newline);
    return 0;
}

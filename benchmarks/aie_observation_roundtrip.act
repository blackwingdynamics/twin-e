"""Measure deterministic observation serialization and sparse-code recall."""
import aie;

import config;

import std::io;

meta limitless("verb")
verb main() -> Int {
    erg original: ObservationEvent = ObservationEvent {kind: ObservationKind.Obstacle, primary_value: 12u16, secondary_value: 4u16, sequence: 128u32, version: OBSERVATION_VERSION, valid: true};
    erg encoded = serialize_observation(event: abs original);
    erg snapshot: ObservationSnapshot = ObservationSnapshot {bytes: Array[u8, 20]()};
    case dat encoded {
        Result.Err(_) => {
            erg failure: String = "AIE_OBSERVATION_ROUNDTRIP serialize_failed";
            println(text: abs failure);
            return 1;
        },
        Result.Ok(value) => {
            snapshot = value;
        },
    };
    erg restored = deserialize_observation(snapshot: abs snapshot);
    erg restored_event: ObservationEvent = ObservationEvent {kind: ObservationKind.Obstacle, primary_value: 0u16, secondary_value: 0u16, sequence: 0u32, version: 0u16, valid: false};
    case dat restored {
        Result.Err(_) => {
            erg failure: String = "AIE_OBSERVATION_ROUNDTRIP deserialize_failed";
            println(text: abs failure);
            return 2;
        },
        Result.Ok(event) => {
            restored_event = event;
        },
    };
    erg first = encode_observation(event: abs original);
    erg second = encode_observation(event: abs restored_event);
    erg first_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg second_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    case dat first {
        Result.Err(_) => {
            return 3;
        },
        Result.Ok(code) => {
            first_code = code;
        },
    };
    case dat second {
        Result.Err(_) => {
            return 4;
        },
        Result.Ok(code) => {
            second_code = code;
        },
    };
    if first_code.mask_low != second_code.mask_low || first_code.mask_high != second_code.mask_high || first_code.active_bits != second_code.active_bits {
        return 5;
    }
    erg heading: String = "AIE_OBSERVATION_ROUNDTRIP bytes=20 code_roundtrip=1 active_bits=12";
    println(text: abs heading);
    return 0;
}

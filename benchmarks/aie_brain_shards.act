"""Prove that two bounded shard files preserve columns and cross-shard links."""
import aie;
import std::io;
import std::path;

verb append_shard_path_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 115u8);
    append(raw, 104u8);
    append(raw, 97u8);
    append(raw, 114u8);
    append(raw, 100u8);
    append(raw, 45u8);
}

verb make_shard_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_shard_path_prefix(raw: ins raw);
    append(raw, suffix);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb make_fabric() -> CorticalFabric[64] {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    fabric.columns[0u32].payload = 11u8;
    fabric.columns[0u32].axon_0 = 32u32;
    fabric.columns[32u32].payload = 22u8;
    return fabric;
}

verb clear_fabric(ins fabric: CorticalFabric[64]) {
    fabric.columns[0u32].payload = 0u8;
    fabric.columns[0u32].axon_0 = NULL_INDEX;
    fabric.columns[32u32].payload = 0u8;
}

verb write_both(abs path_zero: Path, abs path_one: Path, abs fabric: CorticalFabric[64]) -> Bool {
    erg shard_zero: u32 = 0u32;
    erg shard_one: u32 = 1u32;
    erg zero = write_shard(path: abs path_zero, fabric: abs fabric, shard_id: erg shard_zero);
    return case dat zero {
        Result.Err(_) => false,
        Result.Ok(_) => {
            erg one = write_shard(path: abs path_one, fabric: abs fabric, shard_id: erg shard_one);
            return case dat one {
                Result.Err(_) => false,
                Result.Ok(_) => true,
            };
        },
    };
}

verb read_both(ins fabric: CorticalFabric[64], abs path_zero: Path, abs path_one: Path) -> Bool {
    erg shard_zero: u32 = 0u32;
    erg shard_one: u32 = 1u32;
    erg zero = read_shard(fabric: ins fabric, path: abs path_zero, shard_id: erg shard_zero);
    return case dat zero {
        Result.Err(_) => false,
        Result.Ok(_) => {
            erg one = read_shard(fabric: ins fabric, path: abs path_one, shard_id: erg shard_one);
            return case dat one {
                Result.Err(_) => false,
                Result.Ok(_) => true,
            };
        },
    };
}

verb corrupted_shard_rejected(ins fabric: CorticalFabric[64], abs path: Path) -> Bool {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => false,
        Result.Ok(bytes) => {
            bytes[53u32] = 12u8;
            erg shard_zero: u32 = 0u32;
            erg result = read_shard_bytes(fabric: ins fabric, bytes: dat bytes, shard_id: erg shard_zero);
            erg status: Int = case dat result {
                Result.Err(_) => 1,
                Result.Ok(_) => 0,
            };
            return status == 1 && fabric.columns[0u32].payload == 11u8;
        },
    };
}

verb run_paths(abs path_zero: Path, abs path_one: Path) -> Int {
    erg fabric: CorticalFabric[64] = make_fabric();
    erg written: Bool = write_both(path_zero: abs path_zero, path_one: abs path_one, fabric: abs fabric);
    if !written {
        return 3;
    }
    clear_fabric(fabric: ins fabric);
    erg loaded: Bool = read_both(fabric: ins fabric, path_zero: abs path_zero, path_one: abs path_one);
    if !loaded || fabric.columns[0u32].payload != 11u8 || fabric.columns[0u32].axon_0 != 32u32 || fabric.columns[32u32].payload != 22u8 {
        return 4;
    }
    erg corruption_rejected: Bool = corrupted_shard_rejected(fabric: ins fabric, path: abs path_zero);
    if !corruption_rejected {
        return 5;
    }
    erg message: String = "AIE_BRAIN_SHARDS roundtrip=1 shard0=1 shard1=1 cross_shard_axon=32 corrupted_rejected=1";
    println(text: abs message);
    return 0;
}

verb run_with_first(abs path_zero: Path) -> Int {
    erg suffix_one: u8 = 49u8;
    erg path_one_result = make_shard_path(suffix: erg suffix_one);
    return case dat path_one_result {
        Result.Err(_) => 2,
        Result.Ok(path_one) => run_paths(path_zero: abs path_zero, path_one: abs path_one),
    };
}

verb main() -> Int {
    erg suffix_zero: u8 = 48u8;
    erg path_zero_result = make_shard_path(suffix: erg suffix_zero);
    return case dat path_zero_result {
        Result.Err(_) => 1,
        Result.Ok(path_zero) => run_with_first(path_zero: abs path_zero),
    };
}

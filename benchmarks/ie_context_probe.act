"""Probe deterministic bounded context identities for token transitions."""
import config;

import encoding;

import std::io;

verb same_code(abs left: TokenCode, abs right: TokenCode) -> Bool {
    return left.mask_low == right.mask_low && left.mask_high == right.mask_high && left.version == right.version;
}

verb main() -> Int {
    erg first_previous: u32 = 65u32;
    erg first_token: u32 = 66u32;
    erg different_previous: u32 = 67u32;
    erg first_context: u64 = context_key(previous_token_id: erg first_previous, token_id: erg first_token);
    erg repeated_previous: u32 = 65u32;
    erg repeated_token: u32 = 66u32;
    erg repeated_context: u64 = context_key(previous_token_id: erg repeated_previous, token_id: erg repeated_token);
    erg different_context: u64 = context_key(previous_token_id: erg different_previous, token_id: erg first_token);
    if first_context != repeated_context || first_context == different_context {
        return 1;
    }
    erg first_code: TokenCode = encode_context_key(context_key: erg first_context);
    erg different_code: TokenCode = encode_context_key(context_key: erg different_context);
    if same_code(left: abs first_code, right: abs different_code) {
        return 1;
    }
    erg heading: String = "IE_CONTEXT window=2 deterministic=1 distinct=1";
    println(text: abs heading);
    return 0;
}

"""Pairwise collision benchmark for the initial 128-bit token codebook."""
import config;

import encoding;

import std::io;

import std::time;

const CODEBOOK_SIZE: u32 = 5000u32;


const HISTOGRAM_SIZE: u32 = 9u32;


meta limitless("verb")
verb popcount_u64(erg value: u64) -> u32 {
    erg count: u32 = 0u32;
    loop {
        if value == 0u64 {
            break;
        }
        value &= value - 1u64;
        count += 1u32;
    }
    return count;
}

verb overlap(
    erg left_low: u64,
    erg left_high: u64,
    erg right_low: u64,
    erg right_high: u64
) -> u32 {
    erg low: u64 = left_low & right_low;
    erg high: u64 = left_high & right_high;
    return popcount_u64(value: erg low) + popcount_u64(value: erg high);
}

meta limitless("verb")
verb main() -> Int {
    erg codes: Array[TokenCode,5000] = Array[TokenCode, 5000]();
    erg started: u64 = monotonic_nanos();
    erg invalid_code_count: u32 = 0u32;
    erg index: u32 = 0u32;
    loop {
        if index >= CODEBOOK_SIZE {
            break;
        }
        erg code: TokenCode = encode_token_id(token_id: erg index);
        codes[index] = code;
        erg code_low: u64 = code.mask_low;
        erg code_high: u64 = code.mask_high;
        erg code_bits: u32 = popcount_u64(value: erg code_low) + popcount_u64(value: erg code_high);
        if code_bits != TOKEN_CODE_ACTIVE_BITS as u32 {
            invalid_code_count += 1u32;
        }
        index += 1u32;
    }
    erg maximum_overlap: u32 = 0u32;
    erg duplicate_pairs: u32 = 0u32;
    erg overlap_histogram: Array[u32,9] = Array[u32, 9]();
    erg left_index: u32 = 0u32;
    loop {
        if left_index >= CODEBOOK_SIZE {
            break;
        }
        erg right_index: u32 = left_index + 1u32;
        loop {
            if right_index >= CODEBOOK_SIZE {
                break;
            }
            erg left_low: u64 = codes[left_index].mask_low;
            erg left_high: u64 = codes[left_index].mask_high;
            erg right_low: u64 = codes[right_index].mask_low;
            erg right_high: u64 = codes[right_index].mask_high;
            erg pair_overlap: u32 = overlap(
                left_low: erg left_low,
                left_high: erg left_high,
                right_low: erg right_low,
                right_high: erg right_high
            );
            if pair_overlap > maximum_overlap {
                maximum_overlap = pair_overlap;
            }
            overlap_histogram[pair_overlap as Usize] += 1u32;
            if pair_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
                duplicate_pairs += 1u32;
            }
            right_index += 1u32;
        }
        left_index += 1u32;
    }
    erg heading: String = "IE_CODEBOOK population=token_ids size=5000 codebook_version=1 active_bits=12 seed=11400714819323198485 generation=sequential_u32";
    println(text: abs heading);
    erg overlap_label: String = "IE_CODEBOOK max_different_overlap=";
    print(text: abs overlap_label);
    erg overlap_value: Int = maximum_overlap as Int;
    print_int(value: erg overlap_value);
    erg duplicate_label: String = "IE_CODEBOOK duplicate_pairs=";
    print(text: abs duplicate_label);
    erg duplicate_value: Int = duplicate_pairs as Int;
    print_int(value: erg duplicate_value);
    erg invalid_label: String = "IE_CODEBOOK invalid_code_count=";
    print(text: abs invalid_label);
    erg invalid_value: Int = invalid_code_count as Int;
    print_int(value: erg invalid_value);
    erg histogram_index: u32 = 0u32;
    loop {
        if histogram_index >= HISTOGRAM_SIZE {
            break;
        }
        erg histogram_label: String = "IE_CODEBOOK overlap_bucket=";
        print(text: abs histogram_label);
        erg histogram_key: Int = histogram_index as Int;
        print_int(value: erg histogram_key);
        erg histogram_separator: String = " count=";
        print(text: abs histogram_separator);
        erg histogram_value: Int = overlap_histogram[histogram_index as Usize] as Int;
        print_int(value: erg histogram_value);
        histogram_index += 1u32;
    }
    erg total_exact_candidates: u64 = 0u64;
    erg max_exact_candidates: u32 = 0u32;
    erg ambiguous_exact_queries: u32 = 0u32;
    erg total_relaxed_candidates: u64 = 0u64;
    erg max_relaxed_candidates: u32 = 0u32;
    erg ambiguous_relaxed_queries: u32 = 0u32;
    erg missing_exact_missed_queries: u32 = 0u32;
    erg missing_exact_false_queries: u32 = 0u32;
    erg missing_exact_false_candidates: u64 = 0u64;
    erg missing_relaxed_missed_queries: u32 = 0u32;
    erg missing_relaxed_false_queries: u32 = 0u32;
    erg missing_relaxed_false_candidates: u64 = 0u64;
    erg candidate_target_index: u32 = 0u32;
    loop {
        if candidate_target_index >= CODEBOOK_SIZE {
            break;
        }
        erg candidate_target_low: u64 = codes[candidate_target_index].mask_low;
        erg candidate_target_high: u64 = codes[candidate_target_index].mask_high;
        erg exact_candidates_for_query: u32 = 0u32;
        erg relaxed_candidates_for_query: u32 = 0u32;
        erg candidate_query_index: u32 = 0u32;
        loop {
            if candidate_query_index >= CODEBOOK_SIZE {
                break;
            }
            erg candidate_query_low: u64 = codes[candidate_query_index].mask_low;
            erg candidate_query_high: u64 = codes[candidate_query_index].mask_high;
            erg candidate_overlap: u32 = overlap(
                left_low: erg candidate_target_low,
                left_high: erg candidate_target_high,
                right_low: erg candidate_query_low,
                right_high: erg candidate_query_high
            );
            if candidate_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
                exact_candidates_for_query += 1u32;
            }
            if candidate_overlap >= (TOKEN_CODE_ACTIVE_BITS as u32 - 1u32) {
                relaxed_candidates_for_query += 1u32;
            }
            candidate_query_index += 1u32;
        }
        total_exact_candidates += exact_candidates_for_query as u64;
        if exact_candidates_for_query > max_exact_candidates {
            max_exact_candidates = exact_candidates_for_query;
        }
        if exact_candidates_for_query > 1u32 {
            ambiguous_exact_queries += 1u32;
        }
        total_relaxed_candidates += relaxed_candidates_for_query as u64;
        if relaxed_candidates_for_query > max_relaxed_candidates {
            max_relaxed_candidates = relaxed_candidates_for_query;
        }
        if relaxed_candidates_for_query > 1u32 {
            ambiguous_relaxed_queries += 1u32;
        }
        erg missing_low: u64 = candidate_target_low;
        erg missing_high: u64 = candidate_target_high;
        if missing_low != 0u64 {
            missing_low &= missing_low - 1u64;
        } else {
            missing_high &= missing_high - 1u64;
        }
        erg missing_exact_count: u32 = 0u32;
        erg missing_relaxed_count: u32 = 0u32;
        erg missing_exact_target_found: Bool = false;
        erg missing_relaxed_target_found: Bool = false;
        erg missing_query_index: u32 = 0u32;
        loop {
            if missing_query_index >= CODEBOOK_SIZE {
                break;
            }
            erg missing_query_low: u64 = codes[missing_query_index].mask_low;
            erg missing_query_high: u64 = codes[missing_query_index].mask_high;
            erg missing_overlap: u32 = overlap(
                left_low: erg missing_low,
                left_high: erg missing_high,
                right_low: erg missing_query_low,
                right_high: erg missing_query_high
            );
            if missing_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
                missing_exact_count += 1u32;
                if missing_query_index == candidate_target_index {
                    missing_exact_target_found = true;
                }
            }
            if missing_overlap >= (TOKEN_CODE_ACTIVE_BITS as u32 - 1u32) {
                missing_relaxed_count += 1u32;
                if missing_query_index == candidate_target_index {
                    missing_relaxed_target_found = true;
                }
            }
            missing_query_index += 1u32;
        }
        if !missing_exact_target_found {
            missing_exact_missed_queries += 1u32;
        }
        if missing_exact_count > 0u32 {
            missing_exact_false_queries += 1u32;
            missing_exact_false_candidates += missing_exact_count as u64;
        }
        if !missing_relaxed_target_found {
            missing_relaxed_missed_queries += 1u32;
        }
        if missing_relaxed_count > 1u32 {
            missing_relaxed_false_queries += 1u32;
            missing_relaxed_false_candidates += (missing_relaxed_count - 1u32) as u64;
        }
        candidate_target_index += 1u32;
    }
    erg candidate_heading: String = "IE_CODEBOOK candidate_retrieval_queries=5000";
    println(text: abs candidate_heading);
    erg exact_total_label: String = "IE_CODEBOOK candidate_exact_theta=12 total=";
    print(text: abs exact_total_label);
    erg exact_total_value: Int = total_exact_candidates as Int;
    print_int(value: erg exact_total_value);
    erg exact_max_label: String = "IE_CODEBOOK candidate_exact_theta=12 max_per_query=";
    print(text: abs exact_max_label);
    erg exact_max_value: Int = max_exact_candidates as Int;
    print_int(value: erg exact_max_value);
    erg exact_ambiguous_label: String = "IE_CODEBOOK candidate_exact_theta=12 ambiguous_queries=";
    print(text: abs exact_ambiguous_label);
    erg exact_ambiguous_value: Int = ambiguous_exact_queries as Int;
    print_int(value: erg exact_ambiguous_value);
    erg relaxed_total_label: String = "IE_CODEBOOK candidate_relaxed_theta=11 total=";
    print(text: abs relaxed_total_label);
    erg relaxed_total_value: Int = total_relaxed_candidates as Int;
    print_int(value: erg relaxed_total_value);
    erg relaxed_max_label: String = "IE_CODEBOOK candidate_relaxed_theta=11 max_per_query=";
    print(text: abs relaxed_max_label);
    erg relaxed_max_value: Int = max_relaxed_candidates as Int;
    print_int(value: erg relaxed_max_value);
    erg relaxed_ambiguous_label: String = "IE_CODEBOOK candidate_relaxed_theta=11 ambiguous_queries=";
    print(text: abs relaxed_ambiguous_label);
    erg relaxed_ambiguous_value: Int = ambiguous_relaxed_queries as Int;
    print_int(value: erg relaxed_ambiguous_value);
    erg noise_heading: String = "IE_CODEBOOK missing_bit_queries=5000";
    println(text: abs noise_heading);
    erg missing_exact_missed_label: String = "IE_CODEBOOK missing_exact_theta=12 missed_queries=";
    print(text: abs missing_exact_missed_label);
    erg missing_exact_missed_value: Int = missing_exact_missed_queries as Int;
    print_int(value: erg missing_exact_missed_value);
    erg missing_exact_false_label: String = "IE_CODEBOOK missing_exact_theta=12 false_queries=";
    print(text: abs missing_exact_false_label);
    erg missing_exact_false_value: Int = missing_exact_false_queries as Int;
    print_int(value: erg missing_exact_false_value);
    erg missing_exact_false_candidates_label: String = "IE_CODEBOOK missing_exact_theta=12 false_candidates=";
    print(text: abs missing_exact_false_candidates_label);
    erg missing_exact_false_candidates_value: Int = missing_exact_false_candidates as Int;
    print_int(value: erg missing_exact_false_candidates_value);
    erg missing_relaxed_missed_label: String = "IE_CODEBOOK missing_relaxed_theta=11 missed_queries=";
    print(text: abs missing_relaxed_missed_label);
    erg missing_relaxed_missed_value: Int = missing_relaxed_missed_queries as Int;
    print_int(value: erg missing_relaxed_missed_value);
    erg missing_relaxed_false_label: String = "IE_CODEBOOK missing_relaxed_theta=11 false_queries=";
    print(text: abs missing_relaxed_false_label);
    erg missing_relaxed_false_value: Int = missing_relaxed_false_queries as Int;
    print_int(value: erg missing_relaxed_false_value);
    erg missing_relaxed_false_candidates_label: String = "IE_CODEBOOK missing_relaxed_theta=11 false_candidates=";
    print(text: abs missing_relaxed_false_candidates_label);
    erg missing_relaxed_false_candidates_value: Int = missing_relaxed_false_candidates as Int;
    print_int(value: erg missing_relaxed_false_candidates_value);
    erg finished: u64 = monotonic_nanos();
    erg elapsed_label: String = "IE_CODEBOOK elapsed_ns=";
    print(text: abs elapsed_label);
    erg elapsed_value: Int = (finished - started) as Int;
    print_int(value: erg elapsed_value);
    if maximum_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 || duplicate_pairs != 0u32 || invalid_code_count != 0u32 {
        return 1;
    }
    return 0;
}

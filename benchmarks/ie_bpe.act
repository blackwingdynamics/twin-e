"""Verify deterministic bounded BPE encoding over the existing byte tokenizer."""
import tokenizer;

import std::io;

meta limitless("verb")
verb main() -> Int {
    erg rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    rules[0u32] = BpeMergeRule {left_id: 65u32, right_id: 66u32, merged_id: 1000u32, rank: 0u32};
    erg merged_bytes: Array[u8,8] = Array[u8, 8]();
    merged_bytes[0u32] = 65u8;
    merged_bytes[1u32] = 66u8;
    erg merged_record: BpeTokenRecord = BpeTokenRecord {token_id: 1000u32, byte_length: 2u8, bytes: merged_bytes};
    erg records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    records[0u32] = merged_record;
    erg vocabulary: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 1u32, rules: rules, token_count: 1u32, tokens: records};
    erg text: String = "AB";
    erg sequence: TokenSequence = bpe_tokenize_with_special_tokens(text: abs text, vocabulary: abs vocabulary);
    erg first: Token = sequence.tokens[0u32];
    if !sequence.valid {
        erg invalid_message: String = "IE_BPE_ERROR invalid_vocabulary";
        println(text: abs invalid_message);
        return 1;
    }
    if sequence.length != 3u32 {
        erg count_message: String = "IE_BPE_ERROR unexpected_token_count";
        println(text: abs count_message);
        return 1;
    }
    if first.id != BPE_BOS_TOKEN_ID {
        erg id_message: String = "IE_BPE_ERROR unexpected_merged_id";
        println(text: abs id_message);
        return 1;
    }
    erg incompatible_rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    erg incompatible_records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    erg incompatible: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 0u32, rules: incompatible_rules, token_count: 0u32, tokens: incompatible_records};
    incompatible.version = 2u16;
    erg rejected: TokenSequence = bpe_tokenize_vocabulary(text: abs text, vocabulary: abs incompatible);
    if rejected.valid {
        erg rejection_message: String = "IE_BPE_ERROR incompatible_accepted";
        println(text: abs rejection_message);
        return 1;
    }
    erg invalid_rank_rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    invalid_rank_rules[0u32] = BpeMergeRule {left_id: 65u32, right_id: 66u32, merged_id: 1000u32, rank: 1u32};
    erg invalid_rank_records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    erg invalid_rank_vocabulary: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 1u32, rules: invalid_rank_rules, token_count: 0u32, tokens: invalid_rank_records};
    if bpe_vocabulary_is_valid(vocabulary: abs invalid_rank_vocabulary) {
        erg rank_message: String = "IE_BPE_ERROR invalid_rank_accepted";
        println(text: abs rank_message);
        return 1;
    }
    erg oversized_records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    erg oversized_rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    oversized_records[0u32].token_id = 1000u32;
    oversized_records[0u32].byte_length = 9u8;
    erg oversized_vocabulary: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 0u32, rules: oversized_rules, token_count: 1u32, tokens: oversized_records};
    if bpe_vocabulary_is_valid(vocabulary: abs oversized_vocabulary) {
        erg span_message: String = "IE_BPE_ERROR oversized_span_accepted";
        println(text: abs span_message);
        return 1;
    }
    erg byte_rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    erg byte_records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    erg byte_vocabulary: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 0u32, rules: byte_rules, token_count: 0u32, tokens: byte_records};
    erg byte_sequence: TokenSequence = bpe_tokenize_with_special_tokens(text: abs text, vocabulary: abs byte_vocabulary);
    if !bpe_vocabulary_is_valid(vocabulary: abs byte_vocabulary) {
        erg byte_vocab_message: String = "IE_BPE_ERROR byte_vocabulary_invalid";
        println(text: abs byte_vocab_message);
        return 1;
    }
    if !byte_sequence.valid {
        erg byte_sequence_message: String = "IE_BPE_ERROR byte_sequence_invalid";
        println(text: abs byte_sequence_message);
        return 1;
    }
    erg storage: Buffer = Buffer[0];
    erg decoded = bpe_decode_bytes(
        sequence: abs byte_sequence,
        vocabulary: abs byte_vocabulary,
        storage: ins storage
    );
    erg decoded_length: Int = case dat decoded {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if decoded_length != 2 {
        erg byte_decode_message: String = "IE_BPE_ERROR byte_decode_length";
        println(text: abs byte_decode_message);
        return 1;
    }
    erg merged_storage: Buffer = Buffer[0];
    erg merged_decoded = bpe_decode_bytes(
        sequence: abs sequence,
        vocabulary: abs vocabulary,
        storage: ins merged_storage
    );
    erg merged_length: Int = case dat merged_decoded {
        Result.Ok(value) => value,
        Result.Err(_) => -1,
    };
    if merged_length != 2 {
        erg merged_decode_message: String = "IE_BPE_ERROR merged_decode_length";
        println(text: abs merged_decode_message);
        return 1;
    }
    erg unknown_sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 1u32, valid: true};
    unknown_sequence.tokens[0u32].id = BPE_UNKNOWN_TOKEN_ID;
    erg unknown_storage: Buffer = Buffer[0];
    erg unknown_decoded = bpe_decode_bytes(
        sequence: abs unknown_sequence,
        vocabulary: abs vocabulary,
        storage: ins unknown_storage
    );
    erg unknown_rejected: Bool = case dat unknown_decoded {
        Result.Ok(_) => false,
        Result.Err(_) => true,
    };
    if !unknown_rejected {
        erg unknown_message: String = "IE_BPE_ERROR unknown_token_accepted";
        println(text: abs unknown_message);
        return 1;
    }
    erg heading: String = "IE_BPE input_bytes=2 output_tokens=3 special_tokens=2 decoded_bytes=2 merged_decode=2 artifact=valid rejected=1 invalid_rank_rejected=1 oversized_span_rejected=1 unknown_rejected=1";
    println(text: abs heading);
    return 0;
}

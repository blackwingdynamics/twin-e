"""Verify vocabulary-aware `.brain` persistence and decode identity."""
import aie;

import config;

import encoding;

import tokenizer;

import std::fs;

import std::io;

import std::path;

verb append_path_prefix(ins raw: Buffer) {
    erg bytes: Array[u8,11] = Array[u8, 11]();
    bytes[0u32] = 47u8;
    bytes[1u32] = 116u8;
    bytes[2u32] = 109u8;
    bytes[3u32] = 112u8;
    bytes[4u32] = 47u8;
    bytes[5u32] = 116u8;
    bytes[6u32] = 119u8;
    bytes[7u32] = 105u8;
    bytes[8u32] = 110u8;
    bytes[9u32] = 45u8;
    bytes[10u32] = 101u8;
    for erg index: u32 in 0u32 .. 11u32 {
        append(raw, bytes[index]);
    }
}

verb append_path_suffix(ins raw: Buffer) {
    erg bytes: Array[u8,8] = Array[u8, 8]();
    bytes[0u32] = 45u8;
    bytes[1u32] = 118u8;
    bytes[2u32] = 46u8;
    bytes[3u32] = 98u8;
    bytes[4u32] = 114u8;
    bytes[5u32] = 97u8;
    bytes[6u32] = 105u8;
    bytes[7u32] = 110u8;
    for erg index: u32 in 0u32 .. 8u32 {
        append(raw, bytes[index]);
    }
    append(raw, 0u8);
}

verb benchmark_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_path_prefix(raw: ins raw);
    append_path_suffix(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb make_vocabulary() -> BpeVocabulary {
    erg vocabulary: BpeVocabulary = BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 3u32, rules: Array[BpeMergeRule, 128](
    ), token_count: 3u32, tokens: Array[BpeTokenRecord, 256]()};
    vocabulary.rules[0u32] = BpeMergeRule {left_id: 65u32, right_id: 66u32, merged_id: 256u32, rank: 0u32};
    vocabulary.rules[1u32] = BpeMergeRule {left_id: 67u32, right_id: 68u32, merged_id: 257u32, rank: 1u32};
    vocabulary.rules[2u32] = BpeMergeRule {left_id: 256u32, right_id: 257u32, merged_id: 258u32, rank: 2u32};
    vocabulary.tokens[0u32].token_id = 256u32;
    vocabulary.tokens[0u32].byte_length = 2u8;
    vocabulary.tokens[0u32].bytes[0u32] = 65u8;
    vocabulary.tokens[0u32].bytes[1u32] = 66u8;
    vocabulary.tokens[1u32].token_id = 257u32;
    vocabulary.tokens[1u32].byte_length = 2u8;
    vocabulary.tokens[1u32].bytes[0u32] = 67u8;
    vocabulary.tokens[1u32].bytes[1u32] = 68u8;
    vocabulary.tokens[2u32].token_id = 258u32;
    vocabulary.tokens[2u32].byte_length = 4u8;
    vocabulary.tokens[2u32].bytes[0u32] = 65u8;
    vocabulary.tokens[2u32].bytes[1u32] = 66u8;
    vocabulary.tokens[2u32].bytes[2u32] = 67u8;
    vocabulary.tokens[2u32].bytes[3u32] = 68u8;
    return vocabulary;
}

verb save_vocabulary_fixture(
    abs path: Path,
    abs fabric: CorticalFabric[64],
    abs bindings: Array[TokenBinding, 64],
    abs vocabulary: BpeVocabulary
) -> Bool {
    erg saved = write_text_brain_with_vocabulary(
        path: abs path,
        fabric: abs fabric,
        bindings: abs bindings,
        vocabulary: abs vocabulary
    );
    return case dat saved {
        Result.Ok(_) => true,
        Result.Err(_) => false,
    };
}

verb load_vocabulary_fixture(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    ins vocabulary: BpeVocabulary,
    abs path: Path
) -> Bool {
    erg loaded = read_text_brain_with_vocabulary(
        fabric: ins fabric,
        bindings: ins bindings,
        vocabulary: ins vocabulary,
        path: abs path
    );
    return case dat loaded {
        Result.Ok(value) => value == BRAIN_TEXT_VOCABULARY_TOTAL_BYTES as Int,
        Result.Err(_) => false,
    };
}

verb verify_decode(abs vocabulary: BpeVocabulary) -> Int {
    erg text: String = "ABCD";
    erg sequence: TokenSequence = bpe_tokenize_with_special_tokens(text: abs text, vocabulary: abs vocabulary);
    if sequence.length != 3u32 || sequence.tokens[1u32].id != 258u32 {
        return 6;
    }
    erg decoded: Buffer = Buffer[0];
    erg decoded_result = bpe_decode_bytes(
        sequence: abs sequence,
        vocabulary: abs vocabulary,
        storage: ins decoded
    );
    return case dat decoded_result {
        Result.Ok(value) => {
            if value == 4 && decoded[0u32] == 65u8 && decoded[1u32] == 66u8 && decoded[2u32] == 67u8 && decoded[3u32] == 68u8 {
                return 0;
            }
            return 4;
        },
        Result.Err(_) => 5,
    };
}

verb save_initial_state(abs path: Path) -> Bool {
    erg vocabulary: BpeVocabulary = make_vocabulary();
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    return save_vocabulary_fixture(
        path: abs path,
        fabric: abs fabric,
        bindings: abs bindings,
        vocabulary: abs vocabulary
    );
}

verb vocabulary_validity_code(abs vocabulary: BpeVocabulary) -> Int {
    if bpe_vocabulary_is_valid(vocabulary: abs vocabulary) {
        return 0;
    }
    if vocabulary.magic != BPE_VOCAB_MAGIC {
        return 10;
    }
    if vocabulary.version != BPE_VOCAB_VERSION {
        return 11;
    }
    if vocabulary.tokenizer_version != TOKENIZER_VERSION {
        return 12;
    }
    if vocabulary.bos_token_id != BPE_BOS_TOKEN_ID {
        return 13;
    }
    if vocabulary.eos_token_id != BPE_EOS_TOKEN_ID {
        return 14;
    }
    if vocabulary.unknown_token_id != BPE_UNKNOWN_TOKEN_ID {
        return 15;
    }
    if vocabulary.rule_count > BPE_MAX_RULES {
        return 16;
    }
    if vocabulary.token_count > BPE_MAX_TOKENS {
        return 17;
    }
    return 18;
}

verb load_and_verify(abs path: Path) -> Int {
    erg vocabulary: BpeVocabulary = make_vocabulary();
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    vocabulary.rule_count = 0u32;
    if !load_vocabulary_fixture(
        fabric: ins fabric,
        bindings: ins bindings,
        vocabulary: ins vocabulary,
        path: abs path
    ) {
        return 1;
    }
    erg vocabulary_code: Int = vocabulary_validity_code(vocabulary: abs vocabulary);
    if vocabulary_code != 0 {
        return vocabulary_code;
    }
    return verify_decode(vocabulary: abs vocabulary);
}

verb verification_message(erg verification: Int) -> String {
    if verification == 1 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=0";
    } else if verification == 2 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 vocabulary=0";
    } else if verification == 6 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 decode_error=1";
    } else if verification == 7 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 decoded_bytes=0";
    } else if verification == 10 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 magic=0";
    } else if verification == 11 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 version=0";
    } else if verification == 12 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 tokenizer=0";
    } else if verification == 13 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 bos=0";
    } else if verification == 14 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 eos=0";
    } else if verification == 15 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 unknown=0";
    } else if verification == 16 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 rules=0";
    } else if verification == 17 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 tokens=0";
    } else if verification == 18 {
        return "AIE_P5_BRAIN_VOCAB save=1 load=1 vocabulary_field=0";
    }
    return "AIE_P5_BRAIN_VOCAB save=1 load=1 decode_failed=1";
}

verb verify_rejected_vocabulary_load(abs path: Path) -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    fabric.columns[0u32].payload = 77u8;
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    bindings[0u32].token_id = 901u32;
    erg vocabulary: BpeVocabulary = make_vocabulary();
    erg rejected = read_text_brain_with_vocabulary(
        fabric: ins fabric,
        bindings: ins bindings,
        vocabulary: ins vocabulary,
        path: abs path
    );
    return case dat rejected {
        Result.Ok(_) => 1,
        Result.Err(_) => if fabric.columns[0u32].payload == 77u8 {
            if bindings[0u32].token_id == 901u32 {
                0;
            } else {
                3;
            };
        } else {
            2;
        },
    };
}

verb reject_corrupted_vocabulary(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 4,
        Result.Ok(bytes) => {
            bytes[BRAIN_TEXT_TOTAL_BYTES] = bytes[BRAIN_TEXT_TOTAL_BYTES] ^ 1u8;
            erg rewritten = write_file(path: abs path, contents: abs bytes);
            drop(bytes);
            return case dat rewritten {
                Result.Err(_) => 5,
                Result.Ok(_) => verify_rejected_vocabulary_load(path: abs path),
            };
        },
    };
}

verb run_fixture(abs path: Path) -> Int {
    if !save_initial_state(path: abs path) {
        erg message: String = "AIE_P5_BRAIN_VOCAB save=0";
        println(text: abs message);
        return 2;
    }
    erg verification: Int = load_and_verify(path: abs path);
    if verification != 0 {
        erg failure_message: String = verification_message(verification: erg verification);
        println(text: abs failure_message);
        return 3;
    }
    erg rejection: Int = reject_corrupted_vocabulary(path: abs path);
    if rejection != 0 {
        return 4;
    }
    erg success_message: String = "AIE_P5_BRAIN_VOCAB bytes=11106 rules=3 tokens=3 repeated_merge=1 reload_decode=1 compatibility=1 corrupted_rejected=1 unchanged=1";
    println(text: abs success_message);
    return 0;
}

verb main() -> Int {
    erg result = benchmark_path();
    return case dat result {
        Result.Err(_) => {
            erg message: String = "AIE_P5_BRAIN_VOCAB path=0";
            println(text: abs message);
            return 1;
        },
        Result.Ok(path) => run_fixture(path: abs path),
    };
}

"""Verify the explicit 24-byte TokenBinding layout contract."""
import encoding;

import std::io;

verb main() -> Int {
    erg binding: TokenBinding = TokenBinding {storage: Array[u8, 24]()};
    binding.token_id = 16909060u32;
    binding.context_key = 72623859790382856u64;
    binding.tokenizer_version = 1u16;
    binding.context_version = 1u16;
    binding.binding_flags = 3u8;
    if token_binding_size_bytes() != 24u32 {
        return 1;
    }
    if binding.storage[0u32] != 4u8 || binding.storage[1u32] != 3u8 || binding.storage[2u32] != 2u8 || binding.storage[3u32] != 1u8 {
        return 1;
    }
    if binding.storage[8u32] != 8u8 || binding.storage[9u32] != 7u8 || binding.storage[10u32] != 6u8 || binding.storage[11u32] != 5u8 || binding.storage[12u32] != 4u8 || binding.storage[13u32] != 3u8 || binding.storage[14u32] != 2u8 || binding.storage[15u32] != 1u8 {
        return 1;
    }
    if binding.storage[20u32] != 3u8 {
        return 1;
    }
    erg heading: String = "AIE_BINDING bytes=24 context_offset=8 verified=1";
    println(text: abs heading);
    return 0;
}

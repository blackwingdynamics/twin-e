meta limitless("file")
"""Prove that runtime shard payloads create, validate, and load three files."""
import aie;
import std::io;
import std::path;

meta limitless("verb")
verb append_shard_path_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 100u8);
    append(raw, 121u8);
    append(raw, 110u8);
    append(raw, 97u8);
    append(raw, 109u8);
    append(raw, 105u8);
    append(raw, 99u8);
    append(raw, 45u8);
    append(raw, 115u8);
    append(raw, 104u8);
    append(raw, 97u8);
    append(raw, 114u8);
    append(raw, 100u8);
    append(raw, 45u8);
}

verb make_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_shard_path_prefix(raw: ins raw);
    append(raw, suffix);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb make_payload(erg marker: u8) -> Buffer {
    erg payload: Buffer = Buffer[0];
    erg capacity: Int = 128;
    erg reserved = reserve(buffer: ins payload, capacity: erg capacity);
    append(payload, marker);
    erg index: u32 = 1u32;
    loop {
        if index >= 128u32 {
            break;
        }
        append(payload, 0u8);
        index += 1u32;
    }
    return payload;
}

verb write_status(abs path: Path, erg shard_id: u32, erg first_column: u32, abs payload: Buffer) -> Int {
    erg column_count: u32 = 2u32;
    erg result = write_dynamic_shard(path: abs path, shard_id: erg shard_id, first_column_index: erg first_column, column_count: erg column_count, payload: abs payload);
    return case dat result {
        Result.Err(_) => 1,
        Result.Ok(_) => 0,
    };
}

verb validate_status(abs path: Path, erg shard_id: u32, erg first_column: u32) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 1,
        Result.Ok(bytes) => {
            erg column_count: u32 = 2u32;
            erg result = validate_dynamic_shard_bytes(bytes: dat bytes, expected_shard_id: erg shard_id, expected_first_column_index: erg first_column, expected_column_count: erg column_count);
            return case dat result {
                Result.Err(_) => 2,
                Result.Ok(_) => 0,
            };
        },
    };
}

verb validate_all(abs path_zero: Path, abs path_one: Path, abs path_two: Path, erg zero_id: u32, erg one_id: u32, erg two_id: u32) -> Int {
    erg first_zero: u32 = 0u32;
    erg first_one: u32 = 2u32;
    erg first_two: u32 = 4u32;
    if validate_status(path: abs path_zero, shard_id: erg zero_id, first_column: erg first_zero) != 0 {
        return 4;
    }
    if validate_status(path: abs path_one, shard_id: erg one_id, first_column: erg first_one) != 0 {
        return 5;
    }
    if validate_status(path: abs path_two, shard_id: erg two_id, first_column: erg first_two) != 0 {
        return 6;
    }
    return 0;
}

verb append_manifest_u32_local(ins output: Buffer, abs value: u32) {
    append(output, (value & 255u32) as u8);
    append(output, ((value / 256u32) & 255u32) as u8);
    append(output, ((value / 65536u32) & 255u32) as u8);
    append(output, ((value / 16777216u32) & 255u32) as u8);
}

verb append_manifest_u64_local(ins output: Buffer, abs value: u64) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    append_manifest_u32_local(output: ins output, value: abs low);
    append_manifest_u32_local(output: ins output, value: abs high);
}

verb append_manifest_descriptor(ins output: Buffer, erg shard_id: u32, erg checksum: u64) {
    erg first_column: u32 = shard_id * 2u32;
    erg column_count: u32 = 2u32;
    erg payload_offset: u32 = 48u32;
    erg payload_bytes: u32 = 128u32;
    erg zero: u32 = 0u32;
    erg state: u32 = 1u32;
    append_manifest_u32_local(output: ins output, value: abs shard_id);
    append_manifest_u32_local(output: ins output, value: abs first_column);
    append_manifest_u32_local(output: ins output, value: abs column_count);
    append_manifest_u32_local(output: ins output, value: abs payload_offset);
    append_manifest_u32_local(output: ins output, value: abs payload_bytes);
    append_manifest_u32_local(output: ins output, value: abs zero);
    append_manifest_u32_local(output: ins output, value: abs zero);
    append_manifest_u64_local(output: ins output, value: abs checksum);
    append_manifest_u32_local(output: ins output, value: abs state);
}

verb build_manifest_descriptors() -> Buffer {
    erg descriptors: Buffer = Buffer[0];
    erg id_zero: u32 = 0u32;
    erg id_one: u32 = 1u32;
    erg id_two: u32 = 2u32;
    erg checksum_zero: u64 = 10u64;
    erg checksum_one: u64 = 20u64;
    erg checksum_two: u64 = 30u64;
    append_manifest_descriptor(output: ins descriptors, shard_id: erg id_zero, checksum: erg checksum_zero);
    append_manifest_descriptor(output: ins descriptors, shard_id: erg id_one, checksum: erg checksum_one);
    append_manifest_descriptor(output: ins descriptors, shard_id: erg id_two, checksum: erg checksum_two);
    return descriptors;
}

verb write_manifest_status(abs path: Path) -> Int {
    erg descriptors: Buffer = build_manifest_descriptors();
    erg generation: u64 = 1u64;
    erg active_count: u32 = 3u32;
    erg total_columns: u32 = 6u32;
    erg shard_count: u32 = 3u32;
    erg result = write_manifest_dynamic(path: abs path, generation: erg generation, active_count: erg active_count, total_column_count: erg total_columns, shard_count: erg shard_count, descriptors: abs descriptors);
    return case dat result {
        Result.Err(_) => 7,
        Result.Ok(_) => 0,
    };
}

verb validate_pair(abs manifest_path: Path, abs shard_path: Path, erg descriptor_index: u32) -> Int {
    erg manifest_result = read_to_bytes(path: abs manifest_path);
    return case dat manifest_result {
        Result.Err(_) => 8,
        Result.Ok(manifest) => {
            erg shard_result = read_to_bytes(path: abs shard_path);
            return case dat shard_result {
                Result.Err(_) => 9,
                Result.Ok(shard) => {
                    erg result = validate_dynamic_manifest_shard(manifest: abs manifest, shard: dat shard, descriptor_index: erg descriptor_index);
                    return case dat result {
                        Result.Err(_) => 1,
                        Result.Ok(_) => 0,
                    };
                },
            };
        },
    };
}

verb load_pair(ins fabric: CorticalFabric[64], abs shard_path: Path, erg shard_id: u32, erg first_column: u32) -> Int {
    erg loaded = read_to_bytes(path: abs shard_path);
    return case dat loaded {
        Result.Err(_) => 1,
        Result.Ok(bytes) => {
            erg column_count: u32 = 2u32;
            erg result = load_dynamic_shard_bytes(fabric: ins fabric, bytes: dat bytes, expected_shard_id: erg shard_id, expected_first_column_index: erg first_column, expected_column_count: erg column_count);
            return case dat result {
                Result.Err(_) => 2,
                Result.Ok(_) => 0,
            };
        },
    };
}

verb verify_dynamic_loader(abs path_zero: Path, abs path_one: Path) -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg zero_id: u32 = 0u32;
    erg zero_first: u32 = 0u32;
    if load_pair(fabric: ins fabric, shard_path: abs path_zero, shard_id: erg zero_id, first_column: erg zero_first) != 0 || fabric.columns[0u32].storage[0u32] != 10u8 {
        return 14;
    }
    if load_pair(fabric: ins fabric, shard_path: abs path_one, shard_id: erg zero_id, first_column: erg zero_first) == 0 || fabric.columns[0u32].storage[0u32] != 10u8 {
        return 15;
    }
    return 0;
}

verb verify_manifest_bindings(abs manifest_path: Path, abs path_zero: Path, abs path_one: Path, abs path_two: Path) -> Int {
    if write_manifest_status(path: abs manifest_path) != 0 {
        return 10;
    }
    erg index_zero: u32 = 0u32;
    erg index_one: u32 = 1u32;
    erg valid_zero: Int = validate_pair(manifest_path: abs manifest_path, shard_path: abs path_zero, descriptor_index: erg index_zero);
    if valid_zero != 0 {
        return 11;
    }
    erg swapped: Int = validate_pair(manifest_path: abs manifest_path, shard_path: abs path_one, descriptor_index: erg index_zero);
    if swapped == 0 {
        return 12;
    }
    erg valid_one: Int = validate_pair(manifest_path: abs manifest_path, shard_path: abs path_one, descriptor_index: erg index_one);
    if valid_one != 0 {
        return 13;
    }
    return 0;
}

verb write_all(abs path_zero: Path, abs path_one: Path, abs path_two: Path) -> Int {
    erg marker_zero: u8 = 10u8;
    erg marker_one: u8 = 20u8;
    erg marker_two: u8 = 30u8;
    erg payload_zero: Buffer = make_payload(marker: erg marker_zero);
    erg payload_one: Buffer = make_payload(marker: erg marker_one);
    erg payload_two: Buffer = make_payload(marker: erg marker_two);
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    erg two_id: u32 = 2u32;
    erg first_zero: u32 = 0u32;
    erg first_one: u32 = 2u32;
    erg first_two: u32 = 4u32;
    erg zero_status: Int = write_status(path: abs path_zero, shard_id: erg zero_id, first_column: erg first_zero, payload: abs payload_zero);
    if zero_status != 0 {
        return 1;
    }
    erg one_status: Int = write_status(path: abs path_one, shard_id: erg one_id, first_column: erg first_one, payload: abs payload_one);
    if one_status != 0 {
        return 2;
    }
    erg two_status: Int = write_status(path: abs path_two, shard_id: erg two_id, first_column: erg first_two, payload: abs payload_two);
    if two_status != 0 {
        return 3;
    }
    return 0;
}

verb run_paths(abs path_zero: Path, abs path_one: Path, abs path_two: Path, abs manifest_path: Path) -> Int {
    erg write_status_all: Int = write_all(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two);
    if write_status_all != 0 {
        return write_status_all;
    }
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    erg two_id: u32 = 2u32;
    erg validation_status: Int = validate_all(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two, zero_id: erg zero_id, one_id: erg one_id, two_id: erg two_id);
    if validation_status != 0 {
        return validation_status;
    }
    erg manifest_status: Int = verify_manifest_bindings(manifest_path: abs manifest_path, path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two);
    if manifest_status != 0 {
        return manifest_status;
    }
    erg loader_status: Int = verify_dynamic_loader(path_zero: abs path_zero, path_one: abs path_one);
    if loader_status != 0 {
        return loader_status;
    }
    erg message: String = "AIE_SHARDS_DYNAMIC files=3 generated=1 validated=3 manifest_bound=2 swapped_rejected=1 dynamic_loaded=1 dynamic_failed_unchanged=1 payload_bytes=128";
    println(text: abs message);
    return 0;
}

verb run_with_zero(abs path_zero: Path) -> Int {
    erg suffix_one: u8 = 49u8;
    erg suffix_two: u8 = 50u8;
    erg path_one_result = make_path(suffix: erg suffix_one);
    return case dat path_one_result {
        Result.Err(_) => 2,
        Result.Ok(path_one) => {
            erg path_two_result = make_path(suffix: erg suffix_two);
            return case dat path_two_result {
                Result.Err(_) => 3,
                Result.Ok(path_two) => {
                    erg suffix_manifest: u8 = 57u8;
                    erg manifest_result = make_path(suffix: erg suffix_manifest);
                    return case dat manifest_result {
                        Result.Err(_) => 4,
                        Result.Ok(manifest_path) => run_paths(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two, manifest_path: abs manifest_path),
                    };
                },
            };
        },
    };
}

verb main() -> Int {
    erg suffix_zero: u8 = 48u8;
    erg path_zero_result = make_path(suffix: erg suffix_zero);
    return case dat path_zero_result {
        Result.Err(_) => 1,
        Result.Ok(path_zero) => run_with_zero(path_zero: abs path_zero),
    };
}

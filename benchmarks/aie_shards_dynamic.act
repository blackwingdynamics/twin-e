"""Prove that runtime shard payloads create and validate three files."""
import aie;
import std::io;
import std::path;

meta limitless("verb")
verb append_shard_path_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 100u8);
    append(raw, 121u8);
    append(raw, 110u8);
    append(raw, 97u8);
    append(raw, 109u8);
    append(raw, 105u8);
    append(raw, 99u8);
    append(raw, 45u8);
    append(raw, 115u8);
    append(raw, 104u8);
    append(raw, 97u8);
    append(raw, 114u8);
    append(raw, 100u8);
    append(raw, 45u8);
}

verb make_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_shard_path_prefix(raw: ins raw);
    append(raw, suffix);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb make_payload(erg marker: u8) -> Buffer {
    erg payload: Buffer = Buffer[0];
    erg capacity: Int = 128;
    erg reserved = reserve(buffer: ins payload, capacity: erg capacity);
    append(payload, marker);
    erg index: u32 = 1u32;
    loop {
        if index >= 128u32 {
            break;
        }
        append(payload, 0u8);
        index += 1u32;
    }
    return payload;
}

verb write_status(abs path: Path, erg shard_id: u32, erg first_column: u32, abs payload: Buffer) -> Int {
    erg column_count: u32 = 2u32;
    erg result = write_dynamic_shard(path: abs path, shard_id: erg shard_id, first_column_index: erg first_column, column_count: erg column_count, payload: abs payload);
    return case dat result {
        Result.Err(_) => 1,
        Result.Ok(_) => 0,
    };
}

verb validate_status(abs path: Path, erg shard_id: u32, erg first_column: u32) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 1,
        Result.Ok(bytes) => {
            erg column_count: u32 = 2u32;
            erg result = validate_dynamic_shard_bytes(bytes: dat bytes, expected_shard_id: erg shard_id, expected_first_column_index: erg first_column, expected_column_count: erg column_count);
            return case dat result {
                Result.Err(_) => 2,
                Result.Ok(_) => 0,
            };
        },
    };
}

verb validate_all(abs path_zero: Path, abs path_one: Path, abs path_two: Path, erg zero_id: u32, erg one_id: u32, erg two_id: u32) -> Int {
    erg first_zero: u32 = 0u32;
    erg first_one: u32 = 2u32;
    erg first_two: u32 = 4u32;
    if validate_status(path: abs path_zero, shard_id: erg zero_id, first_column: erg first_zero) != 0 {
        return 4;
    }
    if validate_status(path: abs path_one, shard_id: erg one_id, first_column: erg first_one) != 0 {
        return 5;
    }
    if validate_status(path: abs path_two, shard_id: erg two_id, first_column: erg first_two) != 0 {
        return 6;
    }
    return 0;
}

verb write_all(abs path_zero: Path, abs path_one: Path, abs path_two: Path) -> Int {
    erg marker_zero: u8 = 10u8;
    erg marker_one: u8 = 20u8;
    erg marker_two: u8 = 30u8;
    erg payload_zero: Buffer = make_payload(marker: erg marker_zero);
    erg payload_one: Buffer = make_payload(marker: erg marker_one);
    erg payload_two: Buffer = make_payload(marker: erg marker_two);
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    erg two_id: u32 = 2u32;
    erg first_zero: u32 = 0u32;
    erg first_one: u32 = 2u32;
    erg first_two: u32 = 4u32;
    erg zero_status: Int = write_status(path: abs path_zero, shard_id: erg zero_id, first_column: erg first_zero, payload: abs payload_zero);
    if zero_status != 0 {
        return 1;
    }
    erg one_status: Int = write_status(path: abs path_one, shard_id: erg one_id, first_column: erg first_one, payload: abs payload_one);
    if one_status != 0 {
        return 2;
    }
    erg two_status: Int = write_status(path: abs path_two, shard_id: erg two_id, first_column: erg first_two, payload: abs payload_two);
    if two_status != 0 {
        return 3;
    }
    return 0;
}

verb run_paths(abs path_zero: Path, abs path_one: Path, abs path_two: Path) -> Int {
    erg write_status_all: Int = write_all(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two);
    if write_status_all != 0 {
        return write_status_all;
    }
    erg zero_id: u32 = 0u32;
    erg one_id: u32 = 1u32;
    erg two_id: u32 = 2u32;
    erg validation_status: Int = validate_all(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two, zero_id: erg zero_id, one_id: erg one_id, two_id: erg two_id);
    if validation_status != 0 {
        return validation_status;
    }
    erg message: String = "AIE_SHARDS_DYNAMIC files=3 generated=1 validated=3 payload_bytes=128";
    println(text: abs message);
    return 0;
}

verb run_with_zero(abs path_zero: Path) -> Int {
    erg suffix_one: u8 = 49u8;
    erg suffix_two: u8 = 50u8;
    erg path_one_result = make_path(suffix: erg suffix_one);
    return case dat path_one_result {
        Result.Err(_) => 2,
        Result.Ok(path_one) => {
            erg path_two_result = make_path(suffix: erg suffix_two);
            return case dat path_two_result {
                Result.Err(_) => 3,
                Result.Ok(path_two) => run_paths(path_zero: abs path_zero, path_one: abs path_one, path_two: abs path_two),
            };
        },
    };
}

verb main() -> Int {
    erg suffix_zero: u8 = 48u8;
    erg path_zero_result = make_path(suffix: erg suffix_zero);
    return case dat path_zero_result {
        Result.Err(_) => 1,
        Result.Ok(path_zero) => run_with_zero(path_zero: abs path_zero),
    };
}

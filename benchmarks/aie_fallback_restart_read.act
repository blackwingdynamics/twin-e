"""Load the byte-fallback snapshot from fresh process state."""
import aie;

import config;

import encoding;

import std::io;

import std::path;

open io;

verb append_restart_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 97u8);
    append(raw, 108u8);
    append(raw, 108u8);
    append(raw, 98u8);
    append(raw, 97u8);
    append(raw, 99u8);
    append(raw, 107u8);
    append(raw, 45u8);
}

verb append_restart_suffix(ins raw: Buffer) {
    append(raw, 114u8);
    append(raw, 101u8);
    append(raw, 115u8);
    append(raw, 116u8);
    append(raw, 97u8);
    append(raw, 114u8);
    append(raw, 116u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
}

verb restart_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_restart_prefix(raw: ins raw);
    append_restart_suffix(raw: ins raw);
    return path_from_ascii(storage: dat raw);
}

verb main() -> Int {
    erg path_result = restart_path();
    return case dat path_result {
        Result.Err(_) => 1,
        Result.Ok(path) => {
            erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](
            ), free_list_head: 0u32, active_count: 0u32};
            fabric_init(fabric: ins fabric);
            erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
            erg loaded = read_text_brain(
                fabric: ins fabric,
                bindings: ins bindings,
                path: abs path
            );
            return case dat loaded {
                Result.Err(_) => 2,
                Result.Ok(_) => {
                    if fabric.active_count != 64u32 || bindings[1u32].binding_flags != BINDING_ACTIVE_FLAG || bindings[1u32].token_id != 1u32 || bindings[63u32].token_id != 63u32 {
                        return 3;
                    }
                    erg message: String = "AIE_FALLBACK_RESTART reload=1 events=63 active_bindings=63 active_columns=64 process=reader";
                    println(text: abs message);
                    return 0;
                },
            };
        },
    };
}

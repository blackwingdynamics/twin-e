"""Measure logical teaching stages as separate bounded timings."""
import adapters;

import aie;

import config;

import teaching;

import std::io;

import std::fs;

import std::path;

import std::time;

open adapters;

open aie;

open config;

open teaching;

open io;

open fs;

open path;

open time;

struct LatencyMetrics {
    erg adapter_ns: u64,
    erg admission_ns: u64,
    erg routing_ns: u64,
    erg teaching_ns: u64,
    erg flush_ns: u64,
    erg publication_ns: u64,
}

verb append_name(ins raw: Buffer, erg suffix: u8, erg manifest: Bool) {
    if manifest {
        append(raw, 109u8);
        append(raw, 97u8);
        append(raw, 110u8);
        append(raw, 105u8);
        append(raw, 102u8);
        append(raw, 101u8);
        append(raw, 115u8);
        append(raw, 116u8);
    } else {
        append(raw, suffix);
        append(raw, 98u8);
        append(raw, 114u8);
        append(raw, 97u8);
        append(raw, 105u8);
        append(raw, 110u8);
    }
}

verb make_path(erg suffix: u8, erg manifest: Bool) -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append_name(
        raw: ins raw,
        suffix: erg suffix,
        manifest: erg manifest
    );
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb prepare_envelope(abs text: String, ins elapsed: u64) -> Result[AdapterEnvelope, AdapterError] {
    erg started: u64 = monotonic_nanos();
    erg adapted = adapt_text(text: abs text);
    elapsed = monotonic_nanos() - started;
    return adapted;
}

verb measure_adapter(ins elapsed: u64) -> Result[AdapterEnvelope, AdapterError] {
    erg text: String = "latency sample";
    return prepare_envelope(text: abs text, elapsed: ins elapsed);
}

verb measure_admission(ins metrics: LatencyMetrics) -> Bool {
    erg brain: LogicalBrain = logical_brain_empty();
    erg started: u64 = monotonic_nanos();
    erg initialized = logical_brain_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(_) => {},
    };
    erg shard_id: u32 = 0u32;
    erg columns: u32 = BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    erg admitted = logical_brain_admit_shard(
        brain: ins brain,
        shard_id: erg shard_id,
        column_count: erg columns
    );
    metrics.admission_ns = monotonic_nanos() - started;
    return case dat admitted {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb measure_training(
    ins brain: LogicalTeachingBrain,
    abs envelope: AdapterEnvelope,
    ins metrics: LatencyMetrics
) -> Bool {
    erg started: u64 = monotonic_nanos();
    erg taught = teach_text_envelope_logical(brain: ins brain, envelope: abs envelope);
    metrics.teaching_ns = monotonic_nanos() - started;
    return case dat taught {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb measure_flush(ins brain: LogicalTeachingBrain, ins metrics: LatencyMetrics) -> Bool {
    erg target = logical_teaching_flush_target(brain: abs brain);
    return case dat target {
        Option.None => false,
        Option.Some(shard_id) => {
            erg flushed: Result[Int,IoError] = Result[Int, IoError].Ok(0);
            erg started: u64 = monotonic_nanos();
            erg completed = logical_teaching_complete_flush(
                brain: ins brain,
                shard_id: shard_id,
                flushed: abs flushed
            );
            metrics.flush_ns = monotonic_nanos() - started;
            case dat completed {
                Result.Err(_) => false,
                Result.Ok(_) => true,
            };
        },
    };
}

verb measure_routing(erg index: u32) -> u64 {
    erg started: u64 = monotonic_nanos();
    erg location = logical_column_location(global_index: erg index);
    erg elapsed: u64 = monotonic_nanos() - started;
    return case dat location {
        Result.Err(_) => 0u64,
        Result.Ok(_) => elapsed,
    };
}

verb measure_publication(abs brain: LogicalTeachingBrain, abs brain_dir: Path) -> u64 {
    erg generation: u64 = 1u64;
    erg started: u64 = monotonic_nanos();
    erg saved = logical_teaching_save_generation(
        brain: abs brain,
        brain_dir: abs brain_dir,
        generation: erg generation
    );
    erg elapsed: u64 = monotonic_nanos() - started;
    return case dat saved {
        Result.Err(_) => 0u64,
        Result.Ok(_) => elapsed,
    };
}

verb print_metric(abs label: String, erg value: u64) {
    print(string: abs label);
    erg display: Int = value as Int;
    print_int(value: erg display);
}

verb emit_latency(abs metrics: LatencyMetrics) {
    erg adapter: u64 = metrics.adapter_ns;
    erg admission: u64 = metrics.admission_ns;
    erg routing: u64 = metrics.routing_ns;
    erg teaching: u64 = metrics.teaching_ns;
    erg flush: u64 = metrics.flush_ns;
    erg publication: u64 = metrics.publication_ns;
    erg adapter_label: String = "AIE_LOGICAL_LATENCY adapter_ns=";
    erg admission_label: String = " admission_ns=";
    erg routing_label: String = " routing_ns=";
    erg teaching_label: String = " teaching_ns=";
    erg flush_label: String = " flush_ns=";
    erg publication_label: String = " publication_ns=";
    print_metric(label: abs adapter_label, value: erg adapter);
    print_metric(label: abs admission_label, value: erg admission);
    print_metric(label: abs routing_label, value: erg routing);
    print_metric(label: abs teaching_label, value: erg teaching);
    print_metric(label: abs flush_label, value: erg flush);
    print_metric(label: abs publication_label, value: erg publication);
    erg newline: String = "";
    println(text: abs newline);
}

verb finish_run(
    abs brain: LogicalTeachingBrain,
    ins metrics: LatencyMetrics,
    abs brain_dir: Path
) -> Int {
    metrics.publication_ns = measure_publication(brain: abs brain, brain_dir: abs brain_dir);
    erg manifest = persistence_manifest_path(brain_dir: abs brain_dir);
    case dat manifest {
        Result.Err(_) => {},
        Result.Ok(path) => remove_file(path: abs path),
    };
    for erg shard_id: u32 in 0u32 .. BRAIN_LOGICAL_MAX_RESIDENT_SHARDS {
        erg shard = persistence_format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
        case dat shard {
            Result.Err(_) => {},
            Result.Ok(path) => remove_file(path: abs path),
        };
    }
    remove_dir(path: abs brain_dir);
    if metrics.publication_ns == 0u64 || metrics.routing_ns == 0u64 || metrics.flush_ns == 0u64 {
        return 15;
    }
    emit_latency(metrics: abs metrics);
    return 0;
}

verb run_resident_stages(
    ins brain: LogicalTeachingBrain,
    abs envelope: AdapterEnvelope,
    ins metrics: LatencyMetrics
) -> Int {
    if !measure_admission(metrics: ins metrics) {
        return 9;
    }
    erg initialized = logical_teaching_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return 10;
        },
        Result.Ok(_) => {},
    };
    erg route_index: u32 = 17u32;
    metrics.routing_ns = measure_routing(index: erg route_index);
    if !measure_training(
        brain: ins brain,
        envelope: abs envelope,
        metrics: ins metrics
    ) {
        return 11;
    }
    if !measure_flush(brain: ins brain, metrics: ins metrics) {
        return 12;
    }
    return 0;
}

verb publish_workflow(
    abs brain: LogicalTeachingBrain,
    ins metrics: LatencyMetrics
) -> Int {
    erg shard_suffix: u8 = 48u8;
    erg shard_mode: Bool = false;
    erg shard_result = make_path(suffix: erg shard_suffix, manifest: erg shard_mode);
    return case dat shard_result {
        Result.Err(_) => 13,
        Result.Ok(brain_dir) => {
            erg created = create_dir(path: abs brain_dir);
            return case dat created {
                Result.Err(_) => 14,
                Result.Ok(_) => finish_run(
                    brain: abs brain,
                    metrics: ins metrics,
                    brain_dir: abs brain_dir
                ),
            };
        },
    };
}

verb run_workflow(ins metrics: LatencyMetrics) -> Int {
    erg adapted = measure_adapter(elapsed: ins metrics.adapter_ns);
    erg envelope: AdapterEnvelope = AdapterEnvelope {contract_version: 0u16, modality: AdapterModality.Text, event_count: 0u16, source_length: 0u32, events: Array[AdapterEvent, 256](
    ), valid: false};
    case dat adapted {
        Result.Err(_) => {
            return 8;
        },
        Result.Ok(value) => {
            envelope = value;
        },
    };
    erg brain: LogicalTeachingBrain = logical_teaching_empty();
    erg resident_status = run_resident_stages(
        brain: ins brain,
        envelope: abs envelope,
        metrics: ins metrics
    );
    if resident_status != 0 {
        return resident_status;
    }
    return publish_workflow(brain: abs brain, metrics: ins metrics);
}

verb main() -> Int {
    if !logical_shard_profile_is_valid() {
        return 7;
    }
    erg metrics: LatencyMetrics = LatencyMetrics {adapter_ns: 0u64, admission_ns: 0u64, routing_ns: 0u64, teaching_ns: 0u64, flush_ns: 0u64, publication_ns: 0u64};
    return run_workflow(metrics: ins metrics);
}

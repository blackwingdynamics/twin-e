"""Measure one-, two-, and maximum-shard logical-brain profiles."""
import aie;

import config;

import std::io;

import std::time;

open config;

open io;

open time;

verb print_u32(abs label: String, erg value: u32) {
    print(string: abs label);
    erg display: Int = value as Int;
    print_int(value: erg display);
}

verb print_u64(abs label: String, erg value: u64) {
    print(string: abs label);
    erg display: Int = value as Int;
    print_int(value: erg display);
}

verb emit_profile_metrics(
    abs label: String,
    abs brain: LogicalBrain,
    erg elapsed: u64
) {
    print(string: abs "AIE_LOGICAL_SCALE profile=");
    print(string: abs label);
    print(string: abs " shards=");
    erg empty_label: String = "";
    erg shard_count: u32 = brain.shard_count;
    erg logical_columns: u32 = brain.total_column_count;
    erg columns_label: String = " logical_columns=";
    erg resident_label: String = " resident_capacity=";
    erg binding_label: String = " binding_capacity=";
    erg auxiliary_label: String = " auxiliary_capacity=";
    erg restore_label: String = " restore_ns=";
    erg resident_capacity: u32 = BRAIN_LOGICAL_MAX_RESIDENT_SHARDS;
    erg binding_capacity: u32 = BRAIN_LOGICAL_MAX_BINDINGS_PER_SHARD;
    erg auxiliary_capacity: u32 = BRAIN_LOGICAL_MAX_AUXILIARY_RECORDS;
    print_u32(label: abs empty_label, value: erg shard_count);
    print_u32(label: abs columns_label, value: erg logical_columns);
    print_u32(label: abs resident_label, value: erg resident_capacity);
    print_u32(label: abs binding_label, value: erg binding_capacity);
    print_u32(label: abs auxiliary_label, value: erg auxiliary_capacity);
    print_u64(label: abs restore_label, value: erg elapsed);
    erg newline: String = "";
    println(text: abs newline);
}

verb restore_profile(ins brain: LogicalBrain, erg requested_shards: u32) -> Result[Int, LogicalBrainError] {
    erg initialized = logical_brain_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return Result[Int, LogicalBrainError].Err(LogicalBrainError.InvalidProfile);
        },
        Result.Ok(_) => {},
    };
    erg generation: u64 = 1u64;
    erg total_columns: u32 = requested_shards * BRAIN_LOGICAL_SHARD_COLUMN_CAPACITY;
    return logical_brain_restore_generation(
        brain: ins brain,
        generation: erg generation,
        total_column_count: erg total_columns,
        shard_count: abs requested_shards
    );
}

verb measure_profile(abs label: String, erg requested_shards: u32) -> Int {
    erg brain: LogicalBrain = logical_brain_empty();
    erg started: u64 = monotonic_nanos();
    erg restored = restore_profile(brain: ins brain, requested_shards: erg requested_shards);
    erg elapsed: u64 = monotonic_nanos() - started;
    case dat restored {
        Result.Err(_) => {
            return 11;
        },
        Result.Ok(_) => {},
    };
    emit_profile_metrics(
        label: abs label,
        brain: abs brain,
        elapsed: erg elapsed
    );
    return 0;
}

verb main() -> Int {
    if !logical_shard_profile_is_valid() {
        return 7;
    }
    erg one_count: u32 = 1u32;
    erg two_count: u32 = 2u32;
    erg maximum_count: u32 = BRAIN_LOGICAL_MAX_SHARDS;
    erg one_label: String = "one";
    erg two_label: String = "two";
    erg maximum_label: String = "maximum";
    erg one_status = measure_profile(label: abs one_label, requested_shards: erg one_count);
    erg two_status = measure_profile(label: abs two_label, requested_shards: erg two_count);
    erg maximum_status = measure_profile(label: abs maximum_label, requested_shards: erg maximum_count);
    if one_status != 0 || two_status != 0 || maximum_status != 0 {
        return 8;
    }
    return 0;
}

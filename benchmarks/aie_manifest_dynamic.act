meta limitless("file")
"""Prove that manifest descriptors are generated and located dynamically."""
import aie;
import std::fs;
import std::io;
import std::path;

meta limitless("verb")
verb append_dynamic_path_prefix(ins raw: Buffer) {
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 100u8);
    append(raw, 121u8);
    append(raw, 110u8);
    append(raw, 97u8);
    append(raw, 109u8);
    append(raw, 105u8);
    append(raw, 99u8);
    append(raw, 45u8);
    append(raw, 109u8);
    append(raw, 97u8);
    append(raw, 110u8);
    append(raw, 105u8);
    append(raw, 102u8);
    append(raw, 101u8);
    append(raw, 115u8);
    append(raw, 116u8);
}

verb manifest_path() -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_dynamic_path_prefix(raw: ins raw);
    append(raw, 45u8);
    append(raw, 50u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb generation_path(abs marker: u8) -> Result[Path, PathError] {
    erg raw = Buffer[0];
    append_dynamic_path_prefix(raw: ins raw);
    append(raw, 45u8);
    append(raw, 103u8);
    append(raw, 101u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, marker + 48u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb append_dynamic_u32_local(ins output: Buffer, abs value: u32) {
    append(output, (value & 255u32) as u8);
    append(output, ((value / 256u32) & 255u32) as u8);
    append(output, ((value / 65536u32) & 255u32) as u8);
    append(output, ((value / 16777216u32) & 255u32) as u8);
}

verb append_dynamic_u64_local(ins output: Buffer, abs value: u64) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    append_dynamic_u32_local(output: ins output, value: abs low);
    append_dynamic_u32_local(output: ins output, value: abs high);
}

verb append_descriptor(ins output: Buffer, erg shard_id: u32) {
    erg first: u32 = shard_id * 32u32;
    erg count: u32 = 32u32;
    erg payload_offset: u32 = 48u32;
    erg payload_bytes: u32 = 2048u32;
    erg zero: u32 = 0u32;
    erg checksum: u64 = (shard_id as u64) + 1u64;
    erg state: u32 = 1u32;
    append_dynamic_u32_local(output: ins output, value: abs shard_id);
    append_dynamic_u32_local(output: ins output, value: abs first);
    append_dynamic_u32_local(output: ins output, value: abs count);
    append_dynamic_u32_local(output: ins output, value: abs payload_offset);
    append_dynamic_u32_local(output: ins output, value: abs payload_bytes);
    append_dynamic_u32_local(output: ins output, value: abs zero);
    append_dynamic_u32_local(output: ins output, value: abs zero);
    append_dynamic_u64_local(output: ins output, value: abs checksum);
    append_dynamic_u32_local(output: ins output, value: abs state);
}

verb build_descriptors() -> Buffer {
    erg descriptors: Buffer = Buffer[0];
    erg shard_id: u32 = 0u32;
    loop {
        if shard_id >= 3u32 {
            break;
        }
        append_descriptor(output: ins descriptors, shard_id: erg shard_id);
        shard_id += 1u32;
    }
    return descriptors;
}

verb verify_dynamic_plan(abs value: AllocationPlan) -> Int {
    if value.global_index != 96u32 || value.shard_id != 3u32 || value.local_index != 0u32 || !value.creates_shard {
        return 2;
    }
    return 0;
}

verb verify_allocator_head(abs bytes: Buffer) -> Int {
    erg head: u32 = dynamic_manifest_free_list_head(bytes: abs bytes);
    if head != 5u32 {
        return 3;
    }
    return 0;
}

verb verify_free_plan_value(abs value: AllocationPlan) -> Int {
    if value.global_index != 5u32 || value.shard_id != 0u32 || value.local_index != 5u32 || value.creates_shard {
        return 4;
    }
    return 0;
}

verb verify_free_list_plan(abs bytes: Buffer) -> Int {
    erg planned = plan_dynamic_free_list(bytes: abs bytes);
    return case dat planned {
        Result.Err(_) => 5,
        Result.Ok(value) => verify_free_plan_value(value: abs value),
    };
}

verb validate_dynamic(dat bytes: Buffer) -> Int {
    erg allocator_status: Int = verify_allocator_head(bytes: abs bytes);
    if allocator_status != 0 {
        return allocator_status;
    }
    erg free_plan_status: Int = verify_free_list_plan(bytes: abs bytes);
    if free_plan_status != 0 {
        return free_plan_status;
    }
    erg query: u32 = 96u32;
    erg plan = plan_dynamic_allocation(bytes: abs bytes, global_index: erg query);
    return case dat plan {
        Result.Err(_) => 1,
        Result.Ok(value) => verify_dynamic_plan(value: abs value),
    };
}

verb verify_appended_plan(abs value: AllocationPlan) -> Int {
    if value.global_index != 96u32 || value.shard_id != 3u32 || value.local_index != 0u32 || value.creates_shard {
        return 2;
    }
    return 0;
}

verb validate_appended_bytes(abs bytes: Buffer) -> Int {
    erg allocator_status: Int = verify_allocator_head(bytes: abs bytes);
    if allocator_status != 0 {
        return allocator_status;
    }
    erg free_plan_status: Int = verify_free_list_plan(bytes: abs bytes);
    if free_plan_status != 0 {
        return free_plan_status;
    }
    erg query: u32 = 96u32;
    erg plan = plan_dynamic_allocation(bytes: abs bytes, global_index: erg query);
    return case dat plan {
        Result.Err(_) => 4,
        Result.Ok(value) => verify_appended_plan(value: abs value),
    };
}

verb validate_appended_path(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 3,
        Result.Ok(bytes) => validate_appended_bytes(bytes: abs bytes),
    };
}

verb append_and_validate(abs path: Path) -> Int {
    erg new_count: u32 = 2u32;
    erg new_checksum: u64 = 4u64;
    erg new_active_count: u32 = 5u32;
    erg new_free_list_head: u32 = 5u32;
    erg appended = append_manifest_shard(path: abs path, new_column_count: erg new_count, new_checksum: erg new_checksum, active_count: erg new_active_count, free_list_head: erg new_free_list_head);
    erg append_status: Int = case dat appended {
        Result.Err(_) => 6,
        Result.Ok(_) => 0,
    };
    if append_status != 0 {
        return append_status;
    }
    return validate_appended_path(path: abs path);
}

verb run_dynamic(abs path: Path) -> Int {
    erg descriptors: Buffer = build_descriptors();
    erg generation: u64 = 9u64;
    erg active_count: u32 = 3u32;
    erg free_list_head: u32 = 5u32;
    erg total_columns: u32 = 96u32;
    erg shard_count: u32 = 3u32;
    erg saved = write_manifest_dynamic(path: abs path, generation: erg generation, active_count: erg active_count, free_list_head: erg free_list_head, total_column_count: erg total_columns, shard_count: erg shard_count, descriptors: abs descriptors);
    erg save_status: Int = case dat saved {
        Result.Err(_) => 1,
        Result.Ok(_) => 0,
    };
    if save_status != 0 {
        return save_status;
    }
    erg initial_status: Int = validate_dynamic_path(path: abs path);
    if initial_status != 0 {
        return initial_status;
    }
    return append_and_validate(path: abs path);
}

verb validate_dynamic_path(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 2,
        Result.Ok(bytes) => validate_dynamic(bytes: dat bytes),
    };
}

verb verify_invalid_descriptor(ins bytes: Buffer) -> Int {
    bytes[72u32] = 0u8;
    erg valid: Bool = manifest_dynamic_bytes_are_valid(bytes: abs bytes);
    if valid {
        return 8;
    }
    return 0;
}

verb verify_invalid_field(ins bytes: Buffer, erg offset: u32, erg value: u8) -> Int {
    bytes[offset] = value;
    erg valid: Bool = manifest_dynamic_bytes_are_valid(bytes: abs bytes);
    if valid {
        return 8;
    }
    return 0;
}

verb rejects_truncated_manifest() -> Int {
    erg bytes: Buffer = Buffer[0];
    erg index: u32 = 0u32;
    loop {
        if index >= 63u32 {
            break;
        }
        append(bytes, 0u8);
        index += 1u32;
    }
    erg valid: Bool = manifest_dynamic_bytes_are_valid(bytes: abs bytes);
    if valid {
        return 9;
    }
    return 0;
}

verb rejects_oversized_manifest(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 10,
        Result.Ok(bytes) => {
            erg offset: u32 = 8u32;
            erg value: u8 = 255u8;
            return verify_invalid_field(bytes: ins bytes, offset: erg offset, value: erg value);
        },
    };
}

verb rejects_malformed_state(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 11,
        Result.Ok(bytes) => {
            erg offset: u32 = 100u32;
            erg value: u8 = 0u8;
            return verify_invalid_field(bytes: ins bytes, offset: erg offset, value: erg value);
        },
    };
}

verb rejects_invalid_descriptor(abs path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs path);
    return case dat loaded {
        Result.Err(_) => 7,
        Result.Ok(bytes) => verify_invalid_descriptor(bytes: ins bytes),
    };
}

verb write_generation(abs path: Path, erg generation: u64, abs descriptors: Buffer) -> Result[Int, IoError] {
    erg active_count: u32 = 3u32;
    erg free_list_head: u32 = 5u32;
    erg total_columns: u32 = 96u32;
    erg shard_count: u32 = 3u32;
    return write_manifest_dynamic(path: abs path, generation: erg generation, active_count: erg active_count, free_list_head: erg free_list_head, total_column_count: erg total_columns, shard_count: erg shard_count, descriptors: abs descriptors);
}

verb complete_generation_recovery(abs primary: Path, abs fallback: Path, abs staged: Path) -> Int {
    erg descriptors: Buffer = build_descriptors();
    erg old_generation: u64 = 8u64;
    erg new_generation: u64 = 10u64;
    erg old_saved = write_generation(path: abs fallback, generation: erg old_generation, descriptors: abs descriptors);
    erg old_status: Int = case dat old_saved {
        Result.Err(_) => 15,
        Result.Ok(_) => 0,
    };
    if old_status != 0 {
        return old_status;
    } else {
    }
    erg staged_saved = write_generation(path: abs staged, generation: erg new_generation, descriptors: abs descriptors);
    erg staged_status: Int = case dat staged_saved {
        Result.Err(_) => 16,
        Result.Ok(_) => 0,
    };
    if staged_status != 0 {
        return staged_status;
    } else {
    }
    erg published = publish_dynamic_manifest(staged: abs staged, active: abs primary);
    erg published_status: Int = case dat published {
        Result.Err(_) => 17,
        Result.Ok(_) => 0,
    };
    if published_status != 0 {
        return published_status;
    } else {
    }
    erg selected = select_dynamic_manifest_generation(primary: abs primary, fallback: abs fallback);
    erg selected_status: Int = case dat selected {
        Result.Err(_) => 18,
        Result.Ok(choice) => case choice.slot {
            0 => if choice.generation == new_generation { 0 } else { 19 },
            _ => 19,
        },
    };
    if selected_status != 0 {
        return selected_status;
    } else {
    }
    erg invalid: Buffer = Buffer[1];
    invalid[0u32] = 0u8;
    erg invalid_saved = write_file(path: abs staged, contents: abs invalid);
    erg invalid_status: Int = case dat invalid_saved {
        Result.Err(_) => 20,
        Result.Ok(_) => 0,
    };
    if invalid_status != 0 {
        return invalid_status;
    } else {
    }
    erg rejected = publish_dynamic_manifest(staged: abs staged, active: abs primary);
    erg rejected_status: Int = case dat rejected {
        Result.Ok(_) => 21,
        Result.Err(_) => 0,
    };
    if rejected_status != 0 {
        return rejected_status;
    } else {
    }
    erg after_rejected = select_dynamic_manifest_generation(primary: abs primary, fallback: abs fallback);
    return case dat after_rejected {
        Result.Err(_) => 22,
        Result.Ok(choice) => case choice.slot {
            0 => if choice.generation == new_generation { 0 } else { 22 },
            _ => 22,
        },
    };
}

verb resolve_staged_generation(abs primary: Path, abs fallback: Path) -> Int {
    erg staged_marker: u8 = 2u8;
    erg staged_result = generation_path(marker: abs staged_marker);
    return case dat staged_result {
        Result.Err(_) => 14,
        Result.Ok(resolved_staged) => complete_generation_recovery(primary: abs primary, fallback: abs fallback, staged: abs resolved_staged),
    };
}

verb resolve_fallback_generation(abs primary: Path) -> Int {
    erg fallback_marker: u8 = 1u8;
    erg fallback_result = generation_path(marker: abs fallback_marker);
    return case dat fallback_result {
        Result.Err(_) => 13,
        Result.Ok(fallback) => resolve_staged_generation(primary: abs primary, fallback: abs fallback),
    };
}

verb run_generation_recovery() -> Int {
    erg primary_marker: u8 = 0u8;
    erg primary_result = generation_path(marker: abs primary_marker);
    return case dat primary_result {
        Result.Err(_) => 12,
        Result.Ok(primary) => resolve_fallback_generation(primary: abs primary),
    };
}

verb emit_dynamic(abs path: Path) -> Int {
    erg status: Int = run_dynamic(path: abs path);
    if status != 0 {
        return status;
    }
    erg rejected_status: Int = rejects_invalid_descriptor(path: abs path);
    if rejected_status != 0 {
        return rejected_status;
    }
    erg truncated_status: Int = rejects_truncated_manifest();
    if truncated_status != 0 {
        return truncated_status;
    }
    erg oversized_status: Int = rejects_oversized_manifest(path: abs path);
    if oversized_status != 0 {
        return oversized_status;
    }
    erg state_status: Int = rejects_malformed_state(path: abs path);
    if state_status != 0 {
        return state_status;
    }
    erg recovery_status: Int = run_generation_recovery();
    if recovery_status != 0 {
        return recovery_status;
    }
    erg message: String = "AIE_MANIFEST_DYNAMIC shards=3 appended_shard=3 allocation_shard=3 local_index=0 allocator_head=5 allocator_shard=0 allocator_local=5 roundtrip=1 generation_publish=1 newest_generation=10 stale_rejected=1";
    println(text: abs message);
    return 0;
}

verb main() -> Int {
    erg path_result = manifest_path();
    return case dat path_result {
        Result.Err(_) => 1,
        Result.Ok(path) => emit_dynamic(path: abs path),
    };
}

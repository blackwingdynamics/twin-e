"""Pairwise collision benchmark for the initial 128-bit token codebook."""
import config;

import encoding;

import std::io;

import std::time;

const CODEBOOK_SIZE: u32 = 5000u32;


const HISTOGRAM_SIZE: u32 = 9u32;


meta limitless("verb")
verb popcount_u64(erg value: u64) -> u32 {
    erg count: u32 = 0u32;
    loop {
        if value == 0u64 {
            break;
        }
        value &= value - 1u64;
        count += 1u32;
    }
    return count;
}

verb overlap(
    erg left_low: u64,
    erg left_high: u64,
    erg right_low: u64,
    erg right_high: u64
) -> u32 {
    erg low: u64 = left_low & right_low;
    erg high: u64 = left_high & right_high;
    return popcount_u64(value: erg low) + popcount_u64(value: erg high);
}

meta limitless("verb")
verb main() -> Int {
    erg codes: Array[TokenCode,5000] = Array[TokenCode, 5000]();
    erg started: u64 = monotonic_nanos();
    erg invalid_code_count: u32 = 0u32;
    erg index: u32 = 0u32;
    loop {
        if index >= CODEBOOK_SIZE {
            break;
        }
        erg code: TokenCode = encode_token_id(token_id: erg index);
        codes[index] = code;
        erg code_low: u64 = code.mask_low;
        erg code_high: u64 = code.mask_high;
        erg code_bits: u32 = popcount_u64(value: erg code_low) + popcount_u64(value: erg code_high);
        if code_bits != TOKEN_CODE_ACTIVE_BITS as u32 {
            invalid_code_count += 1u32;
        }
        index += 1u32;
    }
    erg maximum_overlap: u32 = 0u32;
    erg duplicate_pairs: u32 = 0u32;
    erg overlap_histogram: Array[u32,9] = Array[u32, 9]();
    erg left_index: u32 = 0u32;
    loop {
        if left_index >= CODEBOOK_SIZE {
            break;
        }
        erg right_index: u32 = left_index + 1u32;
        loop {
            if right_index >= CODEBOOK_SIZE {
                break;
            }
            erg left_low: u64 = codes[left_index].mask_low;
            erg left_high: u64 = codes[left_index].mask_high;
            erg right_low: u64 = codes[right_index].mask_low;
            erg right_high: u64 = codes[right_index].mask_high;
            erg pair_overlap: u32 = overlap(
                left_low: erg left_low,
                left_high: erg left_high,
                right_low: erg right_low,
                right_high: erg right_high
            );
            if pair_overlap > maximum_overlap {
                maximum_overlap = pair_overlap;
            }
            overlap_histogram[pair_overlap as Usize] += 1u32;
            if pair_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
                duplicate_pairs += 1u32;
            }
            right_index += 1u32;
        }
        left_index += 1u32;
    }
    erg heading: String = "AIE_CODEBOOK population=token_ids size=5000 codebook_version=1 active_bits=8 seed=11400714819323198485 generation=sequential_u32";
    println(text: abs heading);
    erg overlap_label: String = "AIE_CODEBOOK max_different_overlap=";
    print(text: abs overlap_label);
    erg overlap_value: Int = maximum_overlap as Int;
    print_int(value: erg overlap_value);
    erg duplicate_label: String = "AIE_CODEBOOK duplicate_pairs=";
    print(text: abs duplicate_label);
    erg duplicate_value: Int = duplicate_pairs as Int;
    print_int(value: erg duplicate_value);
    erg invalid_label: String = "AIE_CODEBOOK invalid_code_count=";
    print(text: abs invalid_label);
    erg invalid_value: Int = invalid_code_count as Int;
    print_int(value: erg invalid_value);
    erg histogram_index: u32 = 0u32;
    loop {
        if histogram_index >= HISTOGRAM_SIZE {
            break;
        }
        erg histogram_label: String = "AIE_CODEBOOK overlap_bucket=";
        print(text: abs histogram_label);
        erg histogram_key: Int = histogram_index as Int;
        print_int(value: erg histogram_key);
        erg histogram_separator: String = " count=";
        print(text: abs histogram_separator);
        erg histogram_value: Int = overlap_histogram[histogram_index as Usize] as Int;
        print_int(value: erg histogram_value);
        histogram_index += 1u32;
    }
    erg threshold: u32 = 1u32;
    loop {
        if threshold > TOKEN_CODE_ACTIVE_BITS as u32 {
            break;
        }
        erg false_pair_count: u32 = 0u32;
        erg bucket: u32 = 0u32;
        loop {
            if bucket >= HISTOGRAM_SIZE {
                break;
            }
            if bucket >= threshold {
                false_pair_count += overlap_histogram[bucket as Usize];
            }
            bucket += 1u32;
        }
        erg threshold_label: String = "AIE_CODEBOOK false_pairs_theta=";
        print(text: abs threshold_label);
        erg threshold_value: Int = threshold as Int;
        print_int(value: erg threshold_value);
        erg threshold_separator: String = " count=";
        print(text: abs threshold_separator);
        erg false_pair_value: Int = false_pair_count as Int;
        print_int(value: erg false_pair_value);
        threshold += 1u32;
    }
    erg target_code: TokenCode = codes[0u32];
    erg noisy_low: u64 = target_code.mask_low;
    erg noisy_high: u64 = target_code.mask_high;
    if noisy_low != 0u64 {
        noisy_low &= noisy_low - 1u64;
    } else {
        noisy_high &= noisy_high - 1u64;
    }
    erg exact_candidate_count: u32 = 0u32;
    erg noisy_exact_candidate_count: u32 = 0u32;
    erg noisy_relaxed_candidate_count: u32 = 0u32;
    erg target_low: u64 = target_code.mask_low;
    erg target_high: u64 = target_code.mask_high;
    erg query_index: u32 = 0u32;
    loop {
        if query_index >= CODEBOOK_SIZE {
            break;
        }
        erg query_code: TokenCode = codes[query_index];
        erg query_low: u64 = query_code.mask_low;
        erg query_high: u64 = query_code.mask_high;
        erg exact_overlap: u32 = overlap(
            left_low: erg target_low,
            left_high: erg target_high,
            right_low: erg query_low,
            right_high: erg query_high
        );
        if exact_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
            exact_candidate_count += 1u32;
        }
        erg noisy_overlap: u32 = overlap(
            left_low: erg noisy_low,
            left_high: erg noisy_high,
            right_low: erg query_low,
            right_high: erg query_high
        );
        if noisy_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 {
            noisy_exact_candidate_count += 1u32;
        }
        if noisy_overlap >= (TOKEN_CODE_ACTIVE_BITS as u32 - 1u32) {
            noisy_relaxed_candidate_count += 1u32;
        }
        query_index += 1u32;
    }
    erg noise_heading: String = "AIE_CODEBOOK noise=one_active_bit_removed";
    println(text: abs noise_heading);
    erg exact_candidates_label: String = "AIE_CODEBOOK exact_query_candidates_theta=8 count=";
    print(text: abs exact_candidates_label);
    erg exact_candidates_value: Int = exact_candidate_count as Int;
    print_int(value: erg exact_candidates_value);
    erg noisy_exact_label: String = "AIE_CODEBOOK noisy_query_candidates_theta=8 count=";
    print(text: abs noisy_exact_label);
    erg noisy_exact_value: Int = noisy_exact_candidate_count as Int;
    print_int(value: erg noisy_exact_value);
    erg noisy_relaxed_label: String = "AIE_CODEBOOK noisy_query_candidates_theta=7 count=";
    print(text: abs noisy_relaxed_label);
    erg noisy_relaxed_value: Int = noisy_relaxed_candidate_count as Int;
    print_int(value: erg noisy_relaxed_value);
    erg finished: u64 = monotonic_nanos();
    erg elapsed_label: String = "AIE_CODEBOOK elapsed_ns=";
    print(text: abs elapsed_label);
    erg elapsed_value: Int = (finished - started) as Int;
    print_int(value: erg elapsed_value);
    if maximum_overlap >= TOKEN_CODE_ACTIVE_BITS as u32 || duplicate_pairs != 0u32 || invalid_code_count != 0u32 {
        return 1;
    }
    return 0;
}

"""Public AIE engine API tests returning zero on success."""
import aie;

import config;

meta test
verb test_public_wavefront_lifecycle() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg source_idx: u32 = allocate_column_index(fabric: ins fabric);
    erg target_idx: u32 = allocate_column_index(fabric: ins fabric);
    fabric.columns[source_idx].threshold = 1u8;
    fabric.columns[source_idx].coincidence_low = 1u64;
    fabric.columns[source_idx].payload = 41u8;
    fabric.columns[source_idx].axons[0u32] = target_idx;
    fabric.columns[target_idx].threshold = 1u8;
    fabric.columns[target_idx].coincidence_low = 1u64;
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg result: ImpulseStepResult = step_wavefront(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
    if result.valid_source && result.source_fired && result.payload == 41u8 && result.destination_0 == target_idx {
        if fabric.columns[source_idx].myelination == 1u8 && fabric.columns[target_idx].myelination == 1u8 {
            return 0;
        }
    }
    return 1;
}

meta test
verb test_public_api_rejects_invalid_and_exhausted_inputs() -> Int {
    erg fabric: CorticalFabric[1] = CorticalFabric[1] {columns: Array[Minicolumn, 1](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg source_idx: u32 = allocate_column_index(fabric: ins fabric);
    erg no_slot: Option[u32] = allocate_column(fabric: ins fabric);
    erg exhausted: Bool = case dat no_slot {
        Option.None => true,
        Option.Some(_) => false,
    };
    erg wave: Wavefront = Wavefront {mask_low: 3u64, mask_high: 0u64, energy: 1u8};
    erg invalid_idx: u32 = 1u32;
    erg invalid: ImpulseStepResult = step_wavefront(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg invalid_idx
    );
    erg invalid_source: Bool = invalid.valid_source == false;
    erg empty_destinations: Bool = invalid.destination_0 == NULL_INDEX;
    if exhausted && invalid_source && empty_destinations {
        return 0;
    }
    return 1;
}

verb cache_entry_is_dirty_for_test(abs cache: ShardCache) -> Bool {
    return case cache.entries[0u32].lifecycle {
        ShardLifecycle.Dirty => true,
        _ => false,
    };
}

verb cache_ready_for_test(abs cache: ShardCache) -> Bool {
    return cache.entries[0u32].shard_id == 7u32 && cache_entry_is_dirty_for_test(cache: abs cache);
}

verb fill_dirty_cache_for_test(ins cache: ShardCache) {
    erg ids: Array[u32,4] = Array[u32, 4]();
    ids[0u32] = 20u32;
    ids[1u32] = 21u32;
    ids[2u32] = 22u32;
    ids[3u32] = 23u32;
    erg index: u32 = 0u32;
    loop {
        if index >= 4u32 {
            break;
        }
        erg id: u32 = ids[index];
        erg generation: u64 = id as u64;
        shard_cache_insert(
            cache: ins cache,
            shard_id: erg id,
            generation: erg generation,
            checksum: erg generation
        );
        erg slot: u8 = index as u8;
        shard_cache_mark_dirty(cache: ins cache, slot: erg slot);
        index += 1u32;
    }
}

verb resident_capacity_error_for_test() -> Bool {
    erg fabric: CorticalFabric[2] = CorticalFabric[2] {columns: Array[Minicolumn, 2](), free_list_head: 0u32, active_count: 0u32};
    erg cache: ShardCache = ShardCache {entries: Array[ShardCacheEntry, 4](), clock: 0u64};
    fabric_init(fabric: ins fabric);
    shard_cache_init(cache: ins cache);
    erg source_idx: u32 = allocate_column_index(fabric: ins fabric);
    fill_dirty_cache_for_test(cache: ins cache);
    erg requested: u32 = 24u32;
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg generation: u64 = requested as u64;
    erg result = neurogenesis_with_resident_cache_result(
        fabric: ins fabric,
        cache: ins cache,
        wave: abs wave,
        source_idx: erg source_idx,
        shard_id: erg requested,
        generation: erg generation,
        checksum: erg generation
    );
    return case dat result {
        Result.Err(error) => case error {
            ResidentNeurogenesisError.NoResidentCapacity => true,
            _ => false,
        },
        Result.Ok(_) => false,
    };
}

meta test
verb test_resident_shard_precedes_neurogenesis_link() -> Int {
    erg fabric: CorticalFabric[4] = CorticalFabric[4] {columns: Array[Minicolumn, 4](), free_list_head: 0u32, active_count: 0u32};
    erg cache: ShardCache = ShardCache {entries: Array[ShardCacheEntry, 4](), clock: 0u64};
    fabric_init(fabric: ins fabric);
    shard_cache_init(cache: ins cache);
    erg source_idx: u32 = allocate_column_index(fabric: ins fabric);
    erg wave: Wavefront = Wavefront {mask_low: 9u64, mask_high: 0u64, energy: 1u8};
    erg shard_id: u32 = 7u32;
    erg generation: u64 = 1u64;
    erg checksum: u64 = 77u64;
    neurogenesis_with_resident_cache_result(
        fabric: ins fabric,
        cache: ins cache,
        wave: abs wave,
        source_idx: erg source_idx,
        shard_id: erg shard_id,
        generation: erg generation,
        checksum: erg checksum
    );
    erg linked: Bool = fabric.columns[source_idx].axons[0u32] != NULL_INDEX;
    if linked && cache_ready_for_test(cache: abs cache) {
        return 0;
    }
    return 1;
}

meta test
verb test_resident_neurogenesis_reports_capacity_error() -> Int {
    if resident_capacity_error_for_test() {
        return 0;
    }
    return 1;
}

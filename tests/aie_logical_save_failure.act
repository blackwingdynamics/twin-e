"""Gate 11.8 evidence for failed logical saves preserving live state."""
import aie;

import std::path;

open aie;

open path;

verb failed_save_path() -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 110u8);
    append(raw, 111u8);
    append(raw, 45u8);
    append(raw, 115u8);
    append(raw, 117u8);
    append(raw, 99u8);
    append(raw, 104u8);
    append(raw, 45u8);
    append(raw, 100u8);
    append(raw, 105u8);
    append(raw, 114u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 46u8);
    append(raw, 98u8);
    append(raw, 114u8);
    append(raw, 97u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb failed_save_train(ins brain: LogicalTeachingBrain) -> Bool {
    erg initialized = logical_teaching_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(_) => {},
    };
    erg token: Token = Token {id: 70000u32, byte_offset: 0u32, byte_length: 1u16, tokenizer_version: 1u16};
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 1u32, valid: true};
    sequence.tokens[0u32] = token;
    erg taught = logical_teaching_sequence(brain: ins brain, sequence: abs sequence);
    case dat taught {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(_) => {},
    };
    return true;
}

verb failed_save_paths(ins paths: Array[Path, 8]) -> Bool {
    erg invalid_result = failed_save_path();
    return case dat invalid_result {
        Result.Err(_) => false,
        Result.Ok(invalid_path) => {
            paths[0u32] = invalid_path;
            paths[3u32] = invalid_path;
            true;
        },
    };
}

verb failed_save_attempt(abs brain: LogicalTeachingBrain, abs brain_dir: Path) -> Bool {
    erg generation: u64 = 1u64;
    erg saved = logical_teaching_save_generation(
        brain: abs brain,
        brain_dir: abs brain_dir,
        generation: erg generation
    );
    return case dat saved {
        Result.Ok(_) => false,
        Result.Err(_) => true,
    };
}

verb test_failed_logical_save_preserves_state() -> Int {
    erg brain: LogicalTeachingBrain = logical_teaching_empty();
    if !failed_save_train(brain: ins brain) {
        return 1;
    }
    erg shard_count_before: u32 = brain.logical.shard_count;
    erg columns_before: u32 = brain.logical.total_column_count;
    erg generation_before: u64 = brain.logical.generation;
    erg paths: Array[Path,8] = Array[Path, 8]();
    if !failed_save_paths(paths: ins paths) {
        return 3;
    }
    if !failed_save_attempt(brain: abs brain, brain_dir: abs paths[0u32]) {
        return 4;
    }
    if brain.logical.shard_count != shard_count_before || brain.logical.total_column_count != columns_before || brain.logical.generation != generation_before {
        return 5;
    }
    return 0;
}

meta test
verb test_failed_logical_save_preserves_live_state() -> Int {
    return test_failed_logical_save_preserves_state();
}

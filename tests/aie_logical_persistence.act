"""Gate 11.6 evidence for logical teaching save, load, and restart recall."""
import aie;

import config;

import std::path;

import std::fs;

import tokenizer;

open aie;

open config;

open path;

open fs;

open tokenizer;

verb persistence_token(abs seed: u32, abs position: u32) -> Token {
    erg token: Token = Token {id: 0u32, byte_offset: 0u32, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    token.id = seed + position;
    token.byte_offset = position;
    return token;
}

verb persistence_sequence(erg seed: u32) -> TokenSequence {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 256u32, valid: true};
    for erg position: u32 in 0u32 .. 256u32 {
        sequence.tokens[position as Usize] = persistence_token(seed: abs seed, position: abs position);
    }
    return sequence;
}

verb persistence_teach(ins brain: LogicalTeachingBrain, erg seed: u32) -> Bool {
    erg sequence: TokenSequence = persistence_sequence(seed: erg seed);
    erg result = logical_teaching_sequence(brain: ins brain, sequence: abs sequence);
    return case dat result {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb persistence_initial_training(ins brain: LogicalTeachingBrain) -> Bool {
    erg first_seed: u32 = 50000u32;
    erg second_seed: u32 = 54000u32;
    erg third_seed: u32 = 55000u32;
    erg fourth_seed: u32 = 56000u32;
    erg fifth_seed: u32 = 57000u32;
    erg initialized = logical_teaching_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(_) => {},
    };
    return persistence_teach(brain: ins brain, seed: erg first_seed) && persistence_teach(brain: ins brain, seed: erg second_seed) && persistence_teach(
        brain: ins brain,
        seed: erg third_seed
    ) && persistence_teach(brain: ins brain, seed: erg fourth_seed) && persistence_teach(brain: ins brain, seed: erg fifth_seed);
}

verb persistence_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 103u8);
    append(raw, 49u8);
    append(raw, 49u8);
    append(raw, 54u8);
    append(raw, 45u8);
    append(raw, 100u8);
    append(raw, 105u8);
    append(raw, 114u8);
    append(raw, 45u8);
    append(raw, suffix);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb persistence_save(
    abs brain: LogicalTeachingBrain,
    abs brain_dir: Path,
    erg generation: u64
) -> Bool {
    erg result = logical_teaching_save_generation(
        brain: abs brain,
        brain_dir: abs brain_dir,
        generation: erg generation
    );
    return case dat result {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb persistence_load(ins brain: LogicalTeachingBrain, abs brain_dir: Path) -> Bool {
    erg result = logical_teaching_load_generation(brain: ins brain, brain_dir: abs brain_dir);
    return case dat result {
        Result.Err(_) => false,
        Result.Ok(value) => value > 0,
    };
}

verb persistence_has_binding(
    abs bindings: Array[TokenBinding, 1024],
    erg token_id: u32
) -> Bool {
    erg bos_token_id: u32 = BPE_BOS_TOKEN_ID;
    erg context: u64 = context_key(previous_token_id: erg bos_token_id, token_id: erg token_id);
    erg result = lookup_token_context[1024](
        bindings: abs bindings,
        token_id: erg token_id,
        context_key: erg context
    );
    return case dat result {
        Option.None => false,
        Option.Some(_) => true,
    };
}

verb persistence_recall(abs brain: LogicalTeachingBrain) -> Bool {
    erg first_token_id: u32 = 50000u32;
    erg second_token_id: u32 = 54000u32;
    erg fifth_token_id: u32 = 57000u32;
    return persistence_has_any_binding(brain: abs brain, token_id: erg first_token_id) && persistence_has_any_binding(
        brain: abs brain,
        token_id: erg second_token_id
    ) && persistence_has_any_binding(brain: abs brain, token_id: erg fifth_token_id);
}

verb persistence_has_any_binding(
    abs brain: LogicalTeachingBrain,
    erg token_id: u32
) -> Bool {
    erg slot: u32 = 0u32;
    loop {
        if slot >= BRAIN_LOGICAL_MAX_RESIDENT_SHARDS {
            break;
        }
        if persistence_has_binding(bindings: abs brain.bindings[slot as Usize], token_id: erg token_id) {
            return true;
        }
        slot += 1u32;
    }
    return false;
}

verb persistence_first_save(abs brain_dir: Path) -> Bool {
    erg first: LogicalTeachingBrain = logical_teaching_empty();
    erg first_generation: u64 = 1u64;
    return persistence_initial_training(brain: ins first) && persistence_save(
        brain: abs first,
        brain_dir: abs brain_dir,
        generation: erg first_generation
    );
}

verb persistence_second_save(ins brain: LogicalTeachingBrain, abs brain_dir: Path) -> Bool {
    erg second_generation: u64 = 2u64;
    erg continuation_seed: u32 = 58000u32;
    if !persistence_load(brain: ins brain, brain_dir: abs brain_dir) {
        return false;
    }
    if brain.logical.generation != 1u64 {
        return false;
    }
    if !persistence_recall(brain: abs brain) {
        return false;
    }
    if !persistence_teach(brain: ins brain, seed: erg continuation_seed) {
        return false;
    }
    if !persistence_save(
        brain: abs brain,
        brain_dir: abs brain_dir,
        generation: erg second_generation
    ) {
        return false;
    }
    return true;
}

verb persistence_third_save(ins brain: LogicalTeachingBrain, abs brain_dir: Path) -> Bool {
    erg third_generation: u64 = 3u64;
    erg continuation_seed: u32 = 59000u32;
    if !persistence_load(brain: ins brain, brain_dir: abs brain_dir) {
        return false;
    }
    if brain.logical.generation != 2u64 {
        return false;
    }
    erg previous_seed: u32 = 58000u32;
    if !persistence_has_any_binding(brain: abs brain, token_id: erg previous_seed) {
        return false;
    }
    if !persistence_teach(brain: ins brain, seed: erg continuation_seed) {
        return false;
    }
    if !persistence_save(
        brain: abs brain,
        brain_dir: abs brain_dir,
        generation: erg third_generation
    ) {
        return false;
    }
    return true;
}

verb persistence_restart_check(
    ins brain: LogicalTeachingBrain,
    abs brain_dir: Path
) -> Bool {
    erg restarted_seed: u32 = 58000u32;
    if !persistence_load(brain: ins brain, brain_dir: abs brain_dir) {
        return false;
    }
    if brain.logical.generation != 3u64 {
        return false;
    }
    if !persistence_has_any_binding(brain: abs brain, token_id: erg restarted_seed) {
        return false;
    }
    if brain.logical.shard_count < 2u32 {
        return false;
    }
    return true;
}

verb persistence_cleanup(abs brain_dir: Path) {
    erg manifest = persistence_manifest_path(brain_dir: abs brain_dir);
    case dat manifest {
        Result.Err(_) => {},
        Result.Ok(path) => remove_file(path: abs path),
    };
    for erg shard_id: u32 in 0u32 .. 4u32 {
        erg shard = persistence_format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
        case dat shard {
            Result.Err(_) => {},
            Result.Ok(path) => remove_file(path: abs path),
        };
    }
    remove_dir(path: abs brain_dir);
}

verb persistence_run_steps(abs brain_dir: Path) -> Int {
    if !persistence_first_save(brain_dir: abs brain_dir) {
        return 1;
    }
    erg loaded: LogicalTeachingBrain = logical_teaching_empty();
    if !persistence_second_save(brain: ins loaded, brain_dir: abs brain_dir) {
        return 1;
    }
    erg third: LogicalTeachingBrain = logical_teaching_empty();
    if !persistence_third_save(brain: ins third, brain_dir: abs brain_dir) {
        return 1;
    }
    erg restarted: LogicalTeachingBrain = logical_teaching_empty();
    if !persistence_restart_check(brain: ins restarted, brain_dir: abs brain_dir) {
        return 1;
    }
    return 0;
}

verb persistence_run_with_directory(dat brain_dir: Path) -> Int {
    remove_dir(path: abs brain_dir);
    erg created = create_dir(path: abs brain_dir);
    erg status: Int = case dat created {
        Result.Err(_) => 1,
        Result.Ok(_) => persistence_run_steps(brain_dir: abs brain_dir),
    };
    persistence_cleanup(brain_dir: abs brain_dir);
    drop(brain_dir);
    return status;
}

meta test
verb test_logical_teaching_save_load_restart_recall() -> Int {
    erg suffix: u8 = 49u8;
    erg brain_dir_result = persistence_path(suffix: erg suffix);
    return case dat brain_dir_result {
        Result.Err(_) => 1,
        Result.Ok(brain_dir) => persistence_run_with_directory(brain_dir: dat brain_dir),
    };
}

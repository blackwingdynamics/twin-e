meta limitless("file")


"""Gate 12.3 evidence for successful dirty-resident flushing."""
import aie;

import config;

import std::fs;

import std::path;

import teaching;

import tokenizer;

open aie;

open config;

open fs;

open path;

open teaching;

open tokenizer;

verb flush_test_path() -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 103u8);
    append(raw, 49u8);
    append(raw, 50u8);
    append(raw, 51u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 108u8);
    append(raw, 117u8);
    append(raw, 115u8);
    append(raw, 104u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb flush_test_sequence() -> TokenSequence {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 256u32, valid: true};
    for erg position: u32 in 0u32 .. 256u32 {
        sequence.tokens[position as Usize] = Token {id: 50000u32 + position, byte_offset: position, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    }
    return sequence;
}

verb flush_test_teach_seed(ins brain: LogicalTeachingBrain, erg seed: u32) -> Bool {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 256u32, valid: true};
    for erg position: u32 in 0u32 .. 256u32 {
        sequence.tokens[position as Usize] = Token {id: seed + position, byte_offset: position, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    }
    erg taught = logical_teaching_sequence(brain: ins brain, sequence: abs sequence);
    return case dat taught {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb flush_test_input_path() -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 103u8);
    append(raw, 49u8);
    append(raw, 50u8);
    append(raw, 51u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 108u8);
    append(raw, 117u8);
    append(raw, 115u8);
    append(raw, 104u8);
    append(raw, 45u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 112u8);
    append(raw, 117u8);
    append(raw, 116u8);
    append(raw, 46u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 102u8);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb flush_test_input_bytes() -> Buffer {
    erg bytes: Buffer = Buffer[0];
    append(bytes, 84u8);
    append(bytes, 87u8);
    append(bytes, 70u8);
    append(bytes, 49u8);
    append(bytes, 1u8);
    append(bytes, 128u8);
    append(bytes, 0u8);
    for erg index: u32 in 0u32 .. 128u32 {
        append(bytes, 65u8 + (index % 26u32) as u8);
    }
    return bytes;
}

verb flush_test_write_input(abs path: Path) -> Bool {
    erg bytes = flush_test_input_bytes();
    erg written = write_file(path: abs path, contents: abs bytes);
    return case dat written {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb flush_test_cleanup(abs brain_dir: Path) {
    erg manifest = persistence_manifest_path(brain_dir: abs brain_dir);
    case dat manifest {
        Result.Err(_) => {},
        Result.Ok(path) => remove_file(path: abs path),
    };
    for erg shard_id: u32 in 0u32 .. 8u32 {
        erg shard = persistence_format_shard_path(brain_dir: abs brain_dir, shard_id: erg shard_id);
        case dat shard {
            Result.Err(_) => {},
            Result.Ok(path) => remove_file(path: abs path),
        };
    }
    remove_dir(path: abs brain_dir);
}

verb flush_test_prepare(ins brain: LogicalTeachingBrain, abs brain_dir: Path) -> Int {
    flush_test_cleanup(brain_dir: abs brain_dir);
    erg created = create_dir(path: abs brain_dir);
    case dat created {
        Result.Err(_) => {
            return 1;
        },
        Result.Ok(_) => {},
    };
    erg initialized = logical_teaching_init(brain: ins brain);
    case dat initialized {
        Result.Err(_) => {
            return 2;
        },
        Result.Ok(_) => {},
    };
    for erg seed_offset: u32 in 0u32 .. 3u32 {
        erg seed: u32 = 50000u32 + (seed_offset * 1000u32);
        if !flush_test_teach_seed(brain: ins brain, seed: erg seed) {
            return 3;
        }
    }
    return 0;
}

verb flush_test_succeeds(ins brain: LogicalTeachingBrain, abs brain_dir: Path) -> Bool {
    erg flushed = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs brain_dir);
    case dat flushed {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(_) => {},
    };
    if shard_cache_dirty_count(cache: abs brain.logical.cache) != 0u8 {
        return false;
    }
    erg target = logical_teaching_flush_target(brain: abs brain);
    return case dat target {
        Option.None => true,
        Option.Some(_) => false,
    };
}

meta test
verb test_logical_teaching_flush_marks_dirty_entries_persisted() -> Int {
    erg directory_result = flush_test_path();
    return case dat directory_result {
        Result.Err(_) => 1,
        Result.Ok(directory) => {
            erg brain: LogicalTeachingBrain = logical_teaching_empty();
            erg prepared = flush_test_prepare(brain: ins brain, brain_dir: abs directory);
            if prepared != 0 {
                flush_test_cleanup(brain_dir: abs directory);
                return prepared + 1;
            }
            erg passed = flush_test_succeeds(brain: ins brain, brain_dir: abs directory);
            flush_test_cleanup(brain_dir: abs directory);
            if passed {
                0;
            } else {
                3;
            }
        },
    };
}

meta test
verb test_logical_teaching_retries_current_twf_record_after_flush() -> Int {
    erg directory_result = flush_test_path();
    return case dat directory_result {
        Result.Err(_) => 1,
        Result.Ok(directory) => {
            erg input_result = flush_test_input_path();
            return case dat input_result {
                Result.Err(_) => {
                    flush_test_cleanup(brain_dir: abs directory);
                    2;
                },
                Result.Ok(input) => {
                    erg brain: LogicalTeachingBrain = logical_teaching_empty();
                    erg prepared = flush_test_prepare(brain: ins brain, brain_dir: abs directory);
                    if prepared != 0 || !flush_test_write_input(path: abs input) {
                        remove_file(path: abs input);
                        flush_test_cleanup(brain_dir: abs directory);
                        return 3;
                    }
                    erg result = teach_logical_file_with_flush(
                        brain: ins brain,
                        path: abs input,
                        brain_dir: abs directory
                    );
                    remove_file(path: abs input);
                    flush_test_cleanup(brain_dir: abs directory);
                    return case dat result {
                        Result.Err(error) => case error {
                            TeachingFileError.IoFailure => 10,
                            TeachingFileError.InvalidRecord => 11,
                            TeachingFileError.LogicalCapacityExceeded => 12,
                            TeachingFileError.ResidentCapacityExceeded => 13,
                            TeachingFileError.FlushRequired => 14,
                            TeachingFileError.InvalidRouting => 15,
                            _ => 16,
                        },
                        Result.Ok(metrics) => if metrics.record_count == 1u16 && metrics.accepted_count == 1u16 {
                            0;
                        } else {
                            5;
                        },
                    };
                },
            };
        },
    };
}

meta test
verb test_logical_teaching_failed_flush_preserves_dirty_state() -> Int {
    erg directory_result = flush_test_path();
    return case dat directory_result {
        Result.Err(_) => 1,
        Result.Ok(directory) => {
            erg input_result = flush_test_input_path();
            return case dat input_result {
                Result.Err(_) => {
                    flush_test_cleanup(brain_dir: abs directory);
                    2;
                },
                Result.Ok(input) => {
                    erg brain: LogicalTeachingBrain = logical_teaching_empty();
                    erg prepared = flush_test_prepare(brain: ins brain, brain_dir: abs directory);
                    if prepared != 0 {
                        remove_file(path: abs input);
                        flush_test_cleanup(brain_dir: abs directory);
                        return 3;
                    }
                    erg before: u8 = shard_cache_dirty_count(cache: abs brain.logical.cache);
                    erg result = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs input);
                    erg after: u8 = shard_cache_dirty_count(cache: abs brain.logical.cache);
                    remove_file(path: abs input);
                    flush_test_cleanup(brain_dir: abs directory);
                    return case dat result {
                        Result.Ok(_) => 4,
                        Result.Err(_) => if before > 0u8 && before == after {
                            0;
                        } else {
                            5;
                        },
                    };
                },
            };
        },
    };
}

meta test
verb test_logical_teaching_keeps_cache_bounded_for_published_shards() -> Int {
    erg directory_result = flush_test_path();
    return case dat directory_result {
        Result.Err(_) => 1,
        Result.Ok(directory) => {
            erg brain: LogicalTeachingBrain = logical_teaching_empty();
            erg prepared = flush_test_prepare(brain: ins brain, brain_dir: abs directory);
            if prepared != 0 {
                flush_test_cleanup(brain_dir: abs directory);
                return 2;
            }
            erg first_flush = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs directory);
            erg first_failed: Bool = case dat first_flush {
                Result.Err(_) => true,
                Result.Ok(_) => false,
            };
            if first_failed {
                flush_test_cleanup(brain_dir: abs directory);
                return 3;
            }
            for erg seed_offset: u32 in 3u32 .. 13u32 {
                erg seed: u32 = 50000u32 + (seed_offset * 1000u32);
                if !flush_test_teach_seed(brain: ins brain, seed: erg seed) {
                    flush_test_cleanup(brain_dir: abs directory);
                    return 4;
                }
                if (seed_offset - 2u32) % 4u32 == 0u32 {
                    erg checkpoint = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs directory);
                    case dat checkpoint {
                        Result.Err(_) => {
                            flush_test_cleanup(brain_dir: abs directory);
                            return 5;
                        },
                        Result.Ok(_) => {},
                    };
                }
            }
            erg published = logical_teaching_flush_dirty_residents(brain: ins brain, brain_dir: abs directory);
            erg publish_failed: Bool = case dat published {
                Result.Err(_) => true,
                Result.Ok(_) => false,
            };
            if publish_failed {
                flush_test_cleanup(brain_dir: abs directory);
                return 6;
            }
            if brain.logical.shard_count != 5u32 {
                flush_test_cleanup(brain_dir: abs directory);
                return 7;
            }
            if shard_cache_resident_count(cache: abs brain.logical.cache) > BRAIN_LOGICAL_MAX_RESIDENT_SHARDS as u8 {
                flush_test_cleanup(brain_dir: abs directory);
                return 8;
            }
            erg recovered: LogicalTeachingBrain = logical_teaching_empty();
            erg loaded = logical_teaching_load_generation(brain: ins recovered, brain_dir: abs directory);
            flush_test_cleanup(brain_dir: abs directory);
            return case dat loaded {
                Result.Err(_) => 9,
                Result.Ok(resident) => if recovered.logical.shard_count == 5u32 && resident == 4 {
                    0;
                } else {
                    10;
                },
            };
        },
    };
}

meta test
verb test_aux_snapshot_attached_free_link_bytes() -> Int {
    erg snapshot = diagnostic_attached_snapshot();
    if snapshot.records[76u32] != 2u8 || snapshot.records[77u32] != 0u8 || snapshot.records[78u32] != 0u8 || snapshot.records[79u32] != 0u8 {
        return 1;
    }
    if snapshot.records[316u32] != 255u8 || snapshot.records[317u32] != 255u8 || snapshot.records[318u32] != 255u8 || snapshot.records[319u32] != 255u8 {
        return 1;
    }
    return 0;
}

meta test
verb test_aux_snapshot_rejection_preserves_live_state() -> Int {
    erg source_table: AuxAxonTable[64] = AuxAxonTable[64] {source_to_record: Array[u16, 64](
    ), records: Array[AuxAxonRecord, 8](), free_list_head: 0u32, active_count: 0u32};
    initialize_diagnostic_auxiliary_table(table: ins source_table);
    erg snapshot = empty_diagnostic_snapshot();
    serialize_auxiliary_snapshot(snapshot: ins snapshot, table: abs source_table);
    snapshot.records[35u32] += 1u8;
    erg live_table: AuxAxonTable[64] = AuxAxonTable[64] {source_to_record: Array[u16, 64](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    aux_table_init(table: ins live_table);
    if restore_auxiliary_snapshot(table: ins live_table, snapshot: abs snapshot) {
        return 1;
    }
    if live_table.active_count != 0u32 || live_table.free_list_head != 0u32 || live_table.source_to_record[3u32] != AUX_AXON_INVALID_ID {
        return 1;
    }
    return 0;
}

meta test
verb test_aux_snapshot_validation_rejects_free_list_cycle() -> Int {
    erg snapshot = diagnostic_attached_snapshot();
    snapshot.records[76u32] = 1u8;
    snapshot.records[77u32] = 0u8;
    snapshot.records[78u32] = 0u8;
    snapshot.records[79u32] = 0u8;
    snapshot.checksum = diagnostic_snapshot_checksum(snapshot: abs snapshot);
    if auxiliary_snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    return 0;
}

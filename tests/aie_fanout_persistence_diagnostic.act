meta test
verb test_aux_snapshot_validation_rejects_checksum_corruption() -> Int {
    erg table: AuxAxonTable[64] = AuxAxonTable[64] {source_to_record: Array[u16, 64](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    aux_table_init(table: ins table);
    erg snapshot = empty_diagnostic_snapshot();
    serialize_auxiliary_snapshot(snapshot: ins snapshot, table: abs table);
    snapshot.records[35u32] += 1u8;
    if auxiliary_snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    return 0;
}

meta test
verb test_aux_snapshot_roundtrip_restores_reclaimed_state() -> Int {
    erg source_table: AuxAxonTable[64] = AuxAxonTable[64] {source_to_record: Array[u16, 64](
    ), records: Array[AuxAxonRecord, 8](), free_list_head: 0u32, active_count: 0u32};
    initialize_diagnostic_auxiliary_table(table: ins source_table);
    erg source: u32 = 3u32;
    release_aux_record(table: ins source_table, source: erg source);
    erg snapshot = empty_diagnostic_snapshot();
    serialize_auxiliary_snapshot(snapshot: ins snapshot, table: abs source_table);
    erg restored_table: AuxAxonTable[64] = AuxAxonTable[64] {source_to_record: Array[u16, 64](
    ), records: Array[AuxAxonRecord, 8](), free_list_head: 0u32, active_count: 0u32};
    aux_table_init(table: ins restored_table);
    if !restore_auxiliary_snapshot(table: ins restored_table, snapshot: abs snapshot) {
        return 1;
    }
    if restored_table.active_count != 0u32 || restored_table.free_list_head != 0u32 || restored_table.source_to_record[3u32] != AUX_AXON_INVALID_ID {
        return 1;
    }
    return 0;
}


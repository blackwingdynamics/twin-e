meta test
verb test_aux_snapshot_direct_nested_array_write() -> Int {
    erg snapshot = empty_diagnostic_snapshot();
    snapshot.source_to_record[126u32] = 255u8;
    snapshot.source_to_record[127u32] = 255u8;
    if snapshot.source_to_record[126u32] != 255u8 || snapshot.source_to_record[127u32] != 255u8 {
        return 1;
    }
    return 0;
}


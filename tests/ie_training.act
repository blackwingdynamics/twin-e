"""Acceptance tests for bounded training input admission."""
import ie;

import tokenizer;

import config;

meta test
verb test_training_input_accepts_valid_sequence() -> Int {
    erg text: String = "Hello";
    erg sequence: TokenSequence = tokenize_string(text: abs text);
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Ok(length) => if length == 5 {
            0;
        } else {
            1;
        },
        Result.Err(_) => 1,
    };
}

meta test
verb test_training_input_rejects_empty_sequence() -> Int {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 0u32, valid: true};
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Err(error) => case error {
            TrainingInputError.EmptySequence => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_training_input_rejects_oversized_sequence() -> Int {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 257u32, valid: true};
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Err(error) => case error {
            TrainingInputError.TooManyEvents => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_training_sequence_creates_context_bindings_and_paths() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg text: String = "AB";
    erg sequence: TokenSequence = tokenize_string(text: abs text);
    erg trained = train_token_sequence(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs sequence
    );
    return case dat trained {
        Result.Err(_) => 1,
        Result.Ok(metrics) => if metrics.processed_events == 2u32 && metrics.allocated_columns == 2u32 && metrics.reinforced_transitions == 2u32 && metrics.active_bindings == 2u32 && fabric.active_count == 3u32 {
            0;
        } else {
            1;
        },
    };
}

verb empty_test_vocabulary() -> BpeVocabulary {
    erg rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    erg records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    return BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 0u32, rules: rules, token_count: 0u32, tokens: records};
}

verb recall_restored_training(abs snapshot: TextSnapshot) -> Bool {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    if !deserialize_text_snapshot(
        fabric: ins fabric,
        bindings: ins bindings,
        snapshot: abs snapshot
    ) {
        return false;
    }
    erg prompt: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 1u32, valid: true};
    prompt.tokens[0u32] = Token {id: 65u32, byte_offset: 0u32, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    erg vocabulary: BpeVocabulary = empty_test_vocabulary();
    erg limit: u32 = 1u32;
    erg result: GenerationResult = generate_associative(
        fabric: ins fabric,
        bindings: abs bindings,
        prompt: abs prompt,
        vocabulary: abs vocabulary,
        max_tokens: erg limit
    );
    return result.valid && result.generated_count == 1u32 && result.tokens.tokens[0u32].id == 66u32;
}

meta test
verb test_training_recall_survives_snapshot_reload() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg text: String = "AB";
    erg sequence: TokenSequence = tokenize_string(text: abs text);
    erg trained = train_token_sequence(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs sequence
    );
    erg trained_ok: Bool = false;
    case dat trained {
        Result.Err(_) => {},
        Result.Ok(metrics) => {
            if metrics.processed_events == 2u32 && metrics.active_bindings == 2u32 {
                trained_ok = true;
            }
        },
    };
    if !trained_ok {
        return 1;
    }
    erg snapshot: TextSnapshot = serialize_text_snapshot(fabric: abs fabric, bindings: abs bindings);
    if !recall_restored_training(snapshot: abs snapshot) {
        return 1;
    }
    return 0;
}

verb bind_competing_token(
    ins bindings: Array[TokenBinding, 64],
    erg slot: u32,
    erg previous_token_id: u32,
    erg token_id: u32
) -> Bool {
    erg context: u64 = context_key(previous_token_id: erg previous_token_id, token_id: erg token_id);
    return bind_token_context(
        bindings: ins bindings,
        slot: erg slot,
        token_id: erg token_id,
        context_key: erg context
    );
}

verb bind_competing_successors(
    ins bindings: Array[TokenBinding, 64],
    erg source: u32,
    erg lower: u32,
    erg higher: u32
) -> Bool {
    erg bos: u32 = BPE_BOS_TOKEN_ID;
    erg current: u32 = 65u32;
    erg lower_token: u32 = 66u32;
    erg higher_token: u32 = 67u32;
    return bind_competing_token(
        bindings: ins bindings,
        slot: erg source,
        previous_token_id: erg bos,
        token_id: erg current
    ) && bind_competing_token(
        bindings: ins bindings,
        slot: erg lower,
        previous_token_id: erg current,
        token_id: erg lower_token
    ) && bind_competing_token(
        bindings: ins bindings,
        slot: erg higher,
        previous_token_id: erg current,
        token_id: erg higher_token
    );
}

verb configure_competing_successors(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    erg source: u32,
    erg lower: u32,
    erg higher: u32
) -> Bool {
    fabric.columns[source].axons[0u32] = higher;
    fabric.columns[source].axons[1u32] = lower;
    fabric.columns[lower].myelination = 4u8;
    fabric.columns[higher].myelination = 4u8;
    return bind_competing_successors(
        bindings: ins bindings,
        source: erg source,
        lower: erg lower,
        higher: erg higher
    );
}

verb prepare_competing_successors(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Bool {
    erg source: u32 = allocate_column_index(fabric: ins fabric);
    erg lower: u32 = allocate_column_index(fabric: ins fabric);
    erg higher: u32 = allocate_column_index(fabric: ins fabric);
    if source == NULL_INDEX || lower == NULL_INDEX || higher == NULL_INDEX {
        return false;
    }
    return configure_competing_successors(
        fabric: ins fabric,
        bindings: ins bindings,
        source: erg source,
        lower: erg lower,
        higher: erg higher
    );
}

meta test
verb test_training_competing_successors_use_lowest_index_on_tie() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    if !prepare_competing_successors(fabric: ins fabric, bindings: ins bindings) {
        return 1;
    }
    erg current: u32 = 65u32;
    erg lower_token: u32 = 66u32;
    erg prompt: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 1u32, valid: true};
    prompt.tokens[0u32] = Token {id: current, byte_offset: 0u32, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    erg vocabulary: BpeVocabulary = empty_test_vocabulary();
    erg limit: u32 = 1u32;
    erg result: GenerationResult = generate_associative(
        fabric: ins fabric,
        bindings: abs bindings,
        prompt: abs prompt,
        vocabulary: abs vocabulary,
        max_tokens: erg limit
    );
    if result.generated_count == 1u32 && result.tokens.tokens[0u32].id == lower_token {
        return 0;
    }
    return 1;
}

verb bind_false_identity_successor(
    ins bindings: Array[TokenBinding, 64],
    erg source: u32,
    erg false_candidate: u32,
    erg valid_candidate: u32
) -> Bool {
    erg bos: u32 = BPE_BOS_TOKEN_ID;
    erg current: u32 = 65u32;
    erg false_token: u32 = 66u32;
    erg valid_token: u32 = 67u32;
    erg wrong_previous: u32 = 999u32;
    return bind_competing_token(
        bindings: ins bindings,
        slot: erg source,
        previous_token_id: erg bos,
        token_id: erg current
    ) && bind_competing_token(
        bindings: ins bindings,
        slot: erg false_candidate,
        previous_token_id: erg wrong_previous,
        token_id: erg false_token
    ) && bind_competing_token(
        bindings: ins bindings,
        slot: erg valid_candidate,
        previous_token_id: erg current,
        token_id: erg valid_token
    );
}

verb prepare_false_identity_successor(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Bool {
    erg source: u32 = allocate_column_index(fabric: ins fabric);
    erg false_candidate: u32 = allocate_column_index(fabric: ins fabric);
    erg valid_candidate: u32 = allocate_column_index(fabric: ins fabric);
    if source == NULL_INDEX || false_candidate == NULL_INDEX || valid_candidate == NULL_INDEX {
        return false;
    }
    fabric.columns[source].axons[0u32] = false_candidate;
    fabric.columns[source].axons[1u32] = valid_candidate;
    fabric.columns[false_candidate].myelination = 9u8;
    fabric.columns[valid_candidate].myelination = 3u8;
    return bind_false_identity_successor(
        bindings: ins bindings,
        source: erg source,
        false_candidate: erg false_candidate,
        valid_candidate: erg valid_candidate
    );
}

meta test
verb test_training_rejects_stronger_false_identity_candidate() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    if !prepare_false_identity_successor(fabric: ins fabric, bindings: ins bindings) {
        return 1;
    }
    erg prompt: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 1u32, valid: true};
    prompt.tokens[0u32] = Token {id: 65u32, byte_offset: 0u32, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    erg vocabulary: BpeVocabulary = empty_test_vocabulary();
    erg limit: u32 = 1u32;
    erg result: GenerationResult = generate_associative(
        fabric: ins fabric,
        bindings: abs bindings,
        prompt: abs prompt,
        vocabulary: abs vocabulary,
        max_tokens: erg limit
    );
    if result.generated_count == 1u32 && result.tokens.tokens[0u32].id == 67u32 {
        return 0;
    }
    return 1;
}

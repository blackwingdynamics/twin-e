"""Regression tests for bounded reuse of repeated byte fallback contexts."""
import ie;

import tokenizer;

verb repeated_fallback_sequence() -> TokenSequence {
    erg input: Buffer = Buffer[32];
    for erg index: u32 in 0u32 .. 32u32 {
        input[index as Usize] = 255u8;
    }
    erg input_length: u32 = 32u32;
    erg sequence: TokenSequence = tokenize_bytes(input: abs input, input_length: erg input_length);
    erg rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    erg rule_count: u32 = 0u32;
    return bpe_encode(
        input: abs sequence,
        rules: abs rules,
        rule_count: erg rule_count
    );
}

verb train_or_empty(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64],
    abs sequence: TokenSequence
) -> TrainingMetrics {
    erg result = train_token_sequence(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs sequence
    );
    return case dat result {
        Result.Err(_) => TrainingMetrics {processed_events: 0u32, allocated_columns: 0u32, reinforced_transitions: 0u32, active_bindings: 0u32},
        Result.Ok(metrics) => metrics,
    };
}

meta test
verb test_repeated_byte_fallback_reuses_context_bindings() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg encoded: TokenSequence = repeated_fallback_sequence();
    erg first_metrics = train_or_empty(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs encoded
    );
    erg second_metrics = train_or_empty(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs encoded
    );
    if first_metrics.allocated_columns > 0u32 && first_metrics.active_bindings > 0u32 && second_metrics.allocated_columns == 0u32 && second_metrics.active_bindings == first_metrics.active_bindings {
        return 0;
    }
    return 1;
}

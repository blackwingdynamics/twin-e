"""Acceptance tests for bounded offline teaching-file ingestion."""
import aie;

import config;

import std::fs;

import std::path;

import teaching;

verb file_test_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 102u8);
    append(raw, 105u8);
    append(raw, 108u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, suffix);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb file_append_u16(ins output: Buffer, erg value: u16) {
    append(output, value as u8);
    append(output, (value >> 8u16) as u8);
}

verb valid_teaching_file() -> Buffer {
    erg output: Buffer = Buffer[0];
    append(output, 84u8);
    append(output, 87u8);
    append(output, 70u8);
    append(output, 1u8);
    append(output, 2u8);
    erg first_length: u16 = 2u16;
    file_append_u16(output: ins output, value: erg first_length);
    append(output, 65u8);
    append(output, 66u8);
    erg second_length: u16 = 2u16;
    file_append_u16(output: ins output, value: erg second_length);
    append(output, 67u8);
    append(output, 68u8);
    return output;
}

verb truncated_teaching_file() -> Buffer {
    erg output: Buffer = Buffer[0];
    append(output, 84u8);
    append(output, 87u8);
    append(output, 70u8);
    append(output, 1u8);
    append(output, 1u8);
    erg length: u16 = 3u16;
    file_append_u16(output: ins output, value: erg length);
    append(output, 65u8);
    append(output, 66u8);
    return output;
}

verb oversized_teaching_file() -> Buffer {
    erg output: Buffer = Buffer[0];
    for erg index: u32 in 0u32 .. TEACHING_FILE_MAX_BYTES {
        append(output, 0u8);
    }
    append(output, 0u8);
    return output;
}

verb invalid_header_teaching_file() -> Buffer {
    erg output: Buffer = Buffer[0];
    append(output, 0u8);
    append(output, 0u8);
    append(output, 0u8);
    append(output, 0u8);
    append(output, 1u8);
    return output;
}

verb teaching_file_fabric() -> CorticalFabric[64] {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    return fabric;
}

verb write_teaching_file(abs path: Path, abs contents: Buffer) -> Bool {
    erg written = write_file(path: abs path, contents: abs contents);
    return case dat written {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb cleanup_teaching_file(dat path: Path) {
    remove_file(path: abs path);
    drop(path);
}

verb run_teaching_file_fixture(
    erg suffix: u8,
    dat contents: Buffer,
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg path_result = file_test_path(suffix: erg suffix);
    case dat path_result {
        Result.Err(_) => {
            drop(contents);
            return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.IoFailure);
        },
        Result.Ok(path) => {
            erg written = write_teaching_file(path: abs path, contents: abs contents);
            drop(contents);
            if !written {
                cleanup_teaching_file(path: dat path);
                return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.IoFailure);
            }
            erg result = teach_file(
                fabric: ins fabric,
                bindings: ins bindings,
                path: abs path
            );
            cleanup_teaching_file(path: dat path);
            return result;
        },
    };
    return Result[TeachingFileMetrics, TeachingFileError].Err(TeachingFileError.IoFailure);
}

verb run_valid_teaching_file(
    erg suffix: u8,
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg contents: Buffer = valid_teaching_file();
    return run_teaching_file_fixture(
        suffix: erg suffix,
        contents: dat contents,
        fabric: ins fabric,
        bindings: ins bindings
    );
}

verb replay_teaching_file(erg suffix: u8) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg fabric = teaching_file_fabric();
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    return run_valid_teaching_file(
        suffix: erg suffix,
        fabric: ins fabric,
        bindings: ins bindings
    );
}

verb run_invalid_header_teaching_file(
    erg suffix: u8,
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Result[TeachingFileMetrics, TeachingFileError] {
    erg contents: Buffer = invalid_header_teaching_file();
    return run_teaching_file_fixture(
        suffix: erg suffix,
        contents: dat contents,
        fabric: ins fabric,
        bindings: ins bindings
    );
}

meta test
verb test_teaching_file_teaches_records_in_order() -> Int {
    erg fabric = teaching_file_fabric();
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg suffix: u8 = 1u8;
    erg result = run_valid_teaching_file(
        suffix: erg suffix,
        fabric: ins fabric,
        bindings: ins bindings
    );
    return case dat result {
        Result.Err(_) => 1,
        Result.Ok(metrics) => if metrics.record_count == 2u16 && metrics.accepted_count == 2u16 && metrics.processed_events == 4u32 {
            0;
        } else {
            1;
        },
    };
}

meta test
verb test_teaching_file_rejects_truncated_record_without_mutation() -> Int {
    erg contents: Buffer = truncated_teaching_file();
    erg fabric = teaching_file_fabric();
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg suffix: u8 = 2u8;
    erg before: u32 = fabric.active_count;
    erg result = run_teaching_file_fixture(
        suffix: erg suffix,
        contents: dat contents,
        fabric: ins fabric,
        bindings: ins bindings
    );
    return case dat result {
        Result.Err(error) => case error {
            TeachingFileError.TruncatedRecord => if fabric.active_count == before {
                0;
            } else {
                1;
            },
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_teaching_file_rejects_oversized_record_without_mutation() -> Int {
    erg contents: Buffer = oversized_teaching_file();
    erg fabric = teaching_file_fabric();
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg suffix: u8 = 3u8;
    erg result = run_teaching_file_fixture(
        suffix: erg suffix,
        contents: dat contents,
        fabric: ins fabric,
        bindings: ins bindings
    );
    return case dat result {
        Result.Err(error) => case error {
            TeachingFileError.FileTooLarge => if fabric.active_count == 0u32 {
                0;
            } else {
                1;
            },
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_teaching_file_rejects_invalid_header() -> Int {
    erg fabric = teaching_file_fabric();
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    erg suffix: u8 = 7u8;
    erg result = run_invalid_header_teaching_file(
        suffix: erg suffix,
        fabric: ins fabric,
        bindings: ins bindings
    );
    return case dat result {
        Result.Err(error) => case error {
            TeachingFileError.InvalidHeader => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_teaching_file_replay_is_deterministic() -> Int {
    erg first_suffix: u8 = 4u8;
    erg first = replay_teaching_file(suffix: erg first_suffix);
    erg second = replay_teaching_file(suffix: erg first_suffix);
    erg first_events: u32 = 0u32;
    case dat first {
        Result.Err(_) => {
            return 1;
        },
        Result.Ok(metrics) => {
            first_events = metrics.processed_events;
        },
    };
    return case dat second {
        Result.Err(_) => 1,
        Result.Ok(metrics) => if first_events == metrics.processed_events {
            0;
        } else {
            1;
        },
    };
}

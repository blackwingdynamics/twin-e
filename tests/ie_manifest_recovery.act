import ie;

import std::fs;

import std::path;

verb recovery_test_path(erg suffix: u8) -> Result[Path, PathError] {
    erg raw: Buffer = Buffer[0];
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 109u8);
    append(raw, 112u8);
    append(raw, 47u8);
    append(raw, 116u8);
    append(raw, 116u8);
    append(raw, 119u8);
    append(raw, 105u8);
    append(raw, 110u8);
    append(raw, 45u8);
    append(raw, 101u8);
    append(raw, 45u8);
    append(raw, 114u8);
    append(raw, 101u8);
    append(raw, 99u8);
    append(raw, 111u8);
    append(raw, 118u8);
    append(raw, 101u8);
    append(raw, 114u8);
    append(raw, 121u8);
    append(raw, 45u8);
    append(raw, suffix);
    append(raw, 0u8);
    return path_from_ascii(storage: dat raw);
}

verb recovery_append_u32(ins output: Buffer, abs value: u32) {
    append(output, (value & 255u32) as u8);
    append(output, ((value / 256u32) & 255u32) as u8);
    append(output, ((value / 65536u32) & 255u32) as u8);
    append(output, ((value / 16777216u32) & 255u32) as u8);
}

verb recovery_append_u64(ins output: Buffer, abs value: u64) {
    erg low: u32 = (value & 4294967295u64) as u32;
    erg high: u32 = (value / 4294967296u64) as u32;
    recovery_append_u32(output: ins output, value: abs low);
    recovery_append_u32(output: ins output, value: abs high);
}

verb recovery_zero_buffer(erg length: u32) -> Buffer {
    erg output: Buffer = Buffer[0];
    erg index: u32 = 0u32;
    loop {
        if index >= length {
            break;
        }
        append(output, 0u8);
        index += 1u32;
    }
    return output;
}

verb recovery_descriptor(abs checksum: u64) -> Buffer {
    erg descriptor: Buffer = Buffer[0];
    recovery_append_u32(output: ins descriptor, value: abs 0u32);
    recovery_append_u32(output: ins descriptor, value: abs 0u32);
    recovery_append_u32(output: ins descriptor, value: abs 2u32);
    recovery_append_u32(output: ins descriptor, value: abs 48u32);
    recovery_append_u32(output: ins descriptor, value: abs 128u32);
    recovery_append_u32(output: ins descriptor, value: abs 176u32);
    recovery_append_u32(output: ins descriptor, value: abs 48u32);
    recovery_append_u32(output: ins descriptor, value: abs 224u32);
    recovery_append_u32(output: ins descriptor, value: abs BRAIN_AUXILIARY_PAYLOAD_BYTES);
    recovery_append_u64(output: ins descriptor, value: abs checksum);
    recovery_append_u32(output: ins descriptor, value: abs 1u32);
    return descriptor;
}

verb recovery_write_shard(abs path: Path) -> Result[u64, IoError] {
    erg payload_length: u32 = 128u32;
    erg bindings_length: u32 = 48u32;
    erg auxiliary_length: u32 = BRAIN_AUXILIARY_PAYLOAD_BYTES;
    erg payload: Buffer = recovery_zero_buffer(length: erg payload_length);
    erg bindings: Buffer = recovery_zero_buffer(length: erg bindings_length);
    erg auxiliary: Buffer = recovery_zero_buffer(length: erg auxiliary_length);
    erg shard_id: u32 = 0u32;
    erg first_column_index: u32 = 0u32;
    erg column_count: u32 = 2u32;
    erg written = write_dynamic_shard_with_bindings_and_auxiliary(
        path: abs path,
        shard_id: erg shard_id,
        first_column_index: erg first_column_index,
        column_count: erg column_count,
        payload: abs payload,
        bindings: abs bindings,
        auxiliary: abs auxiliary
    );
    return case dat written {
        Result.Err(error) => Err(error),
        Result.Ok(_) => dynamic_shard_file_checksum(path: abs path),
    };
}

verb recovery_write_manifest(
    abs path: Path,
    erg checksum: u64,
    erg generation: u64
) -> Result[Int, IoError] {
    erg descriptor: Buffer = recovery_descriptor(checksum: abs checksum);
    erg active_count: u32 = 2u32;
    erg free_list_head: u32 = NULL_INDEX;
    erg total_column_count: u32 = 2u32;
    erg shard_count: u32 = 1u32;
    return write_manifest_dynamic(
        path: abs path,
        generation: erg generation,
        active_count: erg active_count,
        free_list_head: erg free_list_head,
        total_column_count: erg total_column_count,
        shard_count: erg shard_count,
        descriptors: abs descriptor
    );
}

verb recovery_validate_manifest(abs manifest_path: Path, abs shard_path: Path) -> Int {
    erg loaded_manifest = read_to_bytes(path: abs manifest_path);
    return case dat loaded_manifest {
        Result.Err(_) => 1,
        Result.Ok(manifest) => {
            erg loaded_shard = read_to_bytes(path: abs shard_path);
            return case dat loaded_shard {
                Result.Err(_) => {
                    drop(manifest);
                    2;
                },
                Result.Ok(shard) => {
                    erg descriptor_index: u32 = 0u32;
                    erg validated = validate_dynamic_manifest_binding_shard(
                        manifest: abs manifest,
                        shard: abs shard,
                        descriptor_index: erg descriptor_index
                    );
                    drop(manifest);
                    return case dat validated {
                        Result.Err(_) => 3,
                        Result.Ok(_) => 0,
                    };
                },
            };
        },
    };
}

verb corrupt_manifest_file(abs manifest_path: Path) -> Int {
    erg loaded = read_to_bytes(path: abs manifest_path);
    return case dat loaded {
        Result.Err(_) => 17,
        Result.Ok(manifest) => {
            manifest[12u32] = 255u8;
            erg written = write_file(path: abs manifest_path, contents: abs manifest);
            drop(manifest);
            return case dat written {
                Result.Err(_) => 18,
                Result.Ok(_) => 0,
            };
        },
    };
}

verb verify_restart_recovery(abs primary_path: Path, abs fallback_path: Path) -> Int {
    erg corrupted = corrupt_manifest_file(manifest_path: abs primary_path);
    if corrupted != 0 {
        return corrupted;
    }
    erg selected = select_dynamic_manifest_generation(primary: abs primary_path, fallback: abs fallback_path);
    return case dat selected {
        Result.Err(_) => 21,
        Result.Ok(selection) => if selection.slot == 1u8 && selection.generation == 1u64 {
            0;
        } else {
            22;
        },
    };
}

verb recovery_validate_and_select(
    abs primary_path: Path,
    abs fallback_path: Path,
    abs shard_path: Path
) -> Int {
    erg valid = recovery_validate_manifest(manifest_path: abs fallback_path, shard_path: abs shard_path);
    if valid != 0 {
        return valid;
    }
    erg corrupt = corrupt_manifest_file(manifest_path: abs primary_path);
    return if corrupt == 0 {
        verify_restart_recovery(primary_path: abs primary_path, fallback_path: abs fallback_path);
    } else {
        corrupt;
    };
}

verb recovery_write_primary(abs primary_path: Path, erg checksum: u64) -> Result[Int, IoError] {
    erg primary_generation: u64 = 2u64;
    return recovery_write_manifest(
        path: abs primary_path,
        checksum: erg checksum,
        generation: erg primary_generation
    );
}

verb recovery_publish_and_select(
    abs primary_path: Path,
    abs fallback_path: Path,
    abs shard_path: Path,
    erg checksum: u64
) -> Int {
    erg fallback_generation: u64 = 1u64;
    erg fallback_written = recovery_write_manifest(
        path: abs fallback_path,
        checksum: erg checksum,
        generation: erg fallback_generation
    );
    return case dat fallback_written {
        Result.Err(_) => 8,
        Result.Ok(_) => {
            erg primary_written = recovery_write_primary(primary_path: abs primary_path, checksum: erg checksum);
            return case dat primary_written {
                Result.Err(_) => 9,
                Result.Ok(_) => recovery_validate_and_select(
                    primary_path: abs primary_path,
                    fallback_path: abs fallback_path,
                    shard_path: abs shard_path
                ),
            };
        },
    };
}

verb recovery_run_with_paths(
    abs shard_path: Path,
    dat fallback_path: Path,
    erg checksum: u64
) -> Int {
    erg primary_suffix: u8 = 3u8;
    erg primary_result: Result[Path,PathError] = recovery_test_path(suffix: erg primary_suffix);
    case dat primary_result {
        Result.Err(_) => {
            remove_file(path: abs fallback_path);
            remove_file(path: abs shard_path);
            return 7;
        },
        Result.Ok(primary_path) => {
            erg result = recovery_publish_and_select(
                primary_path: abs primary_path,
                fallback_path: abs fallback_path,
                shard_path: abs shard_path,
                checksum: erg checksum
            );
            remove_file(path: abs primary_path);
            remove_file(path: abs fallback_path);
            remove_file(path: abs shard_path);
            return result;
        },
    };
    return 7;
}

verb recovery_drop_shard(dat shard_path: Path) -> Int {
    drop(shard_path);
    return 5;
}

verb recovery_run_with_shard(dat shard_path: Path) -> Int {
    erg checksum_result = recovery_write_shard(path: abs shard_path);
    return case dat checksum_result {
        Result.Err(_) => recovery_drop_shard(shard_path: dat shard_path),
        Result.Ok(checksum) => {
            erg fallback_suffix: u8 = 2u8;
            erg fallback_result: Result[Path,PathError] = recovery_test_path(suffix: erg fallback_suffix);
            case dat fallback_result {
                Result.Err(_) => {
                    remove_file(path: abs shard_path);
                    drop(shard_path);
                    return 6;
                },
                Result.Ok(fallback_path) => {
                    erg result = recovery_run_with_paths(
                        shard_path: abs shard_path,
                        fallback_path: dat fallback_path,
                        checksum: erg checksum
                    );
                    drop(shard_path);
                    return result;
                },
            };
            return 6;
        },
    };
}

meta test
verb test_restart_recovery_selects_complete_auxiliary_generation() -> Int {
    erg shard_suffix: u8 = 1u8;
    erg shard_result = recovery_test_path(suffix: erg shard_suffix);
    return case dat shard_result {
        Result.Err(_) => 4,
        Result.Ok(shard_path) => recovery_run_with_shard(shard_path: dat shard_path),
    };
}

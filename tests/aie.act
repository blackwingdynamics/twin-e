meta limitless("file")


"""Deterministic AIE behavior tests returning zero on success. The suite
covers layout, runtime, persistence, and the public engine API."""
import aie;

import config;

meta test
verb test_package_config() -> Int {
    if DEFAULT_THRESHOLD == 30u8 && DECAY_IDLE_LIMIT == 240u8 && BRAIN_VERSION == 1u16 {
        return 0;
    }
    return 1;
}

import config;

meta test
verb test_minicolumn_stride() -> Int {
    erg columns: Array[Minicolumn,64] = Array[Minicolumn, 64]();
    columns[0].storage[0] = 17u8;
    columns[1].storage[0] = 29u8;
    if columns[0].storage[0] == 17u8 && columns[1].storage[0] == 29u8 {
        return 0;
    }
    return 1;
}

meta test
verb test_bitwise_coincidence() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg slot: Option[u32] = allocate_column(fabric: ins fabric);
    erg index: u32 = case dat slot {
        Option.Some(value) => value,
        Option.None => {
            return 1;
        },
    };
    fabric.columns[index].threshold = 2u8;
    fabric.columns[index].coincidence_low = 3u64;
    fabric.columns[index].payload = 77u8;
    erg wave: Wavefront = Wavefront {mask_low: 3u64, mask_high: 0u64, energy: 1u8};
    erg result: Option[u8] = evaluate_minicolumn(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: index
    );
    return case dat result {
        Option.Some(payload) => case payload {
            77 => case fabric.columns[index].myelination {
                1 => 0,
                _ => 1,
            },
            _ => 1,
        },
        Option.None => 1,
    };
}

meta test
verb test_lateral_inhibition() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    erg source: Option[u32] = allocate_column(fabric: ins fabric);
    erg source_idx: u32 = case dat source {
        Option.Some(value) => value,
        Option.None => {
            return 1;
        },
    };
    fabric.columns[source_idx].threshold = 1u8;
    fabric.columns[source_idx].coincidence_low = 1u64;
    fabric.columns[source_idx].inhibitory_link = 0u32;
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    evaluate_minicolumn(
        fabric: ins fabric,
        wave: abs wave,
        target_idx: source_idx
    );
    if (fabric.columns[0].flags & FLAG_INHIBITED) != 0u8 {
        return 0;
    }
    return 1;
}

meta test
verb test_free_list_integrity() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg first: Option[u32] = allocate_column(fabric: ins fabric);
    erg second: Option[u32] = allocate_column(fabric: ins fabric);
    erg first_idx: u32 = case dat first {
        Option.Some(value) => value,
        Option.None => {
            return 1;
        },
    };
    erg second_idx: u32 = case dat second {
        Option.Some(value) => value,
        Option.None => {
            return 1;
        },
    };
    free_column(fabric: ins fabric, slot: erg first_idx);
    free_column(fabric: ins fabric, slot: erg second_idx);
    erg reused: Option[u32] = allocate_column(fabric: ins fabric);
    return case dat reused {
        Option.Some(value) => if value == second_idx {
            0;
        } else {
            1;
        },
        Option.None => 1,
    };
}

meta test
verb test_neurogenesis_and_linking() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    erg source_idx: u32 = 0u32;
    erg wave: Wavefront = Wavefront {mask_low: 9u64, mask_high: 5u64, energy: 1u8};
    erg created: Option[u32] = neurogenesis(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
    return case dat created {
        Option.Some(index) => if index == 1u32 && fabric.active_count == 2u32 {
            if fabric.columns[1].threshold == 20u8 && fabric.columns[1].coincidence_low == 9u64 && fabric.columns[1].coincidence_high == 5u64 {
                if fabric.columns[0].axon_0 == 1u32 {
                    0;
                } else {
                    1;
                };
            } else {
                1;
            };
        } else {
            1;
        },
        Option.None => 1,
    };
}

meta test
verb test_homeostatic_decay() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    fabric.columns[0].idle_ticks = 239u8;
    fabric.columns[0].myelination = 0u8;
    global_homeostatic_sweep(fabric: ins fabric);
    if fabric.active_count == 0u32 && fabric.free_list_head == 0u32 && fabric.columns[0].flags == 0u8 {
        return 0;
    }
    return 1;
}

meta limitless("verb")
meta test
verb test_forward_impulse() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    fabric.columns[0].axon_0 = 1u32;
    fabric.columns[0].axon_1 = 2u32;
    fabric.columns[0].axon_2 = 3u32;
    fabric.columns[0].axon_3 = 4u32;
    fabric.columns[0].axon_4 = 5u32;
    fabric.columns[0].axon_5 = 6u32;
    fabric.columns[0].axon_6 = 7u32;
    fabric.columns[0].axon_7 = 8u32;
    erg source_idx: u32 = 0u32;
    erg i: u32 = 1u32;
    loop {
        if i > 8u32 {
            break;
        }
        fabric.columns[i].threshold = 1u8;
        fabric.columns[i].coincidence_low = 1u64;
        i += 1u32;
    }
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg fired: Array[u32,8] = forward_impulse(
        fabric: ins fabric,
        wave: abs wave,
        source_idx: erg source_idx
    );
    if fabric.columns[1].myelination == 1u8 && fabric.columns[2].myelination == 1u8 && fabric.columns[3].myelination == 1u8 && fabric.columns[4].myelination == 1u8 && fabric.columns[5].myelination == 1u8 && fabric.columns[6].myelination == 1u8 && fabric.columns[7].myelination == 1u8 && fabric.columns[8].myelination == 1u8 && fired[0] == 1u32 && fired[1] == 2u32 && fired[2] == 3u32 && fired[3] == 4u32 && fired[4] == 5u32 && fired[5] == 6u32 && fired[6] == 7u32 && fired[7] == 8u32 {
        return 0;
    }
    return 1;
}

meta test
verb test_serialization_roundtrip() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    fabric.columns[0].payload = 91u8;
    fabric.columns[0].coincidence_low = 123u64;
    erg snapshot: FabricSnapshot = serialize_fabric(fabric: abs fabric);
    if !snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    fabric.columns[0].payload = 0u8;
    fabric.columns[0].coincidence_low = 0u64;
    fabric.free_list_head = 63u32;
    fabric.active_count = 63u32;
    erg restored: Bool = deserialize_fabric(fabric: ins fabric, snapshot: abs snapshot);
    if restored && fabric.columns[0].payload == 91u8 && fabric.columns[0].coincidence_low == 123u64 && fabric.active_count == 1u32 && fabric.free_list_head == 1u32 {
        return 0;
    }
    return 1;
}

meta test
verb test_snapshot_rejects_corrupted_headers() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    fabric.columns[0].payload = 91u8;
    erg snapshot: FabricSnapshot = serialize_fabric(fabric: abs fabric);
    snapshot.magic = 0u32;
    if snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    erg rejected_magic: Bool = deserialize_fabric(fabric: ins fabric, snapshot: abs snapshot);
    if rejected_magic {
        return 1;
    }
    snapshot = serialize_fabric(fabric: abs fabric);
    snapshot.version = 2u16;
    if snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    erg rejected_version: Bool = deserialize_fabric(fabric: ins fabric, snapshot: abs snapshot);
    if rejected_version {
        return 1;
    }
    return 0;
}

meta test
verb test_snapshot_rejects_truncated_payload() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    allocate_column(fabric: ins fabric);
    erg snapshot: FabricSnapshot = serialize_fabric(fabric: abs fabric);
    snapshot.payload_bytes = 4095u32;
    if snapshot_is_valid(snapshot: abs snapshot) {
        return 1;
    }
    erg rejected_truncated: Bool = deserialize_fabric(fabric: ins fabric, snapshot: abs snapshot);
    if rejected_truncated {

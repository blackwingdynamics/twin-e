"""Baseline test skeleton for the proposed bounded fan-out sidecar."""
import aie;

import config;

meta test
verb test_inline_fanout_contract_remains_eight_slots() -> Int {
    erg fabric: CorticalFabric[16] = CorticalFabric[16] {columns: Array[Minicolumn, 16](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg source: u32 = allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    erg first_target: u32 = 1u32;
    erg inline_slot: u32 = 0u32;
    link_axon(
        fabric: ins fabric,
        source: erg source,
        slot: erg inline_slot,
        target: erg first_target
    );
    for erg slot: u32 in 1u32 .. 8u32 {
        erg target: u32 = allocate_column_index(fabric: ins fabric);
        link_axon(
            fabric: ins fabric,
            source: erg source,
            slot: erg slot,
            target: erg target
        );
    }
    if minicolumn_size_bytes() != 64u32 {
        return 1;
    }
    if fabric.columns[source].axons[0u32] != 1u32 || fabric.columns[source].axons[7u32] != 8u32 {
        return 1;
    }
    return 0;
}

verb auxiliary_lifecycle_result(ins table: AuxAxonTable[16]) -> Int {
    erg allocated = allocate_aux_record(table: ins table);
    erg record_index: u32 = case dat allocated {
        Option.None => NULL_INDEX,
        Option.Some(value) => value,
    };
    if record_index == NULL_INDEX {
        return 1;
    }
    erg attach_source: u32 = 3u32;
    if !attach_aux_record(
        table: ins table,
        source: erg attach_source,
        record_index: erg record_index
    ) {
        return 1;
    }
    erg lookup_source: u32 = 3u32;
    if aux_record_for_source(table: abs table, source: erg lookup_source) != record_index || table.active_count != 1u32 {
        return 1;
    }
    erg release_source: u32 = 3u32;
    if !release_aux_record(table: ins table, source: erg release_source) || aux_record_for_source(
        table: abs table,
        source: erg release_source
    ) != NULL_INDEX || table.active_count != 0u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_aux_table_allocates_attaches_and_reclaims() -> Int {
    erg table: AuxAxonTable[16] = AuxAxonTable[16] {source_to_record: Array[u16, 16](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    aux_table_init(table: ins table);
    return auxiliary_lifecycle_result(table: ins table);
}

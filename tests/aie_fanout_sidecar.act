"""Baseline test skeleton for the proposed bounded fan-out sidecar."""
import aie;

import config;

meta test
verb test_inline_fanout_contract_remains_eight_slots() -> Int {
    erg fabric: CorticalFabric[16] = CorticalFabric[16] {columns: Array[Minicolumn, 16](), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    erg source: u32 = allocate_column_index(fabric: ins fabric);
    allocate_column_index(fabric: ins fabric);
    erg first_target: u32 = 1u32;
    erg inline_slot: u32 = 0u32;
    link_axon(
        fabric: ins fabric,
        source: erg source,
        slot: erg inline_slot,
        target: erg first_target
    );
    for erg slot: u32 in 1u32 .. 8u32 {
        erg target: u32 = allocate_column_index(fabric: ins fabric);
        link_axon(
            fabric: ins fabric,
            source: erg source,
            slot: erg slot,
            target: erg target
        );
    }
    if minicolumn_size_bytes() != 64u32 {
        return 1;
    }
    if fabric.columns[source].axons[0u32] != 1u32 || fabric.columns[source].axons[7u32] != 8u32 {
        return 1;
    }
    return 0;
}

verb auxiliary_lifecycle_result(ins table: AuxAxonTable[16]) -> Int {
    erg allocated = allocate_aux_record(table: ins table);
    erg record_index: u32 = case dat allocated {
        Option.None => NULL_INDEX,
        Option.Some(value) => value,
    };
    if record_index == NULL_INDEX {
        return 1;
    }
    erg attach_source: u32 = 3u32;
    if !attach_aux_record(
        table: ins table,
        source: erg attach_source,
        record_index: erg record_index
    ) {
        return 1;
    }
    erg lookup_source: u32 = 3u32;
    if aux_record_for_source(table: abs table, source: erg lookup_source) != record_index || table.active_count != 1u32 {
        return 1;
    }
    erg release_source: u32 = 3u32;
    if !release_aux_record(table: ins table, source: erg release_source) || aux_record_for_source(
        table: abs table,
        source: erg release_source
    ) != NULL_INDEX || table.active_count != 0u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_aux_table_allocates_attaches_and_reclaims() -> Int {
    erg table: AuxAxonTable[16] = AuxAxonTable[16] {source_to_record: Array[u16, 16](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    aux_table_init(table: ins table);
    return auxiliary_lifecycle_result(table: ins table);
}

verb link_one_gated_target(
    ins fabric: CorticalFabric[16],
    ins table: AuxAxonTable[16],
    erg source: u32,
    erg index: u32
) -> Bool {
    erg target: u32 = allocate_column_index(fabric: ins fabric);
    fabric.columns[target].threshold = 1u8;
    fabric.columns[target].coincidence_low = 1u64;
    if index < 8u32 {
        link_axon(
            fabric: ins fabric,
            source: erg source,
            slot: erg index,
            target: erg target
        );
        return true;
    }
    erg linked = link_aux_axon(
        fabric: ins fabric,
        table: ins table,
        source: erg source,
        target: erg target
    );
    return case dat linked {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb populate_gated_targets(
    ins fabric: CorticalFabric[16],
    ins table: AuxAxonTable[16],
    erg source: u32
) -> Bool {
    for erg index: u32 in 0u32 .. 9u32 {
        if !link_one_gated_target(
            fabric: ins fabric,
            table: ins table,
            source: erg source,
            index: erg index
        ) {
            return false;
        }
    }
    return true;
}

meta test
verb test_gated_auxiliary_step_reaches_extra_target() -> Int {
    erg fabric: CorticalFabric[16] = CorticalFabric[16] {columns: Array[Minicolumn, 16](), free_list_head: 0u32, active_count: 0u32};
    erg table: AuxAxonTable[16] = AuxAxonTable[16] {source_to_record: Array[u16, 16](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    aux_table_init(table: ins table);
    allocate_column_index(fabric: ins fabric);
    erg source: u32 = 0u32;
    if !populate_gated_targets(
        fabric: ins fabric,
        table: ins table,
        source: erg source
    ) {
        return 1;
    }
    fabric.columns[source].threshold = 1u8;
    fabric.columns[source].coincidence_low = 1u64;
    erg wave: Wavefront = Wavefront {mask_low: 1u64, mask_high: 0u64, energy: 1u8};
    erg result = step_wavefront_with_aux(
        fabric: ins fabric,
        table: abs table,
        wave: abs wave,
        source_idx: erg source
    );
    if !result.base.source_fired || result.auxiliary_count != 1u8 || result.auxiliary[0u32] == NULL_INDEX {
        return 1;
    }
    return 0;
}

verb fill_auxiliary_capacity(
    ins fabric: CorticalFabric[16],
    ins table: AuxAxonTable[16]
) -> Bool {
    for erg source: u32 in 0u32 .. AUX_AXON_CAPACITY {
        erg target: u32 = 15u32;
        erg linked = link_aux_axon(
            fabric: ins fabric,
            table: ins table,
            source: erg source,
            target: erg target
        );
        erg linked_ok: Bool = case dat linked {
            Result.Err(_) => false,
            Result.Ok(_) => true,
        };
        if !linked_ok {
            return false;
        }
    }
    return true;
}

meta test
verb test_aux_capacity_rejects_without_mutation() -> Int {
    erg fabric: CorticalFabric[16] = CorticalFabric[16] {columns: Array[Minicolumn, 16](), free_list_head: 0u32, active_count: 0u32};
    erg table: AuxAxonTable[16] = AuxAxonTable[16] {source_to_record: Array[u16, 16](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    aux_table_init(table: ins table);
    if !fill_auxiliary_capacity(fabric: ins fabric, table: ins table) || table.active_count != AUX_AXON_CAPACITY {
        return 1;
    }
    erg source: u32 = 8u32;
    erg target: u32 = 14u32;
    erg rejected = link_aux_axon(
        fabric: ins fabric,
        table: ins table,
        source: erg source,
        target: erg target
    );
    erg rejected_ok: Bool = case dat rejected {
        Result.Err(_) => true,
        Result.Ok(_) => false,
    };
    if !rejected_ok || table.active_count != AUX_AXON_CAPACITY || table.source_to_record[8u32] != AUX_AXON_INVALID_ID {
        return 1;
    }
    return 0;
}

verb create_reclamation_link(
    ins fabric: CorticalFabric[16],
    ins table: AuxAxonTable[16]
) -> Bool {
    erg source: u32 = 2u32;
    erg target: u32 = 3u32;
    erg linked = link_aux_axon(
        fabric: ins fabric,
        table: ins table,
        source: erg source,
        target: erg target
    );
    erg linked_ok: Bool = case dat linked {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
    return linked_ok;
}

verb paired_reclamation_result(
    ins fabric: CorticalFabric[16],
    ins table: AuxAxonTable[16]
) -> Int {
    if !create_reclamation_link(fabric: ins fabric, table: ins table) || (fabric.columns[2u32].flags & FLAG_HAS_AUX) == 0u8 {
        return 1;
    }
    erg release_source: u32 = 2u32;
    if !release_aux_link(
        fabric: ins fabric,
        table: ins table,
        source: erg release_source
    ) || table.active_count != 0u32 || (fabric.columns[2u32].flags & FLAG_HAS_AUX) != 0u8 {
        return 1;
    }
    erg reused = allocate_aux_record(table: ins table);
    return case dat reused {
        Option.Some(_) => 0,
        Option.None => 1,
    };
}

meta test
verb test_paired_aux_reclamation_clears_marker_and_reuses_record() -> Int {
    erg fabric: CorticalFabric[16] = CorticalFabric[16] {columns: Array[Minicolumn, 16](), free_list_head: 0u32, active_count: 0u32};
    erg table: AuxAxonTable[16] = AuxAxonTable[16] {source_to_record: Array[u16, 16](), records: Array[AuxAxonRecord, 8](
    ), free_list_head: 0u32, active_count: 0u32};
    fabric_init(fabric: ins fabric);
    aux_table_init(table: ins table);
    return paired_reclamation_result(fabric: ins fabric, table: ins table);
}

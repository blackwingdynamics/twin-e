"""Regression tests for bounded raw-byte fallback tokenization."""
import tokenizer;

meta test
verb test_byte_fallback_preserves_repeated_bytes() -> Int {
    erg repeated: Buffer = Buffer[8];
    erg repeated_index: u32 = 0u32;
    loop {
        if repeated_index >= 8u32 {
            break;
        }
        repeated[repeated_index as Usize] = 65u8;
        repeated_index += 1u32;
    }
    erg repeated_length: u32 = 8u32;
    erg repeated_sequence: TokenSequence = tokenize_bytes(input: abs repeated, input_length: erg repeated_length);
    if !repeated_sequence.valid || repeated_sequence.length != 8u32 {
        return 1;
    }
    if repeated_sequence.tokens[7u32].id != 65u32 || repeated_sequence.tokens[7u32].byte_offset != 7u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_byte_fallback_preserves_unique_bytes() -> Int {
    erg unique: Buffer = Buffer[8];
    erg unique_index: u32 = 0u32;
    loop {
        if unique_index >= 8u32 {
            break;
        }
        unique[unique_index as Usize] = unique_index as u8;
        unique_index += 1u32;
    }
    erg unique_length: u32 = 8u32;
    erg unique_sequence: TokenSequence = tokenize_bytes(input: abs unique, input_length: erg unique_length);
    if !unique_sequence.valid || unique_sequence.length != 8u32 {
        return 1;
    }
    if unique_sequence.tokens[3u32].id != 3u32 || unique_sequence.tokens[3u32].byte_offset != 3u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_byte_fallback_accepts_non_utf8_bytes_as_bytes() -> Int {
    erg malformed: Buffer = Buffer[2];
    malformed[0u32] = 195u8;
    malformed[1u32] = 40u8;
    erg length: u32 = 2u32;
    erg sequence: TokenSequence = tokenize_bytes(input: abs malformed, input_length: erg length);
    if !sequence.valid || sequence.length != 2u32 {
        return 1;
    }
    if sequence.tokens[0u32].id != 195u32 || sequence.tokens[1u32].id != 40u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_byte_fallback_rejects_length_outside_buffer() -> Int {
    erg input: Buffer = Buffer[4];
    erg length: u32 = 5u32;
    erg sequence: TokenSequence = tokenize_bytes(input: abs input, input_length: erg length);
    if sequence.valid || sequence.length != 0u32 {
        return 1;
    }
    return 0;
}

"""Acceptance tests for direct text teaching through public facades."""
import aie;

import config;

import teaching;

import tokenizer;

verb empty_teaching_vocabulary() -> BpeVocabulary {
    erg rules: Array[BpeMergeRule,128] = Array[BpeMergeRule, 128]();
    erg records: Array[BpeTokenRecord,256] = Array[BpeTokenRecord, 256]();
    return BpeVocabulary {magic: BPE_VOCAB_MAGIC, version: BPE_VOCAB_VERSION, tokenizer_version: TOKENIZER_VERSION, bos_token_id: BPE_BOS_TOKEN_ID, eos_token_id: BPE_EOS_TOKEN_ID, unknown_token_id: BPE_UNKNOWN_TOKEN_ID, rule_count: 0u32, rules: rules, token_count: 0u32, tokens: records};
}

verb train_direct_example(
    ins fabric: CorticalFabric[64],
    ins bindings: Array[TokenBinding, 64]
) -> Bool {
    erg text: String = "AB";
    erg taught = teach_text_direct(
        fabric: ins fabric,
        bindings: ins bindings,
        text: abs text
    );
    case dat taught {
        Result.Err(_) => {
            return false;
        },
        Result.Ok(metrics) => {
            if metrics.processed_events != 2u32 || metrics.accepted_examples != 1u32 || metrics.allocated_columns != 2u32 || metrics.reinforced_transitions != 2u32 {
                return false;
            }
        },
    };
    return true;
}

meta test
verb test_direct_teaching_reports_metrics_and_recalls_text() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    if !train_direct_example(fabric: ins fabric, bindings: ins bindings) {
        return 1;
    }
    erg prompt_text: String = "A";
    erg prompt: TokenSequence = tokenize_string(text: abs prompt_text);
    erg vocabulary: BpeVocabulary = empty_teaching_vocabulary();
    erg max_tokens: u32 = 1u32;
    erg generated = generate_associative(
        fabric: ins fabric,
        bindings: abs bindings,
        prompt: abs prompt,
        vocabulary: abs vocabulary,
        max_tokens: erg max_tokens
    );
    if !generated.valid || generated.generated_count != 1u32 || generated.tokens.tokens[0u32].id != 66u32 {
        return 1;
    }
    return 0;
}

meta test
verb test_direct_teaching_rejects_empty_text_without_state_mutation() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg before: u32 = fabric.active_count;
    erg text: String = "";
    erg result = teach_text_direct(
        fabric: ins fabric,
        bindings: ins bindings,
        text: abs text
    );
    return case dat result {
        Result.Err(_) => if fabric.active_count == before {
            0;
        } else {
            1;
        },
        Result.Ok(_) => 1,
    };
}

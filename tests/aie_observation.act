"""Acceptance tests for bounded modality-neutral observations."""
import aie;

import config;

meta test
verb test_observation_encoding_is_deterministic() -> Int {
    erg event: ObservationEvent = ObservationEvent {kind: ObservationKind.Obstacle, primary_value: 3u16, secondary_value: 1u16, sequence: 7u32, version: OBSERVATION_VERSION, valid: true};
    erg first = encode_observation(event: abs event);
    erg second = encode_observation(event: abs event);
    erg first_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg second_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg first_ok: Bool = false;
    erg second_ok: Bool = false;
    case dat first {
        Result.Err(_) => {},
        Result.Ok(code) => {
            first_code = code;
            first_ok = true;
        },
    };
    case dat second {
        Result.Err(_) => {},
        Result.Ok(code) => {
            second_code = code;
            second_ok = true;
        },
    };
    if first_ok && second_ok && first_code.mask_low == second_code.mask_low && first_code.mask_high == second_code.mask_high && first_code.active_bits == TOKEN_CODE_ACTIVE_BITS {
        return 0;
    }
    return 1;
}

meta test
verb test_observation_validation_rejects_unsupported_values() -> Int {
    erg event: ObservationEvent = ObservationEvent {kind: ObservationKind.Distance, primary_value: OBSERVATION_MAX_VALUE + 1u16, secondary_value: 0u16, sequence: 1u32, version: OBSERVATION_VERSION, valid: true};
    erg result = validate_observation(event: abs event);
    return case dat result {
        Result.Err(error) => case error {
            ObservationError.ValueOutOfBounds => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_observation_context_separates_predecessors() -> Int {
    erg previous_a: ObservationEvent = ObservationEvent {kind: ObservationKind.Person, primary_value: 1u16, secondary_value: 0u16, sequence: 1u32, version: OBSERVATION_VERSION, valid: true};
    erg previous_b: ObservationEvent = ObservationEvent {kind: ObservationKind.Obstacle, primary_value: 1u16, secondary_value: 0u16, sequence: 1u32, version: OBSERVATION_VERSION, valid: true};
    erg current: ObservationEvent = ObservationEvent {kind: ObservationKind.Direction, primary_value: 2u16, secondary_value: 0u16, sequence: 2u32, version: OBSERVATION_VERSION, valid: true};
    erg first = encode_observation_context(previous: abs previous_a, current: abs current);
    erg second = encode_observation_context(previous: abs previous_b, current: abs current);
    erg first_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg second_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    case dat first {
        Result.Err(_) => {},
        Result.Ok(code) => {
            first_code = code;
        },
    };
    case dat second {
        Result.Err(_) => {},
        Result.Ok(code) => {
            second_code = code;
        },
    };
    if first_code.active_bits == 0u8 || second_code.active_bits == 0u8 {
        return 1;
    }
    if first_code.mask_low == second_code.mask_low && first_code.mask_high == second_code.mask_high {
        return 1;
    }
    return 0;
}

verb observation_snapshot_codes_match(
    abs original: ObservationEvent,
    abs restored: ObservationEvent
) -> Bool {
    erg original_code = encode_observation(event: abs original);
    erg restored_code = encode_observation(event: abs restored);
    erg first_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg second_code: TokenCode = TokenCode {mask_low: 0u64, mask_high: 0u64, active_bits: 0u8, version: 0u16};
    erg code_valid: Bool = true;
    case dat original_code {
        Result.Err(_) => {
            code_valid = false;
        },
        Result.Ok(code) => {
            first_code = code;
        },
    };
    case dat restored_code {
        Result.Err(_) => {
            code_valid = false;
        },
        Result.Ok(code) => {
            second_code = code;
        },
    };
    return code_valid && first_code.mask_low == second_code.mask_low && first_code.mask_high == second_code.mask_high;
}

verb observation_events_match(
    abs original: ObservationEvent,
    abs restored: ObservationEvent
) -> Bool {
    return observation_kind_serialized(kind: abs restored.kind) == observation_kind_serialized(
        kind: abs original.kind
    ) && restored.primary_value == original.primary_value && restored.secondary_value == original.secondary_value && restored.sequence == original.sequence && restored.version == original.version && restored.valid;
}

verb observation_snapshot_roundtrip_valid(abs original: ObservationEvent) -> Bool {
    erg encoded = serialize_observation(event: abs original);
    erg snapshot: ObservationSnapshot = ObservationSnapshot {bytes: Array[u8, 20]()};
    case dat encoded {
        Result.Err(_) => {},
        Result.Ok(value) => {
            snapshot = value;
        },
    };
    if !observation_snapshot_is_valid(snapshot: abs snapshot) {
        return false;
    }
    erg decoded = deserialize_observation(snapshot: abs snapshot);
    erg restored: ObservationEvent = ObservationEvent {kind: ObservationKind.Obstacle, primary_value: 0u16, secondary_value: 0u16, sequence: 0u32, version: 0u16, valid: false};
    erg decode_valid: Bool = true;
    case dat decoded {
        Result.Err(_) => {
            decode_valid = false;
        },
        Result.Ok(event) => {
            restored = event;
        },
    };
    if !decode_valid || !observation_events_match(original: abs original, restored: abs restored) {
        return false;
    }
    return observation_snapshot_codes_match(original: abs original, restored: abs restored);
}

meta test
verb test_observation_snapshot_roundtrip() -> Int {
    erg original: ObservationEvent = ObservationEvent {kind: ObservationKind.Motion, primary_value: 17u16, secondary_value: 9u16, sequence: 44u32, version: OBSERVATION_VERSION, valid: true};
    if observation_snapshot_roundtrip_valid(original: abs original) {
        return 0;
    }
    return 1;
}

meta test
verb test_observation_snapshot_rejects_invalid_header() -> Int {
    erg input: ObservationSnapshot = ObservationSnapshot {bytes: Array[u8, 20]()};
    erg result = deserialize_observation(snapshot: abs input);
    return case dat result {
        Result.Err(error) => case error {
            ObservationError.InvalidSerializedData => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

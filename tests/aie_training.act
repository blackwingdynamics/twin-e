"""Acceptance tests for bounded training input admission."""
import aie;

import tokenizer;

meta test
verb test_training_input_accepts_valid_sequence() -> Int {
    erg text: String = "Hello";
    erg sequence: TokenSequence = tokenize_string(text: abs text);
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Ok(length) => if length == 5 {
            0;
        } else {
            1;
        },
        Result.Err(_) => 1,
    };
}

meta test
verb test_training_input_rejects_empty_sequence() -> Int {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 0u32, valid: true};
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Err(error) => case error {
            TrainingInputError.EmptySequence => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_training_input_rejects_oversized_sequence() -> Int {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 257u32, valid: true};
    erg result = validate_training_sequence(sequence: abs sequence);
    return case dat result {
        Result.Err(error) => case error {
            TrainingInputError.TooManyEvents => 0,
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

meta test
verb test_training_sequence_creates_context_bindings_and_paths() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg text: String = "AB";
    erg sequence: TokenSequence = tokenize_string(text: abs text);
    erg trained = train_token_sequence(
        fabric: ins fabric,
        bindings: ins bindings,
        sequence: abs sequence
    );
    return case dat trained {
        Result.Err(_) => 1,
        Result.Ok(metrics) => if metrics.processed_events == 2u32 && metrics.allocated_columns == 2u32 && metrics.reinforced_transitions == 2u32 && metrics.active_bindings == 2u32 && fabric.active_count == 3u32 {
            0;
        } else {
            1;
        },
    };
}

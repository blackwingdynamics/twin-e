"""Acceptance tests for the public teaching wire message contract."""
import teaching;

meta test
verb test_teaching_wire_request_message_has_stable_identity() -> Int {
    erg sequence_num: u32 = 7u32;
    erg payload_length: u32 = 12u32;
    erg message = teaching_wire_request_message(sequence_num: erg sequence_num, payload_length: erg payload_length);
    if message.frame_version != WIRE_VERSION {
        return 1;
    }
    if message.message_id != TEACHING_WIRE_MESSAGE_ID || message.message_version != TEACHING_WIRE_MESSAGE_VERSION {
        return 2;
    }
    if message.sequence_num != 7u32 || message.payload_length != 12u32 {
        return 3;
    }
    return case message.message_type {
        TeachingWireMessageType.TeachingRequest => if teaching_wire_message_is_valid(message: abs message) {
            0;
        } else {
            4;
        },
    };
}

meta test
verb test_teaching_wire_request_rejects_oversized_payload() -> Int {
    erg sequence_num: u32 = 8u32;
    erg payload_length: u32 = WIRE_MAX_PAYLOAD_BYTES + 1u32;
    erg message = teaching_wire_request_message(sequence_num: erg sequence_num, payload_length: erg payload_length);
    if teaching_wire_message_is_valid(message: abs message) {
        return 1;
    }
    return 0;
}

meta test
verb test_teaching_wire_frame_boundary_includes_header_payload_and_checksum() -> Int {
    erg sequence_num: u32 = 9u32;
    erg payload_length: u32 = 64u32;
    erg message = teaching_wire_request_message(sequence_num: erg sequence_num, payload_length: erg payload_length);
    erg expected: u32 = WIRE_HEADER_BYTES + 64u32 + WIRE_CRC_BYTES;
    if teaching_wire_frame_length(message: abs message) != expected {
        return 1;
    }
    if !teaching_wire_frame_is_valid(message: abs message, frame_length: erg expected) {
        return 2;
    }
    erg truncated_length: u32 = expected - 1u32;
    if teaching_wire_frame_is_valid(message: abs message, frame_length: erg truncated_length) {
        return 3;
    }
    return 0;
}

meta test
verb test_teaching_wire_frame_boundary_rejects_maximum_overflow() -> Int {
    erg sequence_num: u32 = 10u32;
    erg maximum_payload: u32 = WIRE_MAX_PAYLOAD_BYTES;
    erg message = teaching_wire_request_message(sequence_num: erg sequence_num, payload_length: erg maximum_payload);
    erg expected: u32 = teaching_wire_frame_length(message: abs message);
    if expected != WIRE_MAX_FRAME_BYTES {
        return 1;
    }
    if !teaching_wire_frame_is_valid(message: abs message, frame_length: erg expected) {
        return 2;
    }
    erg oversized_sequence_num: u32 = 11u32;
    erg oversized_payload_length: u32 = WIRE_MAX_PAYLOAD_BYTES + 1u32;
    erg oversized = teaching_wire_request_message(sequence_num: erg oversized_sequence_num, payload_length: erg oversized_payload_length);
    erg oversized_length: u32 = teaching_wire_frame_length(message: abs oversized);
    if teaching_wire_frame_is_valid(message: abs oversized, frame_length: erg oversized_length) {
        return 3;
    }
    return 0;
}

meta test
verb test_teaching_wire_frame_carries_one_request_only() -> Int {
    if TEACHING_WIRE_MAX_MESSAGES_PER_FRAME != 1u8 {
        return 1;
    }
    erg one_message: u8 = 1u8;
    if !teaching_wire_message_count_is_valid(message_count: erg one_message) {
        return 2;
    }
    erg two_messages: u8 = 2u8;
    if teaching_wire_message_count_is_valid(message_count: erg two_messages) {
        return 3;
    }
    return 0;
}

verb teaching_wire_test_frame(ins output: Buffer) -> Result[u32, WireError] {
    erg header = WireHeader {storage: Array[u8, 12]()};
    header.magic_0 = WIRE_MAGIC_0;
    header.magic_1 = WIRE_MAGIC_1;
    header.version = WIRE_VERSION;
    header.flags = 0u8;
    header.message_id = TEACHING_WIRE_MESSAGE_ID;
    header.channel_id = 0u8;
    header.sequence_num = 21u32;
    header.payload_len = 1u16;
    erg payload: Buffer = Buffer[1];
    payload[0] = 42u8;
    return wire_frame_encode(
        header: abs header,
        payload: abs payload,
        output: ins output
    );
}

meta test
verb test_teaching_wire_decoder_accepts_valid_frame() -> Int {
    erg frame: Buffer = Buffer[15];
    erg encoded = teaching_wire_test_frame(output: ins frame);
    case dat encoded {
        Result.Err(_) => {
            return 1;
        },
        Result.Ok(_) => {},
    };
    erg payload: Buffer = Buffer[1];
    erg decoded = teaching_wire_decode_request(frame: abs frame, payload_output: ins payload);
    return case dat decoded {
        Result.Err(_) => 2,
        Result.Ok(message) => if message.sequence_num == 21u32 && message.payload_length == 1u32 && payload[0] == 42u8 {
            0;
        } else {
            3;
        },
    };
}

meta test
verb test_teaching_wire_decoder_rejects_corrupt_frame() -> Int {
    erg frame: Buffer = Buffer[15];
    erg encoded = teaching_wire_test_frame(output: ins frame);
    case dat encoded {
        Result.Err(_) => {
            return 1;
        },
        Result.Ok(_) => {},
    };
    frame[12] = 43u8;
    erg payload: Buffer = Buffer[1];
    erg corrupt = teaching_wire_decode_request(frame: abs frame, payload_output: ins payload);
    erg corrupt_rejected: Bool = case dat corrupt {
        Result.Err(error) => error == WireError.ChecksumMismatch,
        Result.Ok(_) => false,
    };
    if !corrupt_rejected {
        return 2;
    }
    return 0;
}

meta test
verb test_teaching_wire_decoder_rejects_truncated_frame() -> Int {
    erg frame: Buffer = Buffer[15];
    erg encoded = teaching_wire_test_frame(output: ins frame);
    case dat encoded {
        Result.Err(_) => {
            return 1;
        },
        Result.Ok(_) => {},
    };
    erg truncated: Buffer = Buffer[12];
    for erg index: u32 in 0u32 .. 12u32 {
        truncated[index] = frame[index];
    }
    erg payload: Buffer = Buffer[1];
    erg truncated_result = teaching_wire_decode_request(frame: abs truncated, payload_output: ins payload);
    erg truncated_rejected: Bool = case dat truncated_result {
        Result.Err(error) => error == WireError.Truncated,
        Result.Ok(_) => false,
    };
    if !truncated_rejected {
        return 3;
    }
    return 0;
}

meta test
verb test_teaching_wire_decoder_rejects_unsupported_version() -> Int {
    erg unsupported: Buffer = Buffer[12];
    unsupported[0] = WIRE_MAGIC_0;
    unsupported[1] = WIRE_MAGIC_1;
    unsupported[2] = WIRE_VERSION + 1u8;
    erg payload: Buffer = Buffer[1];
    erg unsupported_result = teaching_wire_decode_request(frame: abs unsupported, payload_output: ins payload);
    erg unsupported_rejected: Bool = case dat unsupported_result {
        Result.Err(error) => error == WireError.UnsupportedVersion,
        Result.Ok(_) => false,
    };
    if !unsupported_rejected {
        return 1;
    }
    return 0;
}

"""Policy fixtures for the accepted image, audio, and video envelopes."""
import config;

meta test
verb test_image_envelope_policy_accepts_bounded_patch() -> Int {
    if ADAPTER_IMAGE_MAX_WIDTH == 0u16 || ADAPTER_IMAGE_MAX_HEIGHT == 0u16 || ADAPTER_IMAGE_MAX_CHANNELS == 0u8 || ADAPTER_IMAGE_MAX_QUANTIZED_VALUE != 255u16 {
        return 1;
    }
    return 0;
}

meta test
verb test_image_envelope_policy_rejects_oversized_patch() -> Int {
    erg width: u16 = ADAPTER_IMAGE_MAX_WIDTH + 1u16;
    erg height: u16 = ADAPTER_IMAGE_MAX_HEIGHT + 1u16;
    if width <= ADAPTER_IMAGE_MAX_WIDTH || height <= ADAPTER_IMAGE_MAX_HEIGHT {
        return 1;
    }
    return 0;
}

meta test
verb test_audio_envelope_policy_defines_empty_and_oversized_windows() -> Int {
    erg empty_window: u32 = 0u32;
    erg oversized_window: u32 = ADAPTER_AUDIO_MAX_WINDOW_SAMPLES + 1u32;
    if empty_window != 0u32 || oversized_window <= ADAPTER_AUDIO_MAX_WINDOW_SAMPLES || ADAPTER_AUDIO_MAX_CHANNELS == 0u8 || ADAPTER_AUDIO_MAX_FEATURE_VALUE > OBSERVATION_MAX_VALUE {
        return 1;
    }
    return 0;
}

meta test
verb test_video_envelope_policy_bounds_temporal_order() -> Int {
    erg empty_frames: u16 = 0u16;
    erg oversized_frames: u16 = ADAPTER_VIDEO_MAX_FRAMES + 1u16;
    if empty_frames != 0u16 || oversized_frames <= ADAPTER_VIDEO_MAX_FRAMES || ADAPTER_VIDEO_MAX_WIDTH == 0u16 || ADAPTER_VIDEO_MAX_HEIGHT == 0u16 || ADAPTER_VIDEO_MAX_CHANNELS == 0u8 {
        return 1;
    }
    return 0;
}

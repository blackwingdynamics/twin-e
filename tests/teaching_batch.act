"""Acceptance tests for bounded caller-driven teaching batches."""
import adapters;

import config;

import teaching;

verb batch_request(erg byte_value: u8, abs valid: Bool) -> TeachingRequest {
    erg input: Buffer = Buffer[1];
    input[0u32] = byte_value;
    erg input_length: u32 = 1u32;
    erg adapted = adapt_text_bytes(input: abs input, input_length: erg input_length);
    erg envelope: AdapterEnvelope = AdapterEnvelope {contract_version: ADAPTER_CONTRACT_VERSION, modality: AdapterModality.Text, event_count: 0u16, source_length: 0u32, events: Array[AdapterEvent, 256](
    ), valid: false};
    case dat adapted {
        Result.Err(_) => {},
        Result.Ok(adapted_envelope) => {
            envelope = adapted_envelope;
        },
    };
    erg envelope_valid: Bool = envelope.valid;
    return TeachingRequest {contract_version: TEACHING_CONTRACT_VERSION, mode: TeachingMode.Direct, envelope: envelope, replay_passes: 1u16, valid: valid && envelope_valid};
}

meta test
verb test_batch_reports_mixed_item_results_in_order() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg requests: Array[TeachingRequest,8] = Array[TeachingRequest, 8]();
    erg first_byte: u8 = 65u8;
    erg second_byte: u8 = 66u8;
    erg accepted: Bool = true;
    erg rejected: Bool = false;
    requests[0u32] = batch_request(byte_value: erg first_byte, valid: abs accepted);
    requests[1u32] = batch_request(byte_value: erg second_byte, valid: abs rejected);
    requests[2u32] = batch_request(byte_value: erg second_byte, valid: abs accepted);
    erg batch: TeachingBatch = TeachingBatch {requests: requests, count: 3u16, valid: true};
    erg taught = teach_batch(
        fabric: ins fabric,
        bindings: ins bindings,
        batch: abs batch
    );
    return case dat taught {
        Result.Err(_) => 1,
        Result.Ok(metrics) => if metrics.item_count == 3u16 && metrics.accepted_count == 2u16 && metrics.rejected_count == 1u16 && !metrics.stopped_on_training_error && metrics.items[0u32].accepted && !metrics.items[1u32].accepted && metrics.items[2u32].accepted && fabric.active_count == 4u32 {
            0;
        } else {
            1;
        },
    };
}

meta test
verb test_batch_rejects_oversized_count_without_mutation() -> Int {
    erg fabric: CorticalFabric[64] = CorticalFabric[64] {columns: Array[Minicolumn, 64](), free_list_head: 0u32, active_count: 0u32};
    erg bindings: Array[TokenBinding,64] = Array[TokenBinding, 64]();
    fabric_init(fabric: ins fabric);
    erg requests: Array[TeachingRequest,8] = Array[TeachingRequest, 8]();
    erg first_byte: u8 = 65u8;
    erg accepted: Bool = true;
    requests[0u32] = batch_request(byte_value: erg first_byte, valid: abs accepted);
    erg batch: TeachingBatch = TeachingBatch {requests: requests, count: TEACHING_MAX_BATCH_ITEMS + 1u16, valid: true};
    erg taught = teach_batch(
        fabric: ins fabric,
        bindings: ins bindings,
        batch: abs batch
    );
    return case dat taught {
        Result.Err(error) => case error {
            TeachingError.InvalidRequest => if fabric.active_count == 0u32 {
                0;
            } else {
                1;
            },
            _ => 1,
        },
        Result.Ok(_) => 1,
    };
}

"""Gate 11.5 evidence for shard-local bindings and auxiliary recovery."""
import aie;

import config;

import tokenizer;

open config;

open tokenizer;

verb auxiliary_test_sequence(erg seed: u32) -> TokenSequence {
    erg sequence: TokenSequence = TokenSequence {tokens: Array[Token, 256](), length: 255u32, valid: true};
    for erg position: u32 in 0u32 .. 255u32 {
        sequence.tokens[position as Usize] = Token {id: seed + position, byte_offset: position, byte_length: 1u16, tokenizer_version: TOKENIZER_VERSION};
    }
    return sequence;
}

verb auxiliary_test_teach(ins brain: LogicalTeachingBrain, erg seed: u32) -> Bool {
    erg sequence: TokenSequence = auxiliary_test_sequence(seed: erg seed);
    erg taught = logical_teaching_sequence(brain: ins brain, sequence: abs sequence);
    return case dat taught {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb auxiliary_test_admit_two(ins brain: LogicalTeachingBrain) -> Bool {
    for erg index: u32 in 0u32 .. 5u32 {
        erg seed: u32 = 1000u32 + index * 1000u32;
        if !auxiliary_test_teach(brain: ins brain, seed: erg seed) {
            return false;
        }
    }
    return brain.logical.shard_count == 2u32;
}

verb auxiliary_test_init(ins brain: LogicalTeachingBrain) -> Bool {
    erg initialized = logical_teaching_init(brain: ins brain);
    return case dat initialized {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb auxiliary_test_link(
    ins brain: LogicalTeachingBrain,
    erg source: u32,
    erg target: u32
) -> Bool {
    erg linked = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg source,
        target_global: erg target
    );
    return case dat linked {
        Result.Err(_) => false,
        Result.Ok(_) => true,
    };
}

verb auxiliary_test_cross_shard_identity(ins brain: LogicalTeachingBrain) -> Int {
    if !auxiliary_test_admit_two(brain: ins brain) {
        return 10;
    }
    erg source: u32 = 0u32;
    erg target: u32 = 1024u32;
    if !auxiliary_test_link(
        brain: ins brain,
        source: erg source,
        target: erg target
    ) {
        return 11;
    }
    erg record_index = aux_record_for_source(table: abs brain.auxiliary[0u32].table, source: erg source);
    if record_index == NULL_INDEX {
        return 12;
    }
    if brain.auxiliary[0u32].table.records[record_index].targets[0u32] != 1024u32 {
        return brain.auxiliary[0u32].table.records[record_index].targets[0u32] as Int;
    }
    if (brain.fabrics[0u32].columns[0u32].flags & FLAG_HAS_AUX) == 0u8 {
        return 13;
    }
    return 0;
}

verb auxiliary_test_recovery_and_invalid_preflight(ins brain: LogicalTeachingBrain) -> Int {
    erg source: u32 = 0u32;
    erg record_index = aux_record_for_source(table: abs brain.auxiliary[0u32].table, source: erg source);
    if record_index == NULL_INDEX {
        return 29;
    }
    erg snapshot: LogicalAuxiliarySnapshot = LogicalAuxiliarySnapshot {table: brain.auxiliary[0u32].table, checksum: 0u64};
    logical_auxiliary_snapshot_capture(snapshot: ins snapshot, state: abs brain.auxiliary[0u32]);
    erg recovered: LogicalAuxiliaryState = logical_auxiliary_empty();
    logical_auxiliary_init(state: ins recovered);
    if !logical_auxiliary_snapshot_restore(state: ins recovered, snapshot: abs snapshot) {
        return 30;
    }
    if recovered.table.records[record_index].targets[0u32] != 1024u32 {
        return 31;
    }
    snapshot.table.records[record_index].targets[0u32] = BRAIN_LOGICAL_MAX_COLUMNS;
    if logical_auxiliary_snapshot_restore(state: ins brain.auxiliary[0u32], snapshot: abs snapshot) {
        return 32;
    }
    if brain.auxiliary[0u32].table.records[record_index].targets[0u32] != 1024u32 {
        return 33;
    }
    return 0;
}

verb auxiliary_test_release_reuse(ins brain: LogicalTeachingBrain) -> Bool {
    erg source: u32 = 0u32;
    erg target: u32 = 1025u32;
    if !logical_teaching_auxiliary_release(brain: ins brain, source_global: erg source) {
        return false;
    }
    if brain.auxiliary[0u32].table.active_count != 0u32 || (brain.fabrics[0u32].columns[0u32].flags & FLAG_HAS_AUX) != 0u8 {
        return false;
    }
    return auxiliary_test_link(
        brain: ins brain,
        source: erg source,
        target: erg target
    );
}

meta test
verb test_logical_auxiliary_cross_shard_round_trip_and_recovery() -> Int {
    erg brain: LogicalTeachingBrain = logical_teaching_empty();
    if !auxiliary_test_init(brain: ins brain) {
        return 1;
    }
    erg identity_status: Int = auxiliary_test_cross_shard_identity(brain: ins brain);
    if identity_status != 0 {
        return identity_status;
    }
    erg recovery_status: Int = auxiliary_test_recovery_and_invalid_preflight(brain: ins brain);
    if recovery_status != 0 {
        return recovery_status;
    }
    if !auxiliary_test_release_reuse(brain: ins brain) {
        return 4;
    }
    return 0;
}

meta test
verb test_logical_auxiliary_rejects_unadmitted_cross_shard_target() -> Int {
    erg brain: LogicalTeachingBrain = logical_teaching_empty();
    erg seed: u32 = 9000u32;
    if !auxiliary_test_init(brain: ins brain) || !auxiliary_test_teach(brain: ins brain, seed: erg seed) {
        return 1;
    }
    erg source: u32 = 0u32;
    erg target: u32 = 1024u32;
    erg rejected = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg source,
        target_global: erg target
    );
    return case dat rejected {
        Result.Err(error) => case error {
            LogicalAuxiliaryError.ShardNotAdmitted => 0,
            _ => 2,
        },
        Result.Ok(_) => 3,
    };
}

verb auxiliary_test_rejects_duplicate(ins brain: LogicalTeachingBrain) -> Bool {
    erg source: u32 = 0u32;
    erg target: u32 = 1024u32;
    if !auxiliary_test_link(
        brain: ins brain,
        source: erg source,
        target: erg target
    ) {
        return false;
    }
    erg duplicate = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg source,
        target_global: erg target
    );
    if case dat duplicate {
        Result.Err(error) => error != LogicalAuxiliaryError.Duplicate,
        Result.Ok(_) => true,
    } {
        return false;
    }
    return true;
}

verb auxiliary_test_link_status(
    ins brain: LogicalTeachingBrain,
    erg source: u32,
    erg target: u32
) -> Int {
    erg linked = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg source,
        target_global: erg target
    );
    return case dat linked {
        Result.Err(error) => case error {
            LogicalAuxiliaryError.NotInitialized => 30,
            LogicalAuxiliaryError.ShardNotAdmitted => 31,
            LogicalAuxiliaryError.InvalidIndex => 32,
            LogicalAuxiliaryError.Capacity => 33,
            LogicalAuxiliaryError.Duplicate => 34,
            LogicalAuxiliaryError.Full => 35,
            LogicalAuxiliaryError.InvalidSnapshot => 36,
        },
        Result.Ok(_) => 0,
    };
}

verb auxiliary_test_rejects_overflow(ins brain: LogicalTeachingBrain) -> Int {
    for erg source: u32 in 1u32 .. 8u32 {
        erg target: u32 = 1024u32 + source;
        erg link_status: Int = auxiliary_test_link_status(
            brain: ins brain,
            source: erg source,
            target: erg target
        );
        if link_status != 0 {
            return link_status + 100 + brain.auxiliary[0u32].table.active_count as Int;
        }
    }
    erg overflow_source: u32 = 8u32;
    erg overflow_target: u32 = 1032u32;
    erg overflow = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg overflow_source,
        target_global: erg overflow_target
    );
    return case dat overflow {
        Result.Err(error) => case error {
            LogicalAuxiliaryError.Capacity => 0,
            LogicalAuxiliaryError.Full => 0,
            _ => 22,
        },
        Result.Ok(_) => 23,
    };
}

verb auxiliary_test_rejects_invalid_source(ins brain: LogicalTeachingBrain) -> Bool {
    erg source: u32 = BRAIN_LOGICAL_MAX_COLUMNS;
    erg target: u32 = 1024u32;
    erg invalid = logical_teaching_auxiliary_link(
        brain: ins brain,
        source_global: erg source,
        target_global: erg target
    );
    return case dat invalid {
        Result.Err(error) => case error {
            LogicalAuxiliaryError.InvalidIndex => true,
            _ => false,
        },
        Result.Ok(_) => false,
    };
}

meta test
verb test_logical_auxiliary_rejects_duplicate_overflow_and_invalid_source() -> Int {
    erg brain: LogicalTeachingBrain = logical_teaching_empty();
    if !auxiliary_test_init(brain: ins brain) || !auxiliary_test_admit_two(brain: ins brain) {
        return 1;
    }
    if !auxiliary_test_rejects_duplicate(brain: ins brain) {
        return 2;
    }
    erg overflow_status: Int = auxiliary_test_rejects_overflow(brain: ins brain);
    if overflow_status != 0 {
        return overflow_status;
    }
    if !auxiliary_test_rejects_invalid_source(brain: ins brain) {
        return 4;
    }
    return 0;
}

